{
  "name": "slot-timer-pro",
  "productName": "PitWall",
  "version": "1.10.2",
  "description": "PitWall — Slot car race management and timing system",
  "author": "Víctor González Gómez <vgonzalezgomez@outlook.es>",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/vgonzalezgomez85/PitWall-Manager"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "electron": "node electron/launcher.js",
    "dist": "electron-builder --mac --win --linux",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@stoprocent/noble": "^2.5.3",
    "better-sqlite3": "^12.2.0",
    "bonjour-service": "^1.3.0",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-session": "^1.17.3",
    "method-override": "^3.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "node-forge": "^1.4.0",
    "qrcode": "^1.5.4",
    "serialport": "^12.0.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.0",
    "socket.io-client": "^4.8.3"
  },
  "build": {
    "appId": "com.pitwall.app",
    "productName": "PitWall",
    "copyright": "Copyright © 2026 Víctor González Gómez — GNU AGPLv3",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "public/**/*",
      "build/icon.png",
      "build/icon.icns",
      "build/icon.ico",
      "build/icon.svg",
      "build/tray/**/*",
      "package.json",
      "!database/**",
      "!dist-app/**",
      "!*.log",
      "!node_modules/.bin"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*",
      "**/node_modules/serialport/**/*",
      "**/node_modules/@serialport/**/*",
      "**/node_modules/bindings/**/*",
      "**/node_modules/node-gyp-build/**/*",
      "**/node_modules/@stoprocent/**/*",
      "**/node_modules/@abandonware/**/*"
    ],
    "npmRebuild": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.sports-games",
      "identity": null,
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "PitWall usa Bluetooth para conectar con el cronómetro BART (BLE).",
        "NSBluetoothPeripheralUsageDescription": "PitWall usa Bluetooth para conectar con el cronómetro BART (BLE)."
      }
    },
    "dmg": {
      "title": "Instalar PitWall",
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PitWall",
      "include": "build/installer.nsh"
    }
  }
}
