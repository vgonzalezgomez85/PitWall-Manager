<%- include('../partials/header', { pageTitle: lang === 'es' ? 'Equipos' : 'Teams' }) %>
<div class="container">

  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;flex-wrap:wrap;gap:.75rem">
    <h1 class="page-title" style="margin:0">
      🤝 <%= lang === 'es' ? 'Equipos' : 'Teams' %>
    </h1>
    <a href="/teams/new" class="btn btn--primary">
      + <%= lang === 'es' ? 'Nuevo equipo' : 'New team' %>
    </a>
  </div>

  <% if (teams.length === 0) { %>
    <div class="empty-state" style="padding:3rem">
      <p class="empty-state__text">
        <%= lang === 'es' ? 'No hay equipos todavía. Crea uno para reutilizarlo en tus carreras.' : 'No teams yet. Create one to reuse it in your races.' %>
      </p>
      <a href="/teams/new" class="btn btn--primary" style="margin-top:1rem">
        + <%= lang === 'es' ? 'Crear equipo' : 'Create team' %>
      </a>
    </div>
  <% } else { %>
    <div class="tanda-block" style="padding:0;overflow:hidden">
      <table class="schedule-table">
        <thead>
          <tr>
            <th style="width:36px"></th>
            <th style="width:64px"><%= lang === 'es' ? 'Coche' : 'Car' %></th>
            <th><%= lang === 'es' ? 'Nombre' : 'Name' %></th>
            <th style="width:90px"><%= lang === 'es' ? 'Categoría' : 'Category' %></th>
            <th><%= lang === 'es' ? 'Pilotos' : 'Drivers' %></th>
            <th><%= lang === 'es' ? 'Notas' : 'Notes' %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% teams.forEach(t => { %>
            <tr>
              <td style="font-size:1.4rem;text-align:center">
                <% if (t.country) { %>
                  <% const flag = t.country.split('|')[1]; %>
                  <% if (flag === '__SVG__') { %>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 9 6" width="26" height="17" style="border-radius:2px;vertical-align:middle"><rect width="9" height="6" fill="#FCDD09"/><rect y="0.667" width="9" height="0.889" fill="#DA121A"/><rect y="2.222" width="9" height="0.889" fill="#DA121A"/><rect y="3.778" width="9" height="0.889" fill="#DA121A"/><rect y="5.333" width="9" height="0.667" fill="#DA121A"/></svg>
                  <% } else { %>
                    <%= flag %>
                  <% } %>
                <% } %>
              </td>
              <td>
                <% if (t.car_photo) { %>
                  <img src="<%= t.car_photo %>" alt="<%= t.coche || '' %>"
                       style="height:36px;max-width:60px;object-fit:contain;border-radius:4px;background:#000000;border:1px solid #30363d;padding:1px">
                <% } else { %>
                  <span style="color:#30363d;font-size:.75rem">—</span>
                <% } %>
              </td>
              <td style="font-weight:600">
                <%= t.name %>
                <% if (t.coche) { %><div style="font-size:.75rem;color:#8b949e;font-weight:400"><%= t.coche %></div><% } %>
              </td>
              <td>
                <% if (t.categoria) { %>
                  <span style="display:inline-block;padding:.1rem .5rem;border-radius:12px;background:#21262d;font-size:.72rem;font-weight:600;letter-spacing:.05em;color:#e6edf3"><%= t.categoria %></span>
                <% } else { %>
                  <span style="color:#30363d">—</span>
                <% } %>
              </td>
              <td style="color:var(--text-muted);font-size:.9rem">
                <% if (t.members.length === 0) { %>
                  <span style="color:var(--text-muted)">—</span>
                <% } else { %>
                  <%= t.members.map(m => m.name).join(', ') %>
                <% } %>
              </td>
              <td style="color:var(--text-muted);font-size:.85rem"><%= t.notes || '—' %></td>
              <td>
                <div style="display:flex;gap:.4rem;justify-content:flex-end">
                  <a href="/teams/<%= t.id %>/edit" class="btn btn--ghost btn--sm">
                    ✏ <%= lang === 'es' ? 'Editar' : 'Edit' %>
                  </a>
                  <form action="/teams/<%= t.id %>/delete" method="POST"
                        onsubmit="return confirm('<%= lang === 'es' ? '¿Eliminar equipo?' : 'Delete team?' %>')">
                    <button type="submit" class="btn btn--danger btn--sm">✕</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

</div>
<%- include('../partials/footer') %>
