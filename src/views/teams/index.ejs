<%- include('../partials/header', { pageTitle: lang === 'es' ? 'Equipos' : 'Teams' }) %>

<div class="vt-page">
  <div class="vt-wrap">

    <a href="/" class="vt-back-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      <%= lang === 'es' ? 'Inicio' : 'Home' %>
    </a>

    <% if (flash) { %>
      <div class="flash flash--<%= flash.type %>" style="margin-bottom:1rem"><%- flash.text %></div>
    <% } %>

    <div class="vt-head">
      <div class="vt-head__title">
        <h1><%= lang === 'es' ? 'Equipos' : 'Teams' %></h1>
        <span class="vt-cnt"><%= teams.length %></span>
      </div>
      <div class="vt-head__actions">
        <a href="/plantilla_equipos.csv" download class="vt-btn vt-btn--ghost vt-btn--sm">
          <svg viewBox="0 0 24 24"><path d="M12 4v12M6 11l6 6 6-6M5 21h14"/></svg>
          <%= lang === 'es' ? 'Plantilla CSV' : 'CSV Template' %>
        </a>
        <button type="button" class="vt-btn vt-btn--ghost vt-btn--sm" id="toggleCsv">
          <svg viewBox="0 0 24 24"><path d="M14 3h5a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"/><path d="M12 3v12M8 11l4 4 4-4"/></svg>
          <%= lang === 'es' ? 'Importar CSV' : 'Import CSV' %>
        </button>
        <a href="/teams/qr-export" target="_blank" class="vt-btn vt-btn--ghost vt-btn--sm">
          <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><path d="M14 14h3v3h-3zM19 14h2v2h-2zM14 19h2v2h-2zM19 19h2v2h-2z"/></svg>
          <%= lang === 'es' ? 'Exportar QR' : 'Export QR' %>
        </a>
        <a href="/teams/new" class="vt-btn vt-btn--primary">
          + <%= lang === 'es' ? 'Nuevo equipo' : 'New team' %>
        </a>
      </div>
    </div>

    <!-- CSV Import panel -->
    <div id="csv-import-panel" style="display:none;margin-top:18px">
      <div class="vt-card">
        <div class="vt-card-h">
          <svg viewBox="0 0 24 24"><path d="M14 3h5a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"/></svg>
          <%= lang === 'es' ? 'Importar equipos desde CSV' : 'Import teams from CSV' %>
        </div>
        <p class="vt-hint" style="margin-bottom:12px;line-height:1.55">
          <%- lang === 'es'
            ? '<b>Cabecera obligatoria.</b> Columnas reconocidas (orden libre): <b>nombre</b> (obligatorio), <b>categoria</b>, <b>coche</b>, <b>pais</b> (escribe el nombre: España, Francia, Reino Unido… — la bandera se añade automáticamente), <b>notas</b>, <b>pilotos</b> (lista separada por "|"). Cada piloto se busca en tu base de datos por nombre: si existe, se enlaza al equipo; si no existe, se crea automáticamente como bronce y aparece en /pilotos para que le ajustes la categoría. Acepta separador "," o ";". Si una celda lleva comas dentro, envuélvela en comillas.'
            : '<b>Header required.</b> Recognized columns (free order): <b>name</b> (required), <b>category</b>, <b>car</b>, <b>country</b> (just the name — flag auto-added), <b>notes</b>, <b>drivers</b> (list separated by "|"). Each driver is looked up in the database by name: if it exists, linked to the team; if not, auto-created as bronze and shown in /drivers so you can adjust the category. Accepts "," or ";" as separator. Quote cells that contain commas.' %>
        </p>
        <form action="/teams/import/preview" method="POST" id="csv-form">
          <input type="hidden" name="csv_content" id="csv-content-input">
          <div class="vt-csv-row">
            <input type="file" id="csv-file-picker" accept=".csv,text/csv">
            <span id="csv-file-name" class="vt-hint"></span>
            <button type="submit" id="csv-submit" class="vt-btn vt-btn--primary vt-btn--sm" disabled>
              <%= lang === 'es' ? 'Importar' : 'Import' %>
            </button>
          </div>
        </form>
      </div>
    </div>

    <%
      const CAT_PALETTE = ['#58a6ff','#f6c90e','#3fb950','#ff6b9d','#ff9800','#ba68c8','#00bcd4','#e63946','#8bc34a','#ce93d8','#4dd0e1','#ffab40'];
      function catColor(cat) {
        if (!cat) return null;
        let h = 0;
        for (let i = 0; i < cat.length; i++) h = (h * 31 + cat.charCodeAt(i)) >>> 0;
        return CAT_PALETTE[h % CAT_PALETTE.length];
      }
      function catRgba(hex, alpha) {
        const r = parseInt(hex.slice(1, 3), 16), g = parseInt(hex.slice(3, 5), 16), b = parseInt(hex.slice(5, 7), 16);
        return `rgba(${r},${g},${b},${alpha})`;
      }
    %>

    <% if (teams.length === 0) { %>
      <div class="vt-empty" style="margin-top:32px">
        <div class="vt-empty__t"><%= lang === 'es' ? 'Sin equipos' : 'No teams' %></div>
        <p style="color:var(--vt-mute);margin:6px 0 16px">
          <%= lang === 'es' ? 'Crea uno para reutilizarlo en tus carreras.' : 'Create one to reuse it in your races.' %>
        </p>
        <a href="/teams/new" class="vt-btn vt-btn--primary">+ <%= lang === 'es' ? 'Crear equipo' : 'Create team' %></a>
      </div>
    <% } else { %>

      <div class="vt-table-card">
        <table class="vt-table">
          <thead>
            <tr>
              <th style="width:50px"></th>
              <th style="width:80px"><%= lang === 'es' ? 'Coche' : 'Car' %></th>
              <th><%= lang === 'es' ? 'Nombre' : 'Name' %></th>
              <th><%= lang === 'es' ? 'Categoría' : 'Category' %></th>
              <th><%= lang === 'es' ? 'Pilotos' : 'Drivers' %></th>
              <th><%= lang === 'es' ? 'Notas' : 'Notes' %></th>
              <th class="is-actions"></th>
            </tr>
          </thead>
          <tbody>
            <% teams.forEach(team => { %>
              <tr>
                <td style="text-align:center">
                  <% const flag = team.country ? team.country.split('|')[1] : null; %>
                  <% if (flag === '__SVG__') { %>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 9 6" width="28" height="18" style="border-radius:3px;vertical-align:middle">
                      <rect width="9" height="6" fill="#FCDD09"/>
                      <rect y="0.667" width="9" height="0.889" fill="#DA121A"/>
                      <rect y="2.222" width="9" height="0.889" fill="#DA121A"/>
                      <rect y="3.778" width="9" height="0.889" fill="#DA121A"/>
                      <rect y="5.333" width="9" height="0.667" fill="#DA121A"/>
                    </svg>
                  <% } else if (flag === '__SVG_EUS__') { %>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 9 6" width="28" height="18" style="border-radius:3px;vertical-align:middle">
                      <rect width="9" height="6" fill="#DC0A2D"/>
                      <line x1="0" y1="0" x2="9" y2="6" stroke="#00933C" stroke-width="1.8"/>
                      <line x1="0" y1="6" x2="9" y2="0" stroke="#00933C" stroke-width="1.8"/>
                      <rect x="0" y="2.4" width="9" height="1.2" fill="#FFFFFF"/>
                      <rect x="3.9" y="0" width="1.2" height="6" fill="#FFFFFF"/>
                    </svg>
                  <% } else if (flag && flagEmojiToIso(flag)) { %>
                    <img src="/flags/4x3/<%= flagEmojiToIso(flag) %>.svg" alt="" width="28" height="18" style="object-fit:cover;border-radius:3px;vertical-align:middle">
                  <% } else { %>
                    <span style="font-size:1.4rem;opacity:.3" title="<%= lang === 'es' ? 'Sin país' : 'No country' %>">🌐</span>
                  <% } %>
                </td>
                <td>
                  <% if (team.car_photo) { %>
                    <img src="<%= team.car_photo %>" alt="<%= team.coche || '' %>"
                         style="height:40px;max-width:64px;object-fit:contain;border-radius:6px;background:rgba(255,255,255,.04);border:1px solid var(--vt-border);padding:2px">
                  <% } else { %>
                    <span class="is-mute">—</span>
                  <% } %>
                </td>
                <td class="is-name">
                  <%= team.name %>
                  <% if (team.coche) { %>
                    <div style="font-size:12.5px;color:var(--vt-mute);font-weight:400;margin-top:2px"><%= team.coche %></div>
                  <% } %>
                </td>
                <td>
                  <% if (team.categoria) { %>
                    <% const cc = catColor(team.categoria); %>
                    <span class="vt-badge" style="color:<%= cc %>;background:<%= catRgba(cc, .12) %>;border:1px solid <%= catRgba(cc, .22) %>">
                      <span class="vt-badge__d" style="background:<%= cc %>"></span><%= team.categoria %>
                    </span>
                  <% } else { %>
                    <span class="is-mute">—</span>
                  <% } %>
                </td>
                <td class="is-mute" style="max-width:260px">
                  <% if (team.members.length === 0) { %>
                    —
                  <% } else { %>
                    <%= team.members.map(m => m.name).join(', ') %>
                  <% } %>
                </td>
                <td class="is-mute"><%= team.notes || '—' %></td>
                <td class="is-actions">
                  <a href="/teams/<%= team.id %>/edit" class="vt-icon-btn" title="<%= lang === 'es' ? 'Editar' : 'Edit' %>">
                    <svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                  </a>
                  <form action="/teams/<%= team.id %>/delete" method="POST" style="display:inline"
                        onsubmit="return confirm('<%= lang === 'es' ? '¿Eliminar equipo?' : 'Delete team?' %>')">
                    <button type="submit" class="vt-icon-btn is-danger" title="<%= lang === 'es' ? 'Eliminar' : 'Delete' %>">
                      <svg viewBox="0 0 24 24"><path d="M4 7h16M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M6 7l1 13a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-13"/></svg>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

    <% } %>
  </div>
</div>

<script>
document.getElementById('toggleCsv')?.addEventListener('click', () => {
  const p = document.getElementById('csv-import-panel');
  p.style.display = p.style.display === 'none' ? '' : 'none';
});
document.getElementById('csv-file-picker')?.addEventListener('change', function() {
  const file = this.files[0];
  if (!file) return;
  document.getElementById('csv-file-name').textContent = file.name;
  const reader = new FileReader();
  reader.onload = e => {
    document.getElementById('csv-content-input').value = e.target.result;
    document.getElementById('csv-submit').disabled = false;
  };
  reader.readAsText(file, 'UTF-8');
});
</script>

<%- include('../partials/footer') %>
