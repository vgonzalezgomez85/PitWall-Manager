<%- include('../partials/header-compact', { lang, pageTitle: typeof pageTitle !== 'undefined' ? pageTitle : '' }) %>

<div class="container--narrow">

  <div class="page-header">
    <div>
      <a href="/categories" class="back-link">← <%= lang === 'es' ? 'Volver' : 'Back' %></a>
      <h1 class="page-title">
        <% if (category) { %>
          ✏️ <%= lang === 'es' ? 'Editar categoría' : 'Edit category' %>
        <% } else { %>
          ➕ <%= lang === 'es' ? 'Nueva categoría' : 'New category' %>
        <% } %>
      </h1>
    </div>
  </div>

  <% if (error) { %>
    <div class="card" style="background:#3d1f1f;border:1px solid var(--red);margin-bottom:1rem;padding:1rem;border-radius:8px">
      <p style="color:var(--red);margin:0"><strong>⚠️ <%= lang === 'es' ? 'Error' : 'Error' %></strong></p>
      <p style="color:var(--red);margin:.5rem 0 0;font-size:.9rem"><%= error %></p>
    </div>
  <% } %>

  <form action="<% if (category) { %>/categories/<%= category.id %><% } else { %>/categories<% } %>" method="POST" class="card">
    <div class="form-group">
      <label class="form-label"><%= lang === 'es' ? 'Nombre de la categoría' : 'Category name' %> *</label>
      <input type="text" name="name" class="form-input" maxlength="50"
        value="<%= category?.name || '' %>" required autofocus>
      <p class="form-hint"><%= lang === 'es' ? 'Ej: Fórmula 1, Rally, Clásicos' : 'E.g: Formula 1, Rally, Classics' %></p>
    </div>

    <div class="form-group">
      <label class="form-label"><%= lang === 'es' ? 'Descripción' : 'Description' %></label>
      <textarea name="description" class="form-input" rows="3" maxlength="200"
        placeholder="<%= lang === 'es' ? 'Descripción opcional...' : 'Optional description...' %>"><%= category?.description || '' %></textarea>
      <p class="form-hint"><%= lang === 'es' ? 'Información adicional sobre esta categoría' : 'Additional information about this category' %></p>
    </div>

    <div style="display:flex;gap:.75rem">
      <button type="submit" class="btn btn--primary">
        <% if (category) { %>
          💾 <%= lang === 'es' ? 'Guardar cambios' : 'Save changes' %>
        <% } else { %>
          ➕ <%= lang === 'es' ? 'Crear categoría' : 'Create category' %>
        <% } %>
      </button>
      <a href="/categories" class="btn btn--ghost">
        <%= lang === 'es' ? 'Cancelar' : 'Cancel' %>
      </a>
    </div>
  </form>

</div>

<%- include('../partials/footer') %>
