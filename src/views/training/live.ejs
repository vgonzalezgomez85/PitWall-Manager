<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= lang === 'es' ? 'Entrenamiento' : 'Training' %> — Voltrace Manager</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Rajdhani:wght@500;600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/semaphore.css">
  <link rel="stylesheet" href="/css/training.css?v=<%= Date.now() %>">
</head>
<body class="training-body">

  <!-- ── Header ────────────────────────────────────────────────────────────── -->
  <header class="training-header">
    <div class="training-header__timer">
      <div id="trainingTimer" class="tr-timer">00:00</div>
      <div class="tr-timer-label"><%= lang === 'es' ? 'tiempo' : 'time' %></div>
    </div>

    <div class="training-header__info">
      <div class="tr-title">🎯 <%= lang === 'es' ? 'ENTRENAMIENTO' : 'TRAINING' %></div>
      <div class="tr-subtitle" id="tr-status">
        <% if (standby) { %>
          <span class="tr-standby-badge"><%= lang === 'es' ? '⏳ Esperando GO…' : '⏳ Waiting for GO…' %></span>
        <% } else { %>
          <%= lanes.length %> <%= lang === 'es' ? 'carriles activos' : 'active lanes' %>
        <% } %>
      </div>
    </div>

    <div class="training-header__actions">
      <%# Controles cuando SlotTime inicia la carrera (simulación o BART). En
          DS-300 manda la caja, así que no se muestran. %>
      <% const _swGo  = (typeof isSimulating !== 'undefined' && isSimulating) || (typeof isBart !== 'undefined' && isBart); %>
      <% const _paused = typeof isPaused !== 'undefined' && isPaused; %>
      <% const _mode  = (typeof heatNumber !== 'undefined' && heatNumber !== null) ? 'competition' : 'free'; %>
      <% if (_swGo && standby) { %>
        <form id="trGoForm" action="/training/go" method="POST" style="display:inline-flex;align-items:center;gap:6px">
          <input type="hidden" name="mode" value="<%= _mode %>">
          <input class="vt-inp is-mono" type="number" name="duration_minutes" min="1" max="600" value="10"
                 style="width:58px;text-align:center" title="<%= lang === 'es' ? 'Duración (min)' : 'Duration (min)' %>">
          <button class="tr-btn" type="submit" style="background:#16a34a;color:#fff;font-weight:700"
                  title="<%= lang === 'es' ? 'Arrancar entrenamiento' : 'Start training' %>">▶ GO</button>
        </form>
      <% } else if (_swGo && !standby) { %>
        <% if (_paused) { %>
          <form id="trResumeForm" action="/training/resume" method="POST" style="display:inline">
            <input type="hidden" name="mode" value="<%= _mode %>">
            <button class="tr-btn" type="submit" style="background:#16a34a;color:#fff;font-weight:700">▶ <%= lang === 'es' ? 'REANUDAR' : 'RESUME' %></button>
          </form>
        <% } else { %>
          <form id="trPauseForm" action="/training/pause" method="POST" style="display:inline">
            <input type="hidden" name="mode" value="<%= _mode %>">
            <button class="tr-btn" type="submit">⏸ <%= lang === 'es' ? 'Pausa' : 'Pause' %></button>
          </form>
        <% } %>
        <form id="trStopForm" action="/training/halt" method="POST" style="display:inline">
          <input type="hidden" name="mode" value="<%= _mode %>">
          <button class="tr-btn" type="submit" style="background:#dc2626;color:#fff;font-weight:700">■ STOP</button>
        </form>
      <% } %>
      <button id="voiceBtn" class="tr-btn tr-btn--voice" onclick="toggleVoice()" title="<%= lang === 'es' ? 'Activar/silenciar voz' : 'Toggle voice' %>">🔊</button>
      <button id="viewBtn" class="tr-btn tr-btn--view" onclick="openTrainingPicker()" title="<%= lang === 'es' ? 'Cambiar vista' : 'Change view' %>">🖼 <%= lang === 'es' ? 'Vista' : 'View' %></button>
      <% if (typeof heatNumber !== 'undefined' && heatNumber !== null) { %>
        <form action="/training/competition/stop" method="POST" style="display:inline"
          onsubmit="return confirm('<%= lang === 'es' ? '¿Reiniciar sesión? Se perderán todos los datos.' : 'Reset session? All data will be lost.' %>')">
          <button class="tr-btn tr-btn--reset">↺ <%= lang === 'es' ? 'Reset' : 'Reset' %></button>
        </form>
      <% } else { %>
        <form action="/training/free/reset" method="POST" style="display:inline"
          onsubmit="return confirm('<%= lang === 'es' ? '¿Reiniciar sesión? Se borrarán los récords.' : 'Reset session? Records will be cleared.' %>')">
          <button class="tr-btn tr-btn--reset">↺ <%= lang === 'es' ? 'Reset' : 'Reset' %></button>
        </form>
      <% } %>
      <form action="/training/exit" method="POST" style="display:inline">
        <button class="tr-btn tr-btn--back" type="submit">← <%= lang === 'es' ? 'Volver' : 'Back' %></button>
      </form>
    </div>
  </header>

  <% if (typeof raceWillStealGo !== 'undefined' && raceWillStealGo) { %>
    <div class="flash flash--error" style="margin:10px 0">
      ⚠️ <%= lang === 'es'
        ? 'Hay una carrera activa: el GO irá a la carrera, no al entreno. Ciérrala en Solución de problemas → “Limpiar pendiente”, o complétala desde la carrera.'
        : 'A race is active: GO will start the race, not training. Close it in Troubleshooting → “Clear pending”, or complete it from the race.' %>
    </div>
  <% } %>

  <!-- ── Lane cards ────────────────────────────────────────────────────────── -->
  <div class="training-grid" id="trainingGrid" style="--lanes: <%= lanes.length %>; --cols: <%= Math.min(8, lanes.length) %>"></div>

  <!-- ── Resting participants (competition only, when P > N) ───────────────── -->
  <% if (typeof resting !== 'undefined' && resting && resting.length > 0) { %>
  <div id="restingBar" class="resting-bar">
    <div class="resting-bar__title">💤 <%= lang === 'es' ? 'En descanso' : 'Resting' %></div>
    <div class="resting-bar__items" id="restingItems">
      <% resting.forEach(r => { %>
        <div class="resting-chip">
          <span class="resting-chip__num">DSC<%= r.restNum %></span>
          <span class="resting-chip__dot" style="background:<%= r.color %>"></span>
          <span class="resting-chip__name"><%= r.name %></span>
        </div>
      <% }) %>
    </div>
  </div>
  <% } else { %>
  <div id="restingBar" class="resting-bar" style="display:none">
    <div class="resting-bar__title">💤 <%= lang === 'es' ? 'En descanso' : 'Resting' %></div>
    <div class="resting-bar__items" id="restingItems"></div>
  </div>
  <% } %>

  <!-- ── View picker modal ────────────────────────────────────────────── -->
  <div id="trainingPickerOverlay" class="vp-overlay" hidden onclick="if(event.target===this)closeTrainingPicker()">
    <div class="vp-modal" role="dialog" aria-modal="true">
      <div class="vp-header">
        <div class="vp-title"><%= lang === 'es' ? 'Elige cómo ver el entrenamiento' : 'Choose how to view training' %></div>
        <button class="vp-x" onclick="closeTrainingPicker()" aria-label="<%= lang === 'es' ? 'Cerrar' : 'Close' %>">✕</button>
      </div>
      <div class="vp-grid">
        <button class="vp-opt" data-mode="history" onclick="selectTrainingView('history')">
          <div class="vp-thumb vp-thumb--tr-history" aria-hidden="true">
            <span></span><span></span><span></span><span></span>
          </div>
          <div class="vp-label"><%= lang === 'es' ? 'Tarjetas con historial' : 'Cards with history' %></div>
          <div class="vp-desc"><%= lang === 'es' ? 'Cada carril con sus últimas 20 vueltas. Ideal para sesiones largas.' : 'Each lane with its last 20 laps. Ideal for long sessions.' %></div>
        </button>
        <button class="vp-opt" data-mode="compact" onclick="selectTrainingView('compact')">
          <div class="vp-thumb vp-thumb--tr-compact" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span><span></span>
          </div>
          <div class="vp-label"><%= lang === 'es' ? 'Compacta' : 'Compact' %></div>
          <div class="vp-desc"><%= lang === 'es' ? 'Solo mejor y última, sin historial. Para muchos carriles a la vez.' : 'Only best and last lap, no history. For many lanes at once.' %></div>
        </button>
      </div>
    </div>
  </div>

  <script>
    const TRAINING_DATA = <%- JSON.stringify({
      startedAt:      startedAt,
      durationMs:     durationMs,
      standby:        standby,
      isPaused:       typeof isPaused !== 'undefined' && isPaused,
      heatNumber:     typeof heatNumber !== 'undefined' ? heatNumber : null,
      isCompetition:  typeof heatNumber !== 'undefined' && heatNumber !== null,
      sessionRecords: typeof sessionRecords !== 'undefined' ? sessionRecords : {},
      lanes:          lanes
    }) %>;
    const LANG = "<%= lang %>";
  </script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/semaphore.js"></script>
  <script src="/js/training.js"></script>
</body>
</html>
