<%- include('../partials/header', { lang, pageTitle: lang === 'es' ? 'Entrenamiento de competición' : 'Competition training' }) %>

<div class="vt-page">
  <div class="vt-wrap vt-wrap--narrow">

    <a href="/training" class="vt-back-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      <%= lang === 'es' ? 'Volver a entrenamiento' : 'Back to training' %>
    </a>

    <div class="vt-head" style="align-items:flex-start;justify-content:flex-start;gap:16px;flex-wrap:nowrap">
      <div class="vt-head__icon" style="background:rgba(250,204,21,.13);color:var(--vt-amber)">
        <svg viewBox="0 0 24 24"><path d="M7 4h10v4a5 5 0 0 1-10 0z"/><path d="M7 5H4.5A1.5 1.5 0 0 0 3 6.5 3.5 3.5 0 0 0 6.5 10M17 5h2.5A1.5 1.5 0 0 1 21 6.5 3.5 3.5 0 0 1 17.5 10"/><path d="M12 13v3M9 20h6M9.5 20l.4-4h4.2l.4 4"/></svg>
      </div>
      <div>
        <h1><%= lang === 'es' ? 'Entrenamiento de competición' : 'Competition training' %></h1>
        <p class="vt-lead">
          <%= lang === 'es'
            ? 'Asigna participantes a los carriles y prepara una sesión por tandas con rotación automática.'
            : 'Assign participants to lanes and prepare a session by heats with auto rotation.' %>
        </p>
      </div>
    </div>

    <form action="/training/competition/start" method="POST" id="compForm">

      <% if (typeof serialTotal !== 'undefined' && serialTotal > 0) { %>
        <!-- Multi-DS: los carriles los fijan los DS conectados; sin selector de circuito. -->
        <div class="vt-card">
          <div class="vt-card-h">
            <svg viewBox="0 0 24 24"><path d="M6 18a3 3 0 0 1 0-6h9a3 3 0 0 0 0-6H7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="6" cy="18" r="1.4" fill="currentColor"/><circle cx="6" cy="6" r="1.4" fill="currentColor"/></svg>
            <%= lang === 'es' ? 'Carriles' : 'Lanes' %>
            <span class="vt-badge is-info" style="margin-left:auto;white-space:nowrap">
              <span class="vt-badge__d"></span> <%= serialTotal %> <%= lang === 'es' ? 'carriles (de los DS)' : 'lanes (from DS)' %>
            </span>
          </div>
          <p class="vt-hint" style="margin-top:8px">
            <%= lang === 'es'
              ? 'El número de carriles se detecta automáticamente de los DS conectados.'
              : 'The number of lanes is detected automatically from the connected DS units.' %>
          </p>
        </div>
      <% } else { %>
        <!-- Circuit selector (sin DS en serie: define los carriles) -->
        <div class="vt-card">
          <div class="vt-card-h">
            <svg viewBox="0 0 24 24"><path d="M6 18a3 3 0 0 1 0-6h9a3 3 0 0 0 0-6H7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="6" cy="18" r="1.4" fill="currentColor"/><circle cx="6" cy="6" r="1.4" fill="currentColor"/></svg>
            <%= lang === 'es' ? 'Circuito' : 'Circuit' %>
          </div>
          <div class="vt-fields vt-fields--2" style="align-items:end">
            <div class="vt-field" style="grid-column:1 / -1">
              <label><%= lang === 'es' ? 'Selecciona el circuito de la sesión' : 'Select the session circuit' %></label>
              <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
                <div class="vt-selw" style="flex:1;min-width:240px">
                  <select name="circuit_id" id="circuitSelect">
                    <option value=""><%= lang === 'es' ? '— Por defecto (de ajustes) —' : '— Default (from settings) —' %></option>
                    <% (circuits || []).forEach(c => { %>
                      <option value="<%= c.id %>" data-lanes="<%= c.lanes_count %>"
                        <%= defaultCircuitId === c.id ? 'selected' : '' %>>
                        <%= c.name %> (<%= c.lanes_count %> <%= lang === 'es' ? 'carriles' : 'lanes' %>)
                      </option>
                    <% }) %>
                  </select>
                </div>
                <span id="circuitLanesHint" class="vt-badge is-info" style="white-space:nowrap"></span>
              </div>
              <p class="vt-hint" style="margin-top:10px">
                <%= lang === 'es'
                  ? 'Cambia aquí el circuito de la sesión sin tener que ir a ajustes.'
                  : 'Switch the circuit for this session without going to settings.' %>
              </p>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Participants list -->
      <div class="vt-card">
        <div class="vt-card-h">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9.5" r="2.3"/><path d="M3 20v-1a5 5 0 0 1 5-5h2a5 5 0 0 1 5 5v1"/><path d="M16 14a4 4 0 0 1 5 4v1"/></svg>
          <%= lang === 'es' ? 'Participantes' : 'Participants' %>
          <span class="vt-cnt" id="partCount" style="margin-left:auto">0 / 0</span>
        </div>

        <div id="participantList" class="tc-part-list" style="margin-top:14px;margin-bottom:6px"></div>

        <button type="button" id="addPilotBtn" class="vt-btn vt-btn--ghost" style="margin-top:6px">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
          <%= lang === 'es' ? 'Añadir piloto' : 'Add pilot' %>
        </button>

        <p class="vt-hint" style="margin-top:10px">
          <%= lang === 'es'
            ? 'Hay un carril por cada pista. Puedes añadir más pilotos que carriles: los de más entran como reserva y rotan por turnos. Deja en blanco los carriles que no se usen.'
            : 'There is one lane per track. You can add more pilots than lanes: the extra ones start as reserves and rotate in. Leave blank any unused lane.' %>
        </p>
      </div>

      <!-- Lane rotation sequence -->
      <div class="vt-card">
        <div class="vt-card-h">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h11M4 12h16M4 17h8"/><path d="M17 5l3 2-3 2M14 15l3 2-3 2"/></svg>
          <%= lang === 'es' ? 'Secuencia de cambio de carril' : 'Lane rotation sequence' %>
        </div>
        <p class="vt-hint" style="margin:6px 0 12px">
          <%= lang === 'es'
            ? 'Orden en el que cada coche va cambiando de carril manga a manga. Arrastra los carriles para reordenarlo.'
            : 'Order in which each car moves through the lanes heat by heat. Drag the lanes to reorder it.' %>
        </p>
        <div id="laneSeqList" class="tc-seq-list"></div>
        <div id="laneSeqHidden"></div>
      </div>

      <!-- Hidden inputs filled by JS -->
      <div id="hiddenInputs"></div>

      <button type="submit" class="vt-btn vt-btn--primary vt-btn--lg" style="width:100%;justify-content:center;margin-top:18px" id="startBtn" disabled>
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        <%= lang === 'es' ? 'Preparar sesión' : 'Prepare session' %>
      </button>

    </form>

  </div>
</div>

<%- include('../partials/footer') %>

<style>
  .tc-seq-list { display:flex; flex-wrap:wrap; gap:8px; }
  .tc-seq-chip {
    display:flex; align-items:center; gap:8px;
    background:#161b22; border:1px solid #30363d; border-radius:8px;
    padding:8px 12px; cursor:grab; user-select:none;
  }
  .tc-seq-chip:active { cursor:grabbing; }
  .tc-seq-chip.dragging { opacity:.4; }
  .tc-seq-chip.drop-target { border-color:var(--vt-amber,#facc15); }
  .tc-seq-chip__ord  { font-size:.7rem; color:#8b949e; font-weight:700; }
  .tc-seq-chip__lane { font-weight:800; }
</style>

<script>
const LANG = "<%= lang %>";
const FALLBACK_LANES = <%= typeof fallbackLanes !== 'undefined' ? fallbackLanes : 6 %>;
// Total físico de carriles de los DS conectados (suma de circuits_serial). Si
// hay DS en modo serial, ESTE es el nº de carriles real, no sim_lanes.
const SERIAL_TOTAL = <%= typeof serialTotal !== 'undefined' ? serialTotal : 0 %>;
const COLORS = [
  '#e63946','#2196f3','#4caf50','#ff9800','#9c27b0','#00bcd4',
  '#ff5722','#607d8b','#795548','#e91e63','#3f51b5','#009688',
  '#cddc39','#ffc107','#f44336','#673ab7','#03a9f4','#8bc34a',
];

/* Estado: una entrada por carril; '' significa carril vacío */
let slots = [];

function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function currentLaneCount() {
  if (SERIAL_TOTAL > 0) return SERIAL_TOTAL;   // multi-DS: manda el total físico de los DS
  const sel = document.getElementById('circuitSelect');
  const opt = sel.options[sel.selectedIndex];
  const lanes = parseInt(opt?.dataset?.lanes || '', 10);
  return lanes > 0 ? lanes : FALLBACK_LANES;
}

// Garantiza al menos un slot por carril; NO trunca: se permiten más pilotos
// que carriles (la competición rota con descansos).
function ensureMinSlots() {
  const n = currentLaneCount();
  while (slots.length < n) slots.push('');
}

function renderSlots() {
  const list   = document.getElementById('participantList');
  const hidden = document.getElementById('hiddenInputs');
  const btn    = document.getElementById('startBtn');
  const count  = document.getElementById('partCount');

  ensureMinSlots();
  const laneCount = currentLaneCount();

  list.innerHTML = slots.map((name, i) => {
    const color = COLORS[i % COLORS.length];
    const v = escapeHtml(name);
    const isReserve = i >= laneCount;
    const label = isReserve
      ? `${LANG === 'es' ? 'Reserva' : 'Reserve'} ${i + 1 - laneCount}`
      : `${LANG === 'es' ? 'Carril' : 'Lane'} ${i + 1}`;
    const showClear = name || isReserve;
    return `
      <div class="tc-slot-row${isReserve ? ' tc-slot-row--reserve' : ''}">
        <span class="tc-slot-row__lane">${label}</span>
        <span class="tc-slot-row__color" style="background:${color}"></span>
        <input type="text" class="vt-inp tc-slot-row__inp" data-idx="${i}"
               maxlength="30" autocomplete="off"
               value="${v}"
               placeholder="${LANG === 'es' ? 'Nombre del piloto / equipo…' : 'Pilot / team name…'}">
        <button type="button" class="vt-icon-btn tc-slot-row__clear" data-idx="${i}"
                title="${isReserve ? (LANG === 'es' ? 'Quitar' : 'Remove') : (LANG === 'es' ? 'Vaciar' : 'Clear')}" ${showClear ? '' : 'style="visibility:hidden"'}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>`;
  }).join('');

  /* hidden inputs sólo para los slots con nombre, con su índice de carril */
  hidden.innerHTML = slots.map((name, i) => {
    const v = name.trim();
    if (!v) return '';
    return `<input type="hidden" name="participants[${i}][name]" value="${escapeHtml(v)}">
            <input type="hidden" name="participants[${i}][color]" value="${COLORS[i % COLORS.length]}">
            <input type="hidden" name="participants[${i}][lane]" value="${i + 1}">`;
  }).join('');

  const filled = slots.filter(n => n.trim()).length;
  count.textContent = `${filled} / ${slots.length}`;
  btn.disabled = filled < 2;
}

/* listeners delegados sobre la lista */
document.getElementById('participantList').addEventListener('input', e => {
  const inp = e.target.closest('.tc-slot-row__inp');
  if (!inp) return;
  const idx = parseInt(inp.dataset.idx, 10);
  slots[idx] = inp.value;
  /* Actualizar X y contador sin destruir el foco */
  const row = inp.closest('.tc-slot-row');
  const clear = row.querySelector('.tc-slot-row__clear');
  clear.style.visibility = (slots[idx].trim() || idx >= currentLaneCount()) ? '' : 'hidden';
  const filled = slots.filter(n => n.trim()).length;
  document.getElementById('partCount').textContent = `${filled} / ${slots.length}`;
  document.getElementById('startBtn').disabled = filled < 2;
  /* hidden inputs */
  const v = slots[idx].trim();
  const hidden = document.getElementById('hiddenInputs');
  /* Reconstruir todos los hidden (es O(n) y n suele ser <= 16) */
  hidden.innerHTML = slots.map((name, i) => {
    const val = name.trim();
    if (!val) return '';
    return `<input type="hidden" name="participants[${i}][name]" value="${escapeHtml(val)}">
            <input type="hidden" name="participants[${i}][color]" value="${COLORS[i % COLORS.length]}">
            <input type="hidden" name="participants[${i}][lane]" value="${i + 1}">`;
  }).join('');
});

document.getElementById('participantList').addEventListener('click', e => {
  const btn = e.target.closest('.tc-slot-row__clear');
  if (!btn) return;
  const idx = parseInt(btn.dataset.idx, 10);
  // Reserva (por encima de los carriles) → elimina la fila; carril → la vacía.
  if (idx >= currentLaneCount()) slots.splice(idx, 1);
  else slots[idx] = '';
  renderSlots();
  /* devolver foco al input correspondiente */
  const inp = document.querySelector(`.tc-slot-row__inp[data-idx="${idx}"]`);
  if (inp) inp.focus();
});

/* Botón "Añadir piloto": agrega un slot extra (reserva) y enfoca su input */
document.getElementById('addPilotBtn').addEventListener('click', () => {
  slots.push('');
  renderSlots();
  const inputs = document.querySelectorAll('.tc-slot-row__inp');
  const last = inputs[inputs.length - 1];
  if (last) last.focus();
});

/* ── Secuencia de rotación de carriles (drag-and-drop) ──────────────────── */
let laneSeq = [];
let _seqDragFrom = null;

function renderLaneSeq() {
  const n = currentLaneCount();
  // Regenera la secuencia natural [1..N] si cambió el nº de carriles.
  const valid = laneSeq.length === n && laneSeq.slice().sort((a, b) => a - b).every((v, i) => v === i + 1);
  if (!valid) laneSeq = Array.from({ length: n }, (_, i) => i + 1);

  const list   = document.getElementById('laneSeqList');
  const hidden = document.getElementById('laneSeqHidden');
  list.innerHTML = laneSeq.map((lane, i) => `
    <div class="tc-seq-chip" draggable="true" data-i="${i}">
      <span class="tc-seq-chip__ord">${i + 1}º</span>
      <span class="tc-seq-chip__lane">${LANG === 'es' ? 'Carril' : 'Lane'} ${lane}</span>
    </div>`).join('');
  hidden.innerHTML = laneSeq.map(lane => `<input type="hidden" name="lane_sequence[]" value="${lane}">`).join('');
}

(function () {
  const list = document.getElementById('laneSeqList');
  list.addEventListener('dragstart', e => {
    const chip = e.target.closest('.tc-seq-chip'); if (!chip) return;
    _seqDragFrom = parseInt(chip.dataset.i, 10);
    chip.classList.add('dragging');
    e.dataTransfer.effectAllowed = 'move';
  });
  list.addEventListener('dragend', () => {
    list.querySelectorAll('.dragging,.drop-target').forEach(c => c.classList.remove('dragging', 'drop-target'));
    _seqDragFrom = null;
  });
  list.addEventListener('dragover', e => {
    e.preventDefault();
    const chip = e.target.closest('.tc-seq-chip');
    list.querySelectorAll('.drop-target').forEach(c => c.classList.remove('drop-target'));
    if (chip) chip.classList.add('drop-target');
  });
  list.addEventListener('drop', e => {
    e.preventDefault();
    const chip = e.target.closest('.tc-seq-chip');
    if (!chip || _seqDragFrom == null) return;
    const to = parseInt(chip.dataset.i, 10);
    if (to !== _seqDragFrom) {
      const [m] = laneSeq.splice(_seqDragFrom, 1);
      laneSeq.splice(to, 0, m);
      renderLaneSeq();
    }
    _seqDragFrom = null;
  });
})();

/* Circuit hint + re-render de slots al cambiar circuito.
   En multi-DS no hay selector de circuito (los carriles los fijan los DS):
   renderizamos directamente slots + secuencia. */
(function () {
  const sel = document.getElementById('circuitSelect');
  if (!sel) { renderSlots(); renderLaneSeq(); return; }
  const hint = document.getElementById('circuitLanesHint');
  function update() {
    const lanes = sel.options[sel.selectedIndex]?.dataset?.lanes;
    hint.innerHTML = lanes
      ? `<span class="vt-badge__d"></span> ${lanes} ${LANG === 'es' ? 'carriles' : 'lanes'}`
      : `<span class="vt-badge__d"></span> ${FALLBACK_LANES} ${LANG === 'es' ? 'carriles' : 'lanes'} (def.)`;
    hint.style.display = '';
    renderSlots();
    renderLaneSeq();
  }
  sel.addEventListener('change', update);
  update();
})();
</script>
