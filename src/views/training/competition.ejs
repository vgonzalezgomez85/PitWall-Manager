<%- include('../partials/header', { lang, pageTitle: t('competition.entrenamiento_de_competicion') }) %>

<div class="vt-page">
  <div class="vt-wrap vt-wrap--narrow">

    <a href="/training" class="vt-back-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      <%= t('competition.volver_a_entrenamiento') %>
    </a>

    <div class="vt-head" style="align-items:flex-start;justify-content:flex-start;gap:16px;flex-wrap:nowrap">
      <div class="vt-head__icon" style="background:rgba(250,204,21,.13);color:var(--vt-amber)">
        <svg viewBox="0 0 24 24"><path d="M7 4h10v4a5 5 0 0 1-10 0z"/><path d="M7 5H4.5A1.5 1.5 0 0 0 3 6.5 3.5 3.5 0 0 0 6.5 10M17 5h2.5A1.5 1.5 0 0 1 21 6.5 3.5 3.5 0 0 1 17.5 10"/><path d="M12 13v3M9 20h6M9.5 20l.4-4h4.2l.4 4"/></svg>
      </div>
      <div>
        <h1><%= t('competition.entrenamiento_de_competicion') %></h1>
        <p class="vt-lead">
          <%= t('competition.asigna_participantes_a_los_carriles_y_prepara') %>
        </p>
        <a href="/training/competition/results" style="font-size:.85rem;color:#58a6ff">
          <%= t('competition.ver_entrenos_guardados') %>
        </a>
      </div>
    </div>

    <form action="/training/competition/start" method="POST" id="compForm">

      <% if (typeof serialTotal !== 'undefined' && serialTotal > 0) { %>
        <!-- Multi-DS: los carriles los fijan los DS conectados; sin selector de circuito. -->
        <div class="vt-card">
          <div class="vt-card-h">
            <svg viewBox="0 0 24 24"><path d="M6 18a3 3 0 0 1 0-6h9a3 3 0 0 0 0-6H7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="6" cy="18" r="1.4" fill="currentColor"/><circle cx="6" cy="6" r="1.4" fill="currentColor"/></svg>
            <span class="tc-step">1</span><%= t('common.carriles') %>
            <span class="vt-badge is-info" style="margin-left:auto;white-space:nowrap">
              <span class="vt-badge__d"></span> <%= serialTotal %> <%= t('competition.carriles_de_los_ds') %>
            </span>
          </div>
          <p class="vt-hint" style="margin-top:8px">
            <%= t('competition.el_numero_de_carriles_se_detecta') %>
          </p>
          <%- include('_min-lap-field', { lang, defaultMinLapMs }) %>
        </div>
      <% } else { %>
        <!-- Circuit selector (sin DS en serie: define los carriles) -->
        <div class="vt-card">
          <div class="vt-card-h">
            <svg viewBox="0 0 24 24"><path d="M6 18a3 3 0 0 1 0-6h9a3 3 0 0 0 0-6H7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="6" cy="18" r="1.4" fill="currentColor"/><circle cx="6" cy="6" r="1.4" fill="currentColor"/></svg>
            <span class="tc-step">1</span><%= t('client.common.circuito') %>
          </div>
          <div class="vt-fields vt-fields--2" style="align-items:end">
            <div class="vt-field" style="grid-column:1 / -1">
              <label><%= t('competition.selecciona_el_circuito_de_la_sesion') %></label>
              <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
                <div class="vt-selw" style="flex:1;min-width:240px">
                  <select name="circuit_id" id="circuitSelect">
                    <option value=""><%= t('competition.por_defecto_de_ajustes') %></option>
                    <% (circuits || []).forEach(c => { %>
                      <option value="<%= c.id %>" data-lanes="<%= c.lanes_count %>" data-min-ms="<%= c.min_lap_ms %>"
                        <%= defaultCircuitId === c.id ? 'selected' : '' %>>
                        <%= c.name %> (<%= c.lanes_count %> <%= t('client.common.carriles') %>)
                      </option>
                    <% }) %>
                  </select>
                </div>
                <span id="circuitLanesHint" class="vt-badge is-info" style="white-space:nowrap"></span>
              </div>
              <p class="vt-hint" style="margin-top:10px">
                <%= t('competition.cambia_aqui_el_circuito_de_la_sesion_sin_tener') %>
              </p>
              <%- include('_min-lap-field', { lang, defaultMinLapMs }) %>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Participants list -->
      <div class="vt-card">
        <div class="vt-card-h">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9.5" r="2.3"/><path d="M3 20v-1a5 5 0 0 1 5-5h2a5 5 0 0 1 5 5v1"/><path d="M16 14a4 4 0 0 1 5 4v1"/></svg>
          <span class="tc-step">2</span><%= t('common.participantes') %>
          <span class="vt-cnt" id="partCount" style="margin-left:auto">0 / 0</span>
        </div>

        <% if ((teamsCatalog || []).length) { %>
          <div class="tc-cat">
            <div class="tc-cat__bar">
              <label class="vt-search tc-cat__search">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
                <input type="search" id="catalogSearch" autocomplete="off"
                       placeholder="<%= t('competition.buscar_en_el_catalogo_de_equipos_2') %>"
                       aria-label="<%= t('competition.buscar_en_el_catalogo_de_equipos') %>">
              </label>
              <span class="vt-hint" id="catalogCount"></span>
            </div>
            <p class="vt-hint" style="margin:6px 0 8px">
              <%= t('competition.toca_un_equipo_para_ponerlo_en_el_primer_carril') %>
            </p>
            <div id="catalogPicker" class="tc-cat__grid">
              <% teamsCatalog.forEach(ct => { %>
                <button type="button" class="catalog-card" data-team-name="<%= ct.name %>">
                  <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= ct.name %></span>
                </button>
              <% }) %>
              <p class="vt-hint tc-cat__none" id="catalogNone" hidden><%= t('competition.ningun_equipo_coincide') %></p>
            </div>
          </div>
        <% } %>

        <div class="tc-tools">
          <button type="button" class="vt-btn vt-btn--ghost vt-btn--sm" id="shuffleBtn" title="<%= t('competition.reparte_los_participantes_en_carriles_al_azar') %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3h5v5M4 20 21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg>
            <%= t('competition.sortear_carriles') %>
          </button>
          <button type="button" class="vt-btn vt-btn--ghost vt-btn--sm" id="clearAllBtn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
            <%= t('competition.vaciar_todo') %>
          </button>
          <span class="tc-dup" id="dupWarn" hidden></span>
        </div>

        <div id="participantList" class="tc-part-list" style="margin-top:14px;margin-bottom:6px"></div>

        <button type="button" id="addPilotBtn" class="vt-btn vt-btn--ghost" style="margin-top:6px">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
          <%= t('competition.anadir_piloto') %>
        </button>

        <p class="vt-hint" style="margin-top:10px">
          <%= t('competition.hay_un_carril_por_cada_pista_puedes_anadir_mas') %>
        </p>
      </div>

      <!-- Lane rotation sequence -->
      <div class="vt-card">
        <div class="vt-card-h">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h11M4 12h16M4 17h8"/><path d="M17 5l3 2-3 2M14 15l3 2-3 2"/></svg>
          <span class="tc-step">3</span><%= t('competition.secuencia_de_cambio_de_carril') %>
          <button type="button" class="vt-btn vt-btn--ghost vt-btn--sm" id="seqResetBtn" style="margin-left:auto"><%= t('competition.orden_natural') %></button>
        </div>
        <p class="vt-hint" style="margin:6px 0 12px">
          <%= t('competition.orden_en_el_que_cada_coche_va_cambiando_de') %>
        </p>
        <div id="laneSeqList" class="tc-seq-list"></div>
        <div id="laneSeqHidden"></div>
      </div>

      <!-- Hidden inputs filled by JS -->
      <div id="hiddenInputs"></div>

      <div class="tc-submit">
        <div class="tc-submit__sum" id="tcSummary" aria-live="polite"></div>
        <button type="submit" class="vt-btn vt-btn--primary vt-btn--lg" id="startBtn" disabled>
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          <%= t('competition.preparar_sesion') %>
        </button>
      </div>

    </form>

  </div>
</div>

<%- include('../partials/footer') %>

<style>
  .tc-step {
    display:inline-grid; place-items:center; width:22px; height:22px; margin-right:8px;
    border-radius:50%; background:rgba(250,204,21,.14); color:var(--vt-amber,#facc15);
    font-family:'IBM Plex Mono',monospace; font-size:12px; font-weight:700;
  }
  .tc-cat { margin-top:14px; }
  .tc-cat__bar { display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
  .tc-cat__search { flex:1; min-width:220px; }
  .tc-cat__search input { width:100%; }
  .tc-cat__grid {
    display:grid; grid-template-columns:repeat(auto-fill,minmax(170px,1fr)); gap:.4rem;
    max-height:220px; overflow-y:auto; padding:.6rem;
    border:1px solid #30363d; border-radius:8px; background:#0d1117;
  }
  .tc-cat__grid .catalog-card { font:inherit; color:inherit; text-align:left; width:100%; }
  .tc-cat__grid .catalog-card.is-first { border-color:var(--vt-amber,#facc15); }
  .tc-cat__grid .catalog-card[hidden], .tc-cat__none[hidden] { display:none; }
  .tc-cat__none { grid-column:1 / -1; text-align:center; margin:6px 0; }
  .tc-tools { display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin-top:14px; }
  .tc-dup { font-size:13px; color:#fbbf5c; }
  .tc-slot-row { grid-template-columns: 86px 16px 1fr auto; }
  .tc-slot-row--dup { border-color:rgba(245,158,11,.55) !important; }
  .tc-slot-row--reserve .tc-slot-row__lane { color:#a78bfa; }
  .tc-slot-row__acts { display:flex; gap:2px; }
  .tc-slot-row__acts .vt-icon-btn { width:30px; height:30px; }
  .tc-slot-row__acts .vt-icon-btn svg { width:14px; height:14px; }
  .tc-slot-row__acts .vt-icon-btn:disabled { opacity:.25; pointer-events:none; }
  .tc-submit {
    position:sticky; bottom:0; z-index:5; margin-top:18px;
    display:flex; align-items:center; gap:14px; flex-wrap:wrap;
    padding:22px 0 12px; background:linear-gradient(180deg, rgba(0,0,0,0), var(--vt-bg,#000) 14px);
  }
  .tc-submit__sum { flex:1; min-width:200px; font-size:14px; color:var(--vt-mute,#8b949e); }
  .tc-submit__sum b { color:var(--vt-text,#e6edf3); font-weight:600; }
  .tc-submit .vt-btn { justify-content:center; min-width:220px; }
  .tc-seq-list { display:flex; flex-wrap:wrap; gap:8px; }
  .tc-seq-chip {
    display:flex; align-items:center; gap:8px;
    background:#161b22; border:1px solid #30363d; border-radius:8px;
    padding:8px 12px; cursor:grab; user-select:none;
  }
  .tc-seq-chip:active { cursor:grabbing; }
  .tc-seq-chip.dragging { opacity:.4; }
  .tc-seq-chip.drop-target { border-color:var(--vt-amber,#facc15); }
  .tc-seq-chip__ord  { font-size:.7rem; color:#8b949e; font-weight:700; }
  .tc-seq-chip__lane { font-weight:800; }
</style>

<script>
const LANG = "<%= lang %>";
const FALLBACK_LANES = <%= typeof fallbackLanes !== 'undefined' ? fallbackLanes : 6 %>;
// Total físico de carriles de los DS conectados (suma de circuits_serial). Si
// hay DS en modo serial, ESTE es el nº de carriles real, no sim_lanes.
const SERIAL_TOTAL = <%= typeof serialTotal !== 'undefined' ? serialTotal : 0 %>;
const COLORS = <%- JSON.stringify(trainingLaneColors()) %>;

/* Estado: una entrada por carril; '' significa carril vacío */
let slots = [];

function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function currentLaneCount() {
  if (SERIAL_TOTAL > 0) return SERIAL_TOTAL;   // multi-DS: manda el total físico de los DS
  const sel = document.getElementById('circuitSelect');
  const opt = sel.options[sel.selectedIndex];
  const lanes = parseInt(opt?.dataset?.lanes || '', 10);
  return lanes > 0 ? lanes : FALLBACK_LANES;
}

// Garantiza al menos un slot por carril; NO trunca: se permiten más pilotos
// que carriles (la competición rota con descansos).
function ensureMinSlots() {
  const n = currentLaneCount();
  while (slots.length < n) slots.push('');
}

function hiddenInputsHtml() {
  /* hidden inputs sólo para los slots con nombre, con su índice de carril */
  return slots.map((name, i) => {
    const v = name.trim();
    if (!v) return '';
    return `<input type="hidden" name="participants[${i}][name]" value="${escapeHtml(v)}">
            <input type="hidden" name="participants[${i}][color]" value="${COLORS[i % COLORS.length]}">
            <input type="hidden" name="participants[${i}][lane]" value="${i + 1}">`;
  }).join('');
}

/* Todo lo que depende de los nombres pero no obliga a repintar las filas (así
   no se pierde el foco al teclear): ocultos, contador, repetidos, resumen. */
function syncDerived() {
  document.getElementById('hiddenInputs').innerHTML = hiddenInputsHtml();
  const laneCount = currentLaneCount();
  const filled = slots.filter(n => n.trim()).length;
  document.getElementById('partCount').textContent = `${filled} / ${slots.length}`;

  const seen = new Map();
  slots.forEach((n, i) => {
    const k = n.trim().toLowerCase();
    if (!k) return;
    seen.set(k, (seen.get(k) || []).concat(i));
  });
  const dupIdx = new Set([...seen.values()].filter(v => v.length > 1).flat());
  document.querySelectorAll('.tc-slot-row').forEach(row => {
    row.classList.toggle('tc-slot-row--dup', dupIdx.has(parseInt(row.dataset.idx, 10)));
  });
  const dupWarn = document.getElementById('dupWarn');
  dupWarn.hidden = dupIdx.size === 0;
  dupWarn.textContent = I18N.t('client.competition.hay_nombres_repetidos_revisa_los_resaltados');

  const onTrack  = slots.slice(0, laneCount).filter(n => n.trim()).length;
  const reserves = slots.slice(laneCount).filter(n => n.trim()).length;
  const sum = document.getElementById('tcSummary');
  if (LANG === 'es') {
    sum.innerHTML = filled < 2
      ? 'Añade al menos <b>2 participantes</b> para preparar la sesión.'
      : `<b>${laneCount}</b> carriles · <b>${onTrack}</b> en pista` + (reserves ? ` · <b>${reserves}</b> en reserva (rotan por turnos)` : '');
  } else {
    sum.innerHTML = filled < 2
      ? 'Add at least <b>2 participants</b> to prepare the session.'
      : `<b>${laneCount}</b> lanes · <b>${onTrack}</b> on track` + (reserves ? ` · <b>${reserves}</b> in reserve (rotate in)` : '');
  }
  document.getElementById('startBtn').disabled = filled < 2;
  refreshCatalogUsedState();
}

function renderSlots() {
  const list = document.getElementById('participantList');
  ensureMinSlots();
  const laneCount = currentLaneCount();
  const up   = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 15l6-6 6 6"/></svg>';
  const down = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>';

  list.innerHTML = slots.map((name, i) => {
    const color = COLORS[i % COLORS.length];
    const v = escapeHtml(name);
    const isReserve = i >= laneCount;
    const label = isReserve
      ? `${I18N.t('client.competition.reserva')} ${i + 1 - laneCount}`
      : `${I18N.t('client.common.carril')} ${i + 1}`;
    const showClear = name || isReserve;
    return `
      <div class="tc-slot-row${isReserve ? ' tc-slot-row--reserve' : ''}" data-idx="${i}">
        <span class="tc-slot-row__lane">${label}</span>
        <span class="tc-slot-row__color" style="background:${color}"></span>
        <input type="text" class="vt-inp tc-slot-row__inp" data-idx="${i}"
               maxlength="30" autocomplete="off"
               value="${v}" aria-label="${label}"
               placeholder="${I18N.t('client.competition.nombre_del_piloto_equipo')}">
        <span class="tc-slot-row__acts">
          <button type="button" class="vt-icon-btn tc-slot-row__move" data-idx="${i}" data-dir="-1" ${i === 0 ? 'disabled' : ''}
                  title="${I18N.t('client.competition.subir_un_carril')}" aria-label="${I18N.t('client.competition.subir')}">${up}</button>
          <button type="button" class="vt-icon-btn tc-slot-row__move" data-idx="${i}" data-dir="1" ${i === slots.length - 1 ? 'disabled' : ''}
                  title="${I18N.t('client.competition.bajar_un_carril')}" aria-label="${I18N.t('client.competition.bajar')}">${down}</button>
          <button type="button" class="vt-icon-btn tc-slot-row__clear" data-idx="${i}"
                  title="${isReserve ? (I18N.t('client.common.quitar')) : (I18N.t('client.competition.vaciar'))}" ${showClear ? '' : 'style="visibility:hidden"'}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </span>
      </div>`;
  }).join('');
  syncDerived();
}

/* ── Catálogo de equipos: un toque para añadir uno al primer hueco libre ──── */
function refreshCatalogUsedState() {
  const used = new Set(slots.map(s => s.trim().toLowerCase()).filter(Boolean));
  document.querySelectorAll('#catalogPicker .catalog-card').forEach(card => {
    card.classList.toggle('catalog-card--used', used.has(card.dataset.teamName.trim().toLowerCase()));
  });
}
function addToFirstFree(name) {
  let idx = slots.findIndex(s => !s.trim());
  if (idx === -1) { slots.push(''); idx = slots.length - 1; }
  slots[idx] = name;
  renderSlots();
}
document.getElementById('catalogPicker')?.addEventListener('click', e => {
  const card = e.target.closest('.catalog-card');
  if (!card || card.classList.contains('catalog-card--used')) return;
  addToFirstFree(card.dataset.teamName);
});

const _norm = (s) => String(s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
function filterCatalog() {
  const inp = document.getElementById('catalogSearch');
  if (!inp) return null;
  const q = _norm(inp.value.trim());
  let first = null, shown = 0, total = 0;
  document.querySelectorAll('#catalogPicker .catalog-card').forEach(card => {
    total++;
    const hit = !q || _norm(card.dataset.teamName).includes(q);
    card.hidden = !hit;
    card.classList.remove('is-first');
    if (hit) {
      shown++;
      if (q && !first && !card.classList.contains('catalog-card--used')) first = card;
    }
  });
  if (first) first.classList.add('is-first');
  document.getElementById('catalogNone').hidden = shown > 0;
  document.getElementById('catalogCount').textContent = q
    ? `${shown} / ${total}`
    : `${total} ${I18N.t('client.common.equipos')}`;
  return first;
}
document.getElementById('catalogSearch')?.addEventListener('input', filterCatalog);
document.getElementById('catalogSearch')?.addEventListener('keydown', e => {
  if (e.key === 'Enter') {
    e.preventDefault();               // no enviar el formulario
    const first = filterCatalog();
    if (first) { addToFirstFree(first.dataset.teamName); e.target.select(); filterCatalog(); }
  } else if (e.key === 'Escape') {
    e.target.value = ''; filterCatalog();
  }
});
filterCatalog();

/* listeners delegados sobre la lista */
document.getElementById('participantList').addEventListener('input', e => {
  const inp = e.target.closest('.tc-slot-row__inp');
  if (!inp) return;
  const idx = parseInt(inp.dataset.idx, 10);
  slots[idx] = inp.value;
  /* Actualizar la X sin destruir el foco */
  const clear = inp.closest('.tc-slot-row').querySelector('.tc-slot-row__clear');
  clear.style.visibility = (slots[idx].trim() || idx >= currentLaneCount()) ? '' : 'hidden';
  syncDerived();
});

document.getElementById('participantList').addEventListener('click', e => {
  const mv = e.target.closest('.tc-slot-row__move');
  if (mv) {
    const i = parseInt(mv.dataset.idx, 10);
    const j = i + parseInt(mv.dataset.dir, 10);
    if (j < 0 || j >= slots.length) return;
    [slots[i], slots[j]] = [slots[j], slots[i]];
    renderSlots();
    const again = document.querySelector(`.tc-slot-row__move[data-idx="${j}"][data-dir="${mv.dataset.dir}"]`)
               || document.querySelector(`.tc-slot-row__inp[data-idx="${j}"]`);
    if (again) again.focus();
    return;
  }
  const btn = e.target.closest('.tc-slot-row__clear');
  if (!btn) return;
  const idx = parseInt(btn.dataset.idx, 10);
  // Reserva (por encima de los carriles) → elimina la fila; carril → la vacía.
  if (idx >= currentLaneCount()) slots.splice(idx, 1);
  else slots[idx] = '';
  renderSlots();
  /* devolver foco al input correspondiente */
  const inp = document.querySelector(`.tc-slot-row__inp[data-idx="${idx}"]`);
  if (inp) inp.focus();
});

/* Botón "Añadir piloto": agrega un slot extra (reserva) y enfoca su input */
document.getElementById('addPilotBtn').addEventListener('click', () => {
  slots.push('');
  renderSlots();
  const inputs = document.querySelectorAll('.tc-slot-row__inp');
  const last = inputs[inputs.length - 1];
  if (last) last.focus();
});

/* Sortear: baraja los nombres (Fisher-Yates) y los vuelve a colocar desde el
   carril 1; los huecos quedan al final. */
document.getElementById('shuffleBtn').addEventListener('click', () => {
  const names = slots.map(s => s.trim()).filter(Boolean);
  for (let i = names.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [names[i], names[j]] = [names[j], names[i]];
  }
  slots = names;
  renderSlots();
});
document.getElementById('clearAllBtn').addEventListener('click', () => {
  if (!slots.some(s => s.trim())) return;
  if (!confirm(I18N.t('client.competition.vaciar_todos_los_carriles'))) return;
  slots = [];
  renderSlots();
});

/* Intro dentro de un nombre pasa al siguiente en vez de enviar el formulario. */
document.getElementById('participantList').addEventListener('keydown', e => {
  if (e.key !== 'Enter' || !e.target.matches('.tc-slot-row__inp')) return;
  e.preventDefault();
  const next = document.querySelector(`.tc-slot-row__inp[data-idx="${parseInt(e.target.dataset.idx, 10) + 1}"]`);
  if (next) next.focus();
});

/* ── Secuencia de rotación de carriles (drag-and-drop) ──────────────────── */
let laneSeq = [];
let _seqDragFrom = null;

function renderLaneSeq() {
  const n = currentLaneCount();
  // Regenera la secuencia natural [1..N] si cambió el nº de carriles.
  const valid = laneSeq.length === n && laneSeq.slice().sort((a, b) => a - b).every((v, i) => v === i + 1);
  if (!valid) laneSeq = Array.from({ length: n }, (_, i) => i + 1);

  const list   = document.getElementById('laneSeqList');
  const hidden = document.getElementById('laneSeqHidden');
  list.innerHTML = laneSeq.map((lane, i) => `
    <div class="tc-seq-chip" draggable="true" data-i="${i}">
      <span class="tc-seq-chip__ord">${i + 1}º</span>
      <span class="tc-seq-chip__lane">${I18N.t('client.common.carril')} ${lane}</span>
    </div>`).join('');
  hidden.innerHTML = laneSeq.map(lane => `<input type="hidden" name="lane_sequence[]" value="${lane}">`).join('');
}
document.getElementById('seqResetBtn').addEventListener('click', () => { laneSeq = []; renderLaneSeq(); });

(function () {
  const list = document.getElementById('laneSeqList');
  list.addEventListener('dragstart', e => {
    const chip = e.target.closest('.tc-seq-chip'); if (!chip) return;
    _seqDragFrom = parseInt(chip.dataset.i, 10);
    chip.classList.add('dragging');
    e.dataTransfer.effectAllowed = 'move';
  });
  list.addEventListener('dragend', () => {
    list.querySelectorAll('.dragging,.drop-target').forEach(c => c.classList.remove('dragging', 'drop-target'));
    _seqDragFrom = null;
  });
  list.addEventListener('dragover', e => {
    e.preventDefault();
    const chip = e.target.closest('.tc-seq-chip');
    list.querySelectorAll('.drop-target').forEach(c => c.classList.remove('drop-target'));
    if (chip) chip.classList.add('drop-target');
  });
  list.addEventListener('drop', e => {
    e.preventDefault();
    const chip = e.target.closest('.tc-seq-chip');
    if (!chip || _seqDragFrom == null) return;
    const to = parseInt(chip.dataset.i, 10);
    if (to !== _seqDragFrom) {
      const [m] = laneSeq.splice(_seqDragFrom, 1);
      laneSeq.splice(to, 0, m);
      renderLaneSeq();
    }
    _seqDragFrom = null;
  });
})();

/* Circuit hint + re-render de slots al cambiar circuito.
   En multi-DS no hay selector de circuito (los carriles los fijan los DS):
   renderizamos directamente slots + secuencia. */
(function () {
  const sel = document.getElementById('circuitSelect');
  if (!sel) { renderSlots(); renderLaneSeq(); return; }
  const hint = document.getElementById('circuitLanesHint');
  const minLapInput = document.getElementById('minLapS');
  function update() {
    const lanes = sel.options[sel.selectedIndex]?.dataset?.lanes;
    hint.innerHTML = lanes
      ? `<span class="vt-badge__d"></span> ${lanes} ${I18N.t('client.common.carriles')}`
      : `<span class="vt-badge__d"></span> ${FALLBACK_LANES} ${I18N.t('client.common.carriles')} (def.)`;
    hint.style.display = '';
    // El Pt sigue al circuito, pero sin pisar lo que haya tecleado el usuario.
    const minMs = parseInt(sel.options[sel.selectedIndex]?.dataset?.minMs || '0', 10);
    if (minLapInput && !minLapInput.dataset.touched) {
      // Punto, NO coma: <input type="number"> exige el formato inglés en `value`.
      minLapInput.value = minMs > 0 ? (minMs / 1000).toFixed(2) : '';
    }
    renderSlots();
    renderLaneSeq();
  }
  if (minLapInput) minLapInput.addEventListener('input', () => { minLapInput.dataset.touched = '1'; });
  sel.addEventListener('change', update);
  update();
})();
</script>
