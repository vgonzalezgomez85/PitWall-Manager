<%- include('../partials/header', { lang, pageTitle: (t('race-shifts.historico_de_turnos')) + ' — ' + race.name }) %>

<%
// fmtHms / shiftCompliance / shiftBadge vienen de app.locals: fuente única de
// formato y de regla. Antes cada vista llevaba su copia y habían divergido.
// El m:ss de antes pintaba 4 h como "240:00", que en una 24h no vale.
function fmtTime(ms) {
  if (ms == null || isNaN(ms)) return '—';
  return fmtHms(ms);
}
function fmtMsStamp(ms) {
  if (!ms) return '—';
  const d = new Date(ms);
  return d.toLocaleTimeString();
}
const minMs   = race.driver_min_total_ms || 0;
const maxMs   = race.driver_max_total_ms || 0;
const maxRuns = race.driver_max_runs || 0;
// Histórico: la carrera ya rodó, así que el mínimo SÍ se juzga.
const reglas  = { minMs, maxMs, maxRuns, final: true };
%>

<div class="vt-page vt-page--shifts-history">
  <div class="vt-wrap">

    <a href="/races/<%= race.id %>" class="vt-back-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      <%= t('common.volver_a_la_carrera') %>
    </a>

    <div class="vt-head">
      <div class="vt-head__title">
        <h1><%= t('race-shifts.historico_de_turnos') %></h1>
        <span class="vt-cnt"><%= race.name %></span>
      </div>
      <div class="vt-head__actions">
        <% if (!notChampionship) { %>
          <a href="/races/<%= race.id %>/shifts/report" class="vt-btn vt-btn--sm">
            <%= t('race-shifts.informe_final') %>
          </a>
        <% } %>
        <a href="/control/shifts" class="vt-btn vt-btn--ghost vt-btn--sm">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          <%= t('race-shifts.control_en_vivo') %>
        </a>
      </div>
    </div>

    <% if (notChampionship) { %>
      <div class="vt-empty" style="margin-top:32px">
        <div class="vt-empty__t"><%= t('race-shifts.no_aplica') %></div>
        <p style="color:var(--vt-mute);margin:6px 0 0">
          <%= t('race-shifts.solo_las_carreras_de_tipo_campeonato_registran') %>
        </p>
      </div>
    <% } else { %>

      <!-- Resumen por piloto -->
      <div class="sc-section" style="margin-top:18px">
        <div class="vt-sec-lbl"><%= t('common.tiempo_total_por_piloto') %></div>
        <% if (summary.length === 0) { %>
          <p style="color:var(--vt-mute)"><%= t('common.aun_no_hay_turnos_registrados') %></p>
        <% } else { %>
          <div class="vt-table-card">
            <table class="vt-table">
              <thead>
                <tr>
                  <th><%= t('client.common.piloto') %></th>
                  <th><%= t('client.common.categoria') %></th>
                  <th class="is-num"><%= t('client.common.total') %></th>
                  <% if (minMs > 0) { %><th class="is-num"><%= t('race-shifts.min') %></th><% } %>
                  <% if (maxMs > 0) { %><th class="is-num"><%= t('race-shifts.max') %></th><% } %>
                  <th class="is-num"><%= t('common.turnos_2') %></th>
                  <th><%= t('common.estado') %></th>
                </tr>
              </thead>
              <tbody>
                <% summary.forEach(r => {
                  // `runs_count` = turnos RODADOS. `shifts_count` incluía los
                  // pre-armes que nunca arrancaron: inflaba el recuento.
                  const runs = r.runs_count || 0;
                  const c = shiftCompliance({ totalMs: r.total_ms, runs }, reglas);
                %>
                  <tr>
                    <td class="is-name"><span class="vt-cat-dot vt-cat--<%= r.profile_category %>" style="margin-right:6px"></span><%= r.profile_name %></td>
                    <td class="is-mute"><%= r.profile_category %></td>
                    <td class="is-num is-mono is-name"><%= fmtTime(r.total_ms) %></td>
                    <% if (minMs > 0) { %><td class="is-num is-mono is-mute"><%= fmtTime(minMs) %></td><% } %>
                    <% if (maxMs > 0) { %><td class="is-num is-mono is-mute"><%= fmtTime(maxMs) %></td><% } %>
                    <td class="is-num is-mono"><%= runs %><% if (maxRuns > 0) { %><span class="is-mute">/<%= maxRuns %></span><% } %></td>
                    <td>
                      <% if (c.overMax) { %>
                        <span class="vt-badge is-bad"><span class="vt-badge__d"></span><%= t('common.pasado') %></span>
                      <% } else if (c.overRuns) { %>
                        <span class="vt-badge is-bad"><span class="vt-badge__d"></span><%= t('common.turnos') %></span>
                      <% } else if (c.underMin) { %>
                        <span class="vt-badge is-bad"><span class="vt-badge__d"></span><%= t('common.bajo_min') %></span>
                      <% } else if (c.nearMax) { %>
                        <span class="vt-badge is-warn"><span class="vt-badge__d"></span>90%+</span>
                      <% } else if (c.nearRuns) { %>
                        <span class="vt-badge is-warn"><span class="vt-badge__d"></span><%= t('common.ultimo_turno') %></span>
                      <% } else { %>
                        <span class="vt-badge is-ok"><span class="vt-badge__d"></span>OK</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <!-- Por manga -->
      <% mangas.forEach(m => { %>
        <div class="sc-section" style="margin-top:28px">
          <div class="vt-sec-lbl">
            <%= t('common.tanda_2') %> <%= m.tanda_number || '?' %> ·
            <%= t('common.manga') %> <%= m.number %>
            <span style="margin-left:10px;font-weight:500;text-transform:none;letter-spacing:0;color:var(--vt-mute)">— <%= m.status %></span>
          </div>
          <% if (m.shifts.length === 0) { %>
            <p style="color:var(--vt-mute);font-size:13px;margin:0">
              <%= t('race-shifts.sin_turnos') %>
            </p>
          <% } else { %>
            <div class="vt-table-card">
              <table class="vt-table">
                <thead>
                  <tr>
                    <th class="is-num"><%= t('client.common.carril') %></th>
                    <th><%= t('client.common.piloto') %></th>
                    <th><%= t('race-shifts.inicio') %></th>
                    <th><%= t('race-shifts.fin') %></th>
                    <th class="is-num"><%= t('race-shifts.duracion') %></th>
                    <th><%= t('common.tipo') %></th>
                  </tr>
                </thead>
                <tbody>
                  <% m.shifts.forEach(s => { %>
                    <tr>
                      <td class="is-num is-mono is-name">L<%= s.lane %></td>
                      <td class="is-name"><%= s.driver_name %></td>
                      <td class="is-mute is-mono"><%= fmtMsStamp(s.started_at_ms) %></td>
                      <td class="is-mute is-mono"><%= s.ended_at_ms ? fmtMsStamp(s.ended_at_ms) : '<span style="color:var(--vt-green)">— ' + (t('race-shifts.abierto')) + '</span>' %></td>
                      <td class="is-num is-mono is-name"><%= fmtTime(s.driving_ms) %></td>
                      <td>
                        <% if (s.pre_armed) { %>
                          <span class="vt-badge is-info"><span class="vt-badge__d"></span><%= t('race-shifts.pre_arme') %></span>
                        <% } else if (s.ended_at_ms == null) { %>
                          <span class="vt-badge is-ok is-live"><span class="vt-badge__d"></span><%= t('common.en_curso') %></span>
                        <% } else { %>
                          <span class="vt-badge is-neutral"><span class="vt-badge__d"></span><%= t('race-shifts.cerrado') %></span>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      <% }) %>

    <% } %>

  </div>
</div>

<%- include('../partials/footer') %>
