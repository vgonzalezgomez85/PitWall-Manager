<%- include('../partials/header', { lang, pageTitle: lang === 'es' ? 'Control de pilotos' : 'Driver shifts' }) %>

<%
// fmtHms / shiftCompliance vienen de app.locals (fuente única). El m:ss de antes
// pintaba 4 h de acumulado como "240:00".
function fmtTime(ms) {
  if (ms == null || isNaN(ms)) return '—';
  return fmtHms(ms);
}

// Pre-calcular shifts cerrados por carril (histórico de la manga) — útil
// como tooltip o lista lateral. Por ahora solo lo dejamos en data atributos.
const closedByLane = {};
(history || []).forEach(s => {
  if (s.ended_at_ms == null) return;
  if (!closedByLane[s.lane]) closedByLane[s.lane] = [];
  closedByLane[s.lane].push(s);
});

// Total acumulado por piloto en la carrera (incluye otras mangas)
const totalsByName = {};
(summary || []).forEach(r => { totalsByName[r.profile_name] = r.total_ms; });

const minMs = current && current.race ? (current.race.driver_min_total_ms || 0) : 0;
const maxMs = current && current.race ? (current.race.driver_max_total_ms || 0) : 0;
const lockoutMs = current && current.race ? (current.race.driver_change_lockout_ms || 120000) : 120000;
const maxRuns = current && current.race ? (current.race.driver_max_runs || 0) : 0;

// Mismos colores de carril que el directo (races/live.ejs) → coherencia visual.
const LC = ['#e63946','#2196f3','#4caf50','#ff9800','#9c27b0','#00bcd4','#ff5722','#607d8b','#795548','#e91e63','#3f51b5','#009688','#cddc39','#ffc107','#f44336','#673ab7','#03a9f4','#8bc34a','#ff6f00','#880e4f','#1a237e','#b71c1c','#004d40','#f57f17','#311b92','#0d47a1','#1b5e20','#33691e','#bf360c','#4a148c','#006064','#827717'];

function esc(s) {
  return String(s == null ? '' : s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}
// Roster del equipo: cada piloto con turnos + tiempo total, coloreado por límite
// (verde ok/bajo mín · ámbar a punto · rojo pasado). driverName = piloto actual.
function renderRoster(roster, driverName) {
  if (!roster || !roster.length) return '';
  const title = lang === 'es' ? 'Pilotos del equipo: tiempo y turnos' : 'Team drivers: time and stints';
  let html = '<div class="sc-lane__roster" title="' + title + '">';
  roster.forEach(p => {
    // En directo el mínimo NO es infracción (nadie lo cumple en el minuto 1):
    // solo se marca "le falta". Por eso final: false.
    const c = shiftCompliance({ totalMs: p.total_ms, runs: p.runs }, { minMs, maxMs, maxRuns, final: false });
    const rcls   = c.status === 'bad'  ? 'is-over'
                 : c.status === 'warn' ? 'is-near'
                 : c.status === 'info' ? 'is-under' : 'is-ok';
    const isNow  = driverName && p.name === driverName;
    html += '<div class="sc-lane__rost ' + rcls + (isNow ? ' is-now' : '') + '">'
          + '<span class="sc-lane__rost-name">' + esc(p.name) + '</span>'
          + '<span class="sc-lane__rost-runs">' + p.runs + (maxRuns > 0 ? '/' + maxRuns : '') + (lang === 'es' ? 'T' : 'x') + '</span>'
          + '<span class="sc-lane__rost-time">' + fmtTime(p.total_ms) + '</span>'
          + '</div>';
  });
  return html + '</div>';
}

// Mapas para la corrección manual de tiempo (modal): pilotos y nombre por carril.
const pilotsByLane   = {};
const teamNameByLane = {};
(lanes || []).forEach(l => {
  pilotsByLane[l.lane]   = ((rosterByLane && rosterByLane[l.lane]) || []).map(p => ({ id: p.driver_id, name: p.name }));
  teamNameByLane[l.lane] = l.team_name || l.driver_name || ('L' + l.lane);
});
%>

<div class="vt-page vt-page--shifts">
  <div class="vt-wrap">

    <a href="/" class="vt-back-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      <%= lang === 'es' ? 'Inicio' : 'Home' %>
    </a>

    <div class="vt-head">
      <div class="vt-head__title">
        <h1><%= lang === 'es' ? 'Control de pilotos' : 'Driver shifts' %></h1>
        <% if (current) { %>
          <span class="vt-cnt"><%= current.race.name %> · M<%= current.manga.number %></span>
        <% } %>
      </div>
      <div class="vt-head__actions">
        <% if (current) { %>
          <% const statusBadge = current.liveStatus === 'running' ? 'is-ok is-live' : current.liveStatus === 'paused' ? 'is-warn' : current.liveStatus === 'standby' ? 'is-warn' : 'is-neutral'; %>
          <% const statusLabel = {
            running: lang === 'es' ? 'EN MARCHA' : 'RUNNING',
            paused:  lang === 'es' ? 'PAUSADA'   : 'PAUSED',
            standby: lang === 'es' ? 'STANDBY (pre-arme)' : 'STANDBY (pre-arm)',
            unknown: lang === 'es' ? 'ACTIVA'    : 'ACTIVE',
          }[current.liveStatus]; %>
          <span class="vt-badge <%= statusBadge %>"><span class="vt-badge__d"></span><%= statusLabel %></span>
        <% } else { %>
          <span class="vt-badge is-neutral"><span class="vt-badge__d"></span><%= lang === 'es' ? 'Sin manga activa' : 'No active manga' %></span>
        <% } %>
        <a href="<%= current ? '/races/' + current.race.id + '/shifts' : '#' %>" class="vt-btn vt-btn--ghost vt-btn--sm" <%= current ? '' : 'aria-disabled="true" style="opacity:.4;pointer-events:none"' %>>
          <svg viewBox="0 0 24 24"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
          <%= lang === 'es' ? 'Histórico' : 'History' %>
        </a>
      </div>
    </div>

    <% if (!current) { %>
      <div class="vt-empty" style="margin-top:32px">
        <div class="vt-empty__t"><%= lang === 'es' ? 'Esperando carrera' : 'Waiting for race' %></div>
        <p style="color:var(--vt-mute);margin:6px 0 0">
          <%= lang === 'es'
            ? 'Esta vista se activa cuando hay una carrera de tipo campeonato con una manga preparada o en marcha.'
            : 'This view activates when there is a championship race with a manga prepared or running.' %>
        </p>
      </div>
    <% } else { %>

      <div class="sc-kiosk" id="scKiosk">
        <!-- ── Columna izquierda: barra de scan + cuadro de cámara ───── -->
        <aside class="sc-left">

          <!-- Barra de scan (info + botón Cámara) ENCIMA del cuadro -->
          <div class="sc-scan-bar" id="scScanBar">
            <span class="sc-scan-led" id="scLed"></span>
            <span class="sc-scan-msg" id="scMsg"><%= lang === 'es' ? 'Listo para escanear' : 'Ready to scan' %></span>
            <button type="button" class="sc-cam-btn" id="scCamBtn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
              <%= lang === 'es' ? 'Cámara' : 'Camera' %>
            </button>
            <span class="sc-remaining" id="scRemaining"></span>
          </div>

          <!-- Cuadro de cámara (modo quiosco) -->
          <aside class="sc-cam-dock" id="scCamDock" hidden>
            <div class="sc-cam-head">
              <span class="sc-cam-status" id="scCamStatus"><%= lang === 'es' ? 'Iniciando cámara…' : 'Starting camera…' %></span>
              <div class="sc-cam-acts">
                <button type="button" class="vt-btn vt-btn--ghost vt-btn--sm" id="scCamSwitch" style="display:none"><%= lang === 'es' ? 'Cambiar' : 'Switch' %></button>
              </div>
            </div>
            <div class="sc-cam-view">
              <video id="scCamVideo" playsinline muted></video>
              <div class="sc-cam-reticle" id="scCamReticle"></div>
            </div>
            <div class="sc-cam-hint" id="scCamHint"><%= lang === 'es' ? 'Apunta la cámara al QR del piloto' : 'Point the camera at the pilot QR' %></div>
          </aside>

        </aside><!-- /.sc-left -->

        <div class="sc-kiosk__main">

      <!-- Input invisible que captura el lector USB-QR -->
      <input id="scScanInput" type="text" autocomplete="off" spellcheck="false"
             aria-label="<%= lang === 'es' ? 'Lector QR' : 'QR scanner' %>"
             class="sc-scan-input">

      <!-- ── Cards por carril (paginado si no caben) ─────────────────── -->
      <div class="sc-lane-head">
        <span class="vt-sec-lbl"><%= lang === 'es' ? 'Carriles' : 'Lanes' %></span>
        <div class="sc-legend">
          <span class="sc-legend__i"><span class="sc-legend__dot" style="background:#c792ea"></span><%= lang === 'es' ? 'Bajo mín.' : 'Under min' %></span>
          <span class="sc-legend__i"><span class="sc-legend__dot" style="background:var(--vt-green)"></span>OK</span>
          <span class="sc-legend__i"><span class="sc-legend__dot" style="background:var(--vt-amber)"></span><%= lang === 'es' ? 'A punto' : 'Near' %></span>
          <span class="sc-legend__i"><span class="sc-legend__dot" style="background:var(--vt-red)"></span><%= lang === 'es' ? 'Pasado' : 'Over' %></span>
        </div>
        <span class="sc-pages-ind" id="scLaneInd"></span>
      </div>
      <div class="sc-lane-area" id="scLaneArea">
      <div class="sc-lane-grid" id="scLaneGrid">
        <% lanes.forEach(l => {
          const s = openByLane[l.lane];
          const live = liveActive[l.lane] || {};
          const drivingMs = live.drivingMs ?? (s ? (s.driving_ms || 0) : 0);
          const driverName = s ? s.driver_name : null;
          const totalMs = driverName ? (totalsByName[driverName] || 0) : 0;
          const closed = closedByLane[l.lane] || [];
        %>
          <div class="sc-lane" data-lane="<%= l.lane %>">
            <div class="sc-lane__head">
              <div class="sc-lane__num" style="background:<%= LC[l.lane - 1] || '#8b949e' %>;color:#fff;border-color:transparent">L<%= l.lane %></div>
              <div class="sc-lane__team"><%= l.team_name || l.driver_name || '—' %></div>
              <button type="button" class="sc-lane__fix" data-lane="<%= l.lane %>" title="<%= lang === 'es' ? 'Corregir tiempo (olvidó fichar)' : 'Correct time (forgot to scan)' %>">✎</button>
            </div>
            <div class="sc-lane__driver" data-driver-name>
              <% if (driverName) { %>
                <%= driverName %>
              <% } else { %>
                <span class="sc-lane__empty"><%= lang === 'es' ? 'Sin asignar' : 'Unassigned' %></span>
              <% } %>
            </div>
            <div class="sc-lane__stats">
              <div>
                <span class="sc-lane__lbl"><%= lang === 'es' ? 'Turno' : 'Shift' %></span>
                <span class="sc-lane__val" data-shift-ms="<%= drivingMs %>"><%= fmtTime(drivingMs) %></span>
              </div>
              <div>
                <span class="sc-lane__lbl"><%= lang === 'es' ? 'Total piloto' : 'Driver total' %></span>
                <span class="sc-lane__val" data-total-ms="<%= totalMs %>"><%= fmtTime(totalMs) %></span>
              </div>
            </div>
            <%- renderRoster((rosterByLane && rosterByLane[l.lane]) || [], driverName) %>
          </div>
        <% }) %>

        <!-- ── Equipos que descansan esta manga ──────────────────────── -->
        <% (restingTeams || []).forEach(rt => { %>
          <div class="sc-lane sc-lane--rest" data-rest="<%= rt.restPos %>">
            <div class="sc-lane__head">
              <div class="sc-lane__num sc-lane__num--rest"><%= lang === 'es' ? 'DESC' : 'REST' %></div>
              <div class="sc-lane__team"><%= rt.team_name %></div>
            </div>
            <div class="sc-lane__rest-badge">
              <%= lang === 'es' ? 'Descanso' : 'Rest' %> <%= rt.restPos %>/<%= rt.restTotal %>
            </div>
            <%- renderRoster(rt.roster, null) %>
          </div>
        <% }) %>
      </div>
      </div><!-- /.sc-lane-area -->

        </div><!-- /.sc-kiosk__main -->

      <!-- ── Pilotos por tiempo (panel lateral derecho, paginado) ─────── -->
      <aside class="sc-pilots-panel" id="scPilotsPanel">
        <div class="sc-pilots-panel__head">
          <span class="vt-sec-lbl"><%= lang === 'es' ? 'Pilotos por tiempo' : 'Drivers by time' %></span>
          <span class="sc-pages-ind" id="scPilotsInd"></span>
        </div>
        <% if (summary.length === 0) { %>
          <p style="color:var(--vt-mute)"><%= lang === 'es' ? 'Aún no hay turnos registrados.' : 'No shifts recorded yet.' %></p>
        <% } else { %>
          <div class="sc-summary" id="scPilotsPages">
            <% summary.forEach(r => {
              const t    = r.total_ms;
              const runs = r.runs_count || 0;
              const c = shiftCompliance({ totalMs: t, runs }, { minMs, maxMs, maxRuns, final: false });
              const badge   = shiftBadge(c.status);
              const runsCls = c.overRuns ? 'is-over' : (c.nearRuns ? 'is-near' : '');
              const pct = maxMs > 0 ? Math.min(100, Math.round(t / maxMs * 100)) : 0;
              const minPct = maxMs > 0 && minMs > 0 ? Math.min(100, Math.round(minMs / maxMs * 100)) : 0;
            %>
              <div class="sc-pilot-row" data-profile-name="<%= r.profile_name %>">
                <div class="sc-pilot-row__name">
                  <span class="vt-cat-dot vt-cat--<%= r.profile_category %>"></span>
                  <%= r.profile_name %>
                </div>
                <% if (maxMs > 0 || minMs > 0) { %>
                  <div class="sc-pilot-row__bar">
                    <div class="sc-pilot-row__bar-fill <%= badge %>" style="width:<%= pct %>%"></div>
                    <% if (minPct > 0) { %>
                      <div class="sc-pilot-row__bar-min" style="left:<%= minPct %>%" title="<%= lang === 'es' ? 'Mínimo' : 'Min' %>"></div>
                    <% } %>
                  </div>
                <% } %>
                <div class="sc-pilot-row__runs <%= runsCls %>" title="<%= lang === 'es' ? 'Veces que ha corrido (turnos)' : 'Times driven (stints)' %><%= maxRuns > 0 ? (lang === 'es' ? ' · máx ' : ' · max ') + maxRuns : '' %>">
                  <span class="sc-pilot-row__runs-n"><%= runs %><% if (maxRuns > 0) { %><span class="sc-pilot-row__runs-max">/<%= maxRuns %></span><% } %></span>
                  <span class="sc-pilot-row__runs-l"><%= c.overRuns ? (lang === 'es' ? 'pasado' : 'over') : (lang === 'es' ? 'turnos' : 'stints') %></span>
                </div>
                <div class="sc-pilot-row__total" data-total-ms="<%= t %>">
                  <%= fmtTime(t) %>
                  <% if (maxMs > 0) { %><span style="color:var(--vt-mute)"> / <%= fmtTime(maxMs) %></span><% } %>
                </div>
                <div class="sc-pilot-row__status">
                  <% if (c.overMax) { %>
                    <span class="vt-badge <%= badge %>"><span class="vt-badge__d"></span><%= lang === 'es' ? 'PASADO' : 'OVER' %></span>
                  <% } else if (c.overRuns) { %>
                    <span class="vt-badge <%= badge %>"><span class="vt-badge__d"></span><%= lang === 'es' ? 'TURNOS' : 'STINTS' %></span>
                  <% } else if (c.nearMax) { %>
                    <span class="vt-badge <%= badge %>"><span class="vt-badge__d"></span>90%+</span>
                  <% } else if (c.nearRuns) { %>
                    <span class="vt-badge <%= badge %>"><span class="vt-badge__d"></span><%= lang === 'es' ? 'Último turno' : 'Last stint' %></span>
                  <% } else if (c.status === 'info') { %>
                    <span class="vt-badge <%= badge %>"><span class="vt-badge__d"></span><%= lang === 'es' ? 'Bajo mín.' : 'Under min' %></span>
                  <% } else { %>
                    <span class="vt-badge is-ok"><span class="vt-badge__d"></span>OK</span>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </aside><!-- /.sc-pilots-panel -->

      </div><!-- /.sc-kiosk -->

      <!-- ── Toast contenedor ───────────────────────────────────────── -->
      <div class="sc-toast-wrap" id="scToasts" aria-live="polite"></div>

      <!-- ── Feedback grande para el piloto (✓/✗ + nombre + carril) ──── -->
      <div class="sc-feedback" id="scFeedback" hidden aria-live="assertive">
        <div class="sc-feedback__box">
          <div class="sc-feedback__icon" id="scFbIcon"></div>
          <div class="sc-feedback__title" id="scFbTitle"></div>
          <div class="sc-feedback__sub" id="scFbSub"></div>
        </div>
      </div>

      <!-- ── Modal corregir tiempo (equipo que olvidó fichar) ────────── -->
      <div class="sc-fix-modal" id="scFixModal" hidden>
        <div class="sc-fix-box">
          <div class="sc-fix-head">
            <span id="scFixTitle"><%= lang === 'es' ? 'Corregir tiempo' : 'Correct time' %></span>
            <button type="button" class="vt-btn vt-btn--ghost vt-btn--sm" id="scFixClose">✕</button>
          </div>
          <p class="sc-fix-hint"><%= lang === 'es'
            ? 'Añade tiempo a un piloto que corrió pero no se fichó por QR.'
            : 'Add time to a driver who raced but was not checked in by QR.' %></p>
          <label class="sc-fix-lbl"><%= lang === 'es' ? 'Piloto' : 'Driver' %></label>
          <select id="scFixPilot" class="sc-fix-select"></select>
          <label class="sc-fix-lbl"><%= lang === 'es' ? 'Tiempo a añadir (min:seg)' : 'Time to add (min:sec)' %></label>
          <input id="scFixTime" class="sc-fix-input" type="text" inputmode="numeric" placeholder="10:00" autocomplete="off">
          <div class="sc-fix-actions">
            <button type="button" class="vt-btn vt-btn--ghost" id="scFixCancel"><%= lang === 'es' ? 'Cancelar' : 'Cancel' %></button>
            <button type="button" class="vt-btn" id="scFixSubmit"><%= lang === 'es' ? 'Añadir tiempo' : 'Add time' %></button>
          </div>
        </div>
      </div>

    <% } %>

  </div>
</div>

<% if (current) { %>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/jsQR.js"></script>
<script>
const RACE_ID  = <%= current.race.id %>;
const MANGA_ID = <%= current.manga.id %>;
const LOCKOUT_MS = <%= lockoutMs %>;
const MIN_MS = <%= minMs %>;
const MAX_MS = <%= maxMs %>;
const LANG = "<%= lang %>";
const MANGA_DURATION_MS = <%= mangaDurationMs || 0 %>;
const TEAM_PILOTS = <%- JSON.stringify(pilotsByLane) %>;
const TEAM_NAMES  = <%- JSON.stringify(teamNameByLane) %>;

// Gemelo en cliente de src/utils/duration.js#fmtHms (el navegador no puede
// hacer require). Con m:ss, un acumulado de 4 h se pintaba "240:00".
function fmtTime(ms) {
  if (ms == null || isNaN(ms)) return '—';
  const total = Math.max(0, Math.floor(ms / 1000));
  const h = Math.floor(total / 3600);
  const m = Math.floor((total % 3600) / 60);
  const s = total % 60;
  const dd = n => String(n).padStart(2, '0');
  return h > 0 ? h + ':' + dd(m) + ':' + dd(s) : m + ':' + dd(s);
}

// ── Input siempre enfocado ────────────────────────────────────────
const input = document.getElementById('scScanInput');
const led   = document.getElementById('scLed');
const msg   = document.getElementById('scMsg');
const scanBar = document.getElementById('scScanBar');

function refocus() { if (input) input.focus(); }
function setLed(state, text) {
  scanBar.dataset.state = state;
  msg.textContent = text;
}
function updateFocus() {
  if (document.activeElement === input) {
    setLed('ready', LANG === 'es' ? 'Listo para escanear' : 'Ready to scan');
  } else {
    setLed('warn', LANG === 'es' ? 'Pulsa para reactivar el lector' : 'Click to reactivate scanner');
  }
}
input.addEventListener('focus', updateFocus);
input.addEventListener('blur', () => setTimeout(updateFocus, 50));
document.addEventListener('click', e => {
  ensureAudio();
  const t = e.target;
  // No robar el foco al interactuar con el modal de corrección ni con campos.
  if (t.closest && t.closest('.sc-fix-modal')) return;
  if (['A', 'BUTTON', 'INPUT', 'SELECT', 'TEXTAREA', 'OPTION'].includes(t.tagName)) return;
  refocus();
});
window.addEventListener('focus', refocus);
refocus(); updateFocus();

// ── Feedback grande + sonido para el piloto ──────────────────────
const fb      = document.getElementById('scFeedback');
const fbIcon  = document.getElementById('scFbIcon');
const fbTitle = document.getElementById('scFbTitle');
const fbSub   = document.getElementById('scFbSub');
let fbTimer = null, audioCtx = null;

// El navegador exige un gesto del usuario para habilitar audio: lo
// desbloqueamos en el primer clic / al activar la cámara.
function ensureAudio() {
  try {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if (audioCtx.state === 'suspended') audioCtx.resume();
  } catch (e) {}
}
function tone(freq, start, dur, type) {
  const o = audioCtx.createOscillator(), g = audioCtx.createGain();
  o.type = type || 'sine'; o.frequency.value = freq;
  g.gain.setValueAtTime(0.0001, start);
  g.gain.exponentialRampToValueAtTime(0.3, start + 0.012);
  g.gain.exponentialRampToValueAtTime(0.0001, start + dur);
  o.connect(g); g.connect(audioCtx.destination);
  o.start(start); o.stop(start + dur + 0.02);
}
function beep(ok) {
  if (!audioCtx) return;
  try {
    const t = audioCtx.currentTime;
    if (ok) { tone(880, t, 0.11); tone(1320, t + 0.12, 0.13); }  // dos tonos ascendentes
    else    { tone(200, t, 0.34, 'square'); }                    // zumbido grave
  } catch (e) {}
}
function bigFeedback(kind, title, sub) {
  if (!fb) return;
  fb.className = 'sc-feedback ' + (kind === 'ok' ? 'is-ok' : 'is-error');
  fbIcon.textContent  = kind === 'ok' ? '✓' : '✕';
  fbTitle.textContent = title || '';
  fbSub.textContent   = sub || '';
  fb.hidden = false;
  beep(kind === 'ok');
  clearTimeout(fbTimer);
  fbTimer = setTimeout(() => {
    fb.classList.add('is-out');
    setTimeout(() => { fb.hidden = true; fb.classList.remove('is-out'); }, 300);
  }, kind === 'ok' ? 4000 : 5000);
}

// ── Envío de un código (lo comparten el lector USB y la webcam) ───
async function submitCode(code) {
  code = (code || '').trim();
  if (!code) return;
  setLed('busy', LANG === 'es' ? 'Procesando…' : 'Processing…');
  try {
    const res = await fetch(`/races/${RACE_ID}/mangas/${MANGA_ID}/checkin`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ qr_code: code }),
    });
    const data = await res.json().catch(() => ({}));
    if (res.ok && data.ok) {
      const modeLabel = {
        pre_arm: LANG === 'es' ? 'Pre-armado' : 'Pre-armed',
        swap_running: LANG === 'es' ? 'Cambio en marcha' : 'Live swap',
        swap_paused: LANG === 'es' ? 'Cambio en pausa' : 'Swap on pause',
      }[data.mode] || (LANG === 'es' ? 'Asignado' : 'Assigned');
      toast('ok', `${modeLabel}: ${data.driverName} → ${LANG === 'es' ? 'Carril' : 'Lane'} ${data.lane}`);
      bigFeedback('ok', data.driverName, `${LANG === 'es' ? 'Carril' : 'Lane'} ${data.lane} · ${modeLabel}`);
    } else {
      const errMap = {
        unknown_qr:                LANG === 'es' ? 'QR desconocido' : 'Unknown QR',
        team_resting:              LANG === 'es' ? 'Equipo descansando — no puede fichar' : 'Team resting — cannot check in',
        driver_not_in_manga:       LANG === 'es' ? 'El piloto no está en esta manga' : 'Driver not in this manga',
        not_championship_race:     LANG === 'es' ? 'No es carrera de campeonato' : 'Not a championship race',
        not_team_race:             LANG === 'es' ? 'No es carrera por equipos' : 'Not a team race',
        ambiguous_team:            LANG === 'es' ? 'Ambigüedad — usa override manual' : 'Ambiguous — use manual override',
        manga_active_but_not_timing: LANG === 'es' ? 'Manga activa pero sin sesión de timing' : 'Manga active but no timing session',
        manga_active_but_not_running: LANG === 'es' ? 'Manga activa pero ni running ni paused' : 'Manga active but neither running nor paused',
        manga_status_invalid:      LANG === 'es' ? 'Estado de manga inválido' : 'Invalid manga status',
        change_locked_final_minutes: LANG === 'es'
          ? `Bloqueado — quedan ${fmtTime(data.remainingMs)} del final`
          : `Locked — ${fmtTime(data.remainingMs)} left`,
        missing_params: LANG === 'es' ? 'Faltan datos' : 'Missing params',
      };
      const text = errMap[data.error] || (data.error || 'Error');
      toast('error', text + (data.name ? ` (${data.name})` : ''));
      bigFeedback('error', text, data.name || '');
    }
  } catch (err) {
    toast('error', err.message || 'Network error');
    bigFeedback('error', LANG === 'es' ? 'Error de red' : 'Network error', '');
  } finally {
    updateFocus();
  }
}

// ── Submit en Enter (el lector USB termina con Enter) ─────────────
input.addEventListener('keydown', e => {
  if (e.key !== 'Enter') return;
  e.preventDefault();
  const code = input.value.trim();
  input.value = '';
  submitCode(code).finally(refocus);
});

// ── Corregir tiempo manualmente (equipo que olvidó fichar) ────────
const fixModal = document.getElementById('scFixModal');
const fixTitle = document.getElementById('scFixTitle');
const fixPilot = document.getElementById('scFixPilot');
const fixTime  = document.getElementById('scFixTime');

function msToClock(ms) {
  const s = Math.max(0, Math.round(ms / 1000));
  return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
}
function clockToMs(str) {
  str = (str || '').trim();
  if (!str) return NaN;
  if (str.indexOf(':') >= 0) {
    const [m, s] = str.split(':');
    return ((parseInt(m, 10) || 0) * 60 + (parseInt(s, 10) || 0)) * 1000;
  }
  const n = parseInt(str, 10);                       // sin ':' → segundos
  return isNaN(n) ? NaN : n * 1000;
}
function openFix(lane) {
  const pilots = (TEAM_PILOTS && TEAM_PILOTS[lane]) || [];
  if (!pilots.length) { toast('error', LANG === 'es' ? 'Sin pilotos en este carril' : 'No drivers on this lane'); return; }
  fixTitle.textContent = (LANG === 'es' ? 'Corregir · ' : 'Fix · ') + (TEAM_NAMES[lane] || ('L' + lane));
  fixPilot.innerHTML = pilots.map(p => `<option value="${p.id}">${p.name}</option>`).join('');
  fixTime.value = msToClock(MANGA_DURATION_MS || 0);
  fixModal.hidden = false;
  setTimeout(() => { fixTime.focus(); fixTime.select(); }, 50);
}
function closeFix() { fixModal.hidden = true; refocus(); }
async function submitFix() {
  const driverId = parseInt(fixPilot.value, 10);
  const ms = clockToMs(fixTime.value);
  if (!driverId || !Number.isFinite(ms) || ms <= 0) { toast('error', LANG === 'es' ? 'Tiempo no válido' : 'Invalid time'); return; }
  try {
    const res = await fetch(`/races/${RACE_ID}/mangas/${MANGA_ID}/correct-time`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ driver_id: driverId, ms }),
    });
    const data = await res.json().catch(() => ({}));
    if (res.ok && data.ok) {
      toast('ok', `${LANG === 'es' ? 'Tiempo añadido' : 'Time added'}: ${data.driverName} +${msToClock(ms)}`);
      closeFix();
      setTimeout(() => location.reload(), 400);
    } else {
      toast('error', data.error || 'Error');
    }
  } catch (e) { toast('error', e.message || 'Network error'); }
}
document.addEventListener('click', e => {
  const btn = e.target.closest && e.target.closest('.sc-lane__fix');
  if (btn) { e.preventDefault(); openFix(parseInt(btn.dataset.lane, 10)); }
});
document.getElementById('scFixClose').addEventListener('click', closeFix);
document.getElementById('scFixCancel').addEventListener('click', closeFix);
document.getElementById('scFixSubmit').addEventListener('click', submitFix);
fixTime.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); submitFix(); } });
fixModal.addEventListener('click', e => { if (e.target === fixModal) closeFix(); });
document.addEventListener('keydown', e => { if (e.key === 'Escape' && !fixModal.hidden) closeFix(); });

// ── Lector por webcam (jsQR) — modo quiosco embebido ──────────────
// La cámara se queda fija en un dock al lado del panel, escaneando en
// continuo, para que los pilotos se fichen de forma autónoma. Su estado
// (on/off) se recuerda en localStorage y se auto-arranca al cargar.
// Reutiliza el mismo endpoint de check-in; el lector USB-HID sigue activo.
const camBtn     = document.getElementById('scCamBtn');
const kioskWrap  = document.getElementById('scKiosk');
const camDock    = document.getElementById('scCamDock');
const camVideo   = document.getElementById('scCamVideo');
const camSwitch  = document.getElementById('scCamSwitch');
const camStatus  = document.getElementById('scCamStatus');
const camReticle = document.getElementById('scCamReticle');
const camHint    = document.getElementById('scCamHint');
const CAM_PREF   = 'sc_cam_kiosk';
let camStream = null, camRAF = null, camCanvas = null, camCtx = null;
let camDevices = [], camDeviceIdx = 0;
let camLastCode = '', camLastTs = 0;
let camOn = false;

function camSetStatus(t) { if (camStatus) camStatus.textContent = t; }

// Pide a la cámara enfoque/exposición/balance automáticos y continuos.
// No todas las webcams lo exponen (muchas son de foco fijo): en ese caso es
// un no-op silencioso y avisamos para que acerquen el QR ~15-20 cm.
async function camApplyFocus() {
  try {
    const track = camStream && camStream.getVideoTracks ? camStream.getVideoTracks()[0] : null;
    if (!track || !track.getCapabilities) return;
    const caps = track.getCapabilities();
    const adv = [];
    if (caps.focusMode && caps.focusMode.includes('continuous'))               adv.push({ focusMode: 'continuous' });
    if (caps.exposureMode && caps.exposureMode.includes('continuous'))         adv.push({ exposureMode: 'continuous' });
    if (caps.whiteBalanceMode && caps.whiteBalanceMode.includes('continuous')) adv.push({ whiteBalanceMode: 'continuous' });
    if (adv.length) await track.applyConstraints({ advanced: adv });
    if (camHint) {
      const hasAF = caps.focusMode && caps.focusMode.includes('continuous');
      camHint.textContent = LANG === 'es'
        ? (hasAF ? 'Apunta la cámara al QR del piloto'
                 : 'Cámara de foco fijo: acerca el QR a ~15-20 cm y mantenlo firme')
        : (hasAF ? 'Point the camera at the pilot QR'
                 : 'Fixed-focus camera: hold the QR ~15-20 cm away and steady');
    }
  } catch (e) { /* sin soporte de constraints avanzados: ignoramos */ }
}
function camFlash() {
  if (!camReticle) return;
  camReticle.classList.add('is-hit');
  setTimeout(() => camReticle.classList.remove('is-hit'), 350);
}

async function camStart(deviceId) {
  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
    camSetStatus(LANG === 'es' ? 'Cámara no disponible en este navegador' : 'Camera not available in this browser');
    return;
  }
  if (!window.isSecureContext) {
    camSetStatus(LANG === 'es'
      ? 'La cámara necesita HTTPS o localhost (no funciona abriendo por IP de red)'
      : 'Camera needs HTTPS or localhost (does not work over a network IP)');
    return;
  }
  try {
    // Pedimos resolución alta: un QR con más píxeles se decodifica mucho mejor.
    const videoCfg = deviceId
      ? { deviceId: { exact: deviceId } }
      : { facingMode: { ideal: 'environment' } };
    videoCfg.width  = { ideal: 1280 };
    videoCfg.height = { ideal: 720 };
    camStream = await navigator.mediaDevices.getUserMedia({ video: videoCfg });
    camVideo.srcObject = camStream;
    await camVideo.play();
    camSetStatus(LANG === 'es' ? 'Escaneando…' : 'Scanning…');
    // Autoenfoque continuo (+ exposición/balance auto) si la cámara lo soporta.
    await camApplyFocus();
    // Con permiso ya concedido, los labels de las cámaras están disponibles.
    if (!camDevices.length) {
      const devs = await navigator.mediaDevices.enumerateDevices();
      camDevices = devs.filter(d => d.kind === 'videoinput');
      camSwitch.style.display = camDevices.length > 1 ? '' : 'none';
    }
    camCanvas = camCanvas || document.createElement('canvas');
    camCtx = camCtx || camCanvas.getContext('2d', { willReadFrequently: true });
    cancelAnimationFrame(camRAF);
    camLoop();
  } catch (err) {
    const map = {
      NotAllowedError:  LANG === 'es' ? 'Permiso de cámara denegado' : 'Camera permission denied',
      NotFoundError:    LANG === 'es' ? 'No se encontró ninguna cámara' : 'No camera found',
      NotReadableError: LANG === 'es' ? 'La cámara está en uso por otra app' : 'Camera is in use by another app',
    };
    camSetStatus(map[err.name] || ((LANG === 'es' ? 'Error de cámara: ' : 'Camera error: ') + (err.message || err.name)));
  }
}

function camLoop() {
  camRAF = requestAnimationFrame(camLoop);
  if (camVideo.readyState !== camVideo.HAVE_ENOUGH_DATA) return;
  const w = camVideo.videoWidth, h = camVideo.videoHeight;
  if (!w || !h) return;
  camCanvas.width = w; camCanvas.height = h;
  camCtx.drawImage(camVideo, 0, 0, w, h);
  let img;
  try { img = camCtx.getImageData(0, 0, w, h); } catch (e) { return; }
  const result = jsQR(img.data, w, h, { inversionAttempts: 'dontInvert' });
  if (!result || !result.data) return;
  const code = result.data.trim();
  // Solo nos interesan los QR de piloto (DRV:<id>); ignoramos otros códigos.
  if (!/^DRV:/i.test(code)) return;
  const now = Date.now();
  // Anti-rebote: no reenviar el mismo código en una ráfaga de frames.
  if (code === camLastCode && now - camLastTs < 3000) return;
  camLastCode = code; camLastTs = now;
  camFlash();
  submitCode(code);
}

function camStopStream() {
  if (camRAF) { cancelAnimationFrame(camRAF); camRAF = null; }
  if (camStream) { camStream.getTracks().forEach(t => t.stop()); camStream = null; }
  if (camVideo) camVideo.srcObject = null;
}

// Activa el dock de cámara (modo quiosco). persist=false al auto-arrancar.
function camEnable(persist) {
  camOn = true;
  camDock.hidden = false;
  kioskWrap.classList.add('is-cam');
  camBtn.classList.add('is-active');
  camBtn.setAttribute('aria-pressed', 'true');
  if (persist !== false) { try { localStorage.setItem(CAM_PREF, '1'); } catch (e) {} }
  camLastCode = ''; camLastTs = 0;
  camStart();
  setTimeout(() => { if (window.scRemeasure) window.scRemeasure(); }, 60);
}

function camDisable(persist) {
  camOn = false;
  camStopStream();
  camDock.hidden = true;
  kioskWrap.classList.remove('is-cam');
  camBtn.classList.remove('is-active');
  camBtn.setAttribute('aria-pressed', 'false');
  if (persist !== false) { try { localStorage.removeItem(CAM_PREF); } catch (e) {} }
  refocus();
  setTimeout(() => { if (window.scRemeasure) window.scRemeasure(); }, 60);
}

camBtn.addEventListener('click', () => { camOn ? camDisable() : camEnable(); });
camSwitch.addEventListener('click', async () => {
  if (camDevices.length < 2) return;
  camDeviceIdx = (camDeviceIdx + 1) % camDevices.length;
  camStopStream();
  await camStart(camDevices[camDeviceIdx].deviceId);
});
window.addEventListener('beforeunload', camStopStream);

// Auto-arranque del quiosco: si quedó activada y el contexto es seguro,
// la cámara se enciende sola al cargar (tras el primer permiso concedido).
(function () {
  let pref = false;
  try { pref = localStorage.getItem(CAM_PREF) === '1'; } catch (e) {}
  if (pref && window.isSecureContext) camEnable(false);
})();

// ── Toast ─────────────────────────────────────────────────────────
const toastWrap = document.getElementById('scToasts');
function toast(kind, text) {
  const el = document.createElement('div');
  el.className = 'sc-toast sc-toast--' + kind;
  el.textContent = text;
  toastWrap.appendChild(el);
  setTimeout(() => el.classList.add('sc-toast--out'), 3500);
  setTimeout(() => el.remove(), 4500);
}

// ── Socket: ticks de turnos + driver_checkin + manga state ────────
const socket = io({ transports: ['websocket', 'polling'] });

socket.on('shifts:tick', data => {
  if (!data || data.mangaId !== MANGA_ID) return;
  const active = data.active || {};
  document.querySelectorAll('.sc-lane').forEach(card => {
    const lane = parseInt(card.dataset.lane, 10);
    const a = active[lane];
    const cell = card.querySelector('[data-shift-ms]');
    if (a && cell) {
      cell.dataset.shiftMs = a.drivingMs;
      cell.textContent = fmtTime(a.drivingMs);
    }
  });
});

socket.on('tick', data => {
  if (!data) return;
  const remEl = document.getElementById('scRemaining');
  if (remEl && data.remainingMs != null) {
    const locked = data.remainingMs <= LOCKOUT_MS && data.remainingMs > 0;
    remEl.textContent = (LANG === 'es' ? 'Restante: ' : 'Remaining: ') + fmtTime(data.remainingMs);
    remEl.classList.toggle('sc-locked', locked);
  }
});

socket.on('driver_checkin', data => {
  if (!data || data.mangaId !== MANGA_ID) return;
  // Para mantener simple, recargamos tras un cambio. Si quieres hot-update,
  // se puede sustituir por mutación directa del DOM.
  setTimeout(() => location.reload(), 300);
});

['manga:started', 'manga:paused', 'manga:cancelled', 'manga:stopped'].forEach(ev => {
  socket.on(ev, () => setTimeout(() => location.reload(), 500));
});

</script>

<!-- Paginación automática en bloque aislado: aunque algo del script
     principal fallara, la rotación de páginas sigue funcionando. -->
<script>
(function () {
  // Muestra una "página" de elementos a la vez y rota cada intervalo. El nº
  // por página se mide según el alto visible (se adapta a la pantalla).
  function makePager(viewport, container, indicator, intervalMs) {
    if (!viewport || !container) return null;
    const items = Array.from(container.children);
    if (!items.length) return null;
    let pageSize = items.length, pages = 1, page = 0;
    function fits() {
      items.forEach(it => { it.style.display = ''; });
      const ch = viewport.clientHeight;
      if (!ch) return items.length;               // aún sin layout: reintentaremos
      const top = viewport.getBoundingClientRect().top;
      let n = 0;
      for (const it of items) {
        const r = it.getBoundingClientRect();
        if (r.bottom - top <= ch) n++; else break;   // estricto: solo filas 100% visibles
      }
      return Math.max(1, n);
    }
    function render() {
      const start = page * pageSize, end = start + pageSize;
      items.forEach((it, i) => { it.style.display = (i >= start && i < end) ? '' : 'none'; });
      if (indicator) indicator.textContent = pages > 1 ? (page + 1) + '/' + pages : '';
    }
    function measure() {
      pageSize = fits();
      pages = Math.max(1, Math.ceil(items.length / pageSize));
      if (page >= pages) page = 0;
      render();
    }
    measure();
    setInterval(() => { if (pages > 1) { page = (page + 1) % pages; render(); } }, intervalMs);
    return { measure };
  }

  // Ajusta la altura del bloque al viewport real (sin depender de un offset
  // fijo) → los paneles quedan acotados a lo visible y no hace falta scroll.
  function fitKioskHeight() {
    const k = document.getElementById('scKiosk');
    if (!k) return;
    const top = k.getBoundingClientRect().top;
    k.style.height = Math.max(360, Math.floor(window.innerHeight - top - 12)) + 'px';
  }
  fitKioskHeight();

  const lanePager   = makePager(document.getElementById('scLaneArea'),    document.getElementById('scLaneGrid'),    document.getElementById('scLaneInd'),   10000);
  const pilotsPager = makePager(document.getElementById('scPilotsPages'), document.getElementById('scPilotsPages'), document.getElementById('scPilotsInd'), 10000);
  function remeasure() { fitKioskHeight(); if (lanePager) lanePager.measure(); if (pilotsPager) pilotsPager.measure(); }
  window.scRemeasure = remeasure;

  // Re-medir cuando el layout ya está listo (carga, fuentes) y por si acaso
  // tras unos instantes; también al redimensionar / abrir-cerrar la cámara.
  window.addEventListener('load', remeasure);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(remeasure);
  setTimeout(remeasure, 300);
  setTimeout(remeasure, 1200);
  let _rzT; window.addEventListener('resize', () => { clearTimeout(_rzT); _rzT = setTimeout(remeasure, 200); });
})();
</script>
