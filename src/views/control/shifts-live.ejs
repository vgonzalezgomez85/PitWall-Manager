  .vt-page--shifts .sc-pilot-row { grid-template-columns: 1fr; gap: 6px; }
}

/* Feedback grande de fichaje (✓/✗) para el piloto */
.vt-page--shifts .sc-feedback {
  position: fixed; inset: 0; z-index: 11000;
  display: flex; align-items: center; justify-content: center;
  pointer-events: none;
}
.vt-page--shifts .sc-feedback[hidden] { display: none; }
.vt-page--shifts .sc-feedback__box {
  text-align: center; padding: 40px 64px; border-radius: 26px;
  backdrop-filter: blur(3px);
  transform: scale(.88); animation: scFbIn .16s ease-out forwards;
}
.vt-page--shifts .sc-feedback.is-out .sc-feedback__box { animation: scFbOut .3s ease-in forwards; }
.vt-page--shifts .sc-feedback.is-ok .sc-feedback__box {
  background: linear-gradient(180deg, rgba(34,197,94,.26), rgba(34,197,94,.12));
  border: 2px solid var(--vt-green); box-shadow: 0 0 80px -12px var(--vt-green);
}
.vt-page--shifts .sc-feedback.is-error .sc-feedback__box {
  background: linear-gradient(180deg, rgba(239,68,68,.26), rgba(239,68,68,.12));
  border: 2px solid var(--vt-red); box-shadow: 0 0 80px -12px var(--vt-red);
}
.vt-page--shifts .sc-feedback__icon { font-size: 92px; line-height: 1; font-weight: 700; }
.vt-page--shifts .sc-feedback.is-ok    .sc-feedback__icon { color: var(--vt-green); }
.vt-page--shifts .sc-feedback.is-error .sc-feedback__icon { color: var(--vt-red); }
.vt-page--shifts .sc-feedback__title {
  margin-top: 8px; font-family: 'Saira Condensed', sans-serif; font-weight: 700;
  font-size: 46px; letter-spacing: .02em; color: var(--vt-text);
}
.vt-page--shifts .sc-feedback__sub { margin-top: 6px; font-size: 24px; color: var(--vt-mute); }
@keyframes scFbIn  { to { transform: scale(1); } }
@keyframes scFbOut { to { opacity: 0; transform: scale(1.04); } }

/* Botón "corregir tiempo" en la card de carril */
.vt-page--shifts .sc-lane__fix {
  margin-left: auto; flex: 0 0 auto;
  width: 26px; height: 26px; border-radius: 7px; cursor: pointer;
  background: var(--vt-surface-2); border: 1px solid var(--vt-border);
  color: var(--vt-mute); font-size: 13px; line-height: 1;
  display: inline-flex; align-items: center; justify-content: center;
  transition: background .15s, color .15s, border-color .15s;
}
.vt-page--shifts .sc-lane__fix:hover { background: var(--vt-panel); color: var(--vt-blue); border-color: var(--vt-blue); }

/* Modal corregir tiempo */
.vt-page--shifts .sc-fix-modal {
  position: fixed; inset: 0; z-index: 11500;
  display: flex; align-items: center; justify-content: center;
  background: rgba(0,0,0,.6); backdrop-filter: blur(3px); padding: 20px;
}
.vt-page--shifts .sc-fix-modal[hidden] { display: none; }
.vt-page--shifts .sc-fix-box {
  width: min(420px, 100%); background: var(--vt-panel); border: 1px solid var(--vt-border);
  border-radius: 16px; padding: 18px 20px; box-shadow: 0 24px 60px -16px rgba(0,0,0,.85);
}
.vt-page--shifts .sc-fix-head {
  display: flex; align-items: center; justify-content: space-between; gap: 10px;
  font-family: 'Saira Condensed', sans-serif; font-weight: 700; font-size: 20px;
  letter-spacing: .04em; text-transform: uppercase; margin-bottom: 6px;
}
.vt-page--shifts .sc-fix-hint { color: var(--vt-mute); font-size: 13px; margin: 0 0 8px; }
.vt-page--shifts .sc-fix-lbl {
  display: block; font-size: 11px; letter-spacing: .08em; text-transform: uppercase;
  color: var(--vt-mute); margin: 10px 0 4px;
}
.vt-page--shifts .sc-fix-select, .vt-page--shifts .sc-fix-input {
  width: 100%; padding: 10px 12px; border-radius: 10px;
  background: var(--vt-surface-2); border: 1px solid var(--vt-border); color: var(--vt-text);
  font-size: 15px; font-family: inherit; box-sizing: border-box;
}
.vt-page--shifts .sc-fix-input { font-family: 'IBM Plex Mono', monospace; }
.vt-page--shifts .sc-fix-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 18px; }

/* Toasts */
.vt-page--shifts .sc-toast-wrap {
  position: fixed; bottom: 24px; right: 24px; z-index: 9999;
  display: flex; flex-direction: column; gap: 8px; max-width: 360px;
}
.vt-page--shifts .sc-toast {
  padding: 12px 16px; border-radius: 12px;
  font-family: 'Saira', sans-serif; font-weight: 600; font-size: 14px;
  color: #fff; box-shadow: 0 14px 28px -10px rgba(0,0,0,.8);
  transform: translateX(0); transition: transform .25s, opacity .25s;
  opacity: 1;
}
.vt-page--shifts .sc-toast--ok    { background: linear-gradient(180deg, #16a34a, #15803d); }
.vt-page--shifts .sc-toast--error { background: linear-gradient(180deg, var(--vt-red), var(--vt-red-deep)); }
.vt-page--shifts .sc-toast--out   { transform: translateX(20px); opacity: 0; }

/* Botón cámara */
.vt-page--shifts .sc-cam-btn {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 7px 14px; border-radius: 10px; cursor: pointer;
  background: var(--vt-surface-2); color: var(--vt-text);
  border: 1px solid var(--vt-border);
  font-family: 'Saira Condensed', sans-serif; font-weight: 700;
  letter-spacing: .08em; text-transform: uppercase; font-size: 13px;
  transition: background .15s, border-color .15s;
}
.vt-page--shifts .sc-cam-btn:hover { background: var(--vt-panel); border-color: var(--vt-blue); }
.vt-page--shifts .sc-cam-btn svg { width: 18px; height: 18px; }

/* Modo quiosco: cámara embebida (dock) junto al panel.
   (El layout/altura del .sc-kiosk se define más abajo con align-items:stretch;
   NO redefinir aquí .sc-kiosk.is-cam con flex-start, rompía la paginación.) */
.vt-page--shifts .sc-left { flex: 0 0 340px; width: 340px; display: flex; flex-direction: column; gap: 12px; }
.vt-page--shifts .sc-left .sc-scan-bar { flex-wrap: wrap; }
.vt-page--shifts .sc-left .sc-scan-bar .sc-cam-btn { flex: 1 1 100%; justify-content: center; margin-top: 2px; }
.vt-page--shifts .sc-cam-dock {
  width: 100%;
  background: var(--vt-panel); border: 1px solid var(--vt-border);
  border-radius: 16px; padding: 14px;
  box-shadow: 0 18px 44px -18px rgba(0,0,0,.7);
}
.vt-page--shifts .sc-cam-dock[hidden] { display: none; }
.vt-page--shifts .sc-cam-btn.is-active {
  background: var(--vt-blue); border-color: var(--vt-blue); color: #fff;
}
@media (max-width: 900px) {
  .vt-page--shifts .sc-kiosk.is-cam { flex-direction: column; }
  .vt-page--shifts .sc-cam-dock { position: static; width: 100%; flex-basis: auto; }
}
.vt-page--shifts .sc-cam-head {
  display: flex; align-items: center; gap: 12px; margin-bottom: 12px;
}
.vt-page--shifts .sc-cam-status {
  font-family: 'Saira Condensed', sans-serif; font-weight: 700;
  letter-spacing: .06em; text-transform: uppercase; font-size: 14px;
  color: var(--vt-text);
}
.vt-page--shifts .sc-cam-acts { display: flex; gap: 8px; margin-left: auto; }
.vt-page--shifts .sc-cam-view {
  position: relative; width: 100%; aspect-ratio: 4 / 3;
  background: #000; border-radius: 12px; overflow: hidden;
}
.vt-page--shifts .sc-cam-view video {
  width: 100%; height: 100%; object-fit: cover; display: block;
}
.vt-page--shifts .sc-cam-reticle {
  position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
  width: 56%; aspect-ratio: 1; border-radius: 16px;
  border: 3px solid rgba(255,255,255,.7);
  box-shadow: 0 0 0 9999px rgba(0,0,0,.25);
  transition: border-color .15s, box-shadow .15s;
}
.vt-page--shifts .sc-cam-reticle.is-hit {
  border-color: var(--vt-green);
  box-shadow: 0 0 0 9999px rgba(0,0,0,.25), 0 0 24px var(--vt-green);
}
.vt-page--shifts .sc-cam-hint {
  margin-top: 10px; text-align: center; color: var(--vt-mute);
  font-size: 13px;
}

/* ── Pantalla completa: sin márgenes laterales ───────────────────── */
.vt-page--shifts .vt-wrap { max-width: none; margin: 0; padding-left: 18px; padding-right: 18px; }

/* ── Layout a 3 zonas que llena el alto disponible ───────────────── */
.vt-page--shifts .sc-kiosk {
  display: flex; align-items: stretch; gap: 16px;
  height: calc(100vh - 150px);
}
.vt-page--shifts .sc-kiosk__main { flex: 1 1 auto; min-width: 0; min-height: 0; display: flex; flex-direction: column; }
.vt-page--shifts .sc-lane-head { display: flex; align-items: center; gap: 18px; margin-top: 12px; margin-bottom: 2px; }
.vt-page--shifts .sc-lane-head .sc-pages-ind { margin-left: auto; }
.vt-page--shifts .sc-legend { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
.vt-page--shifts .sc-legend__i { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; color: var(--vt-mute); text-transform: uppercase; letter-spacing: .05em; }
.vt-page--shifts .sc-legend__dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; flex: 0 0 auto; }
.vt-page--shifts .sc-lane-area { flex: 1 1 auto; min-height: 0; overflow: hidden; margin-top: 6px; }
.vt-page--shifts .sc-lane-area .sc-lane-grid { margin-top: 0; }
/* Alto uniforme → paginación limpia. El valor lo calcula la vista a partir del
   roster MÁS LARGO de la manga (--sc-lane-h), así nunca se corta el último
   piloto ni sobra hueco cuando los equipos son de tres. */
.vt-page--shifts .sc-lane { height: var(--sc-lane-h, 196px); overflow: hidden; }

/* Tarjeta de equipo en DESCANSO */
.vt-page--shifts .sc-lane--rest { border-style: dashed; }
.vt-page--shifts .sc-lane__num--rest { background: var(--vt-blue); color: #fff; }
.vt-page--shifts .sc-lane__rest-badge {
  margin: 12px 0 8px; padding: 7px 10px; border-radius: 8px;
  background: rgba(58,134,255,.14); color: var(--vt-blue);
  font-family: 'Saira Condensed', sans-serif; font-weight: 700;
  letter-spacing: .08em; text-transform: uppercase; font-size: 14px; text-align: center;
}

/* Roster del equipo dentro de la card: cada piloto con turnos + tiempo total */
.vt-page--shifts .sc-lane__roster {
  margin-top: 3px; padding-top: 4px; border-top: 1px solid var(--vt-border);
  display: flex; flex-direction: column; gap: 0;
}
/* 13.5px de fila: un equipo de 6 pilotos entra sin robarle una fila entera de
   tarjetas a la paginación. El alto real lo mide el script del final. */
.vt-page--shifts .sc-lane__rost {
  display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 5px; align-items: center;
  font-size: 11px; color: var(--vt-mute); padding: 0; height: 13.5px; line-height: 13.5px;
}
/* El nombre se queda con todo el sitio sobrante; si aun así no cabe, el título
   del div lo enseña entero al pasar el ratón. */
.vt-page--shifts .sc-lane__rost-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.vt-page--shifts .sc-lane__rost-runs { font-family: 'IBM Plex Mono', monospace; font-size: 10px; opacity: .8; }
.vt-page--shifts .sc-lane__rost-time {
  font-family: 'IBM Plex Mono', monospace; color: var(--vt-text);
  min-width: 40px; text-align: right; font-variant-numeric: tabular-nums;
}
/* El piloto que conduce ahora, resaltado */
.vt-page--shifts .sc-lane__rost.is-now .sc-lane__rost-name { color: var(--vt-text); font-weight: 600; }
.vt-page--shifts .sc-lane__rost.is-now .sc-lane__rost-name::before { content: '▶ '; color: var(--vt-blue); }
/* A punto de pasarse (tiempo o turnos) → ámbar; pasado → rojo */
.vt-page--shifts .sc-lane__rost.is-near .sc-lane__rost-name,
.vt-page--shifts .sc-lane__rost.is-near .sc-lane__rost-runs,
.vt-page--shifts .sc-lane__rost.is-near .sc-lane__rost-time { color: var(--vt-amber); }
.vt-page--shifts .sc-lane__rost.is-over .sc-lane__rost-name,
.vt-page--shifts .sc-lane__rost.is-over .sc-lane__rost-runs,
.vt-page--shifts .sc-lane__rost.is-over .sc-lane__rost-time { color: var(--vt-red); }
/* Correcto (ok) → verde */
.vt-page--shifts .sc-lane__rost.is-ok .sc-lane__rost-name,
.vt-page--shifts .sc-lane__rost.is-ok .sc-lane__rost-runs,
.vt-page--shifts .sc-lane__rost.is-ok .sc-lane__rost-time { color: var(--vt-green); }
/* Aún por debajo del mínimo → lila */
.vt-page--shifts .sc-lane__rost.is-under .sc-lane__rost-name,
.vt-page--shifts .sc-lane__rost.is-under .sc-lane__rost-runs,
.vt-page--shifts .sc-lane__rost.is-under .sc-lane__rost-time { color: #c792ea; }

/* ── Panel lateral de pilotos (derecha), paginado ────────────────── */
.vt-page--shifts .sc-pilots-panel {
  flex: 0 0 340px; width: 340px;
  display: flex; flex-direction: column;
  background: var(--vt-panel-2); border: 1px solid var(--vt-border);
  border-radius: 14px; padding: 12px 12px 10px; overflow: hidden; min-height: 0;
}
.vt-page--shifts .sc-pilots-panel__head {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 8px; flex: 0 0 auto;
}
.vt-page--shifts .sc-pages-ind { font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: var(--vt-mute); }
.vt-page--shifts .sc-pilots-panel .sc-summary { flex: 1 1 auto; min-height: 0; overflow: hidden; display: block; }
/* Filas compactas para el panel estrecho */
.vt-page--shifts .sc-pilots-panel .sc-pilot-row {
  display: flex; align-items: center; gap: 8px;
  grid-template-columns: none; padding: 6px 9px; margin-bottom: 4px;
}
.vt-page--shifts .sc-pilots-panel .sc-pilot-row__name {
  flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 13px;
}
.vt-page--shifts .sc-pilots-panel .sc-pilot-row__bar { display: none; }
.vt-page--shifts .sc-pilots-panel .sc-pilot-row__runs { flex: 0 0 auto; }
.vt-page--shifts .sc-pilots-panel .sc-pilot-row__runs-n { font-size: 15px; }
.vt-page--shifts .sc-pilots-panel .sc-pilot-row__runs-l { display: none; }
.vt-page--shifts .sc-pilots-panel .sc-pilot-row__runs-max { font-size: 11px; }
.vt-page--shifts .sc-pilots-panel .sc-pilot-row__total {
  flex: 0 0 auto; font-family: 'IBM Plex Mono', monospace; font-size: 14px; min-width: 50px; text-align: right;
}
.vt-page--shifts .sc-pilots-panel .sc-pilot-row__total span { display: none; }
.vt-page--shifts .sc-pilots-panel .sc-pilot-row__status .vt-badge { padding: 2px 6px; font-size: 10px; }
.vt-page--shifts .sc-pilots-panel .sc-pilot-row__status .vt-badge__d { display: none; }

@media (max-width: 1100px) {
  .vt-page--shifts .sc-kiosk { flex-direction: column; height: auto; }
  .vt-page--shifts .sc-lane-area { overflow: visible; }
  .vt-page--shifts .sc-left { width: 100%; flex-basis: auto; }
  .vt-page--shifts .sc-left .sc-scan-bar .sc-cam-btn { flex: 0 0 auto; margin-top: 0; }
  .vt-page--shifts .sc-pilots-panel { width: 100%; flex-basis: auto; max-height: 320px; }
}
</style>

