<%- include('../partials/header', { pageTitle: t('importtanda.titulo') }) %>
<div class="container container--narrow">
  <a href="/races" class="vt-back-link" style="margin-top:1rem">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    <%= t('importtanda.carreras') %>
  </a>
  <h1 class="page-title"><%= t('importtanda.h1') %></h1>
  <p class="form-hint" style="margin:-.4rem 0 1rem">
    <%= t('importtanda.intro') %>
  </p>

  <div id="result"></div>

  <form id="importForm" class="form-card">
    <div class="form-group">
      <label class="form-label" for="file"><%= t('importtanda.fichero') %></label>
      <input class="form-input" id="file" name="file" type="file" accept=".json,application/json" required>
      <p class="form-hint"><%- t('importtanda.fichero_d') %></p>
    </div>
    <div class="form-group">
      <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer">
        <input type="checkbox" id="hasPole">
        <span><%- t('importtanda.tiene_pole') %></span>
      </label>
      <p class="form-hint"><%- t('importtanda.pole_d') %></p>
    </div>
    <div class="form-actions">
      <button type="submit" class="vt-btn vt-btn--primary"><%= t('importtanda.crear') %></button>
    </div>
  </form>

  <div class="form-card" style="margin-top:1.25rem">
    <h2 class="form-label" style="margin-bottom:.35rem"><%= t('importtanda.red_h') %></h2>
    <p class="form-hint" style="margin:0 0 .6rem">
      <%= t('importtanda.red_d') %>
    </p>
    <div style="font-size:2rem;font-weight:700;letter-spacing:.35rem;text-align:center;padding:.5rem 0">
      <%= pin %>
    </div>
    <p class="form-hint" style="text-align:center;margin:.2rem 0 0">
      <%= t('importtanda.localhost') %>
    </p>
  </div>
</div>

<script>
(function () {
  var form = document.getElementById('importForm');
  var fileInput = document.getElementById('file');
  var result = document.getElementById('result');

  function show(kind, html) {
    result.innerHTML = '<div class="alert alert--' + kind + '">' + html + '</div>';
  }

  form.addEventListener('submit', function (ev) {
    ev.preventDefault();
    result.innerHTML = '';
    var f = fileInput.files && fileInput.files[0];
    if (!f) { show('error', '<p>' + I18N.t('client.importtanda.selecciona') + '</p>'); return; }

    var reader = new FileReader();
    reader.onload = function () {
      var payload;
      try { payload = JSON.parse(reader.result); }
      catch (e) { show('error', '<p>' + I18N.t('client.importtanda.no_json') + '</p>'); return; }

      // El checkbox manda: marcado activa la pole; si no, se respeta el fichero.
      if (document.getElementById('hasPole').checked) payload.pole = true;

      fetch('/import/tanda', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
      .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
      .then(function (res) {
        if (res.ok && res.j.ok) {
          show('success',
            '<p>' + I18N.t('client.importtanda.creada', { nombre: res.j.name || '', tandas: res.j.tandas, equipos: res.j.teams }) + '</p>' +
            '<p><a class="vt-btn vt-btn--primary" href="' + res.j.url + '">' + I18N.t('client.importtanda.abrir') + '</a></p>');
        } else {
          show('error', '<p>' + (res.j.error || I18N.t('client.importtanda.no_se_pudo')) + '</p>');
        }
      })
      .catch(function () { show('error', '<p>' + I18N.t('client.importtanda.error_red') + '</p>'); });
    };
    reader.readAsText(f);
  });
})();
</script>
<%- include('../partials/footer') %>
