<%- include('../partials/header', { pageTitle: 'Estadísticas en vivo' }) %>

<div class="container container--narrow">
  <a href="/" class="vt-back-link" style="margin-top:1rem">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    <%= lang === 'es' ? 'Inicio' : 'Home' %>
  </a>
  <div class="page-header">
    <h1 class="page-title">📊 <%= lang === 'es' ? 'Estadísticas en vivo' : 'Live stats' %></h1>
    <p style="color:#8b949e; margin-top:.3rem">
      <%= lang === 'es'
        ? 'Elige la carrera activa que quieres seguir en directo.'
        : 'Pick the active race you want to follow live.' %>
    </p>
  </div>

  <% const poleRacesList = typeof poleRaces !== 'undefined' ? poleRaces : []; %>

  <% if (typeof noLive !== 'undefined' && noLive) { %>
    <div class="ls-nolive">
      <div class="ls-nolive__icon">🏁</div>
      <p class="ls-nolive__title"><%= lang === 'es' ? 'No hay ninguna carrera en directo ahora mismo.' : 'No race is live right now.' %></p>
      <p class="ls-nolive__sub"><%= lang === 'es' ? 'Cuando se dé el GO a una carrera, aparecerá aquí automáticamente.' : 'When a race gets the GO, it will appear here automatically.' %></p>
    </div>
  <% } else { %>
    <% if (poleRacesList.length > 0) { %>
      <p class="ls-section-title"><%= lang === 'es' ? '🏁 Pole en directo' : '🏁 Pole live' %></p>
      <div class="ls-race-list" style="margin-bottom:1.4rem">
        <% poleRacesList.forEach(r => { %>
          <a href="/races/<%= r.id %>/pole/timing" class="ls-race-card">
            <div class="ls-race-card__name"><%= r.name %></div>
            <div class="ls-race-card__meta">
              <span class="ls-race-card__status ls-race-card__status--active"><%= lang === 'es' ? 'pole en curso' : 'pole in progress' %></span>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
    <% if (races.length > 0) { %>
      <div class="ls-race-list">
        <% races.forEach(r => { %>
          <a href="/races/<%= r.id %>/live-stats" class="ls-race-card">
            <div class="ls-race-card__name"><%= r.name %></div>
            <div class="ls-race-card__meta">
              <span class="ls-race-card__status ls-race-card__status--<%= r.status %>"><%= r.status %></span>
              <% if (r.created_at) { %>
                <span style="margin-left:.5rem"><%= new Date(r.created_at).toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-GB') %></span>
              <% } %>
            </div>
          </a>
        <% }) %>
      </div>
    <% } else if (poleRacesList.length === 0) { %>
      <p style="color:#8b949e">
        <%= lang === 'es' ? 'No hay carreras creadas todavía.' : 'No races created yet.' %>
      </p>
    <% } %>
  <% } %>
</div>

<style>
  .ls-section-title { font-size:.8rem; font-weight:700; text-transform:uppercase; letter-spacing:.04em; color:#8b949e; margin:1.4rem 0 .5rem }
  .ls-race-list { display:flex; flex-direction:column; gap:.6rem; margin-top:1.2rem }
  .ls-race-card { display:block; background:#161b22; border:1px solid #30363d; border-radius:10px; padding:.9rem 1.1rem; color:#c9d1d9; text-decoration:none; transition: border-color .15s }
  .ls-race-card:hover { border-color:#58a6ff; text-decoration:none }
  .ls-race-card__name { font-weight:600; font-size:1.05rem }
  .ls-race-card__meta { font-size:.78rem; color:#6e7681; margin-top:.2rem }
  .ls-race-card__status { display:inline-block; padding:1px 7px; border-radius:9px; font-size:.7rem; font-weight:700; text-transform:uppercase; background:#21262d; color:#8b949e }
  .ls-race-card__status--active { background:rgba(46,160,67,.18); color:#3fb950 }
  .ls-race-card__status--finished { background:rgba(88,166,255,.15); color:#58a6ff }
  .ls-nolive { text-align:center; margin-top:2.5rem; color:#8b949e }
  .ls-nolive__icon { font-size:3rem; opacity:.6 }
  .ls-nolive__title { color:#e6edf3; font-size:1.15rem; font-weight:600; margin:.8rem 0 .3rem }
  .ls-nolive__sub { font-size:.9rem }
</style>

<% if (typeof noLive !== 'undefined' && noLive) { %>
<script src="/socket.io/socket.io.js"></script>
<script>
  // Cuando arranque una carrera (GO), recargamos: el index redirige solo a la
  // carrera en directo. view=livestats para pasar el gate de acceso.
  const socket = io({ query: { view: 'livestats' } });
  socket.on('manga:started', () => location.reload());
  socket.on('training:autostart', () => location.reload());
</script>
<% } %>

<%- include('../partials/footer') %>
