<%- include('../partials/header', { pageTitle: lang === 'es' ? 'Conexión ecosistema' : 'Ecosystem connection' }) %>
<% const es = lang === 'es'; %>

<div class="vt-page st-page st-page--solo">
  <div class="st-top">
    <a href="/" class="vt-back-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      <%= es ? 'Inicio' : 'Home' %>
    </a>
    <span class="st-top__sep"></span>
    <h1 class="st-top__h"><%= es ? 'Conexión ecosistema' : 'Ecosystem connection' %></h1>
    <span class="st-top__fill"></span>
    <div class="vt-port-pill <%= enabled ? '' : 'is-sim' %>">
      <span class="dot"></span> <%= enabled ? (es ? 'Control puede conectarse' : 'Control can connect') : (es ? 'Control bloqueado' : 'Control blocked') %>
    </div>
  </div>

  <div class="st-solo">
    <header class="st-sec__h">
      <h2><%= es ? 'Puente con PitWall Control' : 'PitWall Control bridge' %></h2>
      <p><%= es
        ? 'Controla si PitWall Control puede conectarse a este Manager por la red local para enviarnos información.'
        : 'Controls whether PitWall Control can connect to this Manager over the local network to send us information.' %></p>
    </header>

    <form method="POST" action="/ecosystem" class="st-card">
      <div class="st-row">
        <div class="db-ico">
          <svg viewBox="0 0 24 24"><path d="M5.5 11.5a9 9 0 0 1 13 0M8.5 14.5a5 5 0 0 1 7 0M12 18h.01"/></svg>
        </div>
        <div class="st-row__txt">
          <div class="st-row__t"><%= es ? 'Permitir que PitWall Control se conecte' : 'Allow PitWall Control to connect' %></div>
          <div class="st-row__d">
            <%= es
              ? 'Activado: Control puede enviarnos tandas por la red (con PIN) y leer los resultados de cada tanda. Desactivado: se rechaza cualquier conexión de Control desde otro dispositivo de la red. Este equipo y las IPs permitidas en Configuración no se ven afectados.'
              : 'Enabled: Control can send us rounds over the network (with a PIN) and read per-round results. Disabled: any connection from Control on another network device is rejected. This machine and the allowlisted IPs in Settings are not affected.' %>
          </div>
        </div>
        <button type="button" class="vt-switch <%= enabled ? 'is-on' : '' %>" id="ecoSwitch" role="switch" aria-checked="<%= !!enabled %>" aria-label="<%= es ? 'Permitir que PitWall Control se conecte' : 'Allow PitWall Control to connect' %>"></button>
        <input type="hidden" name="ecosystem_control_enabled" id="ecoInput" value="<%= enabled ? '1' : '' %>">
      </div>
      <div class="st-row">
        <span class="st-top__fill"></span>
        <button type="submit" class="vt-btn vt-btn--primary"><%= es ? 'Guardar' : 'Save' %></button>
      </div>
    </form>

    <header class="st-sec__h eco-gap">
      <h2><%= es ? 'PIN de emparejamiento' : 'Pairing PIN' %></h2>
      <p><%= es
        ? 'Cuando Control se conecta desde otro dispositivo de la red, tiene que introducir este PIN.'
        : 'When Control connects from another device on the network, it has to enter this PIN.' %></p>
    </header>

    <div class="st-card">
      <div class="eco-pin"><%= pin %></div>
      <div class="st-row">
        <div class="st-row__txt">
          <div class="st-row__d">
            <%= es ? '¿Sin red? También puedes importar una tanda a mano.' : 'No network? You can also import a round by hand.' %>
          </div>
        </div>
        <a class="vt-btn vt-btn--ghost vt-btn--sm" href="/import/tanda"><%= es ? 'Importar tanda' : 'Import round' %></a>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  var sw  = document.getElementById('ecoSwitch');
  var inp = document.getElementById('ecoInput');
  if (sw && inp) {
    sw.addEventListener('click', function () {
      var on = sw.classList.toggle('is-on');
      sw.setAttribute('aria-checked', on ? 'true' : 'false');
      inp.value = on ? '1' : '';
    });
  }
})();
</script>

<%- include('../partials/footer') %>
