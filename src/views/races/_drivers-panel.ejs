<%
  const fmtLap = (ms) => ms == null ? '—' : (ms / 1000).toFixed(3).replace('.', ',');
  const fmtDrive = (ms) => {
    if (!ms) return '—';
    const min = Math.round(ms / 60000);
    return Math.floor(min / 60) + ':' + String(min % 60).padStart(2, '0') + ' h';
  };
  const fmtNum1 = (v) => v == null ? '—' : v.toFixed(1).replace('.', ',');
  const fmtPct = (v) => v == null ? '—' : v.toFixed(1).replace('.', ',') + ' %';
  const ds = driverStats;
  const partial = ds.fromShifts && ds.mangasWithShifts < ds.mangasRaced;
  const allDrivers = [];
  ds.teams.forEach(tm => tm.drivers.forEach(d => { if (d.laps > 0) allDrivers.push({ ...d, team: tm.name, color: tm.color }); }));
  allDrivers.sort((a, b) => (a.bestMs ?? Infinity) - (b.bestMs ?? Infinity));
  const row = (d) => `
        <td class="dp-num" data-v="${d.drivingMs || 0}">${fmtDrive(d.drivingMs)}</td>
        <td class="dp-num" data-v="${d.mangas}">${d.mangas || '—'}</td>
        <td class="dp-num" data-v="${d.laps}">${d.laps}</td>
        <td class="dp-num" data-v="${d.lapsPerHour ?? -1}">${fmtNum1(d.lapsPerHour)}</td>
        <td class="dp-num dp-time" data-v="${d.bestMs ?? 1e12}">${fmtLap(d.bestMs)}</td>
        <td class="dp-num dp-time" data-v="${d.avgMs ?? 1e12}">${fmtLap(d.avgMs)}</td>
        <td class="dp-num" data-v="${d.consistency ?? -1}">${fmtPct(d.consistency)}</td>
        <td class="dp-num" data-v="${d.exits}">${d.exits || '—'}</td>
        <td class="dp-num" data-v="${d.pits}">${d.pits || '—'}</td>`;
  const head = `
        <th class="dp-num" data-sort="num">${t('_drivers-panel.al_volante')}</th>
        <th class="dp-num" data-sort="num">${t('_drivers-panel.mangas')}</th>
        <th class="dp-num" data-sort="num">${t('common.vueltas')}</th>
        <th class="dp-num" data-sort="num" title="${t('_drivers-panel.vph_title')}">${t('_drivers-panel.vph')}</th>
        <th class="dp-num" data-sort="num" data-asc="1">${t('_drivers-panel.mejor')}</th>
        <th class="dp-num" data-sort="num" data-asc="1">${t('_drivers-panel.media')}</th>
        <th class="dp-num" data-sort="num" title="${t('_drivers-panel.const_title')}">${t('_drivers-panel.const')}</th>
        <th class="dp-num" data-sort="num">${t('_drivers-panel.salidas')}</th>
        <th class="dp-num" data-sort="num">${t('_drivers-panel.pits')}</th>`;
%>
<div class="dp" id="driversPanel">
  <div class="dp__head">
    <span class="dp__title"><%= t('_drivers-panel.titulo') %></span>
    <% if (ds.fromShifts) { %>
      <span class="dp__meta"><%= t('_drivers-panel.fichaje_cubre', { n: ds.mangasWithShifts, m: ds.mangasRaced }) %></span>
    <% } else { %>
      <span class="dp__meta"><%= t('_drivers-panel.piloto_de_cada_vuelta') %></span>
    <% } %>
    <div class="dp__toggle" role="group">
      <button type="button" class="dp__tbtn active" data-dp-view="teams"><%= t('_drivers-panel.por_equipo') %></button>
      <button type="button" class="dp__tbtn" data-dp-view="all"><%= t('_drivers-panel.todos') %></button>
    </div>
  </div>
  <% if (partial) { %><p class="dp__note"><%= t('_drivers-panel.nota_sin_fichar') %></p><% } %>

  <div class="dp__wrap" data-dp-panel="teams">
    <table class="dp__table">
      <thead><tr><th><%= t('_drivers-panel.piloto') %></th><%- head %></tr></thead>
      <tbody>
        <% ds.teams.forEach(tm => { %>
          <tr class="dp__team">
            <td colspan="10">
              <span class="dp__pos"><%= tm.position %></span>
              <span class="dp__dot" style="background:<%= tm.color || '#8b949e' %>"></span>
              <span class="dp__tname"><%= tm.name %></span>
              <span class="dp__tlaps"><%= tm.totalLaps %> <%= t('common.vueltas').toLowerCase() %></span>
            </td>
          </tr>
          <% const teamBest = Math.min(...tm.drivers.map(d => d.bestMs ?? Infinity)); %>
          <% tm.drivers.forEach(d => { %>
          <tr class="<%= d.bestMs != null && d.bestMs === teamBest && tm.drivers.length > 1 ? 'is-teambest' : '' %>">
            <td class="dp__name"><%= d.name %></td><%- row(d) %>
          </tr>
          <% }) %>
          <% if (tm.unassigned) { %>
          <tr class="is-unassigned">
            <td class="dp__name"><%= t('_drivers-panel.sin_fichar') %></td><%- row(tm.unassigned) %>
          </tr>
          <% } %>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="dp__wrap" data-dp-panel="all" hidden>
    <table class="dp__table dp__table--sortable">
      <thead><tr>
        <th class="dp__rank">#</th>
        <th data-sort="text"><%= t('_drivers-panel.piloto') %></th>
        <th data-sort="text"><%= t('common.equipo') %></th><%- head %>
      </tr></thead>
      <tbody>
        <% allDrivers.forEach((d, i) => { %>
        <tr>
          <td class="dp__rank"><%= i + 1 %></td>
          <td class="dp__name" data-v="<%= d.name %>"><%= d.name %></td>
          <td class="dp__team-cell" data-v="<%= d.team %>"><span class="dp__dot" style="background:<%= d.color || '#8b949e' %>"></span><%= d.team %></td><%- row(d) %>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <p class="dp__note"><%= t('_drivers-panel.ordenar') %></p>
  </div>
</div>
<style>
  .dp{border:1px solid #21262d;border-radius:12px;background:#0d1117;overflow:hidden}
  .dp__head{display:flex;align-items:center;gap:1rem;flex-wrap:wrap;padding:.9rem 1.1rem;border-bottom:1px solid #21262d;background:#161b22}
  .dp__title{font-weight:700;color:#e6edf3}
  .dp__meta{font-size:.8rem;color:#8b949e}
  .dp__toggle{margin-left:auto;display:flex;gap:.25rem;background:#0d1117;border:1px solid #21262d;border-radius:8px;padding:.2rem}
  .dp__tbtn{background:none;border:0;color:#8b949e;font:inherit;font-size:.82rem;font-weight:600;padding:.3rem .7rem;border-radius:6px;cursor:pointer}
  .dp__tbtn.active{background:#21262d;color:#e6edf3}
  .dp__note{margin:0;padding:.6rem 1.1rem;font-size:.8rem;color:#8b949e;border-bottom:1px solid #21262d}
  .dp__wrap{overflow-x:auto}
  .dp__wrap[hidden]{display:none}
  .dp__table{width:100%;border-collapse:collapse;min-width:820px}
  .dp__table th{text-align:left;font-size:.72rem;text-transform:uppercase;letter-spacing:.04em;color:#8b949e;font-weight:600;padding:.6rem .8rem;border-bottom:1px solid #21262d;white-space:nowrap}
  .dp__table td{padding:.5rem .8rem;border-bottom:1px solid #161b22;color:#c9d1d9}
  .dp__table .dp-num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
  .dp__table .dp-time{font-family:'IBM Plex Mono',monospace}
  .dp__name{font-weight:600;color:#e6edf3;white-space:nowrap}
  .dp__team td{background:#161b22;padding:.55rem .8rem;border-top:1px solid #21262d}
  .dp__pos{display:inline-block;min-width:1.6rem;font-weight:700;color:#8b949e;font-variant-numeric:tabular-nums}
  .dp__dot{display:inline-block;width:.6rem;height:.6rem;border-radius:50%;margin-right:.45rem;vertical-align:middle}
  .dp__tname{font-weight:700;color:#e6edf3}
  .dp__tlaps{margin-left:.6rem;font-size:.8rem;color:#8b949e}
  .dp__table tr.is-teambest td:nth-child(6){color:#3fb950;font-weight:700}
  .dp__table tr.is-unassigned td{color:#6e7681;font-style:italic}
  .dp__rank{width:2.5rem;color:#8b949e;font-variant-numeric:tabular-nums}
  .dp__team-cell{white-space:nowrap}
  .dp__table--sortable th[data-sort]{cursor:pointer;user-select:none}
  .dp__table--sortable th[data-sort]:hover{color:#e6edf3}
  .dp__table--sortable th.is-sorted{color:#58a6ff}
</style>
<script>
  (function () {
    const root = document.getElementById('driversPanel');
    root.querySelectorAll('[data-dp-view]').forEach(btn => btn.addEventListener('click', () => {
      root.querySelectorAll('[data-dp-view]').forEach(b => b.classList.toggle('active', b === btn));
      root.querySelectorAll('[data-dp-panel]').forEach(p => { p.hidden = p.dataset.dpPanel !== btn.dataset.dpView; });
    }));
    const table = root.querySelector('.dp__table--sortable');
    if (!table) return;
    const heads = [...table.tHead.rows[0].cells];
    let current = null, asc = true;
    heads.forEach((th, col) => {
      if (!th.dataset.sort) return;
      th.addEventListener('click', () => {
        // Primer clic: tiempos y nombres de menor a mayor; el resto, de mayor a menor.
        asc = current === col ? !asc : (th.dataset.asc === '1' || th.dataset.sort === 'text');
        current = col;
        heads.forEach(h => h.classList.toggle('is-sorted', h === th));
        const rows = [...table.tBodies[0].rows];
        rows.sort((a, b) => {
          const va = a.cells[col].dataset.v, vb = b.cells[col].dataset.v;
          const r = th.dataset.sort === 'num' ? (+va - +vb) : String(va).localeCompare(String(vb));
          return asc ? r : -r;
        });
        rows.forEach((r, i) => { r.cells[0].textContent = i + 1; table.tBodies[0].appendChild(r); });
      });
    });
  })();
</script>
