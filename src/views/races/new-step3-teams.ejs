<%- include('../partials/header', { pageTitle: t('wizard.step3_teams_title') }) %>
<div class="container container--narrow">

  <%- include('../partials/wizard-progress', { current: 'sequence' }) %>

  <h1 class="page-title"><%= t('wizard.step3_teams_title') %></h1>
  <p class="page-subtitle"><%= wizard.name %> · <%= wizard.lanes_count %> <%= t('races.lanes') %></p>

  <% if (errors.length > 0) { %>
    <div class="alert alert--error">
      <% errors.forEach(e => { %><p><%= t('errors.' + e) %></p><% }) %>
    </div>
  <% } %>

  <form action="/races/new/step3" method="POST" class="form-card" id="teamForm">

    <div class="form-group">
      <label class="form-label" for="members_per_team">
        <%= t('wizard.members_per_team') %>
      </label>
      <div class="input-row">
        <input
          class="form-input form-input--sm <%= errors.includes('members_count_invalid') ? 'form-input--error' : '' %>"
          type="number" id="members_per_team" name="members_per_team"
          min="1" max="10"
          value="<%= body.members_per_team || 2 %>"
          required>
        <span class="form-hint"><%= t('wizard.members_hint') %></span>
      </div>
    </div>

    <div id="teamsContainer" class="teams-container">
      <% const COLORS = ['#e63946','#2196f3','#4caf50','#ff9800','#9c27b0','#00bcd4','#ff5722','#607d8b','#795548','#e91e63','#3f51b5','#009688','#cddc39','#ffc107','#f44336','#673ab7','#03a9f4','#8bc34a','#ff6f00','#880e4f','#1a237e','#b71c1c','#004d40','#f57f17','#311b92','#0d47a1','#1b5e20','#33691e','#bf360c','#4a148c','#006064','#827717']; %>
      <% for (let i = 0; i < wizard.lanes_count; i++) { %>
        <div class="team-block" data-lane="<%= i %>">
          <div class="team-block__header" style="border-left-color: <%= COLORS[i] %>">
            <div class="lane-badge" style="background: <%= COLORS[i] %>"><%= i + 1 %></div>
            <input
              class="form-input team-name-input"
              type="text"
              name="teams[<%= i %>][name]"
              placeholder="<%= t('wizard.team_name_ph') %>"
              autocomplete="off">
          </div>
          <div class="team-members" data-team="<%= i %>">
            <!-- populated by JS -->
          </div>
        </div>
      <% } %>
    </div>

    <div class="form-actions">
      <a href="/races/new/step2" class="btn btn--ghost">← <%= t('wizard.back') %></a>
      <button type="submit" class="btn btn--primary"><%= t('wizard.next') %> →</button>
    </div>

  </form>
</div>

<script>
const memberPlaceholder = "<%= t('wizard.member_ph') %>";
const memberLabel       = "<%= t('wizard.member_name') %>";
const lanesCount        = <%= wizard.lanes_count %>;

function renderMembers(count) {
  for (let i = 0; i < lanesCount; i++) {
    const container = document.querySelector(`[data-team="${i}"]`);
    container.innerHTML = '';
    for (let m = 0; m < count; m++) {
      const row = document.createElement('div');
      row.className = 'member-row';
      row.innerHTML = `
        <span class="member-num">${m + 1}</span>
        <input class="form-input" type="text"
          name="teams[${i}][members][${m}]"
          placeholder="${memberPlaceholder}"
          autocomplete="off">`;
      container.appendChild(row);
    }
  }
}

const membersInput = document.getElementById('members_per_team');
renderMembers(parseInt(membersInput.value) || 2);

membersInput.addEventListener('input', () => {
  const v = Math.min(10, Math.max(1, parseInt(membersInput.value) || 1));
  renderMembers(v);
});
</script>

<%- include('../partials/footer') %>
