<%- include('../partials/header', { pageTitle: t('sim.carrera_simulada') }) %>
<div class="container container--narrow">
  <a href="/races" class="vt-back-link" style="margin-top:1rem">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    <%= t('sim.carreras') %>
  </a>
  <h1 class="page-title"><%= t('sim.h1') %></h1>
  <p class="form-hint" style="margin:-.4rem 0 1rem">
    <%= t('sim.intro') %>
  </p>

  <% if (error) { %><div class="alert alert--error"><p><%= error %></p></div><% } %>

  <form action="/races/sim/analyze" method="POST" enctype="multipart/form-data" class="form-card">
    <div class="form-group">
      <label class="form-label" for="name"><%= t('sim.nombre_carrera') %></label>
      <input class="form-input" id="name" name="name" placeholder="<%= t('sim.ph_nombre') %>">
    </div>
    <div class="form-group">
      <label class="form-label" for="frames"><%= t('sim.fichero') %></label>
      <input class="form-input" id="frames" name="frames" type="file" accept=".txt,.csv" required>
      <p class="form-hint">
        <%- t('sim.ayuda_formatos') %>
      </p>
    </div>
    <div class="form-actions">
      <button type="submit" class="vt-btn vt-btn--primary"><%= t('sim.analizar') %></button>
    </div>
  </form>
</div>
<%- include('../partials/footer') %>
