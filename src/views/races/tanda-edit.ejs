<%- include('../partials/header', { pageTitle: t('tanda-edit.editar_tanda_2') }) %>

<link rel="stylesheet" href="/css/fonts.css">

<div class="pole-broadcast pole-broadcast--form">
<div class="pole-bcast-wrap pole-bcast-wrap--narrow">

  <a href="/races/<%= race.id %>" class="pole-back">← <%= t('common.volver_a_la_carrera') %></a>

  <div class="pole-title-row">
    <div class="pole-flag" aria-hidden="true"></div>
    <h1 class="pole-h1"><%= t('tanda-edit.editar_tanda') %> <%= tanda.number %></h1>
  </div>

  <div class="pole-meta">
    <span class="pole-meta-club"><%= race.name %></span>
    <span class="pole-dot"></span>
    <span><%= t('races.format.' + race.format) %></span>
    <span class="pole-dot"></span>
    <span class="pole-lane-badge">
      <%= t('common.carriles') %>
      <span class="pole-lane-num"><%= laneSequence.length %></span>
    </span>
  </div>

  <% if (!canRestructure) { %>
    <div class="alert" style="background:rgba(255,152,0,.08);border:1px solid rgba(255,152,0,.3);color:#ff9800;margin-bottom:1.25rem">
      <strong>⚠ <%= t('tanda-edit.modo_solo_renombrar') %></strong><br>
      <span style="font-size:.88rem">
        <%= t('tanda-edit.esta_tanda_ya_tiene_mangas_iniciadas_solo') %>
      </span>
    </div>
  <% } %>

  <% if (errors.length > 0) { %>
    <div class="alert alert--error">
      <% errors.forEach(e => { %><p><%= t('errors.' + e) %></p><% }) %>
    </div>
  <% } %>

  <div class="form-card">

    <div class="seq-display" style="margin-bottom:1.75rem">
      <span class="seq-display__label"><%= t('common.secuencia') %></span>
      <% laneSequence.forEach((lane, i) => { %>
        <% if (lane === 0) { %>
          <span class="seq-display__lane" style="background:#30363d;color:#8b949e;font-size:.65rem"><%= t('client.common.dsc') %></span>
        <% } else { %>
          <span class="seq-display__lane" style="background:<%= LANE_COLORS[lane-1] %>"><%= lane %></span>
        <% } %>
        <% if (i < laneSequence.length - 1) { %><span class="seq-display__arrow">→</span><% } %>
      <% }) %>
    </div>

    <% if (canRestructure) { %>
      <div id="restInfo" class="alert" style="display:none;background:rgba(88,166,255,.08);border:1px solid rgba(88,166,255,.25);color:#58a6ff;margin-bottom:1.25rem">
        <span id="restInfoText"></span>
      </div>
    <% } %>

    <form action="/races/<%= race.id %>/tandas/<%= tanda.id %>/edit" method="POST"
          <% if (canRestructure) { %>onsubmit="return confirm('<%= t('tanda-edit.guardar_cambios_se_regenerara_la_programacion') %>')"<% } %>>

      <% if (race.format === 'individual') { %>

        <p class="form-hint" style="margin-bottom:1.25rem">
          <% if (canRestructure) { %>
            <%= t('tanda-edit.minimo_v_pilotos_anade_mas_para_rotaciones_con', { v: laneSequence.length }) %>
          <% } else { %>
            <%= t('tanda-edit.modifica_los_nombres_de_los_pilotos') %>
          <% } %>
        </p>

<%
  // Orden de PANTALLA: carriles de menor a mayor y los descansos al final. La
  // posición en la secuencia (i) es la que decide el carril al guardar, así que
  // cada fila lleva su `i` real en el nombre del campo y no cambia nada.
  const slotOrder = (n) => [...Array(n).keys()].sort((a, b) => {
    const k = (i) => (i < laneSequence.length && laneSequence[i] > 0) ? [0, laneSequence[i]] : [i < laneSequence.length ? 1 : 2, i];
    const x = k(a), y = k(b);
    return x[0] - y[0] || x[1] - y[1];
  });
%>
        <div id="driversGrid" class="drivers-grid">
          <% slotOrder(drivers.length).forEach((i, pos) => {
               const d = drivers[i];
               const slotLane = i < laneSequence.length ? laneSequence[i] : 0;
               const slotColor = slotLane > 0 ? LANE_COLORS[(slotLane - 1) % LANE_COLORS.length] : '#30363d';
               // DSC1 = first to start racing (rests least at start)
               const restIdx = slotLane === 0 ? (drivers.length - i) : 0;
               const slotLabel = slotLane > 0
                 ? slotLane
                 : ((t('client.common.dsc')) + (restIdx > 0 ? restIdx : ''));
          %>
            <div class="driver-row participant-row" data-row="<%= pos %>">
              <span class="lane-badge participant-badge" style="background:<%= slotColor %>;<%= slotLane === 0 ? 'color:#8b949e;font-size:.65rem' : '' %>" data-index="<%= i %>"><%= slotLabel %></span>
              <div class="driver-field participant-fields">
                <% if (canRestructure) { %><span class="drag-handle" draggable="true" title="<%= t('client.tanda-edit.arrastrar_para_reordenar') %>">⠿</span><% } %>
                <% if (!canRestructure) { %>
                  <input type="hidden" name="drivers[<%= i %>][id]" value="<%= d.id %>">
                  <input class="form-input participant-name" type="text"
                         name="drivers[<%= i %>][name]" value="<%= d.name %>"
                         autocomplete="off" required>
                <% } else { %>
                  <input class="form-input participant-name" type="text"
                         name="drivers[<%= i %>][name]" value="<%= d.name %>"
                         autocomplete="off"
                         <%= i < laneSequence.length ? 'required' : '' %>>
                <% } %>
                <%- include('./_participant-attrs', { idxPrefix: 'drivers[' + i + ']',
                      showCat: race.has_categoria, showCar: race.has_coche,
                      categoria: d.categoria, coche: d.coche }) %>
              </div>
              <% if (canRestructure && i >= laneSequence.length) { %>
                <button type="button" class="btn btn--danger btn--sm remove-row" title="<%= t('client.common.eliminar') %>">✕</button>
              <% } %>
            </div>
          <% }) %>
        </div>

        <% if (canRestructure) { %>
          <button type="button" id="addDriver" class="btn btn--ghost btn--sm" style="margin-top:.75rem">
            + <%= t('client.common.anadir_piloto') %>
          </button>
        <% } %>

      <% } else { %>

        <p class="form-hint" style="margin-bottom:1.25rem">
          <% if (canRestructure) { %>
            <%= t('tanda-edit.minimo_v_equipos_anade_mas_para_rotaciones_con', { v: laneSequence.length }) %>
          <% } else { %>
            <%= t('tanda-edit.modifica_los_nombres_de_los_equipos_y_pilotos') %>
          <% } %>
        </p>

<%
  // Orden de PANTALLA: carriles de menor a mayor y los descansos al final. La
  // posición en la secuencia (i) es la que decide el carril al guardar, así que
  // cada fila lleva su `i` real en el nombre del campo y no cambia nada.
  const slotOrder = (n) => [...Array(n).keys()].sort((a, b) => {
    const k = (i) => (i < laneSequence.length && laneSequence[i] > 0) ? [0, laneSequence[i]] : [i < laneSequence.length ? 1 : 2, i];
    const x = k(a), y = k(b);
    return x[0] - y[0] || x[1] - y[1];
  });
%>
        <div id="teamsContainer" class="teams-container">
          <% slotOrder(teams.length).forEach((i, pos) => {
               const team = teams[i];
               const slotLane = i < laneSequence.length ? laneSequence[i] : 0;
               const slotColor = slotLane > 0 ? LANE_COLORS[(slotLane - 1) % LANE_COLORS.length] : '#30363d';
               const restIdx = slotLane === 0 ? (teams.length - i) : 0;
               const slotLabel = slotLane > 0
                 ? slotLane
                 : ((t('client.common.dsc')) + (restIdx > 0 ? restIdx : ''));
          %>
            <div class="team-block participant-row" data-row="<%= pos %>">
              <div class="team-block__header" style="border-left-color:<%= slotColor %>">
                <span class="lane-badge participant-badge" style="background:<%= slotColor %>;<%= slotLane === 0 ? 'color:#8b949e;font-size:.65rem' : '' %>" data-index="<%= i %>"><%= slotLabel %></span>
                <% if (canRestructure) { %><span class="drag-handle" draggable="true" title="<%= t('client.tanda-edit.arrastrar_para_reordenar') %>">⠿</span><% } %>
                <% if (!canRestructure) { %>
                  <input type="hidden" name="teams[<%= i %>][id]" value="<%= team.id %>">
                <% } %>
                <input class="form-input team-name-input" type="text"
                       name="teams[<%= i %>][name]" value="<%= team.name %>"
                       autocomplete="off" required>
                <% if (canRestructure && i >= laneSequence.length) { %>
                  <button type="button" class="btn btn--danger btn--sm remove-row" style="margin-left:.5rem">✕</button>
                <% } %>
              </div>
              <%- include('./_participant-attrs', { idxPrefix: 'teams[' + i + ']',
                    showCat: race.has_categoria, showCar: race.has_coche,
                    categoria: team.categoria, coche: team.coche }) %>
              <div class="team-members">
                <%
                  const existingMembers = team.members || [];
                  const totalSlots = canRestructure ? Math.max(existingMembers.length, 4) : existingMembers.length;
                %>
                <% for (let m = 0; m < totalSlots; m++) {
                     const member = existingMembers[m];
                %>
                  <div class="member-row">
                    <span class="member-num"><%= m + 1 %></span>
                    <% if (!canRestructure && member) { %>
                      <input type="hidden" name="teams[<%= i %>][members][<%= m %>][id]" value="<%= member.id %>">
                      <input class="form-input" type="text"
                             name="teams[<%= i %>][members][<%= m %>][name]"
                             value="<%= member.name %>" autocomplete="off">
                    <% } else { %>
                      <input class="form-input participant-name" type="text"
                             name="teams[<%= i %>][members][]"
                             placeholder="<%= t('wizard.member_ph') %> <%= m + 1 %><%= m === 0 ? '' : (' (' + t('wizard.optional') + ')') %>"
                             value="<%= member ? member.name : '' %>"
                             autocomplete="off"
                             <%= m === 0 && i < laneSequence.length ? 'required' : '' %>>
                    <% } %>
                  </div>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>

        <% if (canRestructure) { %>
          <button type="button" id="addTeam" class="btn btn--ghost btn--sm" style="margin-top:.75rem">
            + <%= t('tanda-edit.anadir_equipo') %>
          </button>
        <% } %>

      <% } %>

      <div class="form-actions pole-lanes-actions" style="margin-top:1.5rem">
        <a href="/races/<%= race.id %>" class="pole-btn-edit">← <%= t('wizard.back') %></a>
        <button type="submit" class="pole-btn-confirm pole-btn-confirm--save">
          💾 <%= t('common.guardar_cambios') %>
        </button>
      </div>

    </form>
  </div>

  <div class="pole-bcast-foot">
    <%= t('tanda-edit.edicion_de_tanda_arrastra_para_reordenar') %>
  </div>

</div>
</div>

<% if (canRestructure) { %>
<script>
const LANES     = <%= laneSequence.length %>;
const LANE_SEQ  = <%- JSON.stringify(laneSequence) %>;
const LANG      = "<%= lang %>";
const COLORS    = <%- JSON.stringify(LANE_COLORS) %>;
function slotLabel(i, total){
  if (i < LANE_SEQ.length && LANE_SEQ[i] > 0) return LANE_SEQ[i];
  const t = total ?? document.querySelectorAll('.participant-row').length;
  const restIdx = t - i;
  return (I18N.t('client.common.dsc')) + (restIdx > 0 ? restIdx : '');
}
function slotColor(i){ const l = i < LANE_SEQ.length ? LANE_SEQ[i] : 0; return l > 0 ? COLORS[(l-1) % COLORS.length] : '#30363d'; }
// Igual que slotOrder() de la plantilla: posición en pantalla → posición en la secuencia.
function slotOrder(n){
  const k = i => (i < LANE_SEQ.length && LANE_SEQ[i] > 0) ? [0, LANE_SEQ[i]] : [i < LANE_SEQ.length ? 1 : 2, i];
  return [...Array(n).keys()].sort((a, b) => { const x = k(a), y = k(b); return x[0] - y[0] || x[1] - y[1]; });
}
const DRIVER_PH = <%- JSON.stringify(t('wizard.driver_name_ph')) %>;
const TEAM_PH   = <%- JSON.stringify(t('wizard.team_name_ph')) %>;
const MEMBER_PH = <%- JSON.stringify(t('wizard.member_ph')) %>;
// Campos opcionales por participante (interruptores de la carrera).
const SHOW_CAT = <%= race.has_categoria ? 'true' : 'false' %>;
const SHOW_CAR = <%= race.has_coche ? 'true' : 'false' %>;
const CAT_PH   = <%- JSON.stringify(t('common.categoria_copa')) %>;
const CAR_PH   = <%- JSON.stringify(t('common.coche')) %>;
function attrsHtml(prefix) {
  if (!SHOW_CAT && !SHOW_CAR) return '';
  let h = '<div class="participant-attrs">';
  if (SHOW_CAT) h += `<input class="form-input participant-cat" type="text" name="${prefix}[categoria]" placeholder="${CAT_PH}" autocomplete="off">`;
  if (SHOW_CAR) h += `<input class="form-input participant-car" type="text" name="${prefix}[coche]" placeholder="${CAR_PH}" autocomplete="off">`;
  return h + '</div>';
}
const OPT_LBL   = <%- JSON.stringify(t('wizard.optional')) %>;

const ALL_PROFILES = <%- JSON.stringify(
  (profiles || []).map(p => ({ name: p.name, category: p.category }))
) %>;
const CAT_ICONS = { platino: '💎', oro: '🥇', plata: '🥈', bronce: '🥉' };

// ── Autocomplete ──────────────────────────────────────────────────────────────
const acDrop = document.createElement('div');
acDrop.className = 'ac-dropdown';
document.body.appendChild(acDrop);
let acTarget = null, acActive = -1;
function acItems() { return acDrop.querySelectorAll('.ac-item'); }
function acFilter(q) { return ALL_PROFILES.filter(p => p.name.toLowerCase().includes(q.toLowerCase())).slice(0, 10); }
function acShow(input, results) {
  if (!results.length) { acHide(); return; }
  acTarget = input; acActive = -1;
  const rect = input.getBoundingClientRect();
  acDrop.style.left  = (rect.left  + window.scrollX) + 'px';
  acDrop.style.top   = (rect.bottom + window.scrollY + 2) + 'px';
  acDrop.style.width = rect.width + 'px';
  acDrop.innerHTML = results.map(p =>
    `<div class="ac-item" data-name="${p.name}"><span class="ac-cat">${CAT_ICONS[p.category]||''}</span><span class="ac-name">${p.name}</span></div>`
  ).join('');
  acDrop.classList.add('ac-dropdown--open');
}
function acHide() { acDrop.classList.remove('ac-dropdown--open'); acTarget = null; acActive = -1; }
function acSelect(name) { if (acTarget) { acTarget.value = name; acTarget.dispatchEvent(new Event('input',{bubbles:true})); } acHide(); }
function acHighlight(idx) { acItems().forEach((el,i)=>el.classList.toggle('ac-item--active',i===idx)); if(acItems()[idx])acItems()[idx].scrollIntoView({block:'nearest'}); }
document.addEventListener('input', e => { if (e.target.classList.contains('participant-name')) acShow(e.target, acFilter(e.target.value)); });
document.addEventListener('keydown', e => {
  if (!acDrop.classList.contains('ac-dropdown--open')) return;
  if (e.key==='ArrowDown') { e.preventDefault(); acActive=Math.min(acActive+1,acItems().length-1); acHighlight(acActive); }
  else if (e.key==='ArrowUp') { e.preventDefault(); acActive=Math.max(acActive-1,0); acHighlight(acActive); }
  else if (e.key==='Enter'&&acActive>=0) { e.preventDefault(); acSelect(acItems()[acActive].dataset.name); }
  else if (e.key==='Escape') acHide();
});
acDrop.addEventListener('mousedown', e => { const item = e.target.closest('.ac-item'); if (item) { e.preventDefault(); acSelect(item.dataset.name); } });
document.addEventListener('focusout', e => { if (e.target.classList.contains('participant-name')) setTimeout(acHide, 150); });

// ── Rest info banner ──────────────────────────────────────────────────────────
function updateRestInfo() {
  const container = document.getElementById('driversGrid') || document.getElementById('teamsContainer');
  if (!container) return;
  const total = container.querySelectorAll('.participant-row').length;
  const info  = document.getElementById('restInfo');
  if (total > LANES) {
    document.getElementById('restInfoText').textContent = I18N.t('client.common.con_total_participantes_y_lanes_carriles_v', { total: total, LANES: LANES, v: total - LANES });
    info.style.display = '';
  } else { info.style.display = 'none'; }
}

function renumber(containerId) {
  const container = document.getElementById(containerId);
  if (!container) return;
  const isTeams = containerId === 'teamsContainer';
  const rows  = container.querySelectorAll('.participant-row');
  const order = slotOrder(rows.length);
  rows.forEach((row, pos) => {
    const i = order[pos];
    row.dataset.row = pos;
    const badge = row.querySelector('.participant-badge');
    if (badge) { badge.dataset.index = i; badge.textContent = slotLabel(i, rows.length); const color = slotColor(i); badge.style.background = color; if (isTeams) { const hdr = row.querySelector('.team-block__header'); if (hdr) hdr.style.borderLeftColor = color; } }
    if (!isTeams) {
      row.querySelectorAll('input').forEach(inp => {
        const key = inp.classList.contains('participant-name') ? 'name'
                  : inp.classList.contains('participant-cat')  ? 'categoria'
                  : inp.classList.contains('participant-car')  ? 'coche' : null;
        if (key) inp.name = `drivers[${i}][${key}]`;
      });
    } else {
      const nameInp = row.querySelector('.team-name-input');
      if (nameInp) nameInp.name = `teams[${i}][name]`;
      row.querySelectorAll('.team-members input').forEach(inp => { inp.name = `teams[${i}][members][]`; });
      const cat = row.querySelector('.participant-cat'); if (cat) cat.name = `teams[${i}][categoria]`;
      const car = row.querySelector('.participant-car'); if (car) car.name = `teams[${i}][coche]`;
    }
  });
  updateRestInfo();
}

document.getElementById('addDriver')?.addEventListener('click', () => {
  const grid = document.getElementById('driversGrid');
  const idx  = grid.querySelectorAll('.participant-row').length;
  const color = slotColor(idx);
  const div  = document.createElement('div');
  div.className = 'driver-row participant-row'; div.dataset.row = idx;
  div.innerHTML = `<span class="lane-badge participant-badge" style="background:${color}" data-index="${idx}">${slotLabel(idx)}</span>
    <div class="driver-field participant-fields" style="display:flex;flex:1;flex-wrap:wrap;align-items:center;gap:.5rem">
      <span class="drag-handle" draggable="true" title="${I18N.t('client.tanda-edit.arrastrar_para_reordenar')}">⠿</span>
      <input class="form-input participant-name" type="text" name="drivers[${idx}][name]" placeholder="${DRIVER_PH}" autocomplete="off" style="flex:1">
      ${attrsHtml(`drivers[${idx}]`)}
    </div>
    <button type="button" class="btn btn--danger btn--sm remove-row" title="${I18N.t('client.common.eliminar')}">✕</button>`;
  grid.appendChild(div);
  div.querySelector('.participant-name').focus();
  renumber('driversGrid');
  updateRestInfo();
});
document.getElementById('driversGrid')?.addEventListener('click', e => {
  if (e.target.classList.contains('remove-row')) { e.target.closest('.participant-row').remove(); renumber('driversGrid'); }
});

document.getElementById('addTeam')?.addEventListener('click', () => {
  const container = document.getElementById('teamsContainer');
  const idx = container.querySelectorAll('.participant-row').length;
  const color = slotColor(idx);
  const members = [0,1,2,3].map(m => `<div class="member-row"><span class="member-num">${m+1}</span><input class="form-input participant-name" type="text" name="teams[${idx}][members][]" placeholder="${MEMBER_PH} ${m+1}${m>0?' ('+OPT_LBL+')':''}" autocomplete="off"></div>`).join('');
  const block = document.createElement('div');
  block.className = 'team-block participant-row'; block.dataset.row = idx;
  block.innerHTML = `<div class="team-block__header" style="border-left-color:${color}">
    <span class="lane-badge participant-badge" style="background:${color}" data-index="${idx}">${slotLabel(idx)}</span>
    <span class="drag-handle" draggable="true" title="${I18N.t('client.tanda-edit.arrastrar_para_reordenar')}">⠿</span>
    <input class="form-input team-name-input" type="text" name="teams[${idx}][name]" placeholder="${TEAM_PH}" autocomplete="off">
    <button type="button" class="btn btn--danger btn--sm remove-row" style="margin-left:.5rem" title="${I18N.t('client.common.eliminar')}">✕</button>
  </div><div class="team-members">${members}</div>`;
  container.appendChild(block);
  block.querySelector('input').focus();
  renumber('teamsContainer');
  updateRestInfo();
});
document.getElementById('teamsContainer')?.addEventListener('click', e => {
  if (e.target.classList.contains('remove-row')) { e.target.closest('.participant-row').remove(); renumber('teamsContainer'); }
});

// ── Drag & drop reorder ───────────────────────────────────────────────────────
function initDragSort(containerId) {
  const container = document.getElementById(containerId);
  if (!container) return;
  let dragging = null;

  container.addEventListener('dragstart', e => {
    if (!e.target.classList.contains('drag-handle')) { e.preventDefault(); return; }
    dragging = e.target.closest('.participant-row');
    if (!dragging) return;
    dragging.classList.add('drag-active');
    e.dataTransfer.effectAllowed = 'move';
  });

  container.addEventListener('dragover', e => {
    if (!dragging) return;
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
    const target = e.target.closest('.participant-row');
    if (!target || target === dragging) return;
    const rect = target.getBoundingClientRect();
    if (e.clientY < rect.top + rect.height / 2) {
      container.insertBefore(dragging, target);
    } else {
      container.insertBefore(dragging, target.nextSibling);
    }
  });

  container.addEventListener('dragend', () => {
    if (dragging) dragging.classList.remove('drag-active');
    dragging = null;
    renumber(containerId);
  });
}

initDragSort('driversGrid');
initDragSort('teamsContainer');
updateRestInfo();
</script>
<% } %>

<%- include('../partials/footer') %>
