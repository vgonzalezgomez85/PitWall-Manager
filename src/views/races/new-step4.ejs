<%- include('../partials/header', { pageTitle: lang === 'es' ? 'Nueva Carrera — Participantes' : 'New Race — Participants' }) %>
<div class="container container--narrow">

  <%- include('../partials/wizard-progress', { step: 4, hasPole: wizard.has_pole }) %>

  <h1 class="page-title"><%= lang === 'es' ? 'Participantes de Pole Position' : 'Pole Position Participants' %></h1>
  <p class="page-subtitle">
    <%= wizard.name %> · <%= t('races.format.' + wizard.format) %> ·
    <%= lang === 'es' ? 'Los tiempos se registran durante la sesión de pole.' : 'Times are recorded during the pole session.' %>
  </p>

  <% if (errors.length > 0) { %>
    <div class="alert alert--error">
      <% errors.forEach(e => { %><p><%= t('errors.' + e) || e %></p><% }) %>
    </div>
  <% } %>

  <div class="form-card">

    <p class="form-hint" style="margin-bottom:1.25rem">
      <% if (wizard.format === 'individual') { %>
        <%= lang === 'es' ? 'Añade todos los pilotos que participarán en la pole y en la carrera.' : 'Add all drivers who will participate in qualifying and the race.' %>
      <% } else { %>
        <%= lang === 'es' ? 'Añade todos los equipos con sus integrantes.' : 'Add all teams with their members.' %>
      <% } %>
    </p>

    <% const _minRows = wizard.lanes_count || 2; %>
    <form action="/races/new/step4" method="POST">

      <% if (wizard.format === 'individual') { %>

        <div id="driversGrid" class="drivers-grid">
          <% const initD = Math.max(_minRows, body.drivers ? body.drivers.length : 0); %>
          <% for (let i = 0; i < initD; i++) { %>
            <div class="driver-row participant-row" data-row="<%= i %>">
              <span class="lane-badge participant-badge" style="background:<%= LANE_COLORS[i % LANE_COLORS.length] %>" data-index="<%= i %>"><%= i + 1 %></span>
              <div class="driver-field participant-fields">
                <input
                  class="form-input participant-name"
                  type="text"
                  name="drivers[]"
                  placeholder="<%= t('wizard.driver_name_ph') %>"
                  value="<%= (body.drivers && body.drivers[i]) || '' %>"
                  autocomplete="off"
                  <%= i < _minRows ? 'required' : '' %>>
              </div>
              <% if (i >= _minRows) { %>
                <button type="button" class="btn btn--danger btn--sm remove-row">✕</button>
              <% } %>
            </div>
          <% } %>
        </div>

        <button type="button" id="addDriver" class="btn btn--ghost btn--sm" style="margin-top:.75rem">
          + <%= lang === 'es' ? 'Añadir piloto' : 'Add driver' %>
        </button>

      <% } else { %>

        <div id="teamsContainer" class="teams-container">
          <% const initT = Math.max(_minRows, body.teams ? Object.keys(body.teams).length : 0); %>
          <% for (let i = 0; i < initT; i++) { %>
            <div class="team-block participant-row" data-row="<%= i %>">
              <div class="team-block__header" style="border-left-color:<%= LANE_COLORS[i % LANE_COLORS.length] %>">
                <span class="lane-badge participant-badge" style="background:<%= LANE_COLORS[i % LANE_COLORS.length] %>" data-index="<%= i %>"><%= i + 1 %></span>
                <input
                  class="form-input team-name-input"
                  type="text"
                  name="teams[<%= i %>][name]"
                  placeholder="<%= t('wizard.team_name_ph') %>"
                  value="<%= (body.teams && body.teams[i] && body.teams[i].name) || '' %>"
                  autocomplete="off"
                  <%= i < _minRows ? 'required' : '' %>>
                <% if (i >= _minRows) { %>
                  <button type="button" class="btn btn--danger btn--sm remove-row" style="margin-left:.5rem">✕</button>
                <% } %>
              </div>
              <div class="team-members">
                <% const _mem = (body.teams && body.teams[i] && body.teams[i].members) || []; const _mrows = Math.max(4, _mem.length); %>
                <% for (let m = 0; m < _mrows; m++) { %>
                  <div class="member-row">
                    <span class="member-num"><%= m + 1 %></span>
                    <input
                      class="form-input participant-name"
                      type="text"
                      name="teams[<%= i %>][members][]"
                      placeholder="<%= t('wizard.member_ph') %> <%= m + 1 %><%= m === 0 ? '' : (' (' + t('wizard.optional') + ')') %>"
                      value="<%= _mem[m] || '' %>"
                      autocomplete="off">
                    <button type="button" class="btn btn--danger btn--sm member-remove" tabindex="-1" title="<%= lang === 'es' ? 'Quitar piloto' : 'Remove driver' %>">✕</button>
                  </div>
                <% } %>
              </div>
              <button type="button" class="btn btn--ghost btn--sm add-member" style="margin-top:.4rem">
                + <%= lang === 'es' ? 'Añadir piloto' : 'Add driver' %>
              </button>
            </div>
          <% } %>
        </div>

        <button type="button" id="addTeam" class="btn btn--ghost btn--sm" style="margin-top:.75rem">
          + <%= lang === 'es' ? 'Añadir equipo' : 'Add team' %>
        </button>
        <% if ((teamsCatalog || []).length) { %>
          <p class="form-hint" style="margin-top:.5rem;font-size:.82rem">
            <%= lang === 'es'
              ? '💡 Empieza a escribir el nombre de un equipo del catálogo y elígelo para rellenar sus pilotos automáticamente.'
              : '💡 Start typing a catalog team name and pick it to auto-fill its drivers.' %>
          </p>
        <% } %>

      <% } %>

      <div class="form-actions" style="margin-top:1.5rem">
        <a href="/races/new/step3" class="btn btn--ghost">← <%= t('wizard.back') %></a>
        <button type="submit" class="btn btn--primary"><%= t('wizard.next') %> →</button>
      </div>

    </form>
  </div>
</div>

<script>
const LANG      = "<%= lang %>";
const COLORS    = <%- JSON.stringify(LANE_COLORS) %>;
const DRIVER_PH = "<%= t('wizard.driver_name_ph') %>";
const TEAM_PH   = "<%= t('wizard.team_name_ph') %>";
const MEMBER_PH = "<%= t('wizard.member_ph') %>";
const OPT_LBL   = "<%= t('wizard.optional') %>";

const ALL_PROFILES = <%- JSON.stringify((profiles || []).map(p => ({ name: p.name, category: p.category }))) %>;
const CATALOG      = <%- JSON.stringify((teamsCatalog || []).map(ct => ({ id: ct.id, name: ct.name, members: (ct.members || []).map(m => m.name) }))) %>;
const CAT_ICONS    = { platino: '💎', oro: '🥇', plata: '🥈', bronce: '🥉' };

// ── Autocomplete ──────────────────────────────────────────────────────────────
const acDrop = document.createElement('div');
acDrop.className = 'ac-dropdown';
document.body.appendChild(acDrop);
let acTarget = null, acActive = -1, acMode = 'pilot';

function acFilter(q) { return !q ? [] : ALL_PROFILES.filter(p => p.name.toLowerCase().includes(q.toLowerCase())).slice(0, 10); }
function acShow(input, results) {
  if (!results.length) { acHide(); return; }
  acTarget = input; acActive = -1;
  const rect = input.getBoundingClientRect();
  acDrop.style.cssText = `left:${rect.left + scrollX}px;top:${rect.bottom + scrollY + 2}px;width:${rect.width}px`;
  acDrop.innerHTML = results.map(p =>
    `<div class="ac-item" data-name="${p.name}"><span class="ac-cat">${CAT_ICONS[p.category]||''}</span><span class="ac-name">${p.name}</span></div>`
  ).join('');
  acDrop.classList.add('ac-dropdown--open');
}
function acHide() { acDrop.classList.remove('ac-dropdown--open'); acTarget = null; acActive = -1; }
function acSelect(name) { if (acTarget) acTarget.value = name; acHide(); }
function acHighlight(idx) {
  const items = acDrop.querySelectorAll('.ac-item');
  items.forEach((el, i) => el.classList.toggle('ac-item--active', i === idx));
  if (items[idx]) items[idx].scrollIntoView({ block: 'nearest' });
}

// Autocomplete de EQUIPOS del catálogo sobre el nombre del equipo.
function teamFilter(q) {
  q = (q || '').toLowerCase();
  const list = !q ? CATALOG : CATALOG.filter(t => t.name.toLowerCase().includes(q));
  return list.slice(0, 10);
}
function acShowTeams(input) {
  const results = teamFilter(input.value);
  if (!results.length) { acHide(); return; }
  acMode = 'team'; acTarget = input; acActive = -1;
  const rect = input.getBoundingClientRect();
  acDrop.style.cssText = `left:${rect.left + scrollX}px;top:${rect.bottom + scrollY + 2}px;width:${Math.max(rect.width, 220)}px`;
  acDrop.innerHTML = results.map(t =>
    `<div class="ac-item" data-team-id="${t.id}"><span class="ac-name">${escAttr(t.name)}</span>`
    + `<span class="ac-cat" style="margin-left:auto;color:var(--vt-mute,#9aa0a6);font-size:.85em">${t.members.length} 👤</span></div>`
  ).join('');
  acDrop.classList.add('ac-dropdown--open');
}
// Aplica la selección según el modo (piloto = set value · equipo = rellena bloque).
function acChoose(item) {
  if (acMode === 'team') {
    const team = CATALOG.find(t => t.id === parseInt(item.dataset.teamId, 10));
    if (team && acTarget) { fillTeamBlock(acTarget.closest('.participant-row'), team.name, team.members); }
    acHide();
  } else {
    acSelect(item.dataset.name);
  }
}

document.addEventListener('input', e => {
  if (e.target.classList.contains('team-name-input')) { acShowTeams(e.target); }
  else if (e.target.classList.contains('participant-name')) { acMode = 'pilot'; acShow(e.target, acFilter(e.target.value)); }
});
document.addEventListener('focusin', e => { if (e.target.classList.contains('team-name-input')) acShowTeams(e.target); });
document.addEventListener('keydown', e => {
  if (!acDrop.classList.contains('ac-dropdown--open')) return;
  const items = acDrop.querySelectorAll('.ac-item');
  if (e.key === 'ArrowDown') { e.preventDefault(); acActive = Math.min(acActive+1, items.length-1); acHighlight(acActive); }
  else if (e.key === 'ArrowUp') { e.preventDefault(); acActive = Math.max(acActive-1, 0); acHighlight(acActive); }
  else if (e.key === 'Enter' && acActive >= 0) { e.preventDefault(); acChoose(items[acActive]); }
  else if (e.key === 'Escape') acHide();
});
acDrop.addEventListener('mousedown', e => { const item = e.target.closest('.ac-item'); if (item) { e.preventDefault(); acChoose(item); } });
document.addEventListener('focusout', e => {
  if (e.target.classList.contains('participant-name') || e.target.classList.contains('team-name-input')) setTimeout(acHide, 150);
});

// ── Re-number ─────────────────────────────────────────────────────────────────
function renumber(containerId) {
  const c = document.getElementById(containerId); if (!c) return;
  const isTeams = containerId === 'teamsContainer';
  c.querySelectorAll('.participant-row').forEach((row, i) => {
    row.dataset.row = i;
    const badge = row.querySelector('.participant-badge');
    if (badge) { badge.dataset.index = i; badge.textContent = i + 1; badge.style.background = COLORS[i % COLORS.length]; }
    if (isTeams) {
      const hdr = row.querySelector('.team-block__header');
      if (hdr) hdr.style.borderLeftColor = COLORS[i % COLORS.length];
      const ni = row.querySelector('.team-name-input'); if (ni) ni.name = `teams[${i}][name]`;
      row.querySelectorAll('.team-members input').forEach(inp => { inp.name = `teams[${i}][members][]`; });
    }
  });
}

// ── Add driver ────────────────────────────────────────────────────────────────
document.getElementById('addDriver')?.addEventListener('click', () => {
  const grid = document.getElementById('driversGrid');
  const idx  = grid.querySelectorAll('.participant-row').length;
  const div  = document.createElement('div');
  div.className = 'driver-row participant-row'; div.dataset.row = idx;
  div.innerHTML = `
    <span class="lane-badge participant-badge" style="background:${COLORS[idx%COLORS.length]}" data-index="${idx}">${idx+1}</span>
    <div class="driver-field participant-fields">
      <input class="form-input participant-name" type="text" name="drivers[]" placeholder="${DRIVER_PH}" autocomplete="off">
    </div>
    <button type="button" class="btn btn--danger btn--sm remove-row">✕</button>`;
  grid.appendChild(div); div.querySelector('.participant-name').focus();
});
document.getElementById('driversGrid')?.addEventListener('click', e => {
  if (e.target.classList.contains('remove-row')) { e.target.closest('.participant-row').remove(); renumber('driversGrid'); }
});

// ── Add team (manual o desde catálogo) ─────────────────────────────────────────
function escAttr(s) { return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;'); }

function memberRowHtml(idx, m, value) {
  return `<div class="member-row"><span class="member-num">${m+1}</span>`
    + `<input class="form-input participant-name" type="text" name="teams[${idx}][members][]"`
    + ` placeholder="${MEMBER_PH} ${m+1}${m>0?' ('+OPT_LBL+')':''}" value="${escAttr(value)}" autocomplete="off">`
    + `<button type="button" class="btn btn--danger btn--sm member-remove" tabindex="-1" title="${LANG==='es'?'Quitar piloto':'Remove driver'}">✕</button></div>`;
}

// Renumera las filas de piloto (1..N) y refresca placeholders dentro de un bloque.
function renumberMembers(block) {
  block.querySelectorAll('.team-members .member-row').forEach((row, m) => {
    const num = row.querySelector('.member-num'); if (num) num.textContent = m + 1;
    const inp = row.querySelector('.participant-name');
    if (inp && !inp.value) inp.placeholder = `${MEMBER_PH} ${m+1}${m>0?' ('+OPT_LBL+')':''}`;
  });
}

// Crea y añade un bloque de equipo (vacío o relleno) y lo devuelve.
function appendTeamBlock(name, memberNames) {
  memberNames = memberNames || [];
  const container = document.getElementById('teamsContainer');
  const idx   = container.querySelectorAll('.participant-row').length;
  const color = COLORS[idx % COLORS.length];
  const rows  = Math.max(4, memberNames.length);
  let members = '';
  for (let m = 0; m < rows; m++) members += memberRowHtml(idx, m, memberNames[m] || '');
  const block = document.createElement('div');
  block.className = 'team-block participant-row'; block.dataset.row = idx;
  block.innerHTML = `
    <div class="team-block__header" style="border-left-color:${color}">
      <span class="lane-badge participant-badge" style="background:${color}" data-index="${idx}">${idx+1}</span>
      <input class="form-input team-name-input" type="text" name="teams[${idx}][name]" placeholder="${TEAM_PH}" value="${escAttr(name)}" autocomplete="off" required>
      <button type="button" class="btn btn--danger btn--sm remove-row" style="margin-left:.5rem">✕</button>
    </div>
    <div class="team-members">${members}</div>
    <button type="button" class="btn btn--ghost btn--sm add-member" style="margin-top:.4rem">+ ${LANG==='es'?'Añadir piloto':'Add driver'}</button>`;
  container.appendChild(block);
  return block;
}

// Primer bloque con el nombre de equipo vacío (para reutilizar las filas iniciales).
function firstEmptyTeamBlock() {
  const blocks = document.querySelectorAll('#teamsContainer .participant-row');
  for (const b of blocks) { const ni = b.querySelector('.team-name-input'); if (ni && !ni.value.trim()) return b; }
  return null;
}

// Rellena un bloque existente con un equipo del catálogo (nombre + pilotos).
function fillTeamBlock(block, name, memberNames) {
  block.querySelector('.team-name-input').value = name || '';
  const idx  = block.dataset.row;
  const wrap = block.querySelector('.team-members');
  let inputs = wrap.querySelectorAll('.participant-name');
  for (let m = inputs.length; m < memberNames.length; m++) wrap.insertAdjacentHTML('beforeend', memberRowHtml(idx, m, ''));
  inputs = wrap.querySelectorAll('.participant-name');
  inputs.forEach((inp, m) => { inp.value = memberNames[m] || ''; });
}

document.getElementById('addTeam')?.addEventListener('click', () => {
  const b = appendTeamBlock(); b.querySelector('.team-name-input').focus();
});

document.getElementById('teamsContainer')?.addEventListener('click', e => {
  if (e.target.classList.contains('remove-row')) {
    e.target.closest('.participant-row').remove(); renumber('teamsContainer');
  } else if (e.target.classList.contains('add-member')) {
    const block = e.target.closest('.participant-row');
    const wrap  = block.querySelector('.team-members');
    const m     = wrap.querySelectorAll('.member-row').length;
    wrap.insertAdjacentHTML('beforeend', memberRowHtml(block.dataset.row, m, ''));
    renumberMembers(block);
    wrap.lastElementChild.querySelector('.participant-name').focus();
  } else if (e.target.classList.contains('member-remove')) {
    const block = e.target.closest('.participant-row');
    const wrap  = block.querySelector('.team-members');
    if (wrap.querySelectorAll('.member-row').length <= 1) return;   // dejar al menos 1
    e.target.closest('.member-row').remove();
    renumberMembers(block);
  }
});
</script>

<%- include('../partials/footer') %>
