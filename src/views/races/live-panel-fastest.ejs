<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= lang === 'es' ? 'Vueltas Rápidas' : 'Fastest Laps' %> — <%= race.name %>
  </title>
  <link rel="icon" type="image/svg+xml" href="/img/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Rajdhani:wght@500;600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      display: flex; flex-direction: column; height: 100vh; overflow: hidden;
      background: #000000; color: #e6edf3; font-family: 'Inter', system-ui, sans-serif;
    }
    .pf-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: .55rem 1.2rem;
      background: #000000; border-bottom: 2px solid #161b22; flex-shrink: 0;
    }
    .pf-title {
      font-size: .68rem; font-weight: 700; letter-spacing: .15em;
      color: #6e7681; text-transform: uppercase;
    }
    .pf-manga {
      font-family: 'Rajdhani', sans-serif; font-size: 1rem; font-weight: 700;
      color: #e6edf3; letter-spacing: .04em;
    }
    .pf-race { font-size: .72rem; color: #6e7681; }

    .pf-wrap { flex: 1; overflow-y: auto; }
    .pf-table { width: 100%; border-collapse: collapse; }
    .pf-table thead { position: sticky; top: 0; z-index: 5; }
    .pf-table thead th {
      padding: .5rem 1rem; font-size: .68rem; font-weight: 700;
      letter-spacing: .09em; color: #4e555e; text-transform: uppercase;
      background: #000000; border-bottom: 1px solid #161b22; text-align: left;
    }
    .pf-table td {
      padding: .55rem 1rem;
      border-bottom: 1px solid #0f1419; vertical-align: middle;
      font-size: var(--pf-font, .95rem);
    }
    .pf-right  { text-align: right; }
    .pf-center { text-align: center; }

    .pf-lane {
      display: inline-flex; align-items: center; justify-content: center;
      width: 28px; height: 28px; border-radius: 50%;
      font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: .88rem;
      color: #fff;
    }
    .pf-name { font-weight: 500; color: #e6edf3; }
    .pf-time {
      font-family: 'Share Tech Mono', monospace;
      color: #f6c90e; font-weight: 700; font-size: 1.05em;
    }
    .pf-row--gold .pf-time { color: #ffd700; font-size: 1.2em; }
    .pf-empty {
      text-align: center; padding: 2rem;
      color: #6e7681; font-size: .9rem;
    }
  </style>
</head>
<body>

  <header class="pf-header">
    <div>
      <div class="pf-title">⚡ <%= lang === 'es' ? 'Vueltas Rápidas por Pista' : 'Fastest Laps by Lane' %></div>
      <div class="pf-manga">
        <% if (tanda) { %><%= lang === 'es' ? 'Tanda' : 'Round' %> <%= tanda.number %> · <% } %>
        <%= lang === 'es' ? 'Manga' : 'Heat' %> #<%= manga.number %>
      </div>
    </div>
    <span class="pf-race"><%= race.name %></span>
  </header>

  <div class="pf-wrap">
    <table class="pf-table">
      <thead>
        <tr>
          <th class="pf-center"><%= lang === 'es' ? 'Pista' : 'Lane' %></th>
          <th><%= lang === 'es' ? 'Participante' : 'Participant' %></th>
          <th class="pf-right"><%= lang === 'es' ? 'Mejor' : 'Best' %></th>
        </tr>
      </thead>
      <tbody id="pfBody"></tbody>
    </table>
  </div>

  <%
    const LC = ['#e63946','#2196f3','#4caf50','#ff9800','#9c27b0','#00bcd4','#ff5722','#607d8b','#795548','#e91e63','#3f51b5','#009688','#cddc39','#ffc107','#f44336','#673ab7','#03a9f4','#8bc34a','#ff6f00','#880e4f','#1a237e','#b71c1c','#004d40','#f57f17','#311b92','#0d47a1','#1b5e20','#33691e','#bf360c','#4a148c','#006064','#827717'];
    const laneRows = lanes
      .filter(l => !l.is_rest)
      .map(l => ({
        lane:  l.lane,
        color: LC[l.lane - 1] || '#8b949e',
        name:  l.team_name || l.driver_name || ('Lane ' + l.lane),
      }));
  %>

  <script>
    const PANEL_DATA = <%- JSON.stringify({
      raceId:       race.id,
      mangaId:      manga.id,
      lanes:        laneRows,
      raceBestLaps: raceBestLaps || {},
    }) %>;
    const LANG = "<%= lang %>";
  </script>
  <script src="/socket.io/socket.io.js"></script>
  <script>
    function formatMs(ms) {
      if (ms == null) return '—';
      const totalSec = Math.floor(ms / 1000);
      const millis   = ms % 1000;
      const secs = totalSec % 60;
      const mins = Math.floor(totalSec / 60);
      return `${mins > 0 ? mins + ':' : ''}${String(secs).padStart(mins > 0 ? 2 : 1, '0')}.${String(millis).padStart(3, '0')}`;
    }

    const pfBody  = document.getElementById('pfBody');
    let _raceBestLaps = { ...(PANEL_DATA.raceBestLaps || {}) };

    function render() {
      const rows = PANEL_DATA.lanes
        .map(l => ({
          ...l,
          bestLapMs:  _raceBestLaps[l.lane]?.bestLapMs  ?? null,
          entityName: _raceBestLaps[l.lane]?.entityName ?? null,
        }))
        .filter(r => r.bestLapMs != null)
        .sort((a, b) => a.bestLapMs - b.bestLapMs);

      if (rows.length === 0) {
        pfBody.innerHTML = `<tr><td colspan="3" class="pf-empty">${LANG === 'es' ? 'Sin vueltas registradas todavía' : 'No laps recorded yet'}</td></tr>`;
        // ajustar tamaño tabla a viewport
        fit();
        return;
      }

      pfBody.innerHTML = rows.map((r, i) => `
        <tr class="pf-row ${i === 0 ? 'pf-row--gold' : ''}">
          <td class="pf-center"><span class="pf-lane" style="background:${r.color}">${r.lane}</span></td>
          <td><span class="pf-name">${r.entityName || r.name}</span></td>
          <td class="pf-right"><span class="pf-time">${formatMs(r.bestLapMs)}</span></td>
        </tr>
      `).join('');
      fit();
    }

    // Auto-ajusta el tamaño de fuente a la altura disponible (igual estilo
    // que live-panel.ejs: filas grandes cuando hay pocas, compactas con muchas)
    function fit() {
      const wrap = document.querySelector('.pf-wrap');
      if (!wrap) return;
      const rows = pfBody.querySelectorAll('tr');
      if (!rows.length) return;
      const thead = wrap.querySelector('thead');
      const available = wrap.clientHeight - (thead ? thead.offsetHeight : 32);
      const rowH = available / rows.length;
      const fontSize = Math.min(1.6, Math.max(0.7, rowH / 38));
      document.documentElement.style.setProperty('--pf-font', fontSize.toFixed(3) + 'rem');
    }
    window.addEventListener('resize', fit);

    render();

    // Socket: actualiza raceBestLaps cuando llegan nuevas vueltas
    const socket = io({ transports: ['websocket', 'polling'] });
    socket.on('connect', () => {
      socket.emit('race:live:join');
      socket.emit('standings:request');
    });

    socket.on('standings', (data) => {
      if (data && data.mangaId !== PANEL_DATA.mangaId) return;
      if (!data?.raceBestLaps) return;
      let changed = false;
      Object.entries(data.raceBestLaps).forEach(([lane, info]) => {
        if (!info || info.bestLapMs == null) return;
        const prev = _raceBestLaps[lane];
        if (!prev || prev.bestLapMs !== info.bestLapMs || prev.entityName !== info.entityName) {
          _raceBestLaps[lane] = info;
          changed = true;
        }
      });
      if (changed) render();
    });

    // Cuando se cierra/cambia manga, mantenemos la última vista
    socket.on('manga:stopped', () => {});
  </script>
</body>
</html>
