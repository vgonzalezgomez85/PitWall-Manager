<%- include('../partials/header', { pageTitle: lang === 'es' ? 'Iniciar Pole Position' : 'Start Pole Position' }) %>
<div class="container container--narrow">

  <a href="/races/<%= race.id %>" class="back-link">← <%= t('race.back_to_list') %></a>
  <h1 class="page-title">🏁 <%= lang === 'es' ? 'Configurar Pole Position' : 'Setup Pole Position' %></h1>
  <p class="page-subtitle"><%= race.name %> · <%= t('races.format.' + race.format) %></p>

  <% if (errors.length > 0) { %>
    <div class="alert alert--error">
      <% errors.forEach(e => { %><p><%= lang === 'es' ? 'Carril inválido. Elige un carril entre 1 y ' + race.lanes_count + '.' : 'Invalid lane. Choose between 1 and ' + race.lanes_count + '.' %></p><% }) %>
    </div>
  <% } %>

  <div class="form-card">

    <!-- Lane picker + participants (mismo form para enviar lane + orden) -->
    <form action="/races/<%= race.id %>/pole/start" method="POST">

    <!-- Participants preview -->
    <div style="margin-bottom:1.5rem">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:.75rem;margin-bottom:.75rem;flex-wrap:wrap">
        <p class="pole-section-title" style="margin:0">
          <%= lang === 'es' ? 'Participantes' : 'Participants' %>
          <span class="form-hint" style="font-weight:400;margin-left:.5rem">
            (<%= entries.length %>)
          </span>
        </p>
        <button type="button" id="shuffleEntries" class="btn btn--ghost btn--sm">
          🎲 <%= lang === 'es' ? 'Aleatorio' : 'Random' %>
        </button>
      </div>
      <div id="entriesList" style="display:flex;flex-wrap:wrap;gap:.4rem">
        <% entries.forEach((e, i) => { %>
          <span class="badge badge--neutral entry-badge" data-id="<%= e.id %>" style="background:rgba(255,255,255,.06)"><%= e.entity_name %></span>
        <% }) %>
      </div>
      <input type="hidden" name="entry_order" id="entryOrderInput"
             value="<%= entries.map(e => e.id).join(',') %>">
      <p class="form-hint" style="margin-top:.6rem">
        <%= lang === 'es'
          ? 'Pulsa 🎲 para barajar el orden. El orden actual será el de salida en la pole.'
          : 'Press 🎲 to shuffle. The current order will be used for the pole start.' %>
      </p>
    </div>

    <hr style="border:none;border-top:1px solid var(--border);margin:1.25rem 0">

      <div class="form-group">
        <label class="form-label">
          <%= lang === 'es' ? 'Carril de pole' : 'Pole lane' %>
        </label>
        <p class="form-hint" style="margin-bottom:.75rem">
          <%= lang === 'es'
            ? 'Todos los participantes harán su vuelta clasificatoria por este carril.'
            : 'All participants will run their qualifying lap on this lane.' %>
        </p>
        <%
          let _cfg = []; try { _cfg = JSON.parse(race.circuits_config || '[]'); } catch (e) {}
          const _circuits = []; let _s = 1;
          _cfg.forEach((c, i) => { _circuits.push({ index: i + 1, from: _s, to: _s + c - 1 }); _s += c; });
        %>
        <% if (_circuits.length > 1) { %>
          <div class="pole-circuit-pick" style="display:flex;align-items:center;gap:.45rem;flex-wrap:wrap;margin-bottom:.85rem">
            <span class="form-hint" style="margin:0"><%= lang === 'es' ? 'Acotar aleatorio a circuito:' : 'Limit random to circuit:' %></span>
            <button type="button" class="btn btn--ghost btn--sm pole-circ-btn is-active" data-circ="all"><%= lang === 'es' ? 'Todos' : 'All' %></button>
            <% _circuits.forEach(c => { %>
              <button type="button" class="btn btn--ghost btn--sm pole-circ-btn" data-circ="<%= c.index %>"
                      data-from="<%= c.from %>" data-to="<%= c.to %>"
                      title="<%= lang === 'es' ? 'Carriles' : 'Lanes' %> <%= c.from %>–<%= c.to %>">
                C<%= c.index %> <span style="opacity:.6;font-size:.85em">(<%= c.from %>–<%= c.to %>)</span>
              </button>
            <% }) %>
          </div>
        <% } %>
        <div class="pole-lane-picker">
          <button type="button" id="poleLaneDec" class="btn btn--ghost btn--sm pole-lane-btn">−</button>
          <div class="pole-lane-display" id="poleLaneDisplay">
            <span id="poleLaneNum">1</span>
          </div>
          <button type="button" id="poleLaneInc" class="btn btn--ghost btn--sm pole-lane-btn">+</button>
          <button type="button" id="poleLaneRandom" class="btn btn--ghost" style="margin-left:.75rem">
            🎲 <%= lang === 'es' ? 'Aleatorio' : 'Random' %>
          </button>
        </div>
        <input type="hidden" name="pole_lane" id="poleLaneInput" value="1">
      </div>

      <div class="form-actions" style="margin-top:1.5rem">
        <a href="/races/<%= race.id %>" class="btn btn--ghost">← <%= t('wizard.back') %></a>
        <button type="submit" class="btn btn--primary btn--lg">
          🚦 <%= lang === 'es' ? 'Empezar Pole' : 'Start Pole' %>
        </button>
      </div>

    </form>
  </div>
</div>

<style>
.pole-circ-btn.is-active {
  background: #1f6feb; border-color: #1f6feb; color: #fff;
}
.pole-circ-btn.is-active span { opacity: .85 !important; }
</style>
<script>
const TOTAL_LANES = <%= race.lanes_count %>;
const COLORS      = <%- JSON.stringify(LANE_COLORS) %>;
let poleLane = 1;

function setPoleLane(n) {
  poleLane = Math.max(1, Math.min(TOTAL_LANES, n));
  document.getElementById('poleLaneNum').textContent    = poleLane;
  document.getElementById('poleLaneInput').value        = poleLane;
  document.getElementById('poleLaneDisplay').style.background = COLORS[(poleLane - 1) % COLORS.length];
}
setPoleLane(1);

document.getElementById('poleLaneDec').addEventListener('click', () => setPoleLane(poleLane - 1));
document.getElementById('poleLaneInc').addEventListener('click', () => setPoleLane(poleLane + 1));

// Circuito al que se acota el aleatorio (por defecto: todos los carriles).
let circFrom = 1, circTo = TOTAL_LANES;
document.querySelectorAll('.pole-circ-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.pole-circ-btn').forEach(b => b.classList.remove('is-active'));
    btn.classList.add('is-active');
    if (btn.dataset.circ === 'all') { circFrom = 1; circTo = TOTAL_LANES; }
    else { circFrom = parseInt(btn.dataset.from, 10); circTo = parseInt(btn.dataset.to, 10); }
  });
});

document.getElementById('poleLaneRandom').addEventListener('click', () => {
  // Aleatorio acotado al circuito seleccionado (o a todos).
  setPoleLane(circFrom + Math.floor(Math.random() * (circTo - circFrom + 1)));
});

// ── Shuffle de participantes ─────────────────────────────────────────────
(function () {
  const list  = document.getElementById('entriesList');
  const input = document.getElementById('entryOrderInput');
  const btn   = document.getElementById('shuffleEntries');
  if (!list || !input || !btn) return;

  function syncHidden() {
    const ids = [...list.querySelectorAll('.entry-badge')].map(el => el.dataset.id);
    input.value = ids.join(',');
  }
  btn.addEventListener('click', () => {
    const nodes = [...list.querySelectorAll('.entry-badge')];
    // Fisher-Yates
    for (let i = nodes.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [nodes[i], nodes[j]] = [nodes[j], nodes[i]];
    }
    list.innerHTML = '';
    nodes.forEach(n => list.appendChild(n));
    syncHidden();
  });
})();
</script>

<%- include('../partials/footer') %>
