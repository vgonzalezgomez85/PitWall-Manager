<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= race.name %> — <%= lang === 'es' ? 'Manga' : 'Heat' %> <%= manga.number %> — PitWall</title>
  <link rel="icon" type="image/svg+xml" href="/img/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32"  href="/img/favicon-32.png">
  <link rel="icon" type="image/png" sizes="256x256" href="/img/favicon-256.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png">
  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="stylesheet" href="/css/semaphore.css">
  <link rel="stylesheet" href="/css/live.css?v=<%= Date.now() %>">
</head>
<body class="live-body">

  <!-- ── Header ────────────────────────────────────────────────────────────── -->
  <header class="live-header">
    <div class="live-header__timer">
      <div id="raceTimer" class="live-timer"><%= String(race.manga_duration_minutes).padStart(2,'0') %>:00</div>
      <!-- Con >1 circuito, se ocultará raceTimer y se mostrarán timers por circuito -->
      <div id="circuitTimers" class="circuit-timers" hidden></div>
      <div class="live-timer-label"><%= lang === 'es' ? 'tiempo' : 'time' %></div>
    </div>

    <div class="live-header__info">
      <div class="live-manga-id">
        <% if (tanda) { %>
          <span class="live-tanda-tag"><%= lang === 'es' ? 'Tanda' : 'Round' %> <%= tanda.number %>/<%= typeof totalTandas !== 'undefined' ? totalTandas : '?' %></span>
        <% } %>
        <span class="live-manga-tag">
          <%= lang === 'es' ? 'Manga' : 'Heat' %> <%= manga.number %>/<%= typeof totalMangas !== 'undefined' ? totalMangas : '?' %>
        </span>
      </div>
      <div id="timerStatus" class="live-status">
        <% if (typeof isPaused !== 'undefined' && isPaused) { %>
          <span class="status-dot status-dot--paused"></span>
          <span class="status-text status-text--paused"><%= lang === 'es' ? 'Pausada' : 'Paused' %></span>
        <% } else if (isActive) { %>
          <span class="status-dot status-dot--active"></span>
          <span class="status-text status-text--active"><%= lang === 'es' ? 'En carrera' : 'Racing' %></span>
        <% } else if (manga.status === 'finished') { %>
          <span class="status-text status-text--finished"><%= lang === 'es' ? 'Finalizada' : 'Finished' %></span>
        <% } else { %>
          <span class="status-text status-text--pending"><%= lang === 'es' ? 'En espera' : 'Pending' %></span>
        <% } %>
      </div>
      <div class="live-race-subtitle"><%= race.name %></div>
    </div>

    <div class="live-header__actions">
      <%# GO/STOP manual: solo cuando SlotTime inicia la carrera (simulación o BART).
          En DS-300 manda la caja → no se muestra. %>
      <% if (isSimulating || isBart) { %>
        <% const goTitle   = isBart ? (lang === 'es' ? 'Arrancar manga (BART)' : 'Start heat (BART)')
                                    : (lang === 'es' ? 'Arrancar simulación'   : 'Start simulation'); %>
        <% const stopTitle = isBart ? (lang === 'es' ? 'Parar manga (BART)'    : 'Stop heat (BART)')
                                    : (lang === 'es' ? 'Parar simulación'      : 'Stop simulation'); %>
        <%# Duración por defecto: el 99 es el placeholder → ofrecer 10 min. %>
        <% const defaultDur = (race.manga_duration_minutes && race.manga_duration_minutes !== 99) ? race.manga_duration_minutes : 10; %>
        <% if (manga.status === 'pending' && !isActive) { %>
          <form id="goForm" action="/races/<%= race.id %>/mangas/<%= manga.id %>/start" method="POST" style="display:inline-flex;align-items:center;gap:8px">
            <label class="live-dur" title="<%= lang === 'es' ? 'Duración de la manga (minutos)' : 'Heat duration (minutes)' %>">
              <input class="vt-inp is-mono live-dur__inp" type="number" name="duration_minutes"
                     min="1" max="600" step="1" value="<%= defaultDur %>"
                     style="width:64px;text-align:center">
              <span class="live-dur__u">min</span>
            </label>
            <button class="lbtn lbtn--go" type="submit" title="<%= goTitle %>">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
              <span>GO</span>
            </button>
          </form>
        <% } else if (isActive) { %>
          <% if (isPaused) { %>
            <form id="resumeForm" action="/races/<%= race.id %>/mangas/<%= manga.id %>/resume" method="POST" style="display:inline">
              <button class="lbtn lbtn--go" type="submit" title="<%= lang === 'es' ? 'Reanudar manga' : 'Resume heat' %>">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                <span><%= lang === 'es' ? 'REANUDAR' : 'RESUME' %></span>
              </button>
            </form>
          <% } else { %>
            <form action="/races/<%= race.id %>/mangas/<%= manga.id %>/pause" method="POST" style="display:inline">
              <button class="lbtn" type="submit" title="<%= lang === 'es' ? 'Pausar manga' : 'Pause heat' %>">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
                <span>PAUSE</span>
              </button>
            </form>
          <% } %>
          <form action="/races/<%= race.id %>/mangas/<%= manga.id %>/stop" method="POST" style="display:inline"
            onsubmit="return confirm('<%= lang === 'es' ? '¿Parar la manga y borrar las vueltas registradas?' : 'Stop the heat and delete recorded laps?' %>')">
            <button class="lbtn lbtn--fin" type="submit" title="<%= stopTitle %>">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="1.5"/></svg>
              <span>STOP</span>
            </button>
          </form>
        <% } %>
      <% } %>
      <% if (typeof nextTanda !== 'undefined' && nextTanda) { %>
        <button id="next-tanda-btn" class="lbtn lbtn--go"
                data-race-id="<%= race.id %>"
                data-tanda-id="<%= tanda.id %>"
                data-next-tanda-number="<%= nextTanda.number %>">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
          <span>Tanda <%= nextTanda.number %></span>
        </button>
      <% } %>
      <% if (manga.status === 'finished') { %>
        <form action="/races/<%= race.id %>/mangas/<%= manga.id %>/repeat" method="POST" style="display:inline"
          onsubmit="return confirm('<%= lang === 'es' ? '¿Repetir esta manga? Se borrarán las vueltas registradas.' : 'Repeat this heat? All recorded laps will be deleted.' %>')">
          <button class="lbtn lbtn--repeat" type="submit">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 0 1 15.5-6.4M21 3v6h-6M21 12a9 9 0 0 1-15.5 6.4M3 21v-6h6"/></svg>
            <span><%= lang === 'es' ? 'Repetir' : 'Repeat' %></span>
          </button>
        </form>
      <% } %>
      <button id="voiceBtn" class="lbtn lbtn--back" onclick="toggleVoice()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M11 5L6 9H2v6h4l5 4z"/>
          <path d="M15 9a3 3 0 0 1 0 6"/>
          <path d="M18 6a7 7 0 0 1 0 12"/>
        </svg>
        <span><%= lang === 'es' ? 'Todas' : 'All' %></span>
      </button>
      <button id="viewBtn" class="lbtn lbtn--view" title="<%= lang === 'es' ? 'Cambiar vista' : 'Change view' %>" onclick="openViewPicker()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="7" height="7" rx="1.2"/>
          <rect x="14" y="3" width="7" height="7" rx="1.2"/>
          <rect x="3" y="14" width="7" height="7" rx="1.2"/>
          <rect x="14" y="14" width="7" height="7" rx="1.2"/>
        </svg>
        <span><%= lang === 'es' ? 'Vista' : 'View' %></span>
      </button>
      <button class="lbtn lbtn--back lbtn--icon" title="<%= lang === 'es' ? 'Clasificación general (ventana)' : 'Overall standings (window)' %>"
        onclick="window.open('/races/<%= race.id %>/mangas/<%= manga.id %>/panel/standings','_blank','width=620,height=780')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18M6 21v-7M11 21V10M16 21v-5M21 21V5"/></svg>
      </button>
      <button class="lbtn lbtn--back lbtn--icon" title="<%= lang === 'es' ? 'Minimapa del circuito (ventana)' : 'Track minimap (window)' %>"
        onclick="window.open('/races/<%= race.id %>/mangas/<%= manga.id %>/panel/track','_blank','width=900,height=600')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3L3 5v16l6-2 6 2 6-2V3l-6 2-6-2zM9 3v16M15 5v16"/></svg>
      </button>
      <% if (race.format === 'team' && totalMangas > 1) { %>
        <a href="/races/<%= race.id %>/lemans" target="_blank" class="lbtn lbtn--back lbtn--icon" title="<%= lang === 'es' ? 'Clasificación Le Mans' : 'Le Mans standings' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 21V4M5 4h12l-2 4 2 4H5"/></svg>
        </a>
      <% } %>
      <a href="/races/<%= race.id %>/mangas/<%= manga.id %>/corrections" target="_blank" class="lbtn lbtn--back lbtn--icon" title="<%= lang === 'es' ? 'Corrección de vueltas' : 'Lap corrections' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 20h9"/>
          <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/>
        </svg>
      </a>
      <a href="/races/<%= race.id %>/events" target="_blank" class="lbtn lbtn--back lbtn--icon" title="<%= lang === 'es' ? 'Registro de sucesos' : 'Event log' %>">
        <svg viewBox="0 0 40 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 2h6l4 4v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"/>
          <path d="M10 2v4h4"/>
          <path d="M5 12h6M5 16h4"/>
          <path d="M20 12c0-3 3.6-6 8-6s8 3 8 6-3.6 6-8 6-8-3-8-6z"/>
          <circle cx="28" cy="12" r="2.1" fill="currentColor" stroke="none"/>
        </svg>
      </a>
      <button id="fsBtn" class="lbtn lbtn--back lbtn--icon" onclick="toggleFullscreen()"
        title="<%= lang === 'es' ? 'Pantalla completa' : 'Fullscreen' %>">
        <svg class="fs-ico-open"  viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3m8 0h3a2 2 0 0 0 2-2v-3"/></svg>
        <svg class="fs-ico-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden><path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3M3 16h3a2 2 0 0 1 2 2v3m8 0v-3a2 2 0 0 1 2-2h3"/></svg>
      </button>
      <a href="/races/<%= race.id %>" class="lbtn lbtn--back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        <span><%= lang === 'es' ? 'Volver' : 'Back' %></span>
      </a>
    </div>
  </header>

  <!-- DS-300 link-down banner (hidden until socket fires serial:status).
       El texto lo compone live.js a partir de `down`: con 3 cajas hay que ver de
       un vistazo CUÁL se ha caído, no solo que algo va mal. -->
  <div id="serialBanner" class="serial-banner" hidden
       data-msg-all="<%= lang === 'es'
         ? 'Sin señal del DS-300. Las vueltas que ocurran ahora no se registrarán.'
         : 'No signal from DS-300. Laps occurring now will not be recorded.' %>"
       data-msg-some="<%= lang === 'es'
         ? 'Sin señal de {cajas}. Las vueltas que ocurran ahora en esos carriles no se registrarán.'
         : 'No signal from {cajas}. Laps occurring now on those lanes will not be recorded.' %>"
       data-box-label="<%= lang === 'es' ? 'caja' : 'box' %>">
    <span class="serial-banner__icon">⚠️</span>
    <span id="serialBannerText" class="serial-banner__text"></span>
    <span id="serialBannerSince" class="serial-banner__since"></span>
  </div>

  <!-- ── Toolbar: VUELTAS RÁPIDAS ────────────────────────────────────────── -->
  <div class="live-toolbar" id="liveToolbar">
    <div class="live-toolbar__fastest">
      <span class="live-toolbar__label live-toolbar__label--fast">
        ⚡ <%= lang === 'es' ? 'VUELTAS RÁPIDAS' : 'FASTEST LAPS' %>
        <a href="/races/<%= race.id %>/mangas/<%= manga.id %>/panel/fastest" target="_blank" class="panel-expand" title="<%= lang === 'es' ? 'Abrir en ventana' : 'Open in window' %>">⤢</a>
      </span>
      <div class="live-footer__items" id="bestLapsFooter"></div>
    </div>
  </div>

  <!-- ── Main layout ───────────────────────────────────────────────────────── -->
  <div class="live-layout">

    <!-- Lane cards + header de columnas (V1) como primer hijo para compartir
         el padding del contenedor y alinearse con las filas. En V2 el header
         se oculta vía CSS body:has(.live-lanes--vertical). -->
    <div class="live-lanes" id="lanesGrid">
      <div class="lanes-header" id="lanesHeader" aria-hidden="true">
        <div class="lh-col lh-col--name"><%= lang === 'es' ? 'PILOTO' : 'DRIVER' %></div>
        <div class="lh-col lh-col--vlt"   data-col="vlt"><%= lang === 'es' ? 'VLT' : 'LAP' %></div>
        <div class="lh-col lh-col--total" data-col="total"><%= lang === 'es' ? 'TOTAL' : 'TOTAL' %></div>
        <div class="lh-col lh-col--last"  data-col="ultima"><%= lang === 'es' ? 'ÚLTIMA' : 'LAST' %></div>
        <div class="lh-col lh-col--best"  data-col="mejor"><%= lang === 'es' ? 'MEJOR' : 'BEST' %></div>
        <div class="lh-col lh-col--avg"   data-col="media"><%= lang === 'es' ? 'MEDIA' : 'AVG' %></div>
        <div class="lh-col lh-col--delta" data-col="delta"><%= lang === 'es' ? 'GAP V' : 'GAP L' %></div>
        <div class="lh-col lh-col--next"><%= lang === 'es' ? 'PRÓX.' : 'NEXT' %></div>
      </div>
    </div>

    <!-- Resizer (oculto: la sidebar ya no se muestra en la vista principal) -->
    <div id="sidebarResizer" class="sidebar-resizer" style="display:none" title="<%= lang === 'es' ? 'Arrastra para redimensionar' : 'Drag to resize' %>"></div>

    <!-- Sidebar: clasificación estimada — OCULTA en la vista principal. Se
         abre en ventana independiente con el botón 📊 del header. Mantenemos
         los IDs en el DOM para que live.js (renderProjected, fitSidebarTable)
         no falle al buscarlos. -->
    <aside class="live-sidebar" id="liveSidebar" style="display:none">
      <div class="live-panel">
        <div class="live-panel__title">
          <%= lang === 'es' ? 'CLASIFICACIÓN ESTIMADA' : 'PROJECTED STANDINGS' %>
          <a href="/races/<%= race.id %>/mangas/<%= manga.id %>/panel/standings" target="_blank" class="panel-expand" title="<%= lang === 'es' ? 'Abrir en ventana' : 'Open in window' %>">⤢</a>
        </div>
        <div class="live-panel__body">
        <table class="sidebar-table sidebar-table--auto">
          <thead>
            <tr>
              <th>#</th>
              <th><%= lang === 'es' ? 'Participante' : 'Participant' %></th>
              <th class="sr-right" title="<%= lang === 'es' ? 'Vueltas proyectadas al final de la carrera' : 'Projected laps at end of race' %>"><%= lang === 'es' ? 'V. Proy.' : 'Proj.' %></th>
              <th class="sr-right" title="<%= lang === 'es' ? 'Vueltas reales acumuladas' : 'Actual laps so far' %>"><%= lang === 'es' ? 'Total' : 'Total' %></th>
              <th class="sr-right"><%= lang === 'es' ? 'Media' : 'Avg' %></th>
              <th class="sr-center" title="<%= lang === 'es' ? 'Tendencia (arriba/abajo)' : 'Trend (up/down)' %>">↕</th>
              <th class="sr-right" title="<%= lang === 'es' ? 'Vueltas proyectadas respecto al de delante' : 'Projected laps behind the car ahead' %>"><%= lang === 'es' ? 'Gap V' : 'Gap L' %></th>
              <th class="sr-right" title="<%= lang === 'es' ? 'Vueltas proyectadas respecto al primer clasificado' : 'Projected laps behind the leader' %>"><%= lang === 'es' ? 'Gap V.T.' : 'Gap L.T.' %></th>
            </tr>
          </thead>
          <tbody id="projectedBody"></tbody>
        </table>
        </div>
      </div>
    </aside>
  </div>

  <!-- Footer eliminado: las vueltas rápidas se muestran ahora en la toolbar. -->

  <%
    // Compute initial lane state from DB laps
    const LC = ['#e63946','#2196f3','#4caf50','#ff9800','#9c27b0','#00bcd4','#ff5722','#607d8b','#795548','#e91e63','#3f51b5','#009688','#cddc39','#ffc107','#f44336','#673ab7','#03a9f4','#8bc34a','#ff6f00','#880e4f','#1a237e','#b71c1c','#004d40','#f57f17','#311b92','#0d47a1','#1b5e20','#33691e','#bf360c','#4a148c','#006064','#827717'];
    const laneInit = {};
    // Number resting entities (1..N) alphabetically by name so each rest
    // entity has its own card with "Descanso n/N".
    // Totales y mangas PENDIENTES por ENTIDAD (de aggregateByRace + asignaciones).
    // finished_race (del controlador) = ya no le quedan mangas por CORRER
    // después de la actual (por POSICIÓN, no por estado). Así funciona tanto en
    // vivo como revisando una carrera cerrada: en la manga 7/11 un equipo que
    // aún corre la 9/10/11 NO está FINAL.
    const entityTotalLaps = {};
    const entityTotalTime = {};
    const entityFinished  = {};
    (allParticipants || []).forEach(p => {
      if (p.entity_id == null) return;
      const k = `${p.entity_type === 'team' ? 't' : 'd'}${p.entity_id}`;
      entityTotalLaps[k] = p.total_laps || 0;
      entityTotalTime[k] = p.total_time_ms || 0;
      entityFinished[k]  = !!p.finished_race;
    });
    // Entidades que NO corren esta manga: separar las que aún volverán a correr
    // (DESCANSO, le quedan carriles) de las que ya han corrido TODOS sus carriles
    // (FINAL). Solo las que descansan entran en la "rueda de descansos" (x/y);
    // las acabadas salen de esa rueda y se marcan como FINAL.
    const keyOf = l => l.team_id ? `t${l.team_id}` : `d${l.driver_id}`;
    const notRacing = lanes.filter(l => l.is_rest)
      .sort((a, b) => (a.team_name || a.driver_name || '').localeCompare(b.team_name || b.driver_name || ''));
    const restingEntries  = notRacing.filter(l => !entityFinished[keyOf(l)]);
    const finishedEntries = notRacing.filter(l =>  entityFinished[keyOf(l)]);
    const restTotal = restingEntries.length;
    const cardInfoByKey = {};
    restingEntries.forEach((l, i)  => { cardInfoByKey[keyOf(l)] = { cardId: 'r' + (i + 1), restPos: i + 1, finished: false }; });
    finishedEntries.forEach((l, i) => { cardInfoByKey[keyOf(l)] = { cardId: 'f' + (i + 1), restPos: null,    finished: true  }; });
    lanes.forEach(l => {
      const entityKey = l.team_id ? `t${l.team_id}` : (l.driver_id ? `d${l.driver_id}` : null);
      const info    = (l.is_rest && entityKey) ? cardInfoByKey[entityKey] : null;
      const cardId  = l.is_rest ? (info ? info.cardId : 'r0') : String(l.lane);
      laneInit[cardId] = {
        cardId,
        lane:         l.lane,
        name:         l.team_name || l.driver_name || ('Lane ' + l.lane),
        country:      l.team_country || null,
        categoria:    l.team_categoria || null,
        color:        l.is_rest ? (l.team_color || '#484f58') : (LC[l.lane - 1] || '#8b949e'),
        isRest:       l.is_rest ? true : false,
        finished:     info ? info.finished : false,
        restPos:      info ? info.restPos : null,
        restTotal,
        lapCount:     0, bestLapMs: null, lastLapMs: null, exitCount: 0,
        prevLapCount: l.is_rest
          ? (entityKey ? (entityTotalLaps[entityKey] || 0) : 0)
          : (prevLapsByLane[l.lane] || 0),
        totalTimeMs:  entityKey ? (entityTotalTime[entityKey] || 0) : null,
        _lapSum: 0, _lapN: 0, avgLapMs: null,
        teamMembers:  teamMembersByLane[l.lane] || [],
        activeDriver: activeDriversByLane[l.lane] || null,
        entityId:     l.team_id || l.driver_id || null,
        entityType:   l.team_id ? 'team' : (l.driver_id ? 'driver' : null),
      };
    });
    laps.forEach(l => {
      const s = laneInit[l.lane];
      if (!s || s.isRest) return;
      s.lapCount = Math.max(s.lapCount, l.lap_number);
      if (!l.is_warmup) s.lastLapMs = l.lap_time_ms;
      // lap_number > 1: la 1ª vuelta de la manga no cuenta como mejor vuelta.
      if (!l.is_exit && l.lap_number > 1 && (!s.bestLapMs || l.lap_time_ms < s.bestLapMs)) s.bestLapMs = l.lap_time_ms;
      if (l.is_exit) s.exitCount++;
      // Media "sucia" = igual que el servidor: excluye SOLO el warmup (out-lap),
      // incluye las salidas. (Antes incluía el warmup y excluía salidas → medias
      // absurdas de 0,2-5s cuando el out-lap pesaba en pocas vueltas.)
      if (!l.is_warmup) { s._lapSum += l.lap_time_ms; s._lapN++; }
    });
    Object.values(laneInit).forEach(s => {
      s.avgLapMs = s._lapN > 0 ? Math.round(s._lapSum / s._lapN) : null;
    });
  %>

