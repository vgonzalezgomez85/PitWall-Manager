<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= race.name %> — <%= lang === 'es' ? 'Manga' : 'Heat' %> <%= manga.number %> — Voltrace Manager</title>
  <link rel="icon" type="image/svg+xml" href="/img/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32"  href="/img/favicon-32.png">
  <link rel="icon" type="image/png" sizes="256x256" href="/img/favicon-256.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Rajdhani:wght@500;600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/live.css?v=<%= Date.now() %>">
</head>
<body class="live-body">

  <!-- ── Header ────────────────────────────────────────────────────────────── -->
  <header class="live-header">
    <div class="live-header__timer">
      <div id="raceTimer" class="live-timer"><%= String(race.manga_duration_minutes).padStart(2,'0') %>:00</div>
      <div class="live-timer-label"><%= lang === 'es' ? 'tiempo' : 'time' %></div>
    </div>

    <div class="live-header__info">
      <div class="live-manga-id">
        <% if (tanda) { %>
          <span class="live-tanda-tag"><%= lang === 'es' ? 'Tanda' : 'Round' %> <%= tanda.number %>/<%= typeof totalTandas !== 'undefined' ? totalTandas : '?' %></span>
        <% } %>
        <span class="live-manga-tag">
          <%= lang === 'es' ? 'Manga' : 'Heat' %> <%= manga.number %>/<%= typeof totalMangas !== 'undefined' ? totalMangas : '?' %>
        </span>
      </div>
      <div id="timerStatus" class="live-status">
        <% if (isActive) { %>
          <span class="status-dot status-dot--active"></span>
          <span class="status-text status-text--active"><%= lang === 'es' ? 'En carrera' : 'Racing' %></span>
        <% } else if (manga.status === 'finished') { %>
          <span class="status-text status-text--finished"><%= lang === 'es' ? 'Finalizada' : 'Finished' %></span>
        <% } else { %>
          <span class="status-text status-text--pending"><%= lang === 'es' ? 'En espera' : 'Pending' %></span>
        <% } %>
      </div>
      <div class="live-race-subtitle"><%= race.name %></div>
    </div>

    <div class="live-header__actions">
      <% if (isSimulating) { %>
        <% if (manga.status === 'pending' && !isActive) { %>
          <form action="/races/<%= race.id %>/mangas/<%= manga.id %>/start" method="POST" style="display:inline">
            <button class="lbtn lbtn--go" type="submit" title="<%= lang === 'es' ? 'Arrancar simulación' : 'Start simulation' %>">▶ GO</button>
          </form>
        <% } else if (isActive) { %>
          <form action="/races/<%= race.id %>/mangas/<%= manga.id %>/stop" method="POST" style="display:inline"
            onsubmit="return confirm('<%= lang === 'es' ? '¿Parar la manga y borrar las vueltas registradas?' : 'Stop the heat and delete recorded laps?' %>')">
            <button class="lbtn lbtn--repeat" type="submit" title="<%= lang === 'es' ? 'Parar simulación' : 'Stop simulation' %>">■ STOP</button>
          </form>
        <% } %>
      <% } %>
      <% if (typeof nextTanda !== 'undefined' && nextTanda) { %>
        <button id="next-tanda-btn" class="lbtn lbtn--go"
                data-race-id="<%= race.id %>"
                data-tanda-id="<%= tanda.id %>"
                data-next-tanda-number="<%= nextTanda.number %>">
          ▶ Tanda <%= nextTanda.number %>
        </button>
      <% } %>
      <% if (manga.status === 'finished') { %>
        <form action="/races/<%= race.id %>/mangas/<%= manga.id %>/repeat" method="POST" style="display:inline"
          onsubmit="return confirm('<%= lang === 'es' ? '¿Repetir esta manga? Se borrarán las vueltas registradas.' : 'Repeat this heat? All recorded laps will be deleted.' %>')">
          <button class="lbtn lbtn--repeat">↺ <%= lang === 'es' ? 'Repetir' : 'Repeat' %></button>
        </form>
      <% } %>
      <button id="voiceBtn" class="lbtn lbtn--back" onclick="toggleVoice()">🔊 <%= lang === 'es' ? 'Todas' : 'All' %></button>
      <button id="viewBtn" class="lbtn lbtn--view" title="<%= lang === 'es' ? 'Cambiar vista' : 'Change view' %>" onclick="openViewPicker()">🖼 <%= lang === 'es' ? 'Vista' : 'View' %></button>
      <button class="lbtn lbtn--back" title="<%= lang === 'es' ? 'Clasificación general (ventana)' : 'Overall standings (window)' %>"
        onclick="window.open('/races/<%= race.id %>/mangas/<%= manga.id %>/panel/standings','_blank','width=620,height=780')">📊</button>
      <button class="lbtn lbtn--back" title="<%= lang === 'es' ? 'Vueltas rápidas por pista (ventana)' : 'Fastest laps by lane (window)' %>"
        onclick="window.open('/races/<%= race.id %>/mangas/<%= manga.id %>/panel/fastest','_blank','width=480,height=560')">⚡</button>
      <button class="lbtn lbtn--back" title="<%= lang === 'es' ? 'Minimapa del circuito (ventana)' : 'Track minimap (window)' %>"
        onclick="window.open('/races/<%= race.id %>/mangas/<%= manga.id %>/panel/track','_blank','width=900,height=600')">🗺</button>
      <a href="/races/<%= race.id %>/mangas/<%= manga.id %>/tv" target="_blank" class="lbtn lbtn--back" title="<%= lang === 'es' ? 'Pantalla TV' : 'TV display' %>">📺</a>
      <% if (race.format === 'team' && totalMangas > 1 && license.tier === 'pro') { %>
        <a href="/races/<%= race.id %>/lemans" target="_blank" class="lbtn lbtn--back" title="<%= lang === 'es' ? 'Clasificación Le Mans' : 'Le Mans standings' %>">🏁</a>
      <% } %>
      <a href="/races/<%= race.id %>/mangas/<%= manga.id %>/corrections" target="_blank" class="lbtn lbtn--back" title="<%= lang === 'es' ? 'Corrección de vueltas' : 'Lap corrections' %>">🔧</a>
      <a href="/races/<%= race.id %>" class="lbtn lbtn--back">← <%= lang === 'es' ? 'Volver' : 'Back' %></a>
    </div>
  </header>

  <!-- DS-300 link-down banner (hidden until socket fires serial:status) -->
  <div id="serialBanner" class="serial-banner" hidden>
    <span class="serial-banner__icon">⚠️</span>
    <span class="serial-banner__text">
      <%= lang === 'es'
        ? 'Sin señal del DS-300. Las vueltas que ocurran ahora no se registrarán.'
        : 'No signal from DS-300. Laps occurring now will not be recorded.' %>
    </span>
    <span id="serialBannerSince" class="serial-banner__since"></span>
  </div>

  <!-- ── Toolbar: VUELTAS RÁPIDAS ────────────────────────────────────────── -->
  <div class="live-toolbar" id="liveToolbar">
    <div class="live-toolbar__fastest">
      <span class="live-toolbar__label live-toolbar__label--fast">
        ⚡ <%= lang === 'es' ? 'VUELTAS RÁPIDAS' : 'FASTEST LAPS' %>
        <a href="/races/<%= race.id %>/mangas/<%= manga.id %>/panel/fastest" target="_blank" class="panel-expand" title="<%= lang === 'es' ? 'Abrir en ventana' : 'Open in window' %>">⤢</a>
      </span>
      <div class="live-footer__items" id="bestLapsFooter"></div>
    </div>
  </div>

  <!-- ── Main layout ───────────────────────────────────────────────────────── -->
  <div class="live-layout">

    <!-- Lane cards + header de columnas (V1) como primer hijo para compartir
         el padding del contenedor y alinearse con las filas. En V2 el header
         se oculta vía CSS body:has(.live-lanes--vertical). -->
    <div class="live-lanes" id="lanesGrid">
      <div class="lanes-header" id="lanesHeader" aria-hidden="true">
        <div class="lh-col lh-col--name"><%= lang === 'es' ? 'PILOTO' : 'DRIVER' %></div>
        <div class="lh-col lh-col--vlt"   data-col="vlt"><%= lang === 'es' ? 'VLT' : 'LAP' %></div>
        <div class="lh-col lh-col--total" data-col="total"><%= lang === 'es' ? 'TOTAL' : 'TOTAL' %></div>
        <div class="lh-col lh-col--last"  data-col="ultima"><%= lang === 'es' ? 'ÚLTIMA' : 'LAST' %></div>
        <div class="lh-col lh-col--best"  data-col="mejor"><%= lang === 'es' ? 'MEJOR' : 'BEST' %></div>
        <div class="lh-col lh-col--avg"   data-col="media"><%= lang === 'es' ? 'MEDIA' : 'AVG' %></div>
        <div class="lh-col lh-col--exits" data-col="salidas"><%= lang === 'es' ? 'SALIDAS' : 'EXITS' %></div>
        <div class="lh-col lh-col--delta" data-col="delta">Δ</div>
        <div class="lh-col lh-col--next"><%= lang === 'es' ? 'PRÓX.' : 'NEXT' %></div>
      </div>
    </div>

    <!-- Resizer (oculto: la sidebar ya no se muestra en la vista principal) -->
    <div id="sidebarResizer" class="sidebar-resizer" style="display:none" title="<%= lang === 'es' ? 'Arrastra para redimensionar' : 'Drag to resize' %>"></div>

    <!-- Sidebar: clasificación estimada — OCULTA en la vista principal. Se
         abre en ventana independiente con el botón 📊 del header. Mantenemos
         los IDs en el DOM para que live.js (renderProjected, fitSidebarTable)
         no falle al buscarlos. -->
    <aside class="live-sidebar" id="liveSidebar" style="display:none">
      <div class="live-panel">
        <div class="live-panel__title">
          <%= lang === 'es' ? 'CLASIFICACIÓN ESTIMADA' : 'PROJECTED STANDINGS' %>
          <a href="/races/<%= race.id %>/mangas/<%= manga.id %>/panel/standings" target="_blank" class="panel-expand" title="<%= lang === 'es' ? 'Abrir en ventana' : 'Open in window' %>">⤢</a>
        </div>
        <div class="live-panel__body">
        <table class="sidebar-table sidebar-table--auto">
          <thead>
            <tr>
              <th>#</th>
              <th><%= lang === 'es' ? 'Participante' : 'Participant' %></th>
              <th class="sr-right" title="<%= lang === 'es' ? 'Vueltas proyectadas al final de la carrera' : 'Projected laps at end of race' %>"><%= lang === 'es' ? 'V. Proy.' : 'Proj.' %></th>
              <th class="sr-right" title="<%= lang === 'es' ? 'Vueltas reales acumuladas' : 'Actual laps so far' %>"><%= lang === 'es' ? 'Total' : 'Total' %></th>
              <th class="sr-right"><%= lang === 'es' ? 'Media' : 'Avg' %></th>
              <th class="sr-center" title="<%= lang === 'es' ? 'Tendencia (arriba/abajo)' : 'Trend (up/down)' %>">↕</th>
              <th class="sr-right"><%= lang === 'es' ? 'Gap V' : 'Gap L' %></th>
              <th class="sr-right"><%= lang === 'es' ? 'Gap S' : 'Gap S' %></th>
            </tr>
          </thead>
          <tbody id="projectedBody"></tbody>
        </table>
        </div>
      </div>
    </aside>
  </div>

  <!-- Footer eliminado: las vueltas rápidas se muestran ahora en la toolbar. -->

  <%
    // Compute initial lane state from DB laps
    const LC = ['#e63946','#2196f3','#4caf50','#ff9800','#9c27b0','#00bcd4','#ff5722','#607d8b','#795548','#e91e63','#3f51b5','#009688','#cddc39','#ffc107','#f44336','#673ab7','#03a9f4','#8bc34a','#ff6f00','#880e4f','#1a237e','#b71c1c','#004d40','#f57f17','#311b92','#0d47a1','#1b5e20','#33691e','#bf360c','#4a148c','#006064','#827717'];
    const laneInit = {};
    // Number resting entities (1..N) alphabetically by name so each rest
    // entity has its own card with "Descanso n/N".
    const restEntries = lanes.filter(l => l.is_rest)
      .sort((a, b) => (a.team_name || a.driver_name || '').localeCompare(b.team_name || b.driver_name || ''));
    const restTotal = restEntries.length;
    const restPosByEntityKey = {};
    restEntries.forEach((r, i) => {
      const key = r.team_id ? `t${r.team_id}` : `d${r.driver_id}`;
      restPosByEntityKey[key] = i + 1;
    });
    lanes.forEach(l => {
      const entityKey = l.team_id ? `t${l.team_id}` : (l.driver_id ? `d${l.driver_id}` : null);
      const restPos = l.is_rest && entityKey ? restPosByEntityKey[entityKey] : null;
      const cardId  = l.is_rest ? ('r' + (restPos || 0)) : String(l.lane);
      laneInit[cardId] = {
        cardId,
        lane:         l.lane,
        name:         l.team_name || l.driver_name || ('Lane ' + l.lane),
        color:        l.is_rest ? (l.team_color || '#484f58') : (LC[l.lane - 1] || '#8b949e'),
        isRest:       l.is_rest ? true : false,
        restPos, restTotal,
        lapCount:     0, bestLapMs: null, lastLapMs: null, exitCount: 0,
        prevLapCount: prevLapsByLane[l.lane] || 0,
        _lapSum: 0, _lapN: 0, avgLapMs: null,
        teamMembers:  teamMembersByLane[l.lane] || [],
        activeDriver: activeDriversByLane[l.lane] || null,
        entityId:     l.team_id || l.driver_id || null,
        entityType:   l.team_id ? 'team' : (l.driver_id ? 'driver' : null),
      };
    });
    laps.forEach(l => {
      const s = laneInit[l.lane];
      if (!s || s.isRest) return;
      s.lapCount = Math.max(s.lapCount, l.lap_number);
      s.lastLapMs = l.lap_time_ms;
      if (!l.is_exit && (!s.bestLapMs || l.lap_time_ms < s.bestLapMs)) s.bestLapMs = l.lap_time_ms;
      if (l.is_exit) { s.exitCount++; } else { s._lapSum += l.lap_time_ms; s._lapN++; }
    });
    Object.values(laneInit).forEach(s => {
      s.avgLapMs = s._lapN > 0 ? Math.round(s._lapSum / s._lapN) : null;
    });
  %>

  <script>
    const RACE_DATA = <%- JSON.stringify({
      id:             race.id,
      raceId:         race.id,
      mangaId:        manga.id,
      tandaId:        manga.tanda_id,
      mangaNumber:    manga.number,
      mangaStatus:    manga.status,
      isActive:       isActive,
      isTeam:         race.format === 'team',
      durationMs:     null,
      mangaDurationMs: race.manga_duration_minutes * 60000,
      standings:      standings,
      lanes:          Object.values(laneInit),
      raceBestLaps:   raceBestLaps,
      hasQrCheckin:   hasQrCheckin,
      nextLaneByLane: nextLaneByLane || {},
      nextMangaInfo:  nextMangaInfo  || null,
    }) %>;
    RACE_DATA.allParticipants = <%- JSON.stringify(allParticipants) %>;
    const LANG = "<%= lang %>";
  </script>
  <!-- ── View picker modal ────────────────────────────────────────────────── -->
  <div id="viewPickerOverlay" class="vp-overlay" hidden onclick="if(event.target===this)closeViewPicker()">
    <div class="vp-modal" role="dialog" aria-modal="true" aria-labelledby="vpTitle">
      <div class="vp-header">
        <div id="vpTitle" class="vp-title"><%= lang === 'es' ? 'Elige cómo quieres ver la carrera' : 'Choose how to view the race' %></div>
        <button class="vp-x" onclick="closeViewPicker()" aria-label="<%= lang === 'es' ? 'Cerrar' : 'Close' %>">✕</button>
      </div>
      <div class="vp-grid">
        <button class="vp-opt" data-mode="1" onclick="selectView('1')">
          <div class="vp-thumb vp-thumb--1" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span><span></span>
          </div>
          <div class="vp-label"><%= lang === 'es' ? 'Filas horizontales' : 'Horizontal rows' %></div>
          <div class="vp-desc"><%= lang === 'es' ? 'Una fila por carril. Recomendado para pocos carriles.' : 'One row per lane. Recommended for few lanes.' %></div>
        </button>
        <button class="vp-opt" data-mode="2" onclick="selectView('2')">
          <div class="vp-thumb vp-thumb--2" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
          </div>
          <div class="vp-label"><%= lang === 'es' ? 'Cuadrícula compacta' : 'Compact grid' %></div>
          <div class="vp-desc"><%= lang === 'es' ? 'Todas las pistas a la vez. Ideal para muchos carriles.' : 'All lanes at once. Ideal for many lanes.' %></div>
        </button>
        <button class="vp-opt" data-mode="3" onclick="selectView('3')">
          <div class="vp-thumb vp-thumb--3" aria-hidden="true">
            <span><i></i><i></i><i></i><i></i></span>
            <span><i></i><i></i><i></i><i></i></span>
            <span><i></i><i></i><i></i><i></i></span>
            <span><i></i><i></i><i></i><i></i></span>
          </div>
          <div class="vp-label"><%= lang === 'es' ? 'Tarjetas con detalles' : 'Detailed cards' %></div>
          <div class="vp-desc"><%= lang === 'es' ? 'Como la compacta pero con VLT, SAL, PIT y Δ visibles en cada tarjeta.' : 'Like compact but with VLT, SAL, PIT and Δ visible on each card.' %></div>
        </button>
      </div>
    </div>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/live.js?v=<%= Date.now() %>"></script>
  <script>
    (function () {
      const resizer = document.getElementById('sidebarResizer');
      const sidebar = document.getElementById('liveSidebar');
      if (!resizer || !sidebar) return;

      const KEY = 'voltrace.liveSidebarW';
      const MIN = 260, MAX_FRACTION = 0.75;

      const saved = parseInt(localStorage.getItem(KEY), 10);
      if (saved && saved >= MIN) {
        document.documentElement.style.setProperty('--sidebar-w', saved + 'px');
      }

      let startX = 0, startW = 0;
      function onDown(e) {
        startX = e.clientX;
        startW = sidebar.getBoundingClientRect().width;
        document.body.classList.add('resizing-sidebar');
        resizer.classList.add('dragging');
        window.addEventListener('mousemove', onMove);
        window.addEventListener('mouseup', onUp, { once: true });
        e.preventDefault();
      }
      function onMove(e) {
        const dx = e.clientX - startX;
        const maxW = Math.floor(window.innerWidth * MAX_FRACTION);
        const w = Math.min(maxW, Math.max(MIN, startW - dx));
        document.documentElement.style.setProperty('--sidebar-w', w + 'px');
      }
      function onUp() {
        document.body.classList.remove('resizing-sidebar');
        resizer.classList.remove('dragging');
        window.removeEventListener('mousemove', onMove);
        const w = sidebar.getBoundingClientRect().width;
        localStorage.setItem(KEY, String(Math.round(w)));
      }
      resizer.addEventListener('mousedown', onDown);
      resizer.addEventListener('dblclick', () => {
        document.documentElement.style.setProperty('--sidebar-w', '380px');
        localStorage.removeItem(KEY);
      });
    })();
  </script>
</body>
</html>
