<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= race.name %> — <%= lang === 'es' ? 'Clasificación' : 'Standings' %></title>
  <link rel="icon" type="image/svg+xml" href="/img/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32"  href="/img/favicon-32.png">
  <link rel="icon" type="image/png" sizes="256x256" href="/img/favicon-256.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Share+Tech+Mono&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:       #0d0d0d;
      --surface:  #161b22;
      --surface2: #1c2330;
      --border:   #30363d;
      --text:     #e6edf3;
      --muted:    #8b949e;
      --gold:     #f6c90e;
      --silver:   #b0b8c0;
      --bronze:   #cd7f4a;
      --green:    #3fb950;
      --header-h: 64px;
      --row-h:    58px;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* ── Header ── */
    .lm-header {
      height: var(--header-h);
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1.5rem;
      gap: 1rem;
      position: sticky;
      top: 0;
      z-index: 10;
    }
    .lm-header__race {
      font-size: 1.1rem;
      font-weight: 700;
      letter-spacing: .02em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .lm-header__title {
      font-size: .75rem;
      font-weight: 600;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .lm-header__badge {
      display: flex;
      align-items: center;
      gap: .4rem;
      font-size: .7rem;
      font-weight: 600;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .lm-live-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--green);
      animation: pulse 1.2s ease-in-out infinite;
    }
    @keyframes pulse {
      0%,100% { opacity: 1; }
      50%      { opacity: .3; }
    }
    .lm-header__left { min-width: 0; }
    .lm-header__mid { display: flex; align-items: center; gap: 1.3rem; }
    .lm-stat { display: flex; flex-direction: column; align-items: center; line-height: 1.05; }
    .lm-stat__lbl { font-size: .52rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
    .lm-stat__val { font-family: 'Share Tech Mono', monospace; font-size: 1.15rem; font-weight: 700; color: var(--text); }
    #lmTimer { color: var(--gold); }
    .lm-state { padding: .25rem .7rem; border-radius: 6px; font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
    .lm-state--running  { background: rgba(63,185,80,.15);  color: var(--green); }
    .lm-state--paused   { background: rgba(246,201,14,.15); color: var(--gold); }
    .lm-state--finished { background: #21262d; color: var(--muted); }
    .lm-clock { font-family: 'Share Tech Mono', monospace; font-size: 1.25rem; font-weight: 700; color: var(--text); }
    /* Carril: badge de color con el nº, mismo tamaño que V.Proy */
    .lane-pill {
      display: inline-flex; align-items: center; justify-content: center;
      min-width: 30px; height: 30px; border-radius: 6px;
      font-family: 'Share Tech Mono', monospace;
      font-size: 1.05rem; font-weight: 700; color: #0d1117;
    }

    /* ── Table ── */
    .lm-wrap {
      padding: .5rem 1rem 2rem;
      max-width: 1280px;
      margin: 0 auto;
    }

    /* Columnas estilo "estimada": proyectadas, media, p/subir */
    .td-proj {
      width: 74px; text-align: right;
      font-family: 'Share Tech Mono', monospace;
      font-size: 1.05rem; font-weight: 700; color: var(--gold);
    }
    .td-avg {
      width: 78px; text-align: right;
      font-family: 'Share Tech Mono', monospace;
      font-size: .78rem; color: #9ca3af;
    }
    .td-psub {
      width: 82px; text-align: right;
      font-family: 'Share Tech Mono', monospace;
      font-size: .78rem; color: #f97316;
    }
    /* Tendencia ▲▼ */
    .lm-trend { display:inline-flex; flex-direction:column; line-height:.7; margin-right:.15rem; font-size:.6rem; }
    .lm-trend .up   { color:#30363d; }
    .lm-trend .down { color:#30363d; }
    .lm-trend .up.good, .lm-trend .down.good { color:#3fb950; }
    .lm-trend .up.bad,  .lm-trend .down.bad  { color:#e63946; }

    .lm-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0 3px;
    }

    .lm-table thead th {
      font-size: .6rem;
      font-weight: 600;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--muted);
      padding: .5rem .6rem;
      text-align: left;
      border-bottom: 1px solid var(--border);
    }
    .lm-table thead th.th-r { text-align: right; }

    /* Car photo cell */
    .td-car {
      width: 96px;
      padding: .3rem .4rem;
    }
    .car-img {
      height: 48px;
      max-width: 90px;
      object-fit: contain;
      border-radius: 4px;
      background:#000000;
      display: block;
    }
    .car-placeholder {
      width: 80px; height: 44px;
      border-radius: 4px;
      background: #161b22;
      border: 1px solid #21262d;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: .65rem;
      color: #30363d;
    }

    /* Category badge */
    .cat-badge {
      display: inline-block;
      padding: .15rem .5rem;
      border-radius: 12px;
      font-size: .65rem;
      font-weight: 700;
      letter-spacing: .07em;
      text-transform: uppercase;
      background: #21262d;
      color: #e6edf3;
      white-space: nowrap;
    }

    /* Row */
    .lm-row {
      background: var(--surface);
      transition: background .15s;
      cursor: default;
    }
    .lm-row:hover { background: var(--surface2); }
    .lm-row.row--leader { background: rgba(246,201,14,.06); }
    .lm-row.row--leader:hover { background: rgba(246,201,14,.1); }
    .lm-row.row--new-best td { animation: bestFlash .8s ease-out; }
    @keyframes bestFlash {
      0%   { background: rgba(63,185,80,.25); }
      100% { background: transparent; }
    }

    .lm-row td {
      padding: .55rem .6rem;
      vertical-align: middle;
      white-space: nowrap;
    }
    .lm-row td:first-child { border-radius: 4px 0 0 4px; }
    .lm-row td:last-child  { border-radius: 0 4px 4px 0; }

    /* Position */
    .td-pos {
      width: 40px;
      text-align: center;
    }
    .pos-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px; height: 28px;
      border-radius: 50%;
      font-size: .75rem;
      font-weight: 700;
      background: #21262d;
      color: var(--muted);
    }
    .pos-badge.p1 { background: var(--gold);   color: #0d1117; }
    .pos-badge.p2 { background: var(--silver); color: #0d1117; }
    .pos-badge.p3 { background: var(--bronze); color: #fff; }

    /* Color bar */
    .td-bar {
      width: 42px;
      padding: 0 .3rem;
      text-align: center;
    }
    .color-bar {
      width: 4px;
      height: 38px;
      border-radius: 2px;
    }

    /* Team + driver */
    .td-team { min-width: 160px; }
    .team-name {
      font-size: .95rem;
      font-weight: 700;
      line-height: 1.2;
    }
    .team-driver {
      font-size: .72rem;
      color: var(--muted);
      margin-top: 1px;
      font-weight: 400;
    }
    .team-driver span {
      color: var(--green);
      font-weight: 600;
    }

    /* Laps */
    .td-laps {
      width: 70px;
      text-align: right;
      font-family: 'Share Tech Mono', monospace;
      font-size: 1.25rem;
      font-weight: 700;
      color: #e6edf3;
    }
    .row--leader .td-laps { color: var(--gold); }

    /* Gap */
    .td-gap {
      width: 80px;
      text-align: right;
    }
    .gap-badge {
      display: inline-block;
      padding: .15rem .55rem;
      border-radius: 20px;
      font-size: .72rem;
      font-weight: 600;
      font-family: 'Share Tech Mono', monospace;
      background: #21262d;
      color: var(--muted);
      min-width: 54px;
      text-align: center;
    }
    .gap-badge.gap--leader {
      background: rgba(246,201,14,.12);
      color: var(--gold);
    }
    .gap-badge.gap--1lap { background: rgba(255,87,34,.15); color: #ff5722; }
    .gap-badge.gap--2lap { background: rgba(255,87,34,.08); color: #ff7043; }

    /* Best */
    .td-best {
      width: 90px;
      text-align: right;
      font-family: 'Share Tech Mono', monospace;
      font-size: .78rem;
      color: #58a6ff;
    }
    .td-best .best--fastest { color: var(--gold); font-weight: 700; }

    /* Delta animation for lap count change */
    @keyframes lapPop {
      0%   { transform: scale(1.25); color: var(--green); }
      100% { transform: scale(1);    color: inherit; }
    }
    .lap-pop { animation: lapPop .5s ease-out forwards; }
  </style>
</head>
<body>

  <header class="lm-header">
    <div class="lm-header__left">
      <div class="lm-header__title"><%= lang === 'es' ? 'CLASIFICACIÓN GENERAL' : 'OVERALL STANDINGS' %></div>
      <div class="lm-header__race"><%= race.name %></div>
    </div>
    <div class="lm-header__mid">
      <div class="lm-stat"><span class="lm-stat__lbl"><%= lang === 'es' ? 'Manga' : 'Heat' %></span><span class="lm-stat__val" id="lmManga">—</span></div>
      <div class="lm-stat"><span class="lm-stat__lbl"><%= lang === 'es' ? 'Restante' : 'Remaining' %></span><span class="lm-stat__val" id="lmTimer">--:--</span></div>
      <div class="lm-state" id="lmState">—</div>
    </div>
    <div class="lm-header__right">
      <div class="lm-clock" id="lmClock">--:--:--</div>
    </div>
  </header>

  <div class="lm-wrap">
    <table class="lm-table">
      <thead>
        <tr>
          <th class="td-pos">P</th>
          <th class="td-bar" style="width:42px"><%= lang === 'es' ? 'Car.' : 'Ln' %></th>
          <th class="td-car"><%= lang === 'es' ? 'Coche' : 'Car' %></th>
          <th><%= lang === 'es' ? 'Equipo / Piloto activo' : 'Team / Active driver' %></th>
          <th style="width:80px"><%= lang === 'es' ? 'Categoría' : 'Category' %></th>
          <th class="th-r" style="width:74px" title="<%= lang === 'es' ? 'Vueltas proyectadas' : 'Projected laps' %>"><%= lang === 'es' ? 'V.Proy' : 'Proj' %></th>
          <th class="th-r" style="width:70px"><%= lang === 'es' ? 'Vueltas' : 'Laps' %></th>
          <th class="th-r" style="width:80px">Gap</th>
          <th class="th-r" style="width:78px"><%= lang === 'es' ? 'Media' : 'Avg' %></th>
          <th class="th-r" style="width:90px"><%= lang === 'es' ? 'Mejor' : 'Best' %></th>
          <th class="th-r" style="width:82px" title="<%= lang === 'es' ? 'Media necesaria para subir' : 'Avg needed to climb' %>"><%= lang === 'es' ? 'P/Subir' : 'To climb' %></th>
        </tr>
      </thead>
      <tbody id="lmBody"></tbody>
    </table>
  </div>

  <script>
    const LM_DATA = <%- JSON.stringify({
      standings:    standings,
      activeMangaId: activeMangaId,
      laneToTeam:   laneToTeam,
      isActive:     isActive,
      mangaDurationMs:   effectiveMangaDurationMs,
      currentRemainingMs: currentRemainingMs,
      mangaNumber:  mangaNumber,
      totalMangas:  totalMangas,
      raceStatus:   raceStatus,
    }) %>;
    const LANG = "<%= lang %>";
  </script>
  <script src="/socket.io/socket.io.js"></script>
  <script>
    // ── Helpers ───────────────────────────────────────────────────────────────
    function formatMs(ms) {
      if (ms == null) return '—';
      ms = Math.round(ms);   // sin esto, ms%1000 sobre un float arrastra basura de coma flotante
      const totalSec = Math.floor(ms / 1000);
      const millis   = ms % 1000;
      const secs = totalSec % 60;
      const mins = Math.floor(totalSec / 60);
      return `${mins > 0 ? mins + ':' : ''}${String(secs).padStart(mins > 0 ? 2 : 1, '0')}.${String(millis).padStart(3, '0')}`;
    }

    function posClass(p) {
      return p === 1 ? 'p1' : p === 2 ? 'p2' : p === 3 ? 'p3' : '';
    }

    function gapLabel(gap) {
      if (gap === 0) return `<span class="gap-badge gap--leader">—</span>`;
      const lbl = `+${gap} ${LANG === 'es' ? (gap === 1 ? 'vlt.' : 'vlts.') : (gap === 1 ? 'lap' : 'laps')}`;
      const cls = gap === 1 ? 'gap--1lap' : gap <= 2 ? 'gap--2lap' : '';
      return `<span class="gap-badge ${cls}">${lbl}</span>`;
    }

    // ── State ─────────────────────────────────────────────────────────────────
    // standings keyed by team name
    // Indexado por ID de equipo (no por nombre): hay equipos con nombre
    // repetido y por nombre se fusionaban (36 → 23).
    const state = {};
    LM_DATA.standings.forEach(s => {
      state[s.id] = {
        ...s,
        currentLaps: s.totalLaps - s.prevLaps, // laps in current/last manga
      };
    });

    // Track active drivers (updated via socket), por ID
    const activeDrivers = {};
    LM_DATA.standings.forEach(s => {
      if (s.currentDriver) activeDrivers[s.id] = s.currentDriver;
    });

    // ── Render ────────────────────────────────────────────────────────────────
    const tbody = document.getElementById('lmBody');

    // ── Carrusel: si las filas no caben en la ventana, rota por páginas ───────
    const LM_PAGE_MS = 12000;
    let _lmPage = 0, _lmTimer = null;
    function applyCarousel() {
      const allRows = Array.from(tbody.querySelectorAll('tr'));
      if (!allRows.length) return;
      allRows.forEach(r => { r.style.display = ''; });   // mostrar todo para medir
      const header = document.querySelector('.lm-header');
      const thead  = document.querySelector('.lm-table thead');
      const headerH = header ? header.offsetHeight : 0;
      const theadH  = thead ? thead.offsetHeight : 0;
      const avail   = window.innerHeight - headerH - theadH - 36;
      const rowH    = (allRows[0].getBoundingClientRect().height || 58) + 3; // + border-spacing
      const pageSize = Math.max(1, Math.floor(avail / rowH));
      if (pageSize >= allRows.length) {                  // caben todas → sin carrusel
        if (_lmTimer) { clearInterval(_lmTimer); _lmTimer = null; }
        _lmPage = 0;
        return;
      }
      const pages = Math.ceil(allRows.length / pageSize);
      _lmPage = _lmPage % pages;
      const from = _lmPage * pageSize, to = from + pageSize;
      allRows.forEach((r, i) => { r.style.display = (i >= from && i < to) ? '' : 'none'; });
      // Temporizador UNA sola vez (si se recrea en cada render nunca rota).
      if (!_lmTimer) {
        _lmTimer = setInterval(() => { _lmPage = _lmPage + 1; applyCarousel(); }, LM_PAGE_MS);
      }
    }
    window.addEventListener('resize', applyCarousel);

    function render() {
      const rows = Object.values(state);

      // Proyección ÚNICA (media-based) — MISMA fórmula que TimingService
      // .buildRaceProjection y que el panel/directo:
      //   proyección = vueltas_totales + (tiempo_restante ÷ media)
      // El servidor ya la calculó (r.projectedRaw / r.projected). En vivo solo
      // recomputamos con las vueltas nuevas y el reloj de la manga actual, usando
      // exactamente la misma fórmula (NO rate/distance).
      const CUR_REM = _remMs;   // restante de la manga activa, ya tickeado en cliente
      rows.forEach(r => {
        const remMs = (r.onTrack ? CUR_REM : 0) + (r.futureRemMs || 0);
        r._remMs = remMs;
        r.projectedRaw = (r.avgLapMs && r.avgLapMs > 0)
          ? r.totalLaps + remMs / r.avgLapMs
          : null;
        r.projected = r.projectedRaw != null ? Math.round(r.projectedRaw) : null;
      });

      // Orden por vueltas PROYECTADAS (desc); desempates: vueltas reales y luego
      // mejor vuelta (mismos criterios que la función única del servidor).
      rows.sort((a, b) => {
        if (a.projectedRaw == null && b.projectedRaw == null) return (a.name || '').localeCompare(b.name || '');
        if (a.projectedRaw == null) return 1;
        if (b.projectedRaw == null) return -1;
        return (b.projectedRaw - a.projectedRaw)
            || (b.totalLaps - a.totalLaps)
            || ((a.bestLapMs ?? Infinity) - (b.bestLapMs ?? Infinity));
      });
      const maxLaps   = Math.max(0, ...rows.map(r => r.totalLaps));
      const fastestMs  = Math.min(...rows.map(r => r.bestLapMs ?? Infinity));

      rows.forEach((r, i) => {
        r.position = i + 1;
        r.gap = maxLaps - r.totalLaps;   // vueltas tras el líder de distancia
      });
      rows.forEach((r, i) => {
        const above = rows[i - 1];
        if (i === 0 || !above || above.projectedRaw == null || !(r._remMs > 0)) { r.psubir = null; return; }
        const lapsNeeded = above.projectedRaw - r.totalLaps;
        const req = lapsNeeded > 0 ? r._remMs / lapsNeeded : null;
        r.psubir = (req != null && req > 0 && (!r.bestLapMs || req >= r.bestLapMs)) ? req : null;
      });

      tbody.innerHTML = rows.map(r => {
        const driver = activeDrivers[r.id] ?? r.currentDriver;
        const driverHtml = driver
          ? `<div class="team-driver"><span>${driver}</span></div>`
          : '';
        const isFastest = r.bestLapMs != null && r.bestLapMs === fastestMs;
        const bestHtml = r.bestLapMs != null
          ? `<span class="${isFastest ? 'best--fastest' : ''}">${formatMs(r.bestLapMs)}</span>`
          : '<span style="color:#30363d">—</span>';
        const carHtml = r.car_photo
          ? `<img class="car-img" src="${r.car_photo}" alt="${r.coche||''}">`
          : `<div class="car-placeholder">${r.coche ? r.coche.substring(0,8) : '—'}</div>`;
        const catHtml = r.categoria
          ? `<span class="cat-badge">${r.categoria}</span>`
          : `<span style="color:#30363d">—</span>`;

        return `<tr class="lm-row ${r.position===1?'row--leader':''}" data-team="${r.id}">
          <td class="td-pos"><span class="pos-badge ${posClass(r.position)}">${r.position}</span></td>
          <td class="td-bar">${r.currentLane != null
            ? `<span class="lane-pill" style="background:${r.color}">${r.currentLane}</span>`
            : `<span class="lane-pill" style="background:#21262d;color:#8b949e">—</span>`}</td>
          <td class="td-car">${carHtml}</td>
          <td class="td-team">
            <div class="team-name">${r.name}</div>
            ${r.coche ? `<div class="team-driver" style="color:#8b949e">${r.coche}</div>` : ''}
            ${driverHtml}
          </td>
          <td>${catHtml}</td>
          <td class="td-proj">${r.projectedRaw != null ? r.projectedRaw.toFixed(1).replace('.', ',') + 'v' : '—'}</td>
          <td class="td-laps" id="laps-${r.id}">${r.totalLaps}</td>
          <td class="td-gap">${gapLabel(r.gap)}</td>
          <td class="td-avg">${r.avgLapMs != null ? formatMs(r.avgLapMs) : '—'}</td>
          <td class="td-best">${bestHtml}</td>
          <td class="td-psub">${r.psubir != null ? formatMs(r.psubir) : '—'}</td>
        </tr>`;
      }).join('');
      applyCarousel();
    }

    // Countdown de la manga activa (compartido por render() para la proyección
    // media-based en vivo y por el reloj de cabecera). Declarado ANTES de
    // render() para no caer en la zona muerta temporal.
    let _remMs   = LM_DATA.currentRemainingMs || 0;
    let _running = LM_DATA.raceStatus === 'running';

    render();

    // ── Cabecera: reloj del sistema, manga X/total, estado y countdown ─────────
    function tickClock() {
      document.getElementById('lmClock').textContent =
        new Date().toLocaleTimeString(LANG === 'es' ? 'es-ES' : 'en-GB', { hour12: false });
    }
    tickClock(); setInterval(tickClock, 1000);

    document.getElementById('lmManga').textContent =
      (LM_DATA.mangaNumber != null) ? `${LM_DATA.mangaNumber}/${LM_DATA.totalMangas}`
      : (LM_DATA.totalMangas ? `–/${LM_DATA.totalMangas}` : '—');

    function setState(s) {
      const el = document.getElementById('lmState');
      const map = LANG === 'es'
        ? { running: 'EN CARRERA', paused: 'PAUSA', finished: 'FINALIZADA' }
        : { running: 'RACING', paused: 'PAUSED', finished: 'FINISHED' };
      const key = map[s] ? s : 'finished';
      el.textContent = map[key];
      el.className = 'lm-state lm-state--' + key;
    }
    setState(LM_DATA.raceStatus);

    function fmtTimer(ms) {
      ms = Math.max(0, Math.round(ms));
      const t = Math.floor(ms / 1000), m = Math.floor(t / 60), s = t % 60;
      return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
    }
    function paintTimer() {
      document.getElementById('lmTimer').textContent = (_running || _remMs > 0) ? fmtTimer(_remMs) : '--:--';
    }
    paintTimer();
    setInterval(() => { if (_running && _remMs > 0) { _remMs -= 1000; paintTimer(); } }, 1000);

    // ── Socket.io (SIEMPRE conectado) ─────────────────────────────────────────
    // Si una manga arranca después de cargar la página, recargamos para traer
    // el nuevo mapeo carril→equipo y el nº de manga.
    {
      const socket = io();
      const laneToTeam = LM_DATA.laneToTeam;

      socket.on('manga:started',   () => location.reload());
      socket.on('manga:paused',    () => { _running = false; setState('paused'); });
      socket.on('manga:resumed',   () => { _running = true;  setState('running'); });
      socket.on('manga:stopped',   () => { _running = false; setState('finished'); _remMs = 0; paintTimer(); });
      socket.on('manga:cancelled', () => { _running = false; setState('finished'); _remMs = 0; paintTimer(); });

      socket.on('standings', (data) => {
        if (!data?.standings) return;
        // Countdown + estado en vivo
        if (typeof data.remainingMs === 'number') _remMs = data.remainingMs;
        _running = true; setState('running'); paintTimer();
        let changed = false;
        data.standings.forEach(row => {
          const teamId = laneToTeam[row.lane];   // laneToTeam ahora mapea carril → team_id
          if (teamId == null || !state[teamId]) return;
          const s = state[teamId];
          const newTotal = s.prevLaps + row.lapCount;
          if (newTotal !== s.totalLaps) { s.totalLaps = newTotal; changed = true; }
          if (row.bestLapMs != null && (s.bestLapMs == null || row.bestLapMs < s.bestLapMs)) {
            s.bestLapMs = row.bestLapMs; changed = true;
          }
        });
        if (changed) render();
      });

      socket.on('driver_checkin', (data) => {
        const teamId = laneToTeam[data.lane];
        if (teamId != null && data.driverName) {
          activeDrivers[teamId] = data.driverName;
          render();
        }
      });
    }
  </script>
</body>
</html>
