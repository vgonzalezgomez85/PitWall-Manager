<%
// Resumen en frases: lo que va a pasar, no los campos internos (el formato sale
// del tipo y la duración de manga la manda la caja: no se enseñan).
const backStep1 = '/races/new?back=1';
const escapeHtml = (v) => String(v).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const minLap = wizard.min_lap_ms > 0 ? (wizard.min_lap_ms / 1000).toFixed(2).replace('.', ',') : null;
const typeTxt = wizard.type === 'championship' ? t('confirm.frase_tipo_resistencia') : t('confirm.frase_tipo_sprint');
const circuitTxt = wizard.circuit_name
  ? t('confirm.frase_circuito', { circuito: wizard.circuit_name, carriles: wizard.lanes_count })
  : t('confirm.frase_circuito_a_mano', { carriles: wizard.lanes_count });
%>
<%- include('../partials/header', { pageTitle: t('wizard.confirm_title') }) %>
<div class="container container--narrow">

  <%- include('../partials/wizard-progress', { current: 'confirm', hasPole: wizard.has_pole, skipSequence: !!wizard.circuit_id }) %>

  <h1 class="page-title"><%= t('confirm.esta_todo_bien') %></h1>
  <p class="page-subtitle cf-sub"><%= t('confirm.leelo_con_calma') %></p>

  <section class="cf-card">
    <div class="cf-row">
      <p><%- t('confirm.frase_nombre', { nombre: '<b>' + escapeHtml(wizard.name) + '</b>', tipo: '<b>' + escapeHtml(typeTxt) + '</b>' }) %></p>
      <a href="<%= backStep1 %>" class="btn btn--ghost cf-change"><%= t('confirm.cambiar') %></a>
    </div>
    <div class="cf-row">
      <p>
        <%= circuitTxt %>
        <% if (minLap) { %><%= t('confirm.frase_vuelta_minima', { s: minLap }) %><% } %>
      </p>
      <a href="<%= backStep1 %>" class="btn btn--ghost cf-change"><%= t('confirm.cambiar') %></a>
    </div>
    <div class="cf-row">
      <p><%= wizard.has_pole ? t('confirm.frase_con_pole') : t('confirm.frase_sin_pole') %></p>
      <a href="<%= backStep1 %>" class="btn btn--ghost cf-change"><%= t('confirm.cambiar') %></a>
    </div>
    <% const extras = [];
       if (wizard.passes > 1) extras.push(t('common.pasadas') + ': ' + wizard.passes);
       if (wizard.lane_repeat > 1) extras.push(t('common.repetir_carril') + ': ' + wizard.lane_repeat);
       if (wizard.tire_pairs_per_team > 0) extras.push(t('common.neumaticos_por_equipo') + ': ' + wizard.tire_pairs_per_team + ' ' + t('confirm.pares'));
       if (wizard.has_categoria) extras.push(t('common.categoria_copa'));
       if (wizard.has_coche) extras.push(t('common.coche'));
    %>
    <% if (extras.length) { %>
      <div class="cf-row">
        <p><%= t('confirm.frase_extras') %> <b><%= extras.join(' · ') %></b></p>
        <a href="<%= backStep1 %>" class="btn btn--ghost cf-change"><%= t('confirm.cambiar') %></a>
      </div>
    <% } %>
    <div class="cf-row cf-row--seq">
      <p><%= t('confirm.frase_orden_carriles') %></p>
      <div class="seq-display">
        <% wizard.lane_sequence.forEach((lane, i) => { %>
          <% if (lane === 0) { %>
            <span class="seq-display__lane" style="background:#30363d;color:#c9d1d9;font-size:.7rem;padding:0 .4rem"><%= t('confirm.descanso') %></span>
          <% } else { %>
            <span class="seq-display__lane" style="background:<%= LANE_COLORS[lane-1] %>"><%= lane %></span>
          <% } %>
          <% if (i < wizard.lane_sequence.length - 1) { %><span class="seq-display__arrow">→</span><% } %>
        <% }) %>
      </div>
      <small class="cf-hint"><%= t('confirm.el_tiempo_lo_pone_la_caja') %></small>
    </div>
  </section>

  <% if (wizard.has_pole && wizard.participants?.length) { %>
    <h2 class="section-title"><%= t('confirm.participantes_de_pole') %></h2>
    <div style="display:flex;flex-wrap:wrap;gap:.4rem;margin-bottom:2rem">
      <% wizard.participants.forEach((p, i) => { %>
        <span class="badge badge--neutral" style="background:rgba(255,255,255,.06);font-size:.95rem">
          <%= p.name %>
          <% if (p.members?.length) { %>
            <span style="color:#b3bcc6;font-size:.85rem;margin-left:.25rem">(<%= p.members.join(', ') %>)</span>
          <% } %>
        </span>
      <% }) %>
    </div>
  <% } else if (!wizard.has_pole) { %>
    <p class="cf-next"><%= t('confirm.siguiente_paso_apuntar') %></p>
  <% } %>

  <form action="/races" method="POST">
    <div class="form-actions">
      <a href="<%= wizard.has_pole ? '/races/new/step4' : (wizard.circuit_id ? '/races/new?back=1' : '/races/new/step3') %>" class="btn btn--ghost btn--lg">← <%= t('wizard.back') %></a>
      <button type="submit" class="btn btn--primary btn--lg">
        <%= wizard.has_pole ? t('wizard.confirm_create') : t('confirm.crear_y_apuntar') %> →
      </button>
    </div>
  </form>

</div>
<style>
  .cf-sub { font-size: 1.1rem; }
  .cf-card { margin: 1.25rem 0 1.5rem; border: 1px solid var(--border); border-radius: 14px; background: var(--bg-card); }
  .cf-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
            padding: 1rem 1.2rem; border-bottom: 1px solid var(--border); }
  .cf-row:last-child { border-bottom: 0; }
  .cf-row p { margin: 0; flex: 1 1 320px; font-size: 1.2rem; line-height: 1.5; }
  .cf-row b { color: #fff; }
  .cf-row--seq { display: grid; gap: .6rem; justify-content: stretch; }
  .cf-change { min-height: 44px; }
  .cf-hint { color: #b3bcc6; font-size: .95rem; }
  .cf-next { margin: 0 0 1.5rem; padding: .9rem 1.1rem; border-radius: 12px; font-size: 1.05rem;
             background: rgba(88,166,255,.08); border: 1px solid rgba(88,166,255,.3); }
</style>
<%- include('../partials/footer') %>
