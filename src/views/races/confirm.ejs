<%
// Resumen en frases: lo que va a pasar, no los campos internos (el formato sale
// del tipo y la duración de manga la manda la caja: no se enseñan).
const backStep1 = '/races/new?back=1';
const escapeHtml = (v) => String(v).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const minLap = wizard.min_lap_ms > 0 ? (wizard.min_lap_ms / 1000).toFixed(2).replace('.', ',') : null;
const typeTxt = wizard.type === 'championship' ? t('confirm.frase_tipo_resistencia') : t('confirm.frase_tipo_sprint');
const circuitTxt = wizard.circuit_name
  ? t('confirm.frase_circuito', { circuito: wizard.circuit_name, carriles: wizard.lanes_count })
  : t('confirm.frase_circuito_a_mano', { carriles: wizard.lanes_count });
%>
<%- include('../partials/header', { pageTitle: t('wizard.confirm_title') }) %>
<div class="vt-page nr-page">
  <div class="vt-wrap vt-wrap--narrow">

    <div class="nr-top">
      <a href="/" class="vt-back-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        <%= t('common.inicio') %>
      </a>
      <%- include('../partials/wizard-progress', { current: 'confirm', hasPole: wizard.has_pole, skipSequence: !!wizard.circuit_id }) %>
    </div>

    <h1><%= t('confirm.esta_todo_bien') %></h1>
    <p class="nr-lead"><%= t('confirm.leelo_con_calma') %></p>

    <section class="vt-card nr-sum" style="margin-top:18px">
      <div class="nr-sum__row">
        <p><%- t('confirm.frase_nombre', { nombre: '<b>' + escapeHtml(wizard.name) + '</b>', tipo: '<b>' + escapeHtml(typeTxt) + '</b>' }) %></p>
        <a href="<%= backStep1 %>" class="vt-btn vt-btn--ghost"><%= t('confirm.cambiar') %></a>
      </div>
      <div class="nr-sum__row">
        <p>
          <%= circuitTxt %>
          <% if (minLap) { %><%= t('confirm.frase_vuelta_minima', { s: minLap }) %><% } %>
        </p>
        <a href="<%= backStep1 %>" class="vt-btn vt-btn--ghost"><%= t('confirm.cambiar') %></a>
      </div>
      <div class="nr-sum__row">
        <p><%= wizard.has_pole ? t('confirm.frase_con_pole') : t('confirm.frase_sin_pole') %></p>
        <a href="<%= backStep1 %>" class="vt-btn vt-btn--ghost"><%= t('confirm.cambiar') %></a>
      </div>
      <% const extras = [];
         if (wizard.passes > 1) extras.push(t('common.pasadas') + ': ' + wizard.passes);
         if (wizard.lane_repeat > 1) extras.push(t('common.repetir_carril') + ': ' + wizard.lane_repeat);
         if (wizard.tire_pairs_per_team > 0) extras.push(t('common.neumaticos_por_equipo') + ': ' + wizard.tire_pairs_per_team + ' ' + t('confirm.pares'));
         if (wizard.has_categoria) extras.push(t('common.categoria_copa'));
         if (wizard.has_coche) extras.push(t('common.coche'));
      %>
      <% if (extras.length) { %>
        <div class="nr-sum__row">
          <p><%= t('confirm.frase_extras') %> <b><%= extras.join(' · ') %></b></p>
          <a href="<%= backStep1 %>" class="vt-btn vt-btn--ghost"><%= t('confirm.cambiar') %></a>
        </div>
      <% } %>
      <div class="nr-sum__row nr-sum__row--seq">
        <p><%= t('confirm.frase_orden_carriles') %></p>
        <div class="seq-display">
          <% wizard.lane_sequence.forEach((lane, i) => { %>
            <% if (lane === 0) { %>
              <span class="seq-display__lane seq-display__lane--rest"><%= t('confirm.descanso') %></span>
            <% } else { %>
              <span class="seq-display__lane" style="background:<%= LANE_COLORS[lane-1] %>"><%= lane %></span>
            <% } %>
            <% if (i < wizard.lane_sequence.length - 1) { %><span class="seq-display__arrow">→</span><% } %>
          <% }) %>
        </div>
        <small class="nr-sum__hint"><%= t('confirm.el_tiempo_lo_pone_la_caja') %></small>
      </div>
    </section>

    <% if (wizard.has_pole && wizard.participants?.length) { %>
      <section class="vt-card">
        <h2 class="nr-q"><%= t('confirm.participantes_de_pole') %></h2>
        <div class="nr-chips">
          <% wizard.participants.forEach((p) => { %>
            <span class="nr-chip">
              <%= p.name %>
              <% if (p.members?.length) { %><small>(<%= p.members.join(', ') %>)</small><% } %>
            </span>
          <% }) %>
        </div>
      </section>
    <% } else if (!wizard.has_pole) { %>
      <p class="nr-note" style="margin-top:16px"><%= t('confirm.siguiente_paso_apuntar') %></p>
    <% } %>

    <form action="/races" method="POST">
      <div class="nr-bar">
        <a href="<%= wizard.has_pole ? '/races/new/step4' : (wizard.circuit_id ? '/races/new?back=1' : '/races/new/step3') %>" class="vt-btn vt-btn--ghost">← <%= t('wizard.back') %></a>
        <div class="nr-bar__sum"></div>
        <button type="submit" class="vt-btn vt-btn--primary">
          <%= wizard.has_pole ? t('wizard.confirm_create') : t('confirm.crear_y_apuntar') %> →
        </button>
      </div>
    </form>

  </div>
</div>
<%- include('../partials/footer') %>
