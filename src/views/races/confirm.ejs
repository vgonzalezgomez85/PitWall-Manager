<%- include('../partials/header', { pageTitle: t('wizard.confirm_title') }) %>
<div class="container container--narrow">

  <%- include('../partials/wizard-progress', { current: 'confirm', hasPole: wizard.has_pole, skipSequence: !!wizard.circuit_id }) %>

  <h1 class="page-title"><%= t('wizard.confirm_title') %></h1>

  <div class="summary-card">
    <table class="summary-table">
      <tr>
        <th><%= t('wizard.summary_name') %></th>
        <td><strong><%= wizard.name %></strong></td>
      </tr>
      <tr>
        <th><%= t('wizard.summary_type') %></th>
        <td><span class="badge badge--type"><%= t('races.type.' + wizard.type) %></span></td>
      </tr>
      <tr>
        <th><%= t('wizard.summary_format') %></th>
        <td><span class="badge badge--format"><%= t('races.format.' + wizard.format) %></span></td>
      </tr>
      <tr>
        <th><%= t('wizard.summary_lanes') %></th>
        <td><%= wizard.lanes_count %></td>
      </tr>
      <tr>
        <th><%= t('wizard.manga_duration') %></th>
        <td><%= wizard.manga_duration_minutes %> <%= t('confirm.minutos') %></td>
      </tr>
      <% if (wizard.passes > 1) { %>
      <tr>
        <th><%= t('common.pasadas') %></th>
        <td><%= wizard.passes %></td>
      </tr>
      <% } %>
      <% if (wizard.lane_repeat > 1) { %>
      <tr>
        <th><%= t('common.repetir_carril') %></th>
        <td><%= wizard.lane_repeat %></td>
      </tr>
      <% } %>
      <% if (wizard.tire_pairs_per_team > 0) { %>
      <tr>
        <th><%= t('common.neumaticos_por_equipo') %></th>
        <td><%= wizard.tire_pairs_per_team %> <%= t('confirm.pares') %></td>
      </tr>
      <% } %>
      <tr>
        <th><%= t('common.pole_position') %></th>
        <td>
          <% if (wizard.has_pole) { %>
            <span class="badge" style="background:rgba(246,201,14,.15);color:#f6c90e;border:1px solid rgba(246,201,14,.3)">
              🏁 <%= t('confirm.si_con_sesion_de_clasificacion') %>
            </span>
          <% } else { %>
            <span style="color:#8b949e"><%= t('confirm.no') %></span>
          <% } %>
        </td>
      </tr>
    </table>
  </div>

  <!-- Lane sequence preview -->
  <h2 class="section-title"><%= t('common.secuencia_de_carriles') %></h2>
  <div class="seq-display" style="margin-bottom:2rem">
    <% wizard.lane_sequence.forEach((lane, i) => { %>
      <span class="seq-display__lane" style="background:<%= LANE_COLORS[lane-1] %>"><%= lane %></span>
      <% if (i < wizard.lane_sequence.length - 1) { %><span class="seq-display__arrow">→</span><% } %>
    <% }) %>
  </div>

  <% if (wizard.has_pole && wizard.participants?.length) { %>
    <h2 class="section-title"><%= t('confirm.participantes_de_pole') %></h2>
    <div style="display:flex;flex-wrap:wrap;gap:.4rem;margin-bottom:2rem">
      <% wizard.participants.forEach((p, i) => { %>
        <span class="badge badge--neutral" style="background:rgba(255,255,255,.06)">
          <%= p.name %>
          <% if (p.members?.length) { %>
            <span style="color:#8b949e;font-size:.78rem;margin-left:.25rem">(<%= p.members.join(', ') %>)</span>
          <% } %>
        </span>
      <% }) %>
    </div>
  <% } else if (!wizard.has_pole) { %>
    <p class="form-hint" style="margin-bottom:2rem">
      <%= t('confirm.los_participantes_se_anaden_al_crear_cada_tanda') %>
    </p>
  <% } %>

  <form action="/races" method="POST">
    <div class="form-actions">
      <a href="<%= wizard.has_pole ? '/races/new/step4' : (wizard.circuit_id ? '/races/new?back=1' : '/races/new/step3') %>" class="btn btn--ghost">← <%= t('wizard.back') %></a>
      <button type="submit" class="btn btn--primary btn--lg">
        🏁 <%= t('wizard.confirm_create') %>
      </button>
    </div>
  </form>

</div>
<%- include('../partials/footer') %>
