<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= lang === 'es' ? 'Minimapa' : 'Minimap' %> — <%= race.name %>
  </title>
  <link rel="icon" type="image/svg+xml" href="/img/favicon.svg">
  <link rel="stylesheet" href="/css/fonts.css">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      display: flex; flex-direction: column; height: 100vh; overflow: hidden;
      background: #000; color: #e6edf3; font-family: 'Inter', system-ui, sans-serif;
    }
    .tk-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: .55rem 1.2rem;
      background: #000; border-bottom: 2px solid #161b22; flex-shrink: 0;
    }
    .tk-title {
      font-size: .68rem; font-weight: 700; letter-spacing: .15em;
      color: #6e7681; text-transform: uppercase;
    }
    .tk-manga {
      font-family: 'Rajdhani', sans-serif; font-size: 1rem; font-weight: 700;
      color: #e6edf3; letter-spacing: .04em;
    }
    .tk-race { font-size: .72rem; color: #6e7681; }

    .tk-stage { flex: 1; position: relative; min-height: 0; overflow: hidden; }
    .tk-grid  { width: 100%; height: 100%; display: grid; gap: 6px; padding: 6px; }
    .tk-cell  {
      position: relative; background: #000;
      border: 1px solid #161b22; border-radius: 8px; overflow: hidden;
      min-width: 0; min-height: 0;
    }
    .tk-cell canvas { display: block; width: 100%; height: 100%; }
    .tk-cell__hd {
      position: absolute; top: 5px; left: 5px; right: 5px; z-index: 2;
      display: flex; align-items: center; gap: 5px; pointer-events: none;
    }
    .tk-cell__n {
      font: 700 .72rem 'Rajdhani', sans-serif; letter-spacing: .06em;
      color: #c9d1d9; background: rgba(0,0,0,.55);
      padding: 2px 8px; border-radius: 6px;
    }
    .tk-cell__sp { flex: 1; }
    .tk-cell__btn {
      pointer-events: auto; cursor: pointer;
      width: 30px; height: 30px; display: inline-flex; align-items: center; justify-content: center;
      background: rgba(22,27,34,.85); border: 1px solid #30363d; border-radius: 7px;
      color: #c9d1d9; font-size: 1rem; line-height: 1; user-select: none;
      transition: background .12s, border-color .12s;
    }
    .tk-cell__btn:hover  { background: #21262d; border-color: #58a6ff; color: #fff; }
    .tk-cell__btn:active { transform: scale(.92); }
    .tk-cell__btn.on     { border-color: #fbbf24; color: #fbbf24; }

    .tk-empty {
      position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
      color: #6e7681; text-align: center; padding: 2rem;
    }
    .tk-empty b { color: #c9d1d9; display: block; margin-bottom: .4rem; }
  </style>
</head>
<body>

  <header class="tk-header">
    <div>
      <div class="tk-title">🗺 <%= lang === 'es' ? 'Minimapa' : 'Track minimap' %></div>
      <div class="tk-manga">
        <% if (tanda) { %><%= lang === 'es' ? 'Tanda' : 'Round' %> <%= tanda.number %> · <% } %>
        <%= lang === 'es' ? 'Manga' : 'Heat' %> #<%= manga.number %>
      </div>
    </div>
    <span class="tk-race"><%= race.name %></span>
  </header>

  <div class="tk-stage">
    <div class="tk-grid" id="tkGrid"></div>
    <% if (!circuit || trackOutline.length < 3) { %>
      <div class="tk-empty">
        <div>
          <b>⚠️ <%= lang === 'es' ? 'Sin trazado configurado' : 'No outline configured' %></b>
          <%= lang === 'es'
            ? 'Edita el circuito de esta carrera y dibuja el trazado en la sección "🗺 Trazado del circuito" para activar el minimapa.'
            : 'Edit this race\'s circuit and draw an outline in the "🗺 Track outline" section to enable the minimap.' %>
        </div>
      </div>
    <% } %>
  </div>

  <%
    const LC = ['#e63946','#2196f3','#4caf50','#ff9800','#9c27b0','#00bcd4','#ff5722','#607d8b','#795548','#e91e63','#3f51b5','#009688','#cddc39','#ffc107','#f44336','#673ab7','#03a9f4','#8bc34a','#ff6f00','#880e4f','#1a237e','#b71c1c','#004d40','#f57f17','#311b92','#0d47a1','#1b5e20','#33691e','#bf360c','#4a148c','#006064','#827717'];
    const laneRows = lanes
      .filter(l => !l.is_rest)
      .map(l => ({
        lane:  l.lane,
        color: LC[l.lane - 1] || '#8b949e',
        name:  l.team_name || l.driver_name || ('Lane ' + l.lane),
      }));
  %>

  <script>
    const PANEL_DATA = <%- JSON.stringify({
      raceId:           race.id,
      mangaId:          manga.id,
      lanes:            laneRows,
      trackOutline:     trackOutline,
      trackDirection:   (circuit && circuit.track_direction === 'ccw') ? 'ccw' : 'cw',
      lastLapByLane:    lastLapByLane,
      isActive:         isActive,
      circuits:         (circuitsLayout && circuitsLayout.length) ? circuitsLayout
                          : [{ index: 0, laneStart: 1, laneCount: laneRows.length || 1, rot: 0, flip: false }],
    }) %>;
    const LANG = "<%= lang %>";
  </script>
  <script src="/socket.io/socket.io.js"></script>
  <script>
  (function () {
    const grid    = document.getElementById('tkGrid');
    const outline = PANEL_DATA.trackOutline || [];
    const hasTrack = outline.length >= 3;
    if (!grid || !hasTrack) return;

    const circuits = PANEL_DATA.circuits;
    const DIR = PANEL_DATA.trackDirection;

    // ── Suavizado Catmull-Rom (igual que antes) ─────────────────────────
    const SAMPLES_PER_SEG = 16;
    function catmullRom(p0, p1, p2, p3, t) {
      const t2 = t*t, t3 = t2*t;
      return [
        0.5*((2*p1[0]) + (-p0[0]+p2[0])*t + (2*p0[0]-5*p1[0]+4*p2[0]-p3[0])*t2 + (-p0[0]+3*p1[0]-3*p2[0]+p3[0])*t3),
        0.5*((2*p1[1]) + (-p0[1]+p2[1])*t + (2*p0[1]-5*p1[1]+4*p2[1]-p3[1])*t2 + (-p0[1]+3*p1[1]-3*p2[1]+p3[1])*t3),
      ];
    }
    function smoothOutline(pts) {
      if (pts.length < 3) return pts;
      const N = pts.length, out = [];
      for (let i = 0; i < N; i++) {
        const p0 = pts[(i-1+N)%N], p1 = pts[i], p2 = pts[(i+1)%N], p3 = pts[(i+2)%N];
        for (let s = 0; s < SAMPLES_PER_SEG; s++) out.push(catmullRom(p0, p1, p2, p3, s/SAMPLES_PER_SEG));
      }
      return out;
    }
    function polyLen(pts) {
      let total = 0; const seg = [];
      for (let i = 0; i < pts.length; i++) {
        const a = pts[i], b = pts[(i+1)%pts.length];
        const d = Math.hypot(b[0]-a[0], b[1]-a[1]); seg.push(d); total += d;
      }
      return { total, seg };
    }

    // Transforma un punto relativo (0..1) según orientación: espejo horizontal
    // + rotación en pasos de 90° alrededor del centro (0.5,0.5).
    function orientPoint([x, y], rot, flip) {
      if (flip) x = 1 - x;
      let steps = (((rot / 90) | 0) % 4 + 4) % 4;
      for (let k = 0; k < steps; k++) { const nx = 1 - y, ny = x; x = nx; y = ny; }
      return [x, y];
    }

    // ── Un renderer por circuito ────────────────────────────────────────
    function makeRenderer(canvas, circ) {
      const ctx = canvas.getContext('2d');
      let path, PERIM, SEG, bbox, laneState;

      function rebuild() {
        const tOutline = outline.map(p => orientPoint(p, circ.rot, circ.flip));
        path = smoothOutline(tOutline);
        const pl = polyLen(path); PERIM = pl.total; SEG = pl.seg;
        let minX=1,minY=1,maxX=0,maxY=0;
        path.forEach(([x,y]) => { if(x<minX)minX=x; if(y<minY)minY=y; if(x>maxX)maxX=x; if(y>maxY)maxY=y; });
        bbox = { minX, minY, maxX, maxY };
        const lanesHere = PANEL_DATA.lanes.filter(l =>
          l.lane >= circ.laneStart && l.lane < circ.laneStart + circ.laneCount);
        laneState = {};
        lanesHere.forEach(l => {
          const last = (PANEL_DATA.lastLapByLane || {})[l.lane];
          laneState[l.lane] = {
            ...l,
            lastCrossingTs: last && last.timestampMs ? last.timestampMs : null,
            lapTimeMs:      last && last.lapTimeMs   ? last.lapTimeMs   : null,
            renderedRx: null, renderedRy: null,
          };
        });
      }
      rebuild();

      function pointAtProgress(prog) {
        let p = ((prog % 1) + 1) % 1;
        if (DIR === 'ccw') p = 1 - p;
        let target = p * PERIM, acc = 0;
        for (let i = 0; i < path.length; i++) {
          const segLen = SEG[i];
          if (acc + segLen >= target) {
            const f = segLen > 0 ? (target - acc) / segLen : 0;
            const a = path[i], b = path[(i+1)%path.length];
            return [a[0] + (b[0]-a[0])*f, a[1] + (b[1]-a[1])*f];
          }
          acc += segLen;
        }
        return path[0];
      }

      function resize() {
        const r = canvas.getBoundingClientRect();
        const dpr = window.devicePixelRatio || 1;
        canvas.width = Math.round(r.width*dpr); canvas.height = Math.round(r.height*dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }

      function getStage() {
        const W = canvas.clientWidth, H = canvas.clientHeight, PAD = 16;
        const aspect = Math.max(.1, (bbox.maxX-bbox.minX) / Math.max(.001, (bbox.maxY-bbox.minY)));
        const availW = W-PAD*2, availH = H-PAD*2;
        let w = availW, h = availW/aspect;
        if (h > availH) { h = availH; w = availH*aspect; }
        return { x:(W-w)/2, y:(H-h)/2, w, h };
      }
      // Mapea coord relativa (0..1, ya orientada) al rect del stage, encajando
      // el bounding box del trazado para que llene la celda.
      function relToScreen(rx, ry, stage) {
        const nx = (rx - bbox.minX) / Math.max(.001, bbox.maxX-bbox.minX);
        const ny = (ry - bbox.minY) / Math.max(.001, bbox.maxY-bbox.minY);
        return [stage.x + nx*stage.w, stage.y + ny*stage.h];
      }

      function draw() {
        resize();
        const W = canvas.clientWidth, H = canvas.clientHeight;
        ctx.clearRect(0,0,W,H); ctx.fillStyle = '#000'; ctx.fillRect(0,0,W,H);
        const stage = getStage();

        ctx.beginPath();
        path.forEach(([rx,ry], i) => { const [px,py]=relToScreen(rx,ry,stage); i===0?ctx.moveTo(px,py):ctx.lineTo(px,py); });
        ctx.closePath();
        ctx.lineWidth = Math.max(2, Math.min(stage.w, stage.h)/250);
        ctx.strokeStyle = 'rgba(251,191,36,.45)';
        ctx.stroke();

        const now = Date.now(), SMOOTH = 0.25, STUCK_RATIO = 1.3;
        Object.values(laneState).forEach(l => {
          let prog = 0, stuckness = 0;
          if (l.lastCrossingTs && l.lapTimeMs > 0) {
            const ratio = (now - l.lastCrossingTs) / l.lapTimeMs;
            prog = ratio;
            if (ratio > STUCK_RATIO) { stuckness = Math.min(1,(ratio-STUCK_RATIO)/0.5); if(prog>1.5)prog=1.5; }
          }
          const [trx, tryY] = pointAtProgress(prog);
          if (l.renderedRx == null) { l.renderedRx = trx; l.renderedRy = tryY; }
          else { l.renderedRx += (trx-l.renderedRx)*SMOOTH; l.renderedRy += (tryY-l.renderedRy)*SMOOTH; }
          const [px, py] = relToScreen(l.renderedRx, l.renderedRy, stage);
          const dotR = Math.max(7, Math.min(stage.w, stage.h)/22);

          let alpha = 1;
          if (stuckness > 0) { const blink = 0.5+0.5*Math.sin(now/150); alpha = 1 - stuckness*(1-blink)*0.7; }
          ctx.globalAlpha = alpha;
          ctx.beginPath(); ctx.arc(px, py+1, dotR, 0, Math.PI*2); ctx.fillStyle='rgba(0,0,0,.6)'; ctx.fill();
          ctx.beginPath(); ctx.arc(px, py, dotR, 0, Math.PI*2); ctx.fillStyle=l.color; ctx.fill();
          ctx.lineWidth = 2; ctx.strokeStyle = stuckness>0 ? '#e63946' : '#0a0a0a'; ctx.stroke();
          ctx.fillStyle='#fff'; ctx.font=`700 ${Math.round(dotR*1.1)}px Rajdhani, sans-serif`;
          ctx.textAlign='center'; ctx.textBaseline='middle';
          ctx.fillText(String(l.lane), px, py+1);
          ctx.font=`600 ${Math.round(dotR*0.8)}px Inter, sans-serif`;
          ctx.fillText(l.name, px, py+dotR+Math.round(dotR*0.9));
          ctx.globalAlpha = 1;
        });
      }

      return { draw, rebuild, laneState: () => laneState };
    }

    // ── Construir la rejilla de celdas + controles ──────────────────────
    const N = circuits.length;
    const cols = Math.ceil(Math.sqrt(N));
    const rows = Math.ceil(N / cols);
    grid.style.gridTemplateColumns = `repeat(${cols}, 1fr)`;
    grid.style.gridTemplateRows    = `repeat(${rows}, 1fr)`;

    const renderers = [];
    function persist() {
      fetch(`/races/${PANEL_DATA.raceId}/circuit-orientation`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ orientations: circuits.map(c => ({ rot: c.rot, flip: c.flip })) }),
      }).catch(() => {});
    }

    circuits.forEach((circ, idx) => {
      const cell = document.createElement('div');
      cell.className = 'tk-cell';
      const canvas = document.createElement('canvas');
      cell.appendChild(canvas);

      // Cabecera con controles (solo si hay más de 1 circuito mostramos nº)
      const hd = document.createElement('div');
      hd.className = 'tk-cell__hd';
      const label = N > 1 ? `Circuito ${idx + 1}` : (LANG === 'es' ? 'Circuito' : 'Track');
      hd.innerHTML = `<span class="tk-cell__n">${label}</span><span class="tk-cell__sp"></span>`;
      const rotBtn  = document.createElement('span');
      rotBtn.className = 'tk-cell__btn'; rotBtn.title = LANG==='es'?'Girar 90°':'Rotate 90°'; rotBtn.textContent = '⟳';
      const flipBtn = document.createElement('span');
      flipBtn.className = 'tk-cell__btn' + (circ.flip ? ' on' : ''); flipBtn.title = LANG==='es'?'Espejo':'Mirror'; flipBtn.textContent = '⇄';
      hd.appendChild(rotBtn); hd.appendChild(flipBtn);
      cell.appendChild(hd);
      grid.appendChild(cell);

      const r = makeRenderer(canvas, circ);
      renderers.push(r);

      rotBtn.addEventListener('click', () => {
        circ.rot = (circ.rot + 90) % 360;
        r.rebuild(); persist();
      });
      flipBtn.addEventListener('click', () => {
        circ.flip = !circ.flip;
        flipBtn.classList.toggle('on', circ.flip);
        r.rebuild(); persist();
      });
    });

    function loop() { renderers.forEach(r => r.draw()); requestAnimationFrame(loop); }
    requestAnimationFrame(loop);

    // ── Socket: cruces ──────────────────────────────────────────────────
    const socket = io({ transports: ['websocket', 'polling'] });
    socket.on('connect', () => socket.emit('race:live:join'));
    socket.on('lap', (lap) => {
      if (!lap || !lap.lane) return;
      for (const r of renderers) {
        const ls = r.laneState();
        if (ls[lap.lane]) {
          ls[lap.lane].lastCrossingTs = Date.now();
          if (lap.lapTimeMs && lap.lapTimeMs > 0) ls[lap.lane].lapTimeMs = lap.lapTimeMs;
          break;
        }
      }
    });
    socket.on('manga:stopped', () => { /* deja el último estado */ });
  })();
  </script>
</body>
</html>
