<%- include('../partials/header', { pageTitle: t('wizard.step1_title') }) %>
<div class="container container--narrow">

  <%- include('../partials/wizard-progress', { current: 'type' }) %>

  <h1 class="page-title"><%= t('wizard.step1_title') %></h1>

  <% if (errors.length > 0) { %>
    <div class="alert alert--error">
      <% errors.forEach(e => { %><p><%= t('errors.' + e) %></p><% }) %>
    </div>
  <% } %>

  <form action="/races/new/step1" method="POST" class="form-card">

    <!-- Name -->
    <div class="form-group">
      <label class="form-label" for="name"><%= t('wizard.race_name') %></label>
      <input
        class="form-input <%= errors.includes('name_required') ? 'form-input--error' : '' %>"
        type="text" id="name" name="name"
        placeholder="<%= t('wizard.race_name_placeholder') %>"
        value="<%= body.name || '' %>"
        autocomplete="off" autofocus required>
    </div>

    <!-- Type -->
    <div class="form-group">
      <label class="form-label"><%= t('wizard.race_type') %></label>
      <div class="option-cards">
        <label class="option-card">
          <input type="radio" name="type" value="club" <%= body.type === 'club' ? 'checked' : '' %> required>
          <div class="option-card__body">
            <span class="option-card__icon">🏎️</span>
            <span class="option-card__title"><%= t('wizard.club_race') %></span>
            <span class="option-card__desc"><%= t('wizard.club_race_desc') %></span>
          </div>
        </label>
        <label class="option-card">
          <input type="radio" name="type" value="championship" <%= body.type === 'championship' ? 'checked' : '' %> required>
          <div class="option-card__body">
            <span class="option-card__icon">🏆</span>
            <span class="option-card__title"><%= t('wizard.championship_race') %></span>
            <span class="option-card__desc"><%= t('wizard.championship_race_desc') %></span>
          </div>
        </label>
      </div>
    </div>

    <!-- Reglas de turnos por piloto (solo championship) -->
    <%
      // Defaults para el form: en BD se guardan en ms, en el form en minutos/segundos.
      const minMin = body.driver_min_total_min != null ? body.driver_min_total_min : '';
      const maxMin = body.driver_max_total_min != null ? body.driver_max_total_min : '';
      const lockS  = body.driver_change_lockout_s != null ? body.driver_change_lockout_s : 120;
      const maxRuns = body.driver_max_runs != null ? body.driver_max_runs : '';
    %>
    <div class="form-group" id="champRulesGroup" style="display:<%= body.type === 'championship' ? 'block' : 'none' %>">
      <label class="form-label">
        <%= lang === 'es' ? 'Reglas de turnos por piloto' : 'Driver shift rules' %>
      </label>
      <p class="form-hint" style="margin:.2rem 0 .8rem">
        <%= lang === 'es'
          ? 'Aplica solo a carreras de campeonato. Cada piloto se identifica por QR; el contador suma sus minutos en TODAS las mangas de la carrera.'
          : 'Championship only. Each driver scans a QR; the counter sums their minutes across ALL heats of the race.' %>
      </p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem">
        <div>
          <label class="form-label" for="driverMinMin" style="font-size:.85rem;color:var(--vt-mute,#9aa0a6)">
            <%= lang === 'es' ? 'Mínimo por piloto (min)' : 'Min per driver (min)' %>
          </label>
          <input class="form-input form-input--sm" type="number" id="driverMinMin" name="driver_min_total_min"
                 min="0" max="600" step="1" placeholder="0 = sin mínimo" value="<%= minMin %>">
        </div>
        <div>
          <label class="form-label" for="driverMaxMin" style="font-size:.85rem;color:var(--vt-mute,#9aa0a6)">
            <%= lang === 'es' ? 'Máximo por piloto (min)' : 'Max per driver (min)' %>
          </label>
          <input class="form-input form-input--sm" type="number" id="driverMaxMin" name="driver_max_total_min"
                 min="0" max="600" step="1" placeholder="0 = sin máximo" value="<%= maxMin %>">
        </div>
        <div>
          <label class="form-label" for="driverMaxRuns" style="font-size:.85rem;color:var(--vt-mute,#9aa0a6)">
            <%= lang === 'es' ? 'Máximo de turnos por piloto' : 'Max turns per driver' %>
          </label>
          <input class="form-input form-input--sm" type="number" id="driverMaxRuns" name="driver_max_runs"
                 min="0" max="100" step="1" placeholder="0 = sin máximo" value="<%= maxRuns %>">
        </div>
        <div>
          <label class="form-label" for="lockoutS" style="font-size:.85rem;color:var(--vt-mute,#9aa0a6)">
            <%= lang === 'es' ? 'Bloqueo final de manga (s)' : 'Final-manga lockout (s)' %>
          </label>
          <input class="form-input form-input--sm" type="number" id="lockoutS" name="driver_change_lockout_s"
                 min="0" max="600" step="1" value="<%= lockS %>">
        </div>
      </div>
      <p class="form-hint" style="margin-top:.4rem;font-size:.78rem">
        <%= lang === 'es'
          ? 'Bloqueo: durante los últimos X segundos de cada manga no se aceptan cambios de piloto (por QR ni manuales).'
          : 'Lockout: during the last X seconds of each heat, no driver swaps are accepted (neither QR nor manual).' %>
      </p>
    </div>

    <!-- Circuit selector -->
    <div class="form-group">
      <label class="form-label">
        <%= lang === 'es' ? 'Circuito' : 'Circuit' %>
      </label>
      <div style="display:flex;align-items:center;gap:.6rem;flex-wrap:wrap">
        <select id="circuitSelect" class="form-input" style="max-width:22rem"
                onchange="applyCircuit(this.value)">
          <option value="">— <%= lang === 'es' ? 'Configurar manualmente' : 'Configure manually' %> —</option>
          <% savedCircuits.forEach(c => { %>
            <option value="<%= c.id %>"
                    data-count="<%= c.circuits_count %>"
                    data-config="<%= c.circuits_config %>"
                    data-min-ms="<%= c.min_lap_ms %>"
                    <%= body.circuit_id == c.id ? 'selected' : '' %>>
              <%= c.name %> (<%= c.lanes_count %> <%= lang === 'es' ? 'carriles' : 'lanes' %><% if (c.min_lap_ms > 0) { %> · min <%= (c.min_lap_ms/1000).toFixed(2) %>s<% } %>)
            </option>
          <% }) %>
        </select>
        <a href="/circuits/new" class="btn btn--ghost btn--sm" target="_blank">
          + <%= lang === 'es' ? 'Nuevo circuito' : 'New circuit' %>
        </a>
      </div>
      <input type="hidden" name="circuit_id" id="circuitId" value="<%= body.circuit_id || '' %>">

      <!-- Category selector (shown only if the chosen circuit has per-category Pt overrides) -->
      <div id="categoryWrap" style="margin-top:.75rem;display:none;align-items:center;gap:.6rem;flex-wrap:wrap">
        <span class="form-hint" style="flex-shrink:0">
          <%= lang === 'es' ? 'Categoría:' : 'Category:' %>
        </span>
        <select id="categorySelect" class="form-input form-input--sm" style="max-width:14rem">
          <option value=""><%= lang === 'es' ? '— por defecto —' : '— default —' %></option>
        </select>
        <input type="hidden" name="category_id" id="categoryId" value="<%= body.category_id || '' %>">
        <span class="form-hint" id="categoryHint" style="color:#9aa0a6"></span>
      </div>
    </div>

    <!-- Circuit configuration -->
    <div class="form-group" id="circuitConfigGroup">
      <label class="form-label">
        <%= lang === 'es' ? 'Configuración de carriles' : 'Lane configuration' %>
      </label>

      <!-- Number of circuits -->
      <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:1rem">
        <span class="form-hint" style="flex-shrink:0">
          <%= lang === 'es' ? 'Número de circuitos:' : 'Number of circuits:' %>
        </span>
        <div class="circ-pills" id="circPills">
          <% for(let i=1; i<=6; i++) { %>
            <button type="button" class="circ-pill<%= (parseInt(body.circuits_count)||1) === i ? ' active' : '' %>"
              data-n="<%= i %>"><%= i %></button>
          <% } %>
        </div>
        <input type="hidden" name="circuits_count" id="circuitsCount" value="<%= body.circuits_count || 1 %>">
      </div>

      <!-- Per-circuit lane inputs -->
      <div class="circuits-grid" id="circuitsGrid">
        <% for(let i=1; i<=6; i++) { %>
          <div class="circuit-cfg-row" data-idx="<%= i %>"
               style="<%= (parseInt(body.circuits_count)||1) < i ? 'display:none' : '' %>">
            <span class="circuit-num-badge" style="background:<%= ['#e63946','#2196f3','#4caf50','#ff9800','#9c27b0','#00bcd4'][i-1] %>">
              <%= lang === 'es' ? 'C' : 'C' %><%= i %>
            </span>
            <input
              class="form-input form-input--sm <%= errors.includes('lanes_invalid') ? 'form-input--error' : '' %>"
              type="number"
              name="circuit_lanes_<%= i %>"
              id="circLanes_<%= i %>"
              min="2" max="8"
              value="<%= body['circuit_lanes_' + i] || (i === 1 ? 6 : 4) %>">
            <span class="form-hint"><%= lang === 'es' ? 'carriles' : 'lanes' %></span>
          </div>
        <% } %>
      </div>

      <!-- Total -->
      <div class="circuits-total">
        <span class="form-hint"><%= lang === 'es' ? 'Total:' : 'Total:' %></span>
        <strong id="totalLanesDisplay" style="color:#58a6ff">
          <%= body.lanes_count || 6 %>
        </strong>
        <span class="form-hint"> <%= t('races.lanes') %></span>
      </div>

      <!-- Minimum lap time -->
      <div style="display:flex;align-items:center;gap:.6rem;margin-top:.75rem;flex-wrap:wrap">
        <span class="form-hint" style="flex-shrink:0">
          <%= lang === 'es' ? 'Vuelta mínima:' : 'Min lap time:' %>
        </span>
        <input class="form-input form-input--sm" type="number" id="minLapS" name="min_lap_s"
               step="0.01" min="0" max="999"
               placeholder="<%= lang === 'es' ? 'desactivado' : 'disabled' %>"
               value="<%= body.min_lap_s || '' %>"
               style="width:5.5rem">
        <span class="form-hint">s</span>
        <span class="form-hint" id="minLapHint" style="color:#4caf50"></span>
      </div>
    </div>

    <!-- Pasadas y repetir carril (válido para sprint y resistencia) -->
    <div class="form-group">
      <label class="form-label">
        <%= lang === 'es' ? 'Pasadas y repetición de carril' : 'Passes and lane repetition' %>
      </label>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem">
        <div>
          <label class="form-label" for="passes" style="font-size:.85rem;color:var(--vt-mute,#9aa0a6)">
            <%= lang === 'es' ? 'Pasadas' : 'Passes' %>
          </label>
          <input class="form-input form-input--sm" type="number" id="passes" name="passes"
                 min="1" step="1" value="<%= body.passes || 1 %>">
          <p class="form-hint" style="margin-top:.35rem">
            <%= lang === 'es'
              ? 'Nº de veces que se repite la secuencia de carriles entera. Ej.: 2 pasadas = la rotación completa se corre 2 veces.'
              : 'Number of times the whole lane sequence repeats. E.g. 2 passes = the full rotation runs twice.' %>
          </p>
        </div>
        <div>
          <label class="form-label" for="laneRepeat" style="font-size:.85rem;color:var(--vt-mute,#9aa0a6)">
            <%= lang === 'es' ? 'Repetir carril' : 'Repeat lane' %>
          </label>
          <input class="form-input form-input--sm" type="number" id="laneRepeat" name="lane_repeat"
                 min="1" step="1" value="<%= body.lane_repeat || 1 %>">
          <p class="form-hint" style="margin-top:.35rem">
            <%= lang === 'es'
              ? 'Cada carril se corre este nº de mangas seguidas (mismo carril); las vueltas se suman. Ej.: 2 = cada carril se hace 2 mangas contiguas.'
              : 'Each lane runs this many consecutive heats (same lane); laps are summed. E.g. 2 = each lane runs 2 contiguous heats.' %>
          </p>
        </div>
      </div>
    </div>

    <!-- Pole position -->
    <div class="form-group">
      <label class="form-label">
        <%= lang === 'es' ? 'Pole position' : 'Pole position' %>
      </label>
      <div class="option-cards">
        <label class="option-card">
          <input type="radio" name="has_pole" value="0" <%= (body.has_pole || '0') !== '1' ? 'checked' : '' %> required>
          <div class="option-card__body">
            <span class="option-card__icon">🏎️</span>
            <span class="option-card__title"><%= lang === 'es' ? 'Sin pole' : 'No pole' %></span>
            <span class="option-card__desc">
              <%= lang === 'es' ? 'Los carriles de salida se asignan al crear la tanda.' : 'Starting lanes are assigned when creating the heat group.' %>
            </span>
          </div>
        </label>
        <label class="option-card">
          <input type="radio" name="has_pole" value="1" <%= body.has_pole === '1' ? 'checked' : '' %>>
          <div class="option-card__body">
            <span class="option-card__icon">🏁</span>
            <span class="option-card__title"><%= lang === 'es' ? 'Con pole position' : 'With pole position' %></span>
            <span class="option-card__desc">
              <%= lang === 'es' ? 'Sesión de clasificación: el más rápido elige carril primero.' : 'Qualifying session: fastest picks their starting lane first.' %>
            </span>
          </div>
        </label>
      </div>
    </div>

    <div class="form-actions">
      <a href="/races" class="btn btn--ghost"><%= t('wizard.back') %></a>
      <button type="submit" class="btn btn--primary"><%= t('wizard.next') %> →</button>
    </div>

  </form>
</div>

<script>
const circPills    = document.getElementById('circPills');
const circCount    = document.getElementById('circuitsCount');
const circGrid     = document.getElementById('circuitsGrid');
const totalDisplay = document.getElementById('totalLanesDisplay');
const circuitIdEl  = document.getElementById('circuitId');
const minLapInput  = document.getElementById('minLapS');
const minLapHint   = document.getElementById('minLapHint');
const categoryWrap   = document.getElementById('categoryWrap');
const categorySelect = document.getElementById('categorySelect');
const categoryIdEl   = document.getElementById('categoryId');
const categoryHint   = document.getElementById('categoryHint');
// Map<circuitId, [{ category_id, category_name, min_lap_ms }]>
const CIRCUIT_CATEGORY_TIMES = <%- JSON.stringify(circuitCategoryTimes || {}) %>;

function getActiveCount() { return parseInt(circCount.value, 10); }

function updateTotal() {
  const n = getActiveCount();
  let total = 0;
  for (let i = 1; i <= n; i++) {
    total += parseInt(document.getElementById('circLanes_' + i)?.value || 0, 10) || 0;
  }
  totalDisplay.textContent = total;
}

function setCircuitCount(n) {
  circCount.value = n;
  circPills.querySelectorAll('.circ-pill').forEach(btn => {
    btn.classList.toggle('active', parseInt(btn.dataset.n) === n);
  });
  circGrid.querySelectorAll('.circuit-cfg-row').forEach(row => {
    row.style.display = parseInt(row.dataset.idx) <= n ? '' : 'none';
  });
  updateTotal();
}

function setReadonly(readonly) {
  circPills.querySelectorAll('.circ-pill').forEach(b => b.disabled = readonly);
  circGrid.querySelectorAll('input[type=number]').forEach(i => i.readOnly = readonly);
  minLapInput.readOnly = readonly;
  circGrid.style.opacity = readonly ? '.55' : '';
  minLapInput.style.opacity = readonly ? '.55' : '';
}

function applyCircuit(id) {
  const sel = document.getElementById('circuitSelect');
  const opt = sel.querySelector(`option[value="${id}"]`);
  circuitIdEl.value = id || '';

  if (!id || !opt) {
    setReadonly(false);
    minLapHint.textContent = '';
    populateCategories(null);
    return;
  }

  const count  = parseInt(opt.dataset.count, 10);
  const config = JSON.parse(opt.dataset.config || '[]');
  const minMs  = parseInt(opt.dataset.minMs, 10) || 0;

  setCircuitCount(count);
  config.forEach((lanes, i) => {
    const inp = document.getElementById('circLanes_' + (i + 1));
    if (inp) inp.value = lanes;
  });
  updateTotal();

  if (minMs > 0) {
    minLapInput.value = (minMs / 1000).toFixed(2);
    minLapHint.textContent = '<%= lang === "es" ? "← del circuito" : "← from circuit" %>';
  } else {
    minLapInput.value = '';
    minLapHint.textContent = '';
  }
  setReadonly(true);

  populateCategories(id);
}

// Rellena el selector de categoría con las que tengan Pt configurado para
// este circuito. Si no hay ninguna, oculta el selector.
function populateCategories(circuitId) {
  // Limpiar opciones (mantener la primera "— por defecto —")
  while (categorySelect.options.length > 1) categorySelect.remove(1);
  const list = circuitId ? (CIRCUIT_CATEGORY_TIMES[circuitId] || []) : [];
  if (!list.length) {
    categoryWrap.style.display = 'none';
    categoryIdEl.value = '';
    categoryHint.textContent = '';
    return;
  }
  for (const cat of list) {
    const opt = document.createElement('option');
    opt.value = cat.category_id;
    opt.textContent = `${cat.category_name} (${(cat.min_lap_ms/1000).toFixed(2)}s)`;
    opt.dataset.minMs = cat.min_lap_ms;
    if (String(categoryIdEl.value) === String(cat.category_id)) opt.selected = true;
    categorySelect.appendChild(opt);
  }
  categoryWrap.style.display = 'flex';
  applyCategoryFromSelect();
}

function applyCategoryFromSelect() {
  const opt = categorySelect.selectedOptions[0];
  const id  = opt && opt.value ? opt.value : '';
  categoryIdEl.value = id;
  if (!id) {
    // "— por defecto —": vuelve al Pt del circuito.
    const cOpt = document.querySelector(`#circuitSelect option[value="${circuitIdEl.value}"]`);
    const cMs  = cOpt ? (parseInt(cOpt.dataset.minMs, 10) || 0) : 0;
    if (cMs > 0) {
      minLapInput.value = (cMs / 1000).toFixed(2);
      minLapHint.textContent = '<%= lang === "es" ? "← del circuito" : "← from circuit" %>';
    } else {
      minLapInput.value = '';
      minLapHint.textContent = '';
    }
    categoryHint.textContent = '';
    return;
  }
  const ms = parseInt(opt.dataset.minMs, 10) || 0;
  if (ms > 0) {
    minLapInput.value = (ms / 1000).toFixed(2);
    minLapHint.textContent = '<%= lang === "es" ? "← de la categoría" : "← from category" %>';
  }
  categoryHint.textContent = opt.textContent;
}

categorySelect.addEventListener('change', applyCategoryFromSelect);

// Toggle del bloque "Reglas de turnos por piloto" según tipo de carrera
const champRules = document.getElementById('champRulesGroup');
document.querySelectorAll('input[name="type"]').forEach(r => {
  r.addEventListener('change', () => {
    champRules.style.display = r.value === 'championship' && r.checked ? 'block' : (
      document.querySelector('input[name="type"]:checked')?.value === 'championship' ? 'block' : 'none'
    );
  });
});

circPills.addEventListener('click', e => {
  const btn = e.target.closest('.circ-pill');
  if (btn) setCircuitCount(parseInt(btn.dataset.n));
});

circGrid.addEventListener('input', updateTotal);

// Init: restore circuit selection if coming back from error
const initId = circuitIdEl.value;
if (initId) {
  document.getElementById('circuitSelect').value = initId;
  applyCircuit(initId);
} else {
  updateTotal();
}
</script>

<%- include('../partials/footer') %>
