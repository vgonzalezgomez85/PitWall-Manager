<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= lang === 'es' ? 'Clasificación General' : 'Overall Standings' %> — <%= race.name %>
  </title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Rajdhani:wght@500;600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/live.css">
  <style>
    .panel-body {
      display: flex; flex-direction: column; height: 100vh; overflow: hidden;
      background: #0a0d13; font-family: 'Inter', system-ui, sans-serif; color: #e6edf3;
    }
    .panel-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: .55rem 1.2rem;
      background: #0d1117; border-bottom: 2px solid #161b22;
      flex-shrink: 0;
    }
    .panel-header__left { display: flex; align-items: center; gap: .75rem; }
    .panel-title {
      font-size: .65rem; font-weight: 700; letter-spacing: .15em;
      color: #6e7681; text-transform: uppercase;
    }
    .panel-manga {
      font-family: 'Rajdhani', sans-serif; font-size: 1rem; font-weight: 700;
      color: #e6edf3; letter-spacing: .04em;
    }
    .panel-race { font-size: .72rem; color: #6e7681; }
    .panel-status { display: flex; align-items: center; gap: .4rem; }

    .panel-table-wrap { flex: 1; overflow-y: auto; }
    .panel-table {
      width: 100%; border-collapse: collapse;
      font-size: var(--pt-font, .92rem); table-layout: auto;
    }
    .panel-table th, .panel-table td { white-space: nowrap; }
    .panel-table thead { position: sticky; top: 0; z-index: 5; }
    .panel-table thead th {
      padding: .5rem 1rem; font-size: .68rem; font-weight: 700;
      letter-spacing: .09em; color: #4e555e; text-transform: uppercase;
      background: #080b10; border-bottom: 1px solid #161b22; text-align: left;
    }
    .panel-table td {
      padding: var(--pt-pad, .55rem) 1rem;
      border-bottom: 1px solid #0f1419; vertical-align: middle;
    }
    .pt-right { text-align: right !important; }
    .pt-row:nth-child(odd) { background: rgba(255,255,255,.015); }
    .pt-row--idle .pt-name,
    .pt-row--idle .pt-ontrack,
    .pt-row--idle .pt-avg,
    .pt-row--idle .pt-proj { opacity: .55; }
    .pt-arrows { text-align: center; line-height: 1.05; }
    .pt-arrow-up, .pt-arrow-down { display: block; font-weight: 700; color: #30363d; }
    .pt-arrow-up.good,   .pt-arrow-down.good { color: #3fb950; }
    .pt-arrow-up.bad,    .pt-arrow-down.bad  { color: #e63946; }

    .pt-pos {
      display: inline-flex; align-items: center; justify-content: center;
      width: 28px; height: 28px; border-radius: 50%;
      font-family: 'Rajdhani', sans-serif; font-size: .88rem; font-weight: 700;
    }
    .pt-pos.p1 { background: #f6c90e; color: #0d1117; }
    .pt-pos.p2 { background: #b0b8c0; color: #0d1117; }
    .pt-pos.p3 { background: #a0674a; color: #fff; }
    .pt-pos.pn { background: #21262d; color: #8b949e; }

    .pt-name    { color: #e6edf3; font-weight: 500; }
    .pt-proj    { font-family: 'Share Tech Mono', monospace; color: #f6c90e; font-weight: 700; font-size: 1.05rem; }
    .pt-ontrack { font-family: 'Share Tech Mono', monospace; color: #e6edf3; font-weight: 700; }
    .pt-avg     { font-family: 'Share Tech Mono', monospace; color: #58a6ff; }
    .pt-gap     { font-family: 'Share Tech Mono', monospace; color: #8b949e; }
  </style>
</head>
<body class="panel-body">

  <header class="panel-header">
    <div class="panel-header__left">
      <span class="panel-title"><%= lang === 'es' ? 'Clasificación General' : 'Overall Standings' %></span>
      <span class="panel-manga">
        <% if (tanda) { %><%= lang === 'es' ? 'Tanda' : 'Round' %> <%= tanda.number %> · <% } %>
        <%= lang === 'es' ? 'Manga' : 'Heat' %> #<%= manga.number %>
      </span>
    </div>
    <div class="panel-header__left">
      <div id="panelStatus" class="panel-status">
        <% if (isActive) { %>
          <span class="status-dot status-dot--active"></span>
          <span class="status-text status-text--active"><%= lang === 'es' ? 'En carrera' : 'Racing' %></span>
        <% } else if (manga.status === 'finished') { %>
          <span class="status-text status-text--finished"><%= lang === 'es' ? 'Finalizada' : 'Finished' %></span>
        <% } else { %>
          <span class="status-text status-text--pending"><%= lang === 'es' ? 'En espera' : 'Pending' %></span>
        <% } %>
      </div>
      <span class="panel-race"><%= race.name %></span>
    </div>
  </header>

  <div class="panel-table-wrap">
    <table class="panel-table">
      <thead>
        <tr>
          <th>#</th>
          <th><%= lang === 'es' ? 'Participante' : 'Participant' %></th>
          <th class="pt-right" title="<%= lang === 'es' ? 'Vueltas proyectadas al final de la carrera' : 'Projected total laps' %>"><%= lang === 'es' ? 'V. Proy.' : 'Proj.' %></th>
          <th class="pt-right"><%= lang === 'es' ? 'Total' : 'Total' %></th>
          <th class="pt-right"><%= lang === 'es' ? 'Media' : 'Avg' %></th>
          <th title="<%= lang === 'es' ? 'Tendencia' : 'Trend' %>">↕</th>
          <th class="pt-right"><%= lang === 'es' ? 'Gap V' : 'Gap L' %></th>
          <th class="pt-right"><%= lang === 'es' ? 'Gap S' : 'Gap S' %></th>
        </tr>
      </thead>
      <tbody id="panelBody"></tbody>
    </table>
  </div>

  <%
    const LC2 = ['#e63946','#2196f3','#4caf50','#ff9800','#9c27b0','#00bcd4','#ff5722','#607d8b','#795548','#e91e63','#3f51b5','#009688','#cddc39','#ffc107','#f44336','#673ab7','#03a9f4','#8bc34a','#ff6f00','#880e4f','#1a237e','#b71c1c','#004d40','#f57f17','#311b92','#0d47a1','#1b5e20','#33691e','#bf360c','#4a148c','#006064','#827717'];
    const laneInit2 = {};
    lanes.forEach(l => {
      laneInit2[l.lane] = {
        lane: l.lane, name: l.team_name || l.driver_name || ('Lane ' + l.lane),
        color: LC2[l.lane - 1] || '#8b949e', isRest: l.is_rest ? true : false,
        lapCount: 0, bestLapMs: null, lastLapMs: null, exitCount: 0,
        _sum: 0, _n: 0, avgLapMs: null,
      };
    });
    laps.forEach(l => {
      const s = laneInit2[l.lane];
      if (!s || s.isRest) return;
      s.lapCount = Math.max(s.lapCount, l.lap_number);
      s.lastLapMs = l.lap_time_ms;
      if (!l.is_exit) {
        if (!s.bestLapMs || l.lap_time_ms < s.bestLapMs) s.bestLapMs = l.lap_time_ms;
        s._sum += l.lap_time_ms; s._n++;
      } else s.exitCount++;
    });
    Object.values(laneInit2).forEach(s => {
      s.avgLapMs = s._n > 0 ? Math.round(s._sum / s._n) : null;
    });
  %>

  <script>
    const PANEL_DATA = <%- JSON.stringify({
      raceId:           race.id,
      mangaId:          manga.id,
      isActive:         isActive,
      lanesCount:       race.lanes_count,
      mangaDurationMs:  race.manga_duration_minutes * 60 * 1000,
      totalRaceMs:      race.lanes_count * race.manga_duration_minutes * 60 * 1000,
      standings:        standings,
      lanes:            Object.values(laneInit2),
      allParticipants:  allParticipants || [],
    }) %>;
    const LANG = "<%= lang %>";
  </script>
  <script src="/socket.io/socket.io.js"></script>
  <script>
    function formatMs(ms) {
      if (ms == null) return '—';
      const totalSec   = Math.floor(ms / 1000);
      const hundredths = Math.floor((ms % 1000) / 10);
      const secs = totalSec % 60;
      const mins = Math.floor(totalSec / 60);
      return `${mins > 0 ? mins + ':' : ''}${String(secs).padStart(mins > 0 ? 2 : 1, '0')}.${String(hundredths).padStart(2, '0')}`;
    }

    function posClass(pos) { return ['p1','p2','p3'][pos-1] || 'pn'; }

    const panelBody = document.getElementById('panelBody');

    function fitTable() {
      const wrap = document.querySelector('.panel-table-wrap');
      if (!wrap) return;
      const thead = wrap.querySelector('thead');
      const rows  = panelBody ? panelBody.querySelectorAll('tr') : [];
      if (!rows.length) return;
      const available = wrap.clientHeight - (thead ? thead.offsetHeight : 32);
      const rowH = available / rows.length;
      const fontSize = Math.min(0.92, Math.max(0.38, rowH / (1.5 + 0.9)));
      const pad      = Math.min(0.55, Math.max(0.06, fontSize * 0.45));
      document.documentElement.style.setProperty('--pt-font', fontSize.toFixed(3) + 'rem');
      document.documentElement.style.setProperty('--pt-pad',  pad.toFixed(3) + 'rem');
    }
    window.addEventListener('resize', fitTable);

    // Projected total laps for the WHOLE race for every participant of every tanda:
    //   totalRaceMs = lanes_count × manga_duration_minutes
    //   projected   = floor(totalRaceMs / avgLapMs) if avg available, else 0
    // Live overrides for the active manga come from `standings` (avg in real time).
    function buildRows(data) {
      const totalRaceMs = PANEL_DATA.totalRaceMs;
      const liveByName = new Map();
      if (data?.standings) {
        data.standings.forEach(s => {
          if (s.name) liveByName.set(s.name, s);
        });
      }

      const rows = (PANEL_DATA.allParticipants || []).map(p => {
        const live = liveByName.get(p.entity_name);
        const total   = (p.total_laps || 0) + (live?.lapCount || 0);
        const avg     = live?.avgLapMs ?? (p.avg_lap_ms != null ? Math.round(p.avg_lap_ms) : null);
        const projected = avg ? Math.floor(totalRaceMs / avg) : 0;
        return {
          name: p.entity_name,
          total, avgLapMs: avg, projectedTotal: projected,
          hasData: total > 0 || avg != null,
        };
      });

      rows.sort((a, b) =>
        b.projectedTotal - a.projectedTotal ||
        (a.avgLapMs ?? Infinity) - (b.avgLapMs ?? Infinity) ||
        a.name.localeCompare(b.name)
      );

      const BIG = 1e9;
      const scoreOf = r => (r.projectedTotal || 0) * BIG - (r.avgLapMs ?? BIG);

      rows.forEach((r, i) => {
        if (i === 0) { r._gapL = 0; r._gapMs = 0; r._gapAbove = null; }
        else {
          const above = rows[i-1];
          r._gapL = above.projectedTotal - r.projectedTotal;
          r._gapMs = (r._gapL === 0 && r.avgLapMs != null && above.avgLapMs != null)
            ? above.avgLapMs - r.avgLapMs : 0;
          r._gapAbove = scoreOf(above) - scoreOf(r);
        }
        const below = rows[i+1];
        r._gapBelow = below ? scoreOf(r) - scoreOf(below) : null;

        const prev = prevPanelGap[r.name] || {};
        r._trUp = 'neutral'; r._trDown = 'neutral';
        if (r._gapAbove != null && prev.above != null) {
          if (r._gapAbove < prev.above)      r._trUp = 'good';
          else if (r._gapAbove > prev.above) r._trUp = 'bad';
        }
        if (r._gapBelow != null && prev.below != null) {
          if (r._gapBelow < prev.below)      r._trDown = 'bad';
          else if (r._gapBelow > prev.below) r._trDown = 'good';
        }
      });

      prevPanelGap = {};
      rows.forEach(r => { prevPanelGap[r.name] = { above: r._gapAbove, below: r._gapBelow }; });
      return rows;
    }
    let prevPanelGap = {};

    function render(data) {
      const rows = buildRows(data);
      panelBody.innerHTML = rows.map((r, i) => {
        const upCls   = r._trUp === 'good' ? ' good' : r._trUp === 'bad' ? ' bad' : '';
        const downCls = r._trDown === 'good' ? ' good' : r._trDown === 'bad' ? ' bad' : '';
        const upCh    = i === 0 ? '' : '▲';
        const downCh  = i === rows.length - 1 ? '' : '▼';
        return `
        <tr class="pt-row${r.hasData ? '' : ' pt-row--idle'}">
          <td><span class="pt-pos ${posClass(i+1)}">${i+1}</span></td>
          <td><span class="pt-name">${r.name}</span></td>
          <td class="pt-right"><span class="pt-proj">${r.projectedTotal || '—'}</span></td>
          <td class="pt-right"><span class="pt-ontrack">${r.total}</span></td>
          <td class="pt-right"><span class="pt-avg">${formatMs(r.avgLapMs)}</span></td>
          <td class="pt-arrows">
            <span class="pt-arrow-up${upCls}">${upCh}</span>
            <span class="pt-arrow-down${downCls}">${downCh}</span>
          </td>
          <td class="pt-right"><span class="pt-gap">${r._gapL > 0 ? '-' + r._gapL : '—'}</span></td>
          <td class="pt-right"><span class="pt-gap">${r._gapMs > 0 ? '+' + formatMs(r._gapMs) : '—'}</span></td>
        </tr>`;
      }).join('');
      requestAnimationFrame(fitTable);
    }

    render(PANEL_DATA.standings);

    if (PANEL_DATA.isActive) {
      const socket = io();
      socket.on('connect', () => socket.emit('standings:request'));
      socket.on('standings', (data) => render(data));
      socket.on('manga:stopped', () => {
        const s = document.getElementById('panelStatus');
        if (s) s.innerHTML = `<span class="status-text status-text--finished">${LANG === 'es' ? 'Finalizada' : 'Finished'}</span>`;
      });
      socket.on('manga:cancelled', () => { location.reload(); });
    }
  </script>
</body>
</html>
