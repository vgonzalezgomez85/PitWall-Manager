<%- include('../partials/header', { pageTitle: t('wizard.step3_seq_title') }) %>
<div class="container container--narrow">

  <%- include('../partials/wizard-progress', { step: 3, hasPole: wizard.has_pole }) %>

  <h1 class="page-title"><%= t('wizard.step3_seq_title') %></h1>
  <%
    const circuitLabels = circuits.map((lanes, i) => {
      let start = 1;
      for (let j = 0; j < i; j++) start += circuits[j];
      return { num: i+1, start, end: start + lanes - 1, lanes };
    });
  %>
  <p class="page-subtitle">
    <%= wizard.name %> ·
    <% circuitLabels.forEach((c, i) => { %>
      <%= lang === 'es' ? 'C' : 'C' %><%= c.num %>: <%= c.lanes %> <%= t('races.lanes') %><%= i < circuitLabels.length-1 ? ' · ' : '' %>
    <% }) %>
    (total: <%= wizard.lanes_count %>)
  </p>

  <% if (errors.length > 0) { %>
    <div class="alert alert--error">
      <p>
        <%= lang === 'es'
          ? 'La secuencia debe contener cada carril exactamente una vez (más los descansos opcionales).'
          : 'The sequence must contain each lane exactly once (plus optional rest slots).' %>
      </p>
    </div>
  <% } %>

  <div class="form-card">

    <!-- Circuit legend (only for multi-circuit) -->
    <% if (circuits.length > 1) { %>
      <div class="circuit-legend" style="margin-bottom:1.25rem">
        <% circuitLabels.forEach(c => { %>
          <% const colors = ['#e63946','#2196f3','#4caf50','#ff9800','#9c27b0','#00bcd4']; %>
          <span class="circuit-legend-item">
            <span class="circuit-legend-dot" style="background:<%= colors[c.num-1] %>">C<%= c.num %></span>
            <%= lang === 'es' ? 'Carriles' : 'Lanes' %> <%= c.start %>–<%= c.end %>
          </span>
        <% }) %>
      </div>
    <% } %>

    <!-- Controls arriba -->
    <div style="display:flex;gap:.75rem;align-items:center;flex-wrap:wrap;margin-bottom:1.25rem;padding:1rem;background:#000000;border-radius:8px;border:1px solid #21262d">
      <label class="form-label" style="margin:0;white-space:nowrap;font-size:1rem">
        <%= lang === 'es' ? 'Participantes:' : 'Participants:' %>
      </label>
      <input type="number" id="numParticipants" class="form-input form-input--sm"
        min="<%= wizard.lanes_count %>" max="99"
        value="<%= wizard.lanes_count %>"
        style="width:80px;font-size:1rem">
      <button type="button" id="btnSmartSeq" class="btn btn--primary">
        ⚡ <%= lang === 'es' ? 'Generar secuencia' : 'Generate sequence' %>
      </button>
      <% if (circuits.length >= 2) { %>
        <span class="form-hint" style="color:#8b949e">
          💡 <%= lang === 'es' ? 'C impares: DSC después del carril 2 · C pares: DSC después del penúltimo' : 'Odd C: rest after lane 2 · Even C: rest after second-to-last' %>
        </span>
      <% } %>
    </div>

    <p class="form-hint" id="seqPreview" style="margin-bottom:.75rem"></p>

    <div id="laneList" class="seq-list">
      <%
        const COLORS_SEQ = ['#e63946','#2196f3','#4caf50','#ff9800','#9c27b0','#00bcd4','#ff5722','#607d8b','#795548','#e91e63','#3f51b5','#009688','#cddc39','#ffc107','#f44336','#673ab7','#03a9f4','#8bc34a','#ff6f00','#880e4f','#1a237e','#b71c1c','#004d40','#f57f17','#311b92','#0d47a1','#1b5e20','#33691e','#bf360c','#4a148c','#006064','#827717'];
      %>
      <% sequence.forEach((lane, i) => { %>
        <% if (lane === 0) { %>
          <div class="seq-item seq-item--rest" draggable="true" data-lane="0">
            <span class="seq-handle">⠿</span>
            <span class="seq-dot seq-dot--rest"><%= lang === 'es' ? 'DSC' : 'REST' %></span>
            <button type="button" class="seq-remove" title="<%= lang === 'es' ? 'Quitar' : 'Remove' %>">✕</button>
            <span class="seq-arrow"><%= i < sequence.length - 1 ? '→' : '' %></span>
          </div>
        <% } else { %>
          <div class="seq-item" draggable="true" data-lane="<%= lane %>">
            <span class="seq-handle">⠿</span>
            <span class="seq-dot" style="background:<%= COLORS_SEQ[lane-1] %>"><%= lane %></span>
            <span class="seq-arrow"><%= i < sequence.length - 1 ? '→' : '' %></span>
          </div>
        <% } %>
      <% }) %>
    </div>

    <p class="form-hint" style="margin-top:.5rem;color:#6e7681">
      <%= lang === 'es' ? 'Arrastra los elementos para ajustar el orden manualmente.' : 'Drag items to manually adjust the order.' %>
    </p>

    <form action="/races/new/step3" method="POST" id="seqForm" style="margin-top:1.5rem">
      <input type="hidden" name="lane_sequence" id="seqInput">

      <div class="form-actions">
        <a href="/races/new/step2" class="btn btn--ghost">← <%= t('wizard.back') %></a>
        <button type="submit" class="btn btn--primary"><%= t('wizard.next') %> →</button>
      </div>
    </form>

  </div>
</div>

<script>
const LANES    = <%= wizard.lanes_count %>;
const LANG     = "<%= lang %>";
const CIRCUITS = <%- JSON.stringify(circuits) %>; // e.g. [8, 8]
const COLORS   = <%- JSON.stringify(['#e63946','#2196f3','#4caf50','#ff9800','#9c27b0','#00bcd4','#ff5722','#607d8b','#795548','#e91e63','#3f51b5','#009688','#cddc39','#ffc107','#f44336','#673ab7','#03a9f4','#8bc34a','#ff6f00','#880e4f','#1a237e','#b71c1c','#004d40','#f57f17','#311b92','#0d47a1','#1b5e20','#33691e','#bf360c','#4a148c','#006064','#827717']) %>;

// ── Smart sequence: circuit-based with mirror rule ────────────────────────────
// Odd circuits (C1,C3...): rest after local lane 2
// Even circuits (C2,C4...): rest after local lane M-1 (mirror of lane 2)
function buildSmartSeq(numParticipants) {
  const totalRests   = Math.max(0, numParticipants - LANES);
  const numCircuits  = CIRCUITS.length;
  // Distribute rests evenly across circuits (1 rest point per circuit)
  const restsPerCircuit = Array(numCircuits).fill(Math.floor(totalRests / numCircuits));
  for (let i = 0; i < totalRests % numCircuits; i++) restsPerCircuit[i]++;

  const seq = [];
  let globalStart = 1;

  CIRCUITS.forEach((M, ci) => {
    const isEven   = (ci + 1) % 2 === 0; // 1-based index: C2, C4 are even
    // Rest position: local lane 2 for odd, local lane M-1 for even
    const restAfterLocal = isEven ? (M - 1) : 2;
    const rests = restsPerCircuit[ci];

    for (let local = 1; local <= M; local++) {
      seq.push(globalStart + local - 1);
      if (local === restAfterLocal) {
        for (let r = 0; r < rests; r++) seq.push(0); // REST
      }
    }
    globalStart += M;
  });
  return seq;
}

// Standard sequence: odd lanes ascending → even lanes descending (legacy)
const STD_SEQ = (() => {
  const odds = [], evens = [];
  for (let i = 1; i <= LANES; i++) { if (i % 2) odds.push(i); else evens.push(i); }
  return [...odds, ...evens.reverse()];
})();

const list     = document.getElementById('laneList');
const seqInput = document.getElementById('seqInput');
const preview  = document.getElementById('seqPreview');

function readOrder() {
  return [...list.querySelectorAll('.seq-item')].map(el => +el.dataset.lane);
}

function updatePreview() {
  const order = readOrder();
  seqInput.value = order.join(',');
  const restLabel = LANG === 'es' ? 'DSC' : 'REST';
  preview.textContent = order.map(n => n === 0 ? restLabel : n).join(' → ');
  list.querySelectorAll('.seq-arrow').forEach((el, i) => {
    el.textContent = i < order.length - 1 ? '→' : '';
  });
}
updatePreview();

// ── Drag-and-drop ─────────────────────────────────────────────────────────────
let dragSrc = null;
list.addEventListener('dragstart', e => {
  dragSrc = e.target.closest('.seq-item');
  e.dataTransfer.effectAllowed = 'move';
});
list.addEventListener('dragover', e => {
  e.preventDefault();
  const target = e.target.closest('.seq-item');
  if (target && target !== dragSrc) {
    const rect  = target.getBoundingClientRect();
    const after = e.clientY > rect.top + rect.height / 2;
    list.insertBefore(dragSrc, after ? target.nextSibling : target);
    updatePreview();
  }
});
list.addEventListener('dragend', () => { dragSrc = null; updatePreview(); });

// ── Remove rest slot ──────────────────────────────────────────────────────────
list.addEventListener('click', e => {
  const btn = e.target.closest('.seq-remove');
  if (btn) {
    btn.closest('.seq-item').remove();
    updatePreview();
  }
});


// ── Generate smart sequence ───────────────────────────────────────────────────
function makeRestEl() {
  const item = document.createElement('div');
  item.className = 'seq-item seq-item--rest';
  item.draggable = true;
  item.dataset.lane = '0';
  item.innerHTML = `
    <span class="seq-handle">⠿</span>
    <span class="seq-dot seq-dot--rest">${LANG === 'es' ? 'DSC' : 'REST'}</span>
    <button type="button" class="seq-remove" title="${LANG === 'es' ? 'Quitar' : 'Remove'}">✕</button>
    <span class="seq-arrow"></span>`;
  return item;
}

function makeLaneEl(lane) {
  const item = document.createElement('div');
  item.className = 'seq-item';
  item.draggable = true;
  item.dataset.lane = lane;
  item.innerHTML = `
    <span class="seq-handle">⠿</span>
    <span class="seq-dot" style="background:${COLORS[lane-1]}">${lane}</span>
    <span class="seq-arrow"></span>`;
  return item;
}

function applySeq(seq) {
  list.innerHTML = '';
  seq.forEach(lane => list.appendChild(lane === 0 ? makeRestEl() : makeLaneEl(lane)));
  updatePreview();
}

document.getElementById('btnSmartSeq').addEventListener('click', () => {
  const n = parseInt(document.getElementById('numParticipants').value, 10) || LANES;
  applySeq(buildSmartSeq(n));
});

document.getElementById('seqForm').addEventListener('submit', () => {
  seqInput.value = readOrder().join(',');
});
</script>

<%- include('../partials/footer') %>
