<%- include('../partials/header', { pageTitle: (lang === 'es' ? 'Resultados' : 'Results') + ' — ' + race.name }) %>
<style>
/* ── Race fastest lap banner ── */
.race-best-banner {
  display: flex; align-items: center; gap: 1rem;
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
  color: #1a1a1a; padding: 1rem 1.25rem; border-radius: 12px;
  margin-bottom: 1.25rem; box-shadow: 0 4px 16px rgba(245,158,11,0.25);
}
.race-best-banner__icon { font-size: 2rem; line-height: 1; }
.race-best-banner__label { font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; opacity: .8; }
.race-best-banner__value strong { font-size: 1.5rem; font-weight: 800; font-variant-numeric: tabular-nums; }
.race-best-banner__meta { margin-left: .75rem; font-size: .9rem; opacity: .85; }

/* ── Comparison matrix table ── */
.matrix-wrapper { overflow-x: auto; border-radius: 12px; border: 1px solid #21262d; background: #0d1117; }
.matrix-table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; font-size: .85rem; }
.matrix-table th, .matrix-table td { padding: .55rem .7rem; text-align: center; }
.matrix-table thead th {
  background: #161b22; color: #c9d1d9; font-weight: 600; font-size: .75rem;
  text-transform: uppercase; letter-spacing: .05em; border-bottom: 2px solid #30363d;
  position: sticky; top: 0; z-index: 1;
}
.matrix-table .matrix-name { text-align: left; min-width: 180px; }
.matrix-table .matrix-pos { width: 3rem; }
.matrix-lane__label { font-size: .65rem; color: #8b949e; margin-top: 4px; font-weight: 500; }
.lane-pill {
  display: inline-flex; align-items: center; justify-content: center;
  width: 1.8rem; height: 1.8rem; border-radius: 6px; color: #fff;
  font-weight: 700; font-size: .8rem;
}
.matrix-entity { border-top: 2px solid #30363d; background: #161b22; }
.matrix-entity .matrix-name { padding-top: .7rem; padding-bottom: .25rem; }
.matrix-entity .matrix-total { font-size: 1.15rem; font-weight: 800; color: #58a6ff; }
.matrix-entity .matrix-lane-laps { font-size: 1rem; font-weight: 700; color: #c9d1d9; }
.matrix-entity.top-1 .matrix-total { color: #fbbf24; }
.matrix-entity.top-2 .matrix-total { color: #d1d5db; }
.matrix-entity.top-3 .matrix-total { color: #d97706; }
.matrix-stat { background: #0d1117; }
.matrix-stat td { padding: .35rem .7rem; color: #c9d1d9; }
.matrix-stat__label { text-align: left !important; color: #8b949e !important; font-size: .75rem; font-weight: 500; padding-left: 1rem !important; }
.matrix-stat__total { color: #8b949e !important; font-size: .8rem; }
.matrix-stat--best td { color: #7ee787; font-weight: 600; }
.matrix-stat--avg td { color: #c9d1d9; }
.matrix-stat--worst td { color: #8b949e; font-size: .78rem; }
.matrix-stat--worst .exit-count { color: #f85149; font-weight: 600; margin-right: 3px; }
.matrix-stat--worst .exit-count:not(.has-exits) { color: #484f58; }
.matrix-stat--pit td { color: #c9d1d9; font-size: .78rem; }
.matrix-stat--pit .exit-count { color: #ff9800; font-weight: 600; margin-right: 3px; }
.matrix-stat--pit .pit-laps { color: #8b949e; font-family: 'Share Tech Mono', monospace; }
.exit-total { color: #f85149; font-weight: 600; margin-left: 4px; }
.matrix-stat--pit .exit-total { color: #ff9800; }

.race-best {
  background: linear-gradient(135deg, rgba(251,191,36,0.2), rgba(245,158,11,0.15)) !important;
  color: #fbbf24 !important; font-weight: 800 !important;
  position: relative;
  border-radius: 4px;
}
.race-best-star { color: #fbbf24; margin-left: 2px; }

@media print {
  .navbar, .page-header__actions, .results-tabs, .back-link,
  .results-panel:not(.active) { display: none !important; }
  .results-panel.active { display: block !important; }
  body { background: #fff !important; color: #000 !important; }
  .results-table { border-collapse: collapse; width: 100%; }
  .results-table th, .results-table td { border: 1px solid #ccc; padding: 6px 10px; }
  .results-table thead th { background: #f0f0f0 !important; color: #000 !important; }
  .pos-badge { border: 1px solid #999; color: #000 !important; background: none !important; }
  .result-highlight { font-weight: 700; }
  .page-title::before { content: "<%= race.name %> — "; font-size: 1rem; color: #555; display: block; }
}
</style>
<div class="container">

  <!-- Header -->
  <div class="page-header">
    <div>
      <a href="/races/<%= race.id %>" class="back-link">← <%= t('race.back_to_list') %></a>
      <h1 class="page-title"><%= lang === 'es' ? 'Resultados' : 'Results' %></h1>
      <p class="page-subtitle"><%= race.name %> · <%= t('races.type.' + race.type) %> · <%= t('races.format.' + race.format) %></p>
    </div>
    <div class="page-header__actions">
      <span class="badge badge--neutral"><%= tandas.length %> <%= lang === 'es' ? 'tandas' : 'rounds' %></span>
      <a href="/races/<%= race.id %>/results/xlsx?lang=<%= lang %>" class="btn btn--ghost btn--sm" title="<%= lang === 'es' ? 'Exportar a Excel' : 'Export to Excel' %>">
        📊 Excel
      </a>
      <button class="btn btn--ghost btn--sm" onclick="window.print()" title="<%= lang === 'es' ? 'Guardar como PDF' : 'Save as PDF' %>">
        🖨 PDF
      </button>
    </div>
  </div>

  <% if (results.length === 0) { %>
    <div class="empty-state">
      <div class="empty-state__icon">📊</div>
      <p class="empty-state__text">
        <%= lang === 'es' ? 'Sin datos todavía. Completa al menos una manga para ver resultados.' : 'No data yet. Complete at least one heat to see results.' %>
      </p>
    </div>
  <% } else { %>

    <%
      function fmtMs(ms) {
        if (ms == null) return '—';
        const totalSec   = Math.floor(ms / 1000);
        const hundredths = Math.floor((ms % 1000) / 10);
        const secs = totalSec % 60;
        const mins = Math.floor(totalSec / 60);
        return (mins > 0 ? mins + ':' : '') + String(secs).padStart(mins > 0 ? 2 : 1, '0') + '.' + String(hundredths).padStart(2, '0');
      }
    %>

    <!-- Tab nav -->
    <div class="results-tabs">
      <button class="results-tab active" data-tab="total">
        🏆 <%= lang === 'es' ? 'Total vueltas' : 'Total laps' %>
      </button>
      <button class="results-tab" data-tab="best">
        ⚡ <%= lang === 'es' ? 'Mejor vuelta' : 'Best lap' %>
      </button>
      <button class="results-tab" data-tab="avg">
        📈 <%= lang === 'es' ? 'Vuelta media' : 'Average lap' %>
      </button>
      <button class="results-tab" data-tab="lanes">
        🗂 <%= lang === 'es' ? 'Por carril' : 'Per lane' %>
      </button>
      <button class="results-tab" data-tab="matrix">
        🏁 <%= lang === 'es' ? 'Comparativa' : 'Comparison' %>
      </button>
    </div>

    <!-- ── Total laps ranking ── -->
    <div class="results-panel active" id="tab-total">
      <table class="results-table">
        <thead>
          <tr>
            <th class="col-pos">#</th>
            <th><%= lang === 'es' ? 'Piloto / Equipo' : 'Driver / Team' %></th>
            <th class="col-num"><%= lang === 'es' ? 'Vueltas' : 'Laps' %></th>
            <th class="col-num"><%= lang === 'es' ? 'Mejor' : 'Best' %></th>
            <th class="col-num"><%= lang === 'es' ? 'Media' : 'Avg' %></th>
            <th class="col-num"><%= lang === 'es' ? 'Mangas' : 'Heats' %></th>
          </tr>
        </thead>
        <tbody>
          <% const byTotal = [...results].sort((a,b) => b.total_laps - a.total_laps || (a.best_lap_ms||Infinity) - (b.best_lap_ms||Infinity)); %>
          <% byTotal.forEach((r, i) => { %>
            <tr class="results-row <%= i < 3 ? 'top-' + (i+1) : '' %>">
              <td class="col-pos">
                <span class="pos-badge pos-<%= i+1 %>"><%= i+1 %></span>
              </td>
              <td>
                <% if (r.color) { %>
                  <span class="lane-dot" style="background:<%= r.color %>; width:10px; height:10px; display:inline-block; border-radius:3px; margin-right:6px;"></span>
                <% } %>
                <strong><%= r.entity_name %></strong>
              </td>
              <td class="col-num result-highlight"><%= r.total_laps %></td>
              <td class="col-num"><%= fmtMs(r.best_lap_ms) %></td>
              <td class="col-num text-muted"><%= fmtMs(Math.round(r.avg_lap_ms)) %></td>
              <td class="col-num text-muted"><%= r.mangas_raced %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- ── Best lap ranking ── -->
    <div class="results-panel" id="tab-best">
      <table class="results-table">
        <thead>
          <tr>
            <th class="col-pos">#</th>
            <th><%= lang === 'es' ? 'Piloto / Equipo' : 'Driver / Team' %></th>
            <th class="col-num"><%= lang === 'es' ? 'Mejor vuelta' : 'Best lap' %></th>
            <th class="col-num"><%= lang === 'es' ? 'Vueltas' : 'Laps' %></th>
          </tr>
        </thead>
        <tbody>
          <% const byBest = [...results].filter(r => r.best_lap_ms).sort((a,b) => a.best_lap_ms - b.best_lap_ms); %>
          <% byBest.forEach((r, i) => { %>
            <tr class="results-row <%= i < 3 ? 'top-' + (i+1) : '' %>">
              <td class="col-pos">
                <span class="pos-badge pos-<%= i+1 %>"><%= i+1 %></span>
              </td>
              <td>
                <% if (r.color) { %>
                  <span class="lane-dot" style="background:<%= r.color %>; width:10px; height:10px; display:inline-block; border-radius:3px; margin-right:6px;"></span>
                <% } %>
                <strong><%= r.entity_name %></strong>
              </td>
              <td class="col-num result-highlight"><%= fmtMs(r.best_lap_ms) %></td>
              <td class="col-num text-muted"><%= r.total_laps %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- ── Average lap ranking ── -->
    <div class="results-panel" id="tab-avg">
      <table class="results-table">
        <thead>
          <tr>
            <th class="col-pos">#</th>
            <th><%= lang === 'es' ? 'Piloto / Equipo' : 'Driver / Team' %></th>
            <th class="col-num"><%= lang === 'es' ? 'Media' : 'Average' %></th>
            <th class="col-num"><%= lang === 'es' ? 'Vueltas' : 'Laps' %></th>
          </tr>
        </thead>
        <tbody>
          <% const byAvg = [...results].filter(r => r.avg_lap_ms).sort((a,b) => a.avg_lap_ms - b.avg_lap_ms); %>
          <% byAvg.forEach((r, i) => { %>
            <tr class="results-row <%= i < 3 ? 'top-' + (i+1) : '' %>">
              <td class="col-pos">
                <span class="pos-badge pos-<%= i+1 %>"><%= i+1 %></span>
              </td>
              <td>
                <% if (r.color) { %>
                  <span class="lane-dot" style="background:<%= r.color %>; width:10px; height:10px; display:inline-block; border-radius:3px; margin-right:6px;"></span>
                <% } %>
                <strong><%= r.entity_name %></strong>
              </td>
              <td class="col-num result-highlight"><%= fmtMs(Math.round(r.avg_lap_ms)) %></td>
              <td class="col-num text-muted"><%= r.total_laps %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- ── Per-lane breakdown ── -->
    <div class="results-panel" id="tab-lanes">
      <% results.forEach(r => { %>
        <div class="per-lane-block">
          <div class="per-lane-header">
            <% if (r.color) { %>
              <span class="lane-dot" style="background:<%= r.color %>; width:14px; height:14px; display:inline-block; border-radius:4px; margin-right:8px; flex-shrink:0"></span>
            <% } %>
            <strong><%= r.entity_name %></strong>
            <span class="text-muted" style="font-size:.8rem; margin-left:.5rem">
              <%= r.total_laps %> <%= lang === 'es' ? 'vueltas totales' : 'total laps' %>
            </span>
          </div>
          <% if (r.perLane && r.perLane.length > 0) { %>
            <table class="per-lane-table">
              <thead>
                <tr>
                  <th><%= lang === 'es' ? 'Carril' : 'Lane' %></th>
                  <th class="col-num"><%= lang === 'es' ? 'Vueltas' : 'Laps' %></th>
                  <th class="col-num"><%= lang === 'es' ? 'Mejor' : 'Best' %></th>
                  <th class="col-num"><%= lang === 'es' ? 'Media' : 'Avg' %></th>
                  <th class="col-num" title="<%= lang === 'es' ? 'Salidas de pista' : 'Off-track exits' %>">🚨</th>
                </tr>
              </thead>
              <tbody>
                <% r.perLane.forEach(pl => { %>
                  <tr>
                    <td>
                      <span class="lane-dot" style="background:<%= LANE_COLORS[pl.lane-1] || '#8b949e' %>"><%= pl.lane %></span>
                    </td>
                    <td class="col-num"><%= pl.laps %></td>
                    <td class="col-num"><%= fmtMs(pl.best_ms) %></td>
                    <td class="col-num text-muted"><%= fmtMs(Math.round(pl.avg_ms)) %></td>
                    <td class="col-num" style="<%= pl.exit_count > 0 ? 'color:#e63946;font-weight:600' : 'color:#8b949e' %>">
                      <%= pl.exit_count || 0 %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } else { %>
            <p class="form-hint" style="padding:.5rem 0"><%= lang === 'es' ? 'Sin datos de vueltas.' : 'No lap data.' %></p>
          <% } %>
        </div>
      <% }) %>
    </div>

    <!-- ── Comparison matrix (PDF-style, modern) ── -->
    <div class="results-panel" id="tab-matrix">
      <%
        const orderedLanes = (laneSequence || []).filter(l => l > 0);
        const byTotalM = [...results].sort((a,b) => b.total_laps - a.total_laps || (a.best_lap_ms||Infinity) - (b.best_lap_ms||Infinity));

        function fmtSec(ms) {
          if (ms == null) return '—';
          return (ms / 1000).toFixed(3).replace('.', ',');
        }
      %>

      <% if (raceBestLapMs != null) { %>
        <div class="race-best-banner">
          <span class="race-best-banner__icon">⚡</span>
          <div>
            <div class="race-best-banner__label"><%= lang === 'es' ? 'Vuelta rápida de la carrera' : 'Race fastest lap' %></div>
            <div class="race-best-banner__value">
              <strong><%= fmtSec(raceBestLapMs) %>s</strong>
              <span class="race-best-banner__meta"><%= raceBestEntity %> · <%= lang === 'es' ? 'Pista' : 'Lane' %> <%= raceBestLane %></span>
            </div>
          </div>
        </div>
      <% } %>

      <div class="matrix-wrapper">
        <table class="matrix-table">
          <thead>
            <tr>
              <th class="matrix-pos">#</th>
              <th class="matrix-name"><%= lang === 'es' ? 'Equipo / Piloto' : 'Team / Driver' %></th>
              <th class="matrix-laps"><%= lang === 'es' ? 'Vueltas' : 'Laps' %></th>
              <% orderedLanes.forEach(lane => { %>
                <th class="matrix-lane">
                  <span class="lane-pill" style="background:<%= LANE_COLORS[lane-1] || '#8b949e' %>"><%= lane %></span>
                  <div class="matrix-lane__label"><%= lang === 'es' ? 'Pista' : 'Lane' %> <%= lane %></div>
                </th>
              <% }) %>
            </tr>
          </thead>
          <tbody>
            <% byTotalM.forEach((r, i) => {
                 const laneMap = new Map((r.perLane||[]).map(pl => [pl.lane, pl]));
            %>
              <!-- Entity header row -->
              <tr class="matrix-entity <%= i < 3 ? 'top-' + (i+1) : '' %>">
                <td class="matrix-pos" rowspan="5">
                  <span class="pos-badge pos-<%= i+1 %>"><%= i+1 %></span>
                </td>
                <td class="matrix-name">
                  <% if (r.color) { %>
                    <span class="lane-dot" style="background:<%= r.color %>; width:10px; height:10px; display:inline-block; border-radius:3px; margin-right:6px;"></span>
                  <% } %>
                  <strong><%= r.entity_name %></strong>
                </td>
                <td class="matrix-laps matrix-total"><%= r.total_laps %></td>
                <% orderedLanes.forEach(lane => {
                     const pl = laneMap.get(lane);
                %>
                  <td class="matrix-lane-cell matrix-lane-laps">
                    <%= pl ? pl.laps : '—' %>
                  </td>
                <% }) %>
              </tr>

              <!-- Fastest lap row -->
              <tr class="matrix-stat matrix-stat--best">
                <td class="matrix-stat__label">⚡ <%= lang === 'es' ? 'Rápida' : 'Fast' %></td>
                <td class="matrix-stat__total"><%= fmtSec(r.best_lap_ms) %></td>
                <% orderedLanes.forEach(lane => {
                     const pl = laneMap.get(lane);
                     const isRaceBest = pl && pl.best_ms != null && pl.best_ms === raceBestLapMs;
                %>
                  <td class="matrix-lane-cell <%= isRaceBest ? 'race-best' : '' %>">
                    <% if (pl && pl.best_ms != null) { %>
                      <%= fmtSec(pl.best_ms) %><% if (isRaceBest) { %> <span class="race-best-star">★</span><% } %>
                    <% } else { %>—<% } %>
                  </td>
                <% }) %>
              </tr>

              <!-- Average row -->
              <tr class="matrix-stat matrix-stat--avg">
                <td class="matrix-stat__label"><%= lang === 'es' ? 'Media' : 'Avg' %></td>
                <td class="matrix-stat__total"><%= fmtSec(Math.round(r.avg_lap_ms)) %></td>
                <% orderedLanes.forEach(lane => {
                     const pl = laneMap.get(lane);
                %>
                  <td class="matrix-lane-cell">
                    <%= pl && pl.avg_ms != null ? fmtSec(Math.round(pl.avg_ms)) : '—' %>
                  </td>
                <% }) %>
              </tr>

              <!-- Slowest + exits row -->
              <tr class="matrix-stat matrix-stat--worst">
                <td class="matrix-stat__label">
                  <%= lang === 'es' ? 'Salidas' : 'Exits' %>
                  <span class="exit-total">(<%= (r.perLane||[]).reduce((s,pl)=>s+(pl.exit_count||0),0) %>)</span>
                </td>
                <td class="matrix-stat__total">—</td>
                <% orderedLanes.forEach(lane => {
                     const pl = laneMap.get(lane);
                %>
                  <td class="matrix-lane-cell">
                    <% if (pl && pl.worst_ms != null) { %>
                      <span class="exit-count <%= pl.exit_count > 0 ? 'has-exits' : '' %>">(<%= pl.exit_count || 0 %>)</span>
                      <%= fmtSec(pl.worst_ms) %>
                    <% } else { %>—<% } %>
                  </td>
                <% }) %>
              </tr>

              <!-- Pit-stops row -->
              <%
                const totalPitStops = (r.perLane||[]).reduce((s,pl)=>s+(pl.pit_stop_count||0),0);
              %>
              <tr class="matrix-stat matrix-stat--pit">
                <td class="matrix-stat__label">
                  🔧 <%= lang === 'es' ? 'Pit-stops' : 'Pit-stops' %>
                  <span class="exit-total">(<%= totalPitStops %>)</span>
                </td>
                <td class="matrix-stat__total">—</td>
                <% orderedLanes.forEach(lane => {
                     const pl = laneMap.get(lane);
                     const lapsList = (pl && pl.pit_stop_laps)
                       ? pl.pit_stop_laps.split(',').filter(Boolean).map(n => 'V' + n).join(', ')
                       : '';
                %>
                  <td class="matrix-lane-cell">
                    <% if (pl && pl.pit_stop_count > 0) { %>
                      <span class="exit-count has-exits">(<%= pl.pit_stop_count %>)</span>
                      <span class="pit-laps"><%= lapsList %></span>
                    <% } else { %>—<% } %>
                  </td>
                <% }) %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

  <% } %>

  <!-- Lap corrections per manga -->
  <% if (tandas.some(t => t.mangas && t.mangas.length > 0)) { %>
    <div style="margin-top:2.5rem">
      <h2 class="section-title">
        🔧 <%= lang === 'es' ? 'Corrección de vueltas' : 'Lap Corrections' %>
      </h2>
      <p class="form-hint" style="margin-bottom:1rem">
        <%= lang === 'es'
          ? 'Elimina vueltas fantasma, transfiere vueltas entre carriles o añade vueltas manualmente.'
          : 'Remove ghost laps, transfer laps between lanes, or add laps manually.' %>
      </p>
      <div style="display:flex;flex-direction:column;gap:.5rem">
        <% tandas.forEach(t => { %>
          <% if (t.mangas && t.mangas.length > 0) { %>
            <div class="tanda-block" style="padding:.75rem 1rem">
              <span class="tanda-num"><%= lang === 'es' ? 'Tanda' : 'Round' %> <%= t.number %></span>
              <div style="display:flex;flex-wrap:wrap;gap:.4rem;margin-top:.5rem">
                <% t.mangas.forEach(m => { %>
                  <a href="/races/<%= race.id %>/mangas/<%= m.id %>/corrections"
                     class="btn btn--ghost btn--sm">
                    <%= lang === 'es' ? 'Manga' : 'Heat' %> <%= m.number %>
                    <span class="badge badge--<%= m.status %>" style="font-size:.65rem;margin-left:.3rem">
                      <%= {pending: lang==='es'?'Pend.':'Pend.', active: lang==='es'?'Activa':'Active', finished: '✓'}[m.status] %>
                    </span>
                  </a>
                <% }) %>
              </div>
            </div>
          <% } %>
        <% }) %>
      </div>
    </div>
  <% } %>

</div>

<script>
  document.querySelectorAll('.results-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.results-tab').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.results-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('tab-' + btn.dataset.tab).classList.add('active');
    });
  });
</script>

<%- include('../partials/footer') %>
