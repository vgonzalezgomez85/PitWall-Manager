      .adv-card__big { font-family:'Share Tech Mono', monospace; color:#e6edf3; font-size:1.6rem; font-weight:700; margin-top:.15rem }
      .adv-card__hint { color:#6e7681; font-size:.75rem; margin-top:.15rem }
      .adv-card--wide { grid-column: 1 / -1 }
      .adv-manga-chart { height:260px; background:#000000; border:1px solid #21262d; border-radius:10px; padding:.6rem; margin:.5rem 0 .8rem }
      .adv-mangas { display:flex; gap:.5rem; flex-wrap:wrap; margin-top:.3rem }
      .adv-manga { flex:0 0 auto; background:#000000; border:1px solid #21262d; border-radius:8px; padding:.5rem .7rem; min-width:100px }
      .adv-manga__lbl { color:#6e7681; font-size:.7rem; text-transform:uppercase; letter-spacing:.05em }
      .adv-manga__val { font-family:'Share Tech Mono', monospace; color:#c9d1d9; font-weight:700; font-size:1rem }
      .adv-manga__meta { color:#6e7681; font-size:.7rem }
      .adv-compare-table { width:100%; border-collapse:collapse; font-size:.92rem }
      .adv-compare-table th, .adv-compare-table td { padding:.5rem .7rem; border-bottom:1px solid #21262d; color:#c9d1d9 }
      .adv-compare-table th { color:#8b949e; font-size:.72rem; text-transform:uppercase; letter-spacing:.05em; background:#000000 }
      .adv-diff--better { color:#3fb950; font-weight:700 }
      .adv-diff--worse  { color:#f85149; font-weight:700 }
    </style>

    <script id="advancedStatsData" type="application/json"><%- JSON.stringify(advancedStats || []) %></script>
    <script>
      (function() {
        const data = JSON.parse(document.getElementById('advancedStatsData').textContent || '[]');
        if (data.length === 0) return;
        const selEntity  = document.getElementById('advEntity');
        const selCompare = document.getElementById('advCompare');
        const cbOutliers = document.getElementById('advIncludeOutliers');
        const panels     = document.getElementById('advPanels');
        const cmpSection = document.getElementById('advCompareSection');
        let includeOutliers = false;

        // Populate selects
        data.forEach(e => {
          selEntity.innerHTML  += `<option value="${e.key}">${e.entityName}</option>`;
          selCompare.innerHTML += `<option value="${e.key}">${e.entityName}</option>`;
        });
        selEntity.value = data[0].key;

        function fmtMs(ms) { return ms == null ? '—' : (ms/1000).toFixed(3).replace('.', ',') + 's'; }
        function fmtSec(ms) { return ms == null ? '—' : (ms/1000).toFixed(2).replace('.', ',') + 's'; }
        function getStat(e, key) {
          if (key === 'avg')   return includeOutliers ? e.avgAll   : e.avgClean;
          if (key === 'delta') return includeOutliers ? e.deltaAll : e.deltaClean;
          return e[key];
        }

        function renderEntity(e) {
          const avg   = getStat(e, 'avg');
          const delta = getStat(e, 'delta');
          panels.innerHTML = `
            <div class="adv-card">
              <div class="adv-card__label">Total vueltas</div>
              <div class="adv-card__big">${e.totalLaps}</div>
              <div class="adv-card__hint">${e.cleanLaps} limpias</div>
            </div>
            <div class="adv-card">
              <div class="adv-card__label">Mejor vuelta</div>
              <div class="adv-card__big">${fmtMs(e.bestMs)}</div>
            </div>
            <div class="adv-card">
              <div class="adv-card__label">Media ${includeOutliers ? '(con salidas)' : 'limpia'}</div>
              <div class="adv-card__big">${fmtMs(avg)}</div>
            </div>
            <div class="adv-card">
              <div class="adv-card__label">Δ consistencia</div>
              <div class="adv-card__big">${delta != null ? '+' + fmtSec(delta) : '—'}</div>
              <div class="adv-card__hint">avg − best</div>
            </div>
            <div class="adv-card">
              <div class="adv-card__label">Salidas · pit-stops</div>
              <div class="adv-card__big">${e.exitCount} · ${e.pitStopCount}</div>
            </div>
            <div class="adv-card">
              <div class="adv-card__label">Tiempo perdido</div>
              <div class="adv-card__big">${fmtSec(e.lostMs)}</div>
              <div class="adv-card__hint">≈ ${e.lostLapsEquiv} vueltas</div>
            </div>
            <div class="adv-card adv-card--wide">
              <div class="adv-card__label">Evolución por carril</div>
              <div class="adv-manga-chart"><canvas id="advMangaChart"></canvas></div>
              <div class="adv-mangas">
                ${(e.perLane || []).map(p => `
                  <div class="adv-manga">
                    <div class="adv-manga__lbl">Pista ${p.lane}</div>
                    <div class="adv-manga__val">${fmtMs(includeOutliers ? p.avgAll : p.avgClean)}</div>
                    <div class="adv-manga__meta">${p.totalLaps}v · ${p.exitCount} salidas</div>
                  </div>
                `).join('')}
              </div>
            </div>
          `;
        }

        function renderCompare(a, b) {
          if (!b) { cmpSection.hidden = true; return; }
          cmpSection.hidden = false;
          document.getElementById('advCompA').textContent = a.entityName;
          document.getElementById('advCompB').textContent = b.entityName;
          const rows = [
            ['Total vueltas',         a.totalLaps,             b.totalLaps,             'higher'],
            ['Mejor vuelta',          fmtMs(a.bestMs),         fmtMs(b.bestMs),         'lowerMs', a.bestMs, b.bestMs],
            ['Media',                 fmtMs(getStat(a,'avg')), fmtMs(getStat(b,'avg')), 'lowerMs', getStat(a,'avg'), getStat(b,'avg')],
            ['Δ consistencia',        fmtSec(getStat(a,'delta')), fmtSec(getStat(b,'delta')), 'lowerMs', getStat(a,'delta'), getStat(b,'delta')],
            ['Salidas',               a.exitCount,             b.exitCount,             'lower'],
            ['Pit-stops',             a.pitStopCount,          b.pitStopCount,          'lower'],
            ['Tiempo perdido',        fmtSec(a.lostMs),        fmtSec(b.lostMs),        'lowerMs', a.lostMs, b.lostMs],
          ];
          document.getElementById('advCompareBody').innerHTML = rows.map(r => {
            const [label, va, vb, cmp, na, nb] = r;
            const aN = na != null ? na : (typeof va === 'number' ? va : null);
            const bN = nb != null ? nb : (typeof vb === 'number' ? vb : null);
            let cls = '';
            let diff = '';
            if (aN != null && bN != null) {
              const d = aN - bN;
              if (cmp === 'higher')  { cls = d > 0 ? 'adv-diff--better' : (d < 0 ? 'adv-diff--worse' : ''); diff = (d > 0 ? '+' : '') + d; }
              if (cmp === 'lower')   { cls = d < 0 ? 'adv-diff--better' : (d > 0 ? 'adv-diff--worse' : ''); diff = (d > 0 ? '+' : '') + d; }
              if (cmp === 'lowerMs') { cls = d < 0 ? 'adv-diff--better' : (d > 0 ? 'adv-diff--worse' : ''); diff = (d > 0 ? '+' : '') + (d/1000).toFixed(2).replace('.',',') + 's'; }
            }
            return `<tr><td>${label}</td><td>${va}</td><td>vs</td><td>${vb}</td><td class="${cls}">${diff || '—'}</td></tr>`;
          }).join('');
        }

        // Gráfico de evolución de la media POR CARRIL (entidad + comparada).
        let mangaChart = null;
        function drawMangaChart(a, b) {
          const canvas = document.getElementById('advMangaChart');
          if (!canvas || typeof Chart === 'undefined') return;   // Chart.js carga después en la 1ª pasada
          if (mangaChart) { mangaChart.destroy(); mangaChart = null; }
          const key = includeOutliers ? 'avgAll' : 'avgClean';
          const labels = (a.perLane || []).map(p => 'P' + p.lane);
          const datasets = [{
            label: a.entityName,
            data: (a.perLane || []).map(p => p[key] != null ? p[key] / 1000 : null),
            borderColor: '#f6c90e', backgroundColor: 'rgba(246,201,14,.15)',
            tension: .25, spanGaps: true, pointRadius: 3, borderWidth: 2,
          }];
          if (b) {
            const bByLane = new Map((b.perLane || []).map(p => [p.lane, p]));
            datasets.push({
              label: b.entityName,
              data: (a.perLane || []).map(p => { const bp = bByLane.get(p.lane); return bp && bp[key] != null ? bp[key] / 1000 : null; }),
              borderColor: '#58a6ff', backgroundColor: 'rgba(88,166,255,.15)',
              tension: .25, spanGaps: true, pointRadius: 3, borderWidth: 2,
            });
          }
          mangaChart = new Chart(canvas, {
            type: 'line',
            data: { labels, datasets },
            options: {
              responsive: true, maintainAspectRatio: false,
              interaction: { mode: 'index', intersect: false },
              plugins: {
                legend: { labels: { color: '#c9d1d9' } },
                tooltip: { callbacks: { label: (ctx) => ctx.dataset.label + ': ' + ctx.parsed.y.toFixed(3).replace('.', ',') + 's' } },
              },
              scales: {
                x: { ticks: { color: '#8b949e' }, grid: { color: '#21262d' } },
                y: { ticks: { color: '#8b949e', callback: (v) => v.toFixed(2).replace('.', ',') + 's' },
                     grid: { color: '#21262d' },
                     title: { display: true, text: 'Media por carril', color: '#6e7681' } },
              },
            },
          });
        }

        function update() {
          const a = data.find(e => e.key === selEntity.value);
          const b = data.find(e => e.key === selCompare.value);
          if (a) renderEntity(a);
          renderCompare(a, b);
          if (a) drawMangaChart(a, b);
        }

        selEntity.addEventListener('change',  update);
        selCompare.addEventListener('change', update);
        cbOutliers.addEventListener('change', () => { includeOutliers = cbOutliers.checked; update(); });

        document.querySelector('[data-tab="advanced"]')?.addEventListener('click', () => setTimeout(update, 50));
        update();
      })();
    </script>

<script>
  // Ajuste a una sola hoja al imprimir: escala el contenido (zoom) para que la
  // comparativa completa quepa en un A3 apaisado, por largo que sea el listado.
  (function () {
    const PAGE_W = 1040, PAGE_H = 1500; // A3 vertical menos márgenes de 10mm, en px CSS
    const wrap = document.querySelector('.vt-page--results .vt-wrap');
    if (!wrap) return;
    let prev = null;
    window.addEventListener('beforeprint', () => {
      const table = wrap.querySelector('.matrix-table');
      if (!table) return;
      prev = { width: wrap.style.width, zoom: wrap.style.zoom };
      // Siempre se imprime la comparativa: forzarla visible para medirla
      // aunque el usuario esté en otra pestaña.
      wrap.querySelectorAll('.results-panel').forEach(p => {
        p.style.display = p.id === 'tab-matrix' ? 'block' : 'none';
      });
      // Anchura natural de la tabla: el contenido se maqueta a ese ancho y se
      // escala; así las celdas no cambian de altura entre pantalla y papel.
      const w = Math.max(table.scrollWidth, PAGE_W);
      wrap.style.width = w + 'px';
      // Altura del flujo a ese ancho, descontando lo que el CSS de impresión
      // oculta. Sin tope superior: si sobra hoja, la fuente crece hasta llenarla.
      let hiddenH = 0;
      wrap.querySelectorAll('.results-tabs, .vt-back-link, .print-hide')
          .forEach(el => { hiddenH += el.offsetHeight; });
      const h = wrap.scrollHeight - hiddenH;
      wrap.style.zoom = Math.min(PAGE_W / w, PAGE_H / h);
    });
    window.addEventListener('afterprint', () => {
      if (!prev) return;
      wrap.style.width = prev.width;
      wrap.style.zoom  = prev.zoom;
      wrap.querySelectorAll('.results-panel').forEach(p => { p.style.display = ''; });
      prev = null;
    });
  })();
</script>
<script id="positionsData" type="application/json"><%- JSON.stringify(positionData || {}) %></script>
<script id="progressionData" type="application/json"><%- JSON.stringify(progressionByEntity || {}) %></script>
<script>const PER_OCCURRENCE = <%= perOccurrence ? 'true' : 'false' %>;</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
  (function() {
    // Datos vuelta-a-vuelta: pueden ser muy grandes (carreras de 24h ≈ 12 MB).
    // No los parseamos al cargar la página — eso bloquea móviles antes de cablear
    // los botones. Se parsean en diferido al abrir la pestaña Progresión.
    let data = {};
    const entitiesBox = document.getElementById('progEntities');
    const selManga    = document.getElementById('progManga');
    const selDriver   = document.getElementById('progDriver');
    const lanesBox    = document.getElementById('progLanes');
    const canvas      = document.getElementById('progChart');
    if (!entitiesBox || !canvas) return;
    const ENTITY_PALETTE = ['#58a6ff','#f6c90e','#7ee787','#ff6b9d','#a371f7','#56d4dd','#f97316','#e63946','#fbbf24','#34d399'];
    // Lane variation: solid for first lane, dashed for second, dotted for third...
    const LANE_DASH = [[], [8,4], [2,4], [12,3,2,3]];
    let chart = null;
    let mode  = 'abs';
    const enabledLanes = new Set();
    const selectedEntities = new Set();
    const entityColor = {};

    function renderEntities() {
      const entries = Object.entries(data);
      entries.forEach(([key], i) => { entityColor[key] = ENTITY_PALETTE[i % ENTITY_PALETTE.length]; });
      entitiesBox.innerHTML = entries.map(([key, e]) => {
        const active = selectedEntities.has(key) ? 'active' : '';
        const color = entityColor[key];
        return `<span class="prog-entity-chip ${active}" data-key="${key}" style="${selectedEntities.has(key) ? 'background:' + color + '22;' : ''}">
          <span class="prog-entity-chip__dot" style="background:${color}"></span>${e.name}
        </span>`;
      }).join('');
      entitiesBox.querySelectorAll('.prog-entity-chip').forEach(chip => {
        chip.addEventListener('click', () => {
          const key = chip.dataset.key;
          if (selectedEntities.has(key)) selectedEntities.delete(key);
          else selectedEntities.add(key);
          renderEntities();
          refreshFilters();
          build();
        });
      });
    }

    function collectLaps() {
      const out = [];
      selectedEntities.forEach(key => {
        const e = data[key];
        if (e) e.laps.forEach(l => out.push({ ...l, _entity: key, _entityName: e.name }));
      });
      return out;
    }

    function refreshFilters() {
      const laps = collectLaps();
      // Manga options
      const mangas = [...new Set(laps.map(l => l.manga))].sort((a,b)=>a-b);
      const prevManga = selManga.value;
      selManga.innerHTML = '<option value="all">Todas</option>' +
        mangas.map(m => `<option value="${m}">Manga ${m}</option>`).join('');
      if ([...selManga.options].some(o => o.value === prevManga)) selManga.value = prevManga;
      // Driver options
      const drivers = [...new Set(laps.map(l => l.driver).filter(d => d && d !== '—'))].sort();
      const prevDriver = selDriver.value;
      selDriver.innerHTML = '<option value="all">Todos</option>' +
        drivers.map(d => `<option value="${d}">${d}</option>`).join('');
      if ([...selDriver.options].some(o => o.value === prevDriver)) selDriver.value = prevDriver;
      selDriver.parentElement.style.display = drivers.length > 0 ? '' : 'none';
      // Lanes chips
      const lanes = [...new Set(laps.map(l => l.lane))].sort((a,b)=>a-b);
      // Keep previously enabled lanes that still exist; default-enable any new ones
      const prevEnabled = new Set(enabledLanes);
      enabledLanes.clear();
      lanes.forEach(l => { if (prevEnabled.size === 0 || prevEnabled.has(l)) enabledLanes.add(l); });
      if (enabledLanes.size === 0) lanes.forEach(l => enabledLanes.add(l));
      lanesBox.innerHTML = lanes.map(lane => {
        const cls = enabledLanes.has(lane) ? 'active' : '';
        return `<span class="prog-lane-chip ${cls}" data-lane="${lane}">P${lane}</span>`;
      }).join('');
      lanesBox.querySelectorAll('.prog-lane-chip').forEach(chip => {
        chip.addEventListener('click', () => {
          const lane = Number(chip.dataset.lane);
          if (enabledLanes.has(lane)) { enabledLanes.delete(lane); chip.classList.remove('active'); }
          else { enabledLanes.add(lane); chip.classList.add('active'); }
          build();
        });
      });
    }

    function build() {
      if (selectedEntities.size === 0) {
        if (chart) { chart.destroy(); chart = null; }
        const ctx = canvas.getContext('2d');
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        return;
      }
      const mangaFilter  = 'all';   // selector deshabilitado: siempre todas las mangas
      const driverFilter = selDriver.value;
      const showExits = document.getElementById('progShowExits')?.checked ?? true;
      const showPits  = document.getElementById('progShowPits')?.checked  ?? true;
      const lanes = [...enabledLanes].sort((a,b)=>a-b);
      const datasets = [];
      const allMs = [];
      const ys = [];   // todos los valores PINTADOS, para calcular el rango del eje Y

      [...selectedEntities].forEach(key => {
        const entity = data[key];
        if (!entity) return;
        const color = entityColor[key];
        lanes.forEach((lane, laneIdx) => {
          const filtered = entity.laps.filter(l =>
            l.lane === lane
            && (mangaFilter === 'all' || String(l.manga) === mangaFilter)
            && (driverFilter === 'all' || l.driver === driverFilter)
            // Un pit-stop también lleva is_exit=1; las categorías son EXCLUYENTES:
            // pit-stop → check de pits; salida pura (exit sin pit) → check de piños.
            && (l.isPitStop ? showPits : (l.isExit ? showExits : true))
          );
          if (filtered.length === 0) return;

          // En carreras de PASADAS / REPETIR-CARRIL una misma entidad corre el
          // mismo carril en varias mangas. Cada manga distinta = una OCURRENCIA
          // (repetición) de ese carril. Dibujamos UNA LÍNEA POR OCURRENCIA para
          // poder comparar la progresión de cada repetición; el eje X pasa a ser
          // el índice de vuelta DENTRO de la ocurrencia (1..n) para que las
          // repeticiones se solapen y se lean una sobre otra.
          let occurrences;
          if (PER_OCCURRENCE) {
            const byManga = new Map();
            filtered.forEach(l => {
              if (!byManga.has(l.manga)) byManga.set(l.manga, []);
              byManga.get(l.manga).push(l);
            });
            const mangasOrdered = [...byManga.keys()].sort((a, b) => a - b);
            const K = mangasOrdered.length;
            occurrences = mangasOrdered.map((m, i) => ({
              laps: byManga.get(m),
              // Etiqueta "<entidad> · P<L> · k/K"
              label: entity.name + ' · P' + lane + ' · ' + (i + 1) + '/' + K,
              occIdx: i,
            }));
          } else {
            // Modo normal: una sola línea por carril (comportamiento previo).
            occurrences = [{ laps: filtered, label: entity.name + ' · P' + lane, occIdx: 0 }];
          }

          occurrences.forEach(occ => {
            const laps = occ.laps;
            laps.forEach(l => allMs.push(l.ms));
            const avg = laps.reduce((s, l) => s + l.ms, 0) / laps.length;
            const points = laps.map((l, idx) => ({
              x: idx + 1,
              y: mode === 'abs' ? l.ms / 1000 : (l.ms - avg) / 1000,
              _meta: l, _entityName: entity.name,
            }));
            points.forEach(p => ys.push(p.y));
            const pointColors = laps.map(l =>
              l.isPitStop ? '#ff9800' :
              l.isExit    ? '#e63946' : color);
            // Vueltas normales sin punto (radio 0) → línea limpia aunque haya
            // 100+ vueltas/manga; solo se ven los marcadores de salida y pit.
            // pointHitRadius mantiene el tooltip al pasar por cualquier vuelta.
            const pointRadius = laps.map(l => (l.isPitStop || l.isExit) ? 5 : 0);
            // Distinción visual: en modo normal el patrón de guiones representa
            // el carril (laneIdx); en per-ocurrencia todas comparten carril, así
            // que el patrón (y un ligero grosor decreciente) distingue la
            // repetición manteniendo el color de la entidad.
            const dashIdx = PER_OCCURRENCE ? occ.occIdx : laneIdx;
            datasets.push({
              label: occ.label,
              data: points,
              borderColor: color,
              backgroundColor: color + '22',
              borderDash: LANE_DASH[dashIdx % LANE_DASH.length],
              pointBackgroundColor: pointColors,
              pointBorderColor:     pointColors,
              pointRadius,
              pointHoverRadius: laps.map(l => (l.isPitStop || l.isExit) ? 7 : 4),
              pointHitRadius: 6,
              tension: 0.2, borderWidth: 2,
            });
          });
        });
      });

      // Eje Y: hasta el valor MÁS GRANDE pintado + 2 (para no cortar los picos),
      // y abajo el percentil 1 − 1 (ignora outliers bajos puntuales —out-lap,
      // parciales— que dejaban un hueco muerto abajo y aplastaban la información).
      let yMin, yMax;
      if (ys.length) {
        ys.sort((a, b) => a - b);
        const lo = ys[Math.floor(ys.length * 0.01)];
        const hi = ys[ys.length - 1];
        yMin = Math.floor(lo) - 1;
        yMax = Math.ceil(hi) + 2;
      }

      if (chart) chart.destroy();
      chart = new Chart(canvas, {
        type: 'line',
        data: { datasets },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: {
            legend: { labels: { color: '#c9d1d9', boxWidth: 14 } },
            tooltip: {
              callbacks: {
                label: (ctx) => {
                  const v = ctx.parsed.y;
                  const m = ctx.raw._meta;
                  const sign = mode === 'delta' && v > 0 ? '+' : '';
                  let s = ctx.dataset.label + ': ' + sign + v.toFixed(3) + 's';
                  if (m?.driver && m.driver !== '—') s += ' · ' + m.driver;
                  if (m?.manga) s += ' · M' + m.manga;
                  if (m?.isPitStop) s += ' · pit-stop';
                  else if (m?.isExit) s += ' · <%= lang === "es" ? "salida" : "exit" %>';
                  return s;
                }
              }
            }
          },
          scales: {
            x: {
              type: 'linear',
              title: { display: true, text: PER_OCCURRENCE ? 'Vuelta dentro de la repetición' : 'Vuelta (orden cronológico)', color: '#8b949e' },
              ticks: { color: '#8b949e', stepSize: 1 },
              grid:  { color: '#21262d' },
            },
            y: {
              min: yMin, max: yMax,
              title: { display: true,
                text: mode === 'abs' ? 'Segundos' : 'Δ vs media (s)', color: '#8b949e' },
              ticks: { color: '#8b949e' },
              grid:  { color: '#21262d',
                       drawBorder: false,
                       lineWidth: (ctx) => (mode === 'delta' && ctx.tick.value === 0) ? 2 : 1,
                       color:     (ctx) => (mode === 'delta' && ctx.tick.value === 0) ? '#58a6ff' : '#21262d' },
            }
          }
        }
      });
    }

    selManga.addEventListener('change', build);
    selDriver.addEventListener('change', build);
    document.getElementById('progShowExits')?.addEventListener('change', build);
    document.getElementById('progShowPits')?.addEventListener('change', build);
    // Carriles: seleccionar / deseleccionar todos.
    function setAllLanes(on) {
      lanesBox.querySelectorAll('.prog-lane-chip').forEach(chip => {
        const lane = Number(chip.dataset.lane);
        if (on) { enabledLanes.add(lane);    chip.classList.add('active'); }
        else    { enabledLanes.delete(lane); chip.classList.remove('active'); }
      });
      build();
    }
    document.getElementById('progLanesAll') ?.addEventListener('click', () => setAllLanes(true));
    document.getElementById('progLanesNone')?.addEventListener('click', () => setAllLanes(false));
    document.querySelectorAll('.prog-subtab').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.prog-subtab').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        mode = btn.dataset.prog;
        build();
      });
    });

    // Inicialización perezosa: solo al abrir la pestaña por primera vez se
    // parsean los datos (potencialmente enormes) y se pinta el primer equipo.
    let initialized = false;
    function initProgression() {
      if (initialized) return;
      initialized = true;
      data = JSON.parse(document.getElementById('progressionData').textContent || '{}');
      const firstKey = Object.keys(data)[0];
      if (firstKey) selectedEntities.add(firstKey);
      renderEntities();
      refreshFilters();
    }

    document.querySelector('[data-tab="progression"]')?.addEventListener('click', () => {
      setTimeout(() => { initProgression(); build(); }, 50);
    });
  })();

  // ── Position-per-manga chart ───────────────────────────────────────────
  // Clasificación acumulada al cierre de cada manga (no cruce a cruce).
  (function() {
    const data   = JSON.parse(document.getElementById('positionsData').textContent || '{}');
    const canvas = document.getElementById('positionsChart');
    if (!canvas) return;
    const PALETTE = ['#1F6FEB','#F6C90E','#2DA44E','#FB6A6B','#A371F7','#16BDCA','#F97316','#E63946','#FBBF24','#34D399','#FF6B9D','#56D4DD'];
    let chart = null;

    function build() {
      const entries = Object.entries(data);
      if (entries.length === 0) return;
      const totalEntities = entries.length;
      const datasets = entries.map(([key, e], i) => ({
        label: e.name,
        data: (e.points || []),   // {x: minuto de carrera, y: posición proyectada}
        borderColor: e.color || PALETTE[i % PALETTE.length],
        backgroundColor: (e.color || PALETTE[i % PALETTE.length]) + '22',
        tension: 0.25, spanGaps: true,
        pointRadius: 3, pointHoverRadius: 6, borderWidth: 2.5,
      }));
      if (chart) chart.destroy();
      chart = new Chart(canvas, {
        type: 'line',
        data: { datasets },
        options: {
          responsive: true, maintainAspectRatio: false,
          interaction: { mode: 'nearest', intersect: false },
          plugins: {
            legend: { position: 'right', labels: { color: '#c9d1d9', boxWidth: 14 } },
            tooltip: {
              callbacks: {
                title: (items) => 'min ' + items[0].parsed.x,
                label: (ctx) => ctx.dataset.label + ': P' + ctx.parsed.y,
              }
            }
          },
          scales: {
            x: {
              type: 'linear',
              title: { display: true, text: '<%= lang === "es" ? "Tiempo de carrera (min)" : "Race time (min)" %>', color: '#8b949e' },
              ticks: { color: '#8b949e' }, grid: { color: '#21262d' },
            },
            y: {
              reverse: true, // P1 at top
              min: 1, max: totalEntities,
              title: { display: true, text: '<%= lang === "es" ? "Posición (proyectada)" : "Position (projected)" %>', color: '#8b949e' },
              ticks: { color: '#8b949e', stepSize: 1, callback: (v) => 'P' + v },
              grid: { color: '#21262d' },
            }
          }
        }
      });
    }

    document.querySelector('[data-tab="positions"]')?.addEventListener('click', () => {
      setTimeout(build, 50);
    });
  })();

  // ── Gap-to-leader chart ────────────────────────────────────────────────
  // Vueltas que cada equipo lleva por detrás del líder, por tiempo de carrera.
  (function() {
    const data   = JSON.parse(document.getElementById('gapData').textContent || '{}');
    const canvas = document.getElementById('gapChart');
    if (!canvas) return;
    const PALETTE = ['#1F6FEB','#F6C90E','#2DA44E','#FB6A6B','#A371F7','#16BDCA','#F97316','#E63946','#FBBF24','#34D399','#FF6B9D','#56D4DD'];
    let chart = null, built = false, maxManga = 1;
    const fromSel  = document.getElementById('gapFrom');
    const toSel    = document.getElementById('gapTo');
    const resetBtn = document.getElementById('gapReset');

    function fillSelects() {
      if (!fromSel || !toSel || fromSel.options.length) return;
      for (let i = 1; i <= maxManga; i++) {
        fromSel.add(new Option('M' + i, i));
        toSel.add(new Option('M' + i, i));
      }
      fromSel.value = '1';
      toSel.value   = String(maxManga);
    }

    // Reescala el eje Y a lo VISIBLE: rango de mangas seleccionado + equipos NO
    // ocultados con la leyenda. Usa min "duro" para que el eje también ENCOJA
    // (suggestedMin solo expandía, por eso al quitar equipos no se reajustaba).
    function rescaleY() {
      if (!chart) return;
      const from = parseInt(fromSel?.value, 10) || 1;
      const to   = parseInt(toSel?.value, 10)   || maxManga;
      let minGap = 0;
      chart.data.datasets.forEach((ds, i) => {
        if (chart.getDatasetMeta(i).hidden) return;   // equipo oculto por la leyenda
        (ds.data || []).forEach(p => { if (p.x >= from && p.x <= to && p.y < minGap) minGap = p.y; });
      });
      chart.options.scales.y.min = Math.min(-1, Math.floor(minGap) - 1);
      chart.update();
    }

    // Zoom: limita el rango de mangas (eje X) y reescala el eje Y a lo visible.
    function applyRange() {
      if (!chart) return;
      let from = parseInt(fromSel?.value, 10) || 1;
      let to   = parseInt(toSel?.value, 10)   || maxManga;
      if (from > to) { const t = from; from = to; to = t; if (fromSel) fromSel.value = String(from); if (toSel) toSel.value = String(to); }
      chart.options.scales.x.min = from;
      chart.options.scales.x.max = to;
      rescaleY();
    }

    function build() {
      const entries = Object.entries(data);
      if (entries.length === 0) return;
      maxManga = 1; let minGap = 0;
      entries.forEach(([, e]) => (e.points || []).forEach(p => { if (p.y < minGap) minGap = p.y; if (p.x > maxManga) maxManga = p.x; }));
      const datasets = entries.map(([key, e], i) => ({
        label: e.name,
        data: (e.points || []),   // {x: nº de manga, y: vueltas tras el líder (≤0)}
        borderColor: e.color || PALETTE[i % PALETTE.length],
        backgroundColor: (e.color || PALETTE[i % PALETTE.length]) + '22',
        tension: 0.2, spanGaps: true,
        pointRadius: 2, pointHoverRadius: 6, borderWidth: 2.5,
      }));
      if (chart) chart.destroy();
      chart = new Chart(canvas, {
        type: 'line',
        data: { datasets },
        options: {
          responsive: true, maintainAspectRatio: false,
          interaction: { mode: 'nearest', intersect: false },
          plugins: {
            legend: {
              position: 'right', labels: { color: '#c9d1d9', boxWidth: 14 },
              // Al ocultar/mostrar un equipo, reescala el eje Y a los visibles.
              onClick: (e, item, legend) => {
                const ci = legend.chart;
                if (ci.getDatasetMeta(item.datasetIndex).hidden) ci.show(item.datasetIndex);
                else ci.hide(item.datasetIndex);
                // tras el hide/show (que ya hace su update con animación), reescala
                setTimeout(rescaleY, 0);
              }
            },
            tooltip: {
              callbacks: {
                title: (items) => 'M' + items[0].parsed.x,
                label: (ctx) => ctx.dataset.label + ': ' + (ctx.parsed.y === 0
                  ? '<%= lang === "es" ? "líder" : "leader" %>'
                  : ctx.parsed.y + ' <%= lang === "es" ? "vueltas" : "laps" %>'),
              }
            }
          },
          scales: {
            x: {
              type: 'linear',
              min: 1, max: maxManga,
              title: { display: true, text: '<%= lang === "es" ? "Manga" : "Heat" %>', color: '#8b949e' },
              ticks: { color: '#8b949e', stepSize: 1, precision: 0, callback: (v) => 'M' + v },
              grid: { color: '#21262d' },
            },
            y: {
              // Líder en 0 (arriba); el resto NEGATIVO (vueltas perdidas) hacia abajo.
              // min "duro" para que el eje encoja al quitar equipos/rango.
              max: 0, min: Math.min(-1, Math.floor(minGap) - 1),
              title: { display: true, text: '<%= lang === "es" ? "Vueltas tras el líder" : "Laps behind leader" %>', color: '#8b949e' },
              // Divisiones del eje Y de 200 en 200.
              ticks: { color: '#8b949e', precision: 0, stepSize: 200, maxTicksLimit: 30 },
              grid: { color: '#21262d' },
            }
          }
        }
      });
      built = true;
      fillSelects();
    }

    fromSel?.addEventListener('change', applyRange);
    toSel?.addEventListener('change', applyRange);
    resetBtn?.addEventListener('click', () => {
      if (fromSel) fromSel.value = '1';
      if (toSel) toSel.value = String(maxManga);
      applyRange();
    });

    document.querySelector('[data-tab="gap"]')?.addEventListener('click', () => {
      setTimeout(() => { if (!built) build(); else if (chart) chart.resize(); }, 50);
    });
  })();

  // ── Gap GRID (rejilla) — filtro entre 2-4 equipos + resaltado de pit-stops ──
  (function() {
    const data     = JSON.parse(document.getElementById('gapData').textContent || '{}');
    const table    = document.getElementById('gapgridTable');
    const chipsBox = document.getElementById('gapgridEntities');
    if (!table) return;
    const LBL_TEAM = '<%= lang === "es" ? "Equipo" : "Team" %>';
    const entries  = Object.entries(data);   // [key, {name,color,points:[{x,y,pit}]}]
    let maxM = 0;
    const byM = {};
    entries.forEach(([k, e]) => {
      byM[k] = {};
      (e.points || []).forEach(p => { byM[k][p.x] = p; if (p.x > maxM) maxM = p.x; });
    });
    const selected = new Set();

    function renderChips() {
      if (!chipsBox) return;
      chipsBox.innerHTML = entries.map(([k, e]) =>
        '<span class="prog-entity-chip' + (selected.has(k) ? ' active' : '') + '" data-k="' + k + '">' +
          '<span class="prog-entity-chip__dot" style="background:' + (e.color || '#8b949e') + '"></span>' + e.name +
        '</span>').join('');
    }

    function esc(s) { return String(s).replace(/"/g, '&quot;'); }

    function build() {
      const useSel = selected.size >= 2 && selected.size <= 4;
      const rows = entries.filter(([k]) => !useSel || selected.has(k));
      // Referencia por manga = el que MÁS vueltas lleva (y más alto) entre los mostrados.
      const refByM = {};
      for (let m = 1; m <= maxM; m++) {
        let mx = -Infinity;
        rows.forEach(([k]) => { const p = byM[k][m]; if (p && p.y > mx) mx = p.y; });
        refByM[m] = (mx === -Infinity) ? undefined : mx;
      }
      let minGap = 0;
      rows.forEach(([k]) => { for (let m = 1; m <= maxM; m++) { const p = byM[k][m]; if (p && refByM[m] !== undefined) { const g = p.y - refByM[m]; if (g < minGap) minGap = g; } } });

      let html = '<thead><tr><th class="gapgrid__name">' + LBL_TEAM + '</th>';
      for (let m = 1; m <= maxM; m++) html += '<th>M' + m + '</th>';
      html += '</tr></thead><tbody>';
      rows.forEach(([k, e]) => {
        html += '<tr><td class="gapgrid__name" title="' + esc(e.name) + '"><span class="gapgrid__dot" style="background:' + (e.color || '#8b949e') + '"></span>' + e.name + '</td>';
        for (let m = 1; m <= maxM; m++) {
          const p = byM[k][m], ref = refByM[m];
          if (!p || ref === undefined) { html += '<td></td>'; continue; }
          const g = p.y - ref;
          let style = '';
          if (g < 0 && minGap < 0) { const a = Math.min(0.55, (g / minGap) * 0.55); style = 'background:rgba(248,81,73,' + a.toFixed(3) + ')'; }
          else if (g === 0) { style = 'background:rgba(46,160,67,.18)'; }
          const isPit = p.pit > 0;
          const cls = isPit ? ' class="gapgrid--pit"' : '';
          const tip = isPit ? ' title="' + p.pit + ' pit-stop' + (p.pit > 1 ? 's' : '') + '"' : '';
          html += '<td' + cls + ' style="' + style + '"' + tip + '>' + g + '</td>';
        }
        html += '</tr>';
      });
      html += '</tbody>';
      table.innerHTML = html;
    }

    chipsBox?.addEventListener('click', e => {
      const chip = e.target.closest('.prog-entity-chip'); if (!chip) return;
      const k = chip.dataset.k;
      if (selected.has(k)) selected.delete(k);
      else { if (selected.size >= 4) return; selected.add(k); }   // máximo 4
      renderChips(); build();
    });

    renderChips();
    build();
    document.querySelector('[data-tab="gapgrid"]')?.addEventListener('click', () => setTimeout(build, 30));
  })();
</script>

    <!-- Lap corrections per manga (oculto en la vista pública) -->
    <% if (!_publicView && tandas.some(t => t.mangas && t.mangas.length > 0)) { %>
      <div class="print-hide" style="margin-top:2.5rem">
        <h2 class="section-title">
          <%= lang === 'es' ? 'Corrección de vueltas' : 'Lap Corrections' %>
        </h2>
        <p class="form-hint" style="margin-bottom:1rem">
          <%= lang === 'es'
            ? 'Elimina vueltas fantasma, transfiere vueltas entre carriles o añade vueltas manualmente.'
            : 'Remove ghost laps, transfer laps between lanes, or add laps manually.' %>
        </p>
        <div style="display:flex;flex-direction:column;gap:.5rem">
          <% tandas.forEach(t => { %>
            <% if (t.mangas && t.mangas.length > 0) { %>
              <div class="tanda-block" style="padding:.75rem 1rem">
                <span class="tanda-num"><%= lang === 'es' ? 'Tanda' : 'Round' %> <%= t.number %></span>
                <div style="display:flex;flex-wrap:wrap;gap:.4rem;margin-top:.5rem">
                  <% t.mangas.forEach(m => { %>
                    <a href="/races/<%= race.id %>/mangas/<%= m.id %>/corrections"
                       class="btn btn--ghost btn--sm">
                      <%= lang === 'es' ? 'Manga' : 'Heat' %> <%= m.number %>
                      <span class="badge badge--<%= m.status %>" style="font-size:.65rem;margin-left:.3rem">
                        <%= {pending: lang==='es'?'Pend.':'Pend.', active: lang==='es'?'Activa':'Active', finished: '✓'}[m.status] %>
                      </span>
                    </a>
                  <% }) %>
                </div>
              </div>
            <% } %>
          <% }) %>
        </div>
      </div>
    <% } %>

  <% } %>

