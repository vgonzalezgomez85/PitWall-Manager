<%- include('../partials/header', { pageTitle: (lang === 'es' ? 'Resultados' : 'Results') + ' — ' + race.name }) %>
<style>
/* ── Race fastest lap banner ── */
.race-best-banner {
  display: flex; align-items: center; gap: 1rem;
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
  color: #1a1a1a; padding: 1rem 1.25rem; border-radius: 12px;
  margin-bottom: 1.25rem; box-shadow: 0 4px 16px rgba(245,158,11,0.25);
}
.race-best-banner__icon { font-size: 2rem; line-height: 1; }
.race-best-banner__label { font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; opacity: .8; }
.race-best-banner__value strong { font-size: 1.5rem; font-weight: 800; font-variant-numeric: tabular-nums; }
.race-best-banner__meta { margin-left: .75rem; font-size: .9rem; opacity: .85; }

/* ── Comparison matrix table ── */
.matrix-wrapper { overflow-x: auto; border-radius: 12px; border: 1px solid #21262d; background:#000000; }
.matrix-table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; font-size: .85rem; }
.matrix-table th, .matrix-table td { padding: .55rem .7rem; text-align: center; }
.matrix-table thead th {
  background: #161b22; color: #c9d1d9; font-weight: 600; font-size: .75rem;
  text-transform: uppercase; letter-spacing: .05em; border-bottom: 2px solid #30363d;
  position: sticky; top: 0; z-index: 1;
}
.matrix-table .matrix-name { text-align: left; min-width: 180px; }
.matrix-table .matrix-pos { width: 3rem; }
.matrix-lane__label { font-size: .65rem; color: #8b949e; margin-top: 4px; font-weight: 500; }
.lane-pill {
  display: inline-flex; align-items: center; justify-content: center;
  width: 1.8rem; height: 1.8rem; border-radius: 6px; color: #fff;
  font-weight: 700; font-size: .8rem;
}
.matrix-entity { border-top: 2px solid #30363d; background: #161b22; }
.matrix-entity .matrix-name { padding-top: .7rem; padding-bottom: .25rem; }
.matrix-entity .matrix-total { font-size: 1.15rem; font-weight: 800; color: #58a6ff; }
.matrix-entity .matrix-lane-laps { font-size: 1rem; font-weight: 700; color: #c9d1d9; }
.matrix-entity.top-1 .matrix-total { color: #fbbf24; }
.matrix-entity.top-2 .matrix-total { color: #d1d5db; }
.matrix-entity.top-3 .matrix-total { color: #d97706; }
.matrix-stat { background:#000000; }
.matrix-stat td { padding: .35rem .7rem; color: #c9d1d9; }
.matrix-stat__label { text-align: left !important; color: #8b949e !important; font-size: .75rem; font-weight: 500; padding-left: 1rem !important; }
.matrix-stat__total { color: #8b949e !important; font-size: .8rem; }
.matrix-stat--best td { color: #7ee787; font-weight: 600; }
.matrix-stat--avg td { color: #c9d1d9; }
.matrix-stat--worst td { color: #8b949e; font-size: .78rem; }
.matrix-stat--worst .exit-count { color: #f85149; font-weight: 600; margin-right: 3px; }
.matrix-stat--worst .exit-count:not(.has-exits) { color: #484f58; }
.matrix-stat--pit td { color: #c9d1d9; font-size: .78rem; }
.matrix-stat--pit .exit-count { color: #ff9800; font-weight: 600; margin-right: 3px; }
.matrix-stat--pit .pit-laps { color: #8b949e; font-family: 'Share Tech Mono', monospace; }
.exit-total { color: #f85149; font-weight: 600; margin-left: 4px; }
.matrix-stat--pit .exit-total { color: #ff9800; }

/* Starting lane highlight: subtle left border + tinted background, applied to
   the entity header cell and the 4 stat cells of that lane so the column
   reads as a single visual block. */
.matrix-lane-cell--start {
  background: rgba(88, 166, 255, 0.10) !important;
  box-shadow: inset 3px 0 0 #58a6ff;
}
.start-lane-tag {
  display: inline-block; margin-left: 8px;
  padding: 2px 7px; border-radius: 10px;
  background: rgba(88,166,255,.16); color: #58a6ff;
  font-size: .7rem; font-weight: 700; letter-spacing: .03em;
  vertical-align: middle;
}

.race-best {
  background: linear-gradient(135deg, rgba(251,191,36,0.2), rgba(245,158,11,0.15)) !important;
  color: #fbbf24 !important; font-weight: 800 !important;
  position: relative;
  border-radius: 4px;
}
.race-best-star { color: #fbbf24; margin-left: 2px; }
/* Redondel azul = vuelta rápida general del carril (mejor entre todos en esa pista) */
.lane-fastest-dot {
  display: inline-block; width: .62em; height: .62em; border-radius: 50%;
  background: #2f81f7; margin-right: .35em; vertical-align: middle;
}

@media print {
  .navbar, .footer, .vt-head__actions, .results-tabs, .vt-back-link,
  .results-panel:not(.active) { display: none !important; }
  .results-panel.active { display: block !important; }
  body, .vt-page, .main-content { background: #fff !important; color: #000 !important; }
  .vt-page h1 { color: #000 !important; }
  .vt-lead { color: #555 !important; }
  .results-table { border-collapse: collapse; width: 100%; }
  .results-table th, .results-table td { border: 1px solid #ccc; padding: 6px 10px; color: #000 !important; }
  .results-table thead th { background: #f0f0f0 !important; color: #000 !important; }
  .pos-badge { border: 1px solid #999; color: #000 !important; background: none !important; }
  .result-highlight { font-weight: 700; }
  .vt-page h1::before { content: "<%= race.name %> — "; font-size: 1rem; color: #555; display: block; font-weight: 400; }
}
</style>
<div class="vt-page vt-page--results">
  <div class="vt-wrap">

    <% var _publicView = (typeof publicView !== 'undefined' && publicView); %>
    <a href="<%= _publicView ? '/results' : '/races/' + race.id %>" class="vt-back-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      <%= _publicView ? (lang === 'es' ? 'Volver a resultados' : 'Back to results') : (lang === 'es' ? 'Volver a la carrera' : 'Back to race') %>
    </a>

  <!-- Header -->
  <div class="vt-head" style="align-items:flex-start">
    <div class="vt-head__title" style="flex-direction:column;align-items:flex-start;gap:6px">
      <h1><%= lang === 'es' ? 'Resultados' : 'Results' %></h1>
      <p class="vt-lead" style="margin-top:0">
        <strong style="color:var(--vt-text);font-weight:600"><%= race.name %></strong>
        · <%= t('races.type.' + race.type) %>
        · <%= t('races.format.' + race.format) %>
      </p>
    </div>
    <div class="vt-head__actions">
      <span class="vt-badge is-info"><span class="vt-badge__d"></span><%= tandas.length %> <%= lang === 'es' ? 'tandas' : 'rounds' %></span>
      <% if (!_publicView) { %>
      <a href="/races/<%= race.id %>/results/xlsx?lang=<%= lang %>" class="vt-btn vt-btn--ghost vt-btn--sm" title="<%= lang === 'es' ? 'Exportar a Excel' : 'Export to Excel' %>">
        <svg viewBox="0 0 24 24"><path d="M14 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13l3 3 3-3M12 16V9"/></svg>
        Excel
      </a>
      <a href="/races/<%= race.id %>/results/points.xlsx?lang=<%= lang %>" class="vt-btn vt-btn--ghost vt-btn--sm" title="<%= lang === 'es' ? 'Exportar puntos de clasificación (Excel)' : 'Export classification points (Excel)' %>">
        <svg viewBox="0 0 24 24"><path d="M8 21h8M12 17v4M7 4h10v6a5 5 0 0 1-10 0z"/><path d="M7 5H4.5A1.5 1.5 0 0 0 3 6.5 3.5 3.5 0 0 0 6.5 10M17 5h2.5A1.5 1.5 0 0 1 21 6.5 3.5 3.5 0 0 1 17.5 10"/></svg>
        <%= lang === 'es' ? 'Puntos (xlsx)' : 'Points (xlsx)' %>
      </a>
      <a href="/races/<%= race.id %>/results/points.csv?lang=<%= lang %>" class="vt-btn vt-btn--ghost vt-btn--sm" title="<%= lang === 'es' ? 'Exportar puntos (CSV)' : 'Export points (CSV)' %>">
        <svg viewBox="0 0 24 24"><path d="M14 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg>
        <%= lang === 'es' ? 'Puntos (csv)' : 'Points (csv)' %>
      </a>
      <% } %>
      <button type="button" class="vt-btn vt-btn--ghost vt-btn--sm" onclick="window.print()" title="<%= lang === 'es' ? 'Guardar como PDF' : 'Save as PDF' %>">
        <svg viewBox="0 0 24 24"><path d="M6 9V4h12v5M6 18H4a1 1 0 0 1-1-1v-5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5a1 1 0 0 1-1 1h-2M6 14h12v7H6z"/></svg>
        PDF
      </button>
    </div>
  </div>

  <% if (results.length === 0) { %>
    <div class="vt-empty" style="margin-top:32px">
      <div class="vt-empty__t"><%= lang === 'es' ? 'Sin datos todavía' : 'No data yet' %></div>
      <p style="color:var(--vt-mute);margin:6px 0 0">
        <%= lang === 'es' ? 'Completa al menos una manga para ver resultados.' : 'Complete at least one heat to see results.' %>
      </p>
    </div>
  <% } else { %>

    <%
      function fmtMs(ms) {
        if (ms == null) return '—';
        const totalSec   = Math.floor(ms / 1000);
        const hundredths = Math.floor((ms % 1000) / 10);
        const secs = totalSec % 60;
        const mins = Math.floor(totalSec / 60);
        return (mins > 0 ? mins + ':' : '') + String(secs).padStart(mins > 0 ? 2 : 1, '0') + '.' + String(hundredths).padStart(2, '0');
      }
    %>

    <!-- Tab nav -->
    <div class="results-tabs">
      <button class="results-tab active" data-tab="matrix">
        🏁 <%= lang === 'es' ? 'Comparativa' : 'Comparison' %>
      </button>
      <button class="results-tab" data-tab="progression">
        📊 <%= lang === 'es' ? 'Progresión' : 'Progression' %>
      </button>
      <button class="results-tab" data-tab="positions">
        🏁 <%= lang === 'es' ? 'Posiciones' : 'Positions' %>
      </button>
      <button class="results-tab" data-tab="advanced">
        📊 <%= lang === 'es' ? 'Estadísticas avanzadas' : 'Advanced stats' %>
      </button>
    </div>

    <!-- ── Comparison matrix (PDF-style, modern) ── -->
    <div class="results-panel active" id="tab-matrix">
      <%
        const orderedLanes = (laneSequence || []).filter(l => l > 0);
        const byTotalM = [...results].sort((a,b) => b.total_laps - a.total_laps || (a.best_lap_ms||Infinity) - (b.best_lap_ms||Infinity));

        // VR general de cada carril = mejor `best_ms` de ese carril entre todos
        // los participantes. Se marca con un redondel azul en la fila "Rápida".
        const laneFastest = {};
        byTotalM.forEach(r => (r.perLane || []).forEach(pl => {
          if (pl.best_ms != null && (laneFastest[pl.lane] == null || pl.best_ms < laneFastest[pl.lane])) {
            laneFastest[pl.lane] = pl.best_ms;
          }
        }));

        function fmtSec(ms) {
          if (ms == null) return '—';
          return (ms / 1000).toFixed(3).replace('.', ',');
        }
      %>

      <% if (raceBestLapMs != null) { %>
        <div class="race-best-banner">
          <span class="race-best-banner__icon">⚡</span>
          <div>
            <div class="race-best-banner__label"><%= lang === 'es' ? 'Vuelta rápida de la carrera' : 'Race fastest lap' %></div>
            <div class="race-best-banner__value">
              <strong><%= fmtSec(raceBestLapMs) %>s</strong>
              <span class="race-best-banner__meta"><%= raceBestEntity %> · <%= lang === 'es' ? 'Pista' : 'Lane' %> <%= raceBestLane %></span>
            </div>
          </div>
        </div>
      <% } %>

      <div class="matrix-wrapper">
        <table class="matrix-table">
          <thead>
            <tr>
              <th class="matrix-pos">#</th>
              <th class="matrix-name"><%= lang === 'es' ? 'Equipo / Piloto' : 'Team / Driver' %></th>
              <th class="matrix-laps"><%= lang === 'es' ? 'Vueltas' : 'Laps' %></th>
              <% orderedLanes.forEach(lane => { %>
                <th class="matrix-lane">
                  <span class="lane-pill" style="background:<%= LANE_COLORS[lane-1] || '#8b949e' %>"><%= lane %></span>
                  <div class="matrix-lane__label"><%= lang === 'es' ? 'Pista' : 'Lane' %> <%= lane %></div>
                </th>
              <% }) %>
            </tr>
          </thead>
          <tbody>
            <% byTotalM.forEach((r, i) => {
                 const laneMap = new Map((r.perLane||[]).map(pl => [pl.lane, pl]));
                 const startKey = `${r.entity_type}_${r.entity_id}`;
                 const startLane = (startLaneByEntity || {})[startKey];
            %>
              <!-- Entity header row -->
              <tr class="matrix-entity <%= i < 3 ? 'top-' + (i+1) : '' %>">
                <td class="matrix-pos" rowspan="5">
                  <span class="pos-badge pos-<%= i+1 %>"><%= i+1 %></span>
                </td>
                <td class="matrix-name">
                  <% if (r.color) { %>
                    <span class="lane-dot" style="background:<%= r.color %>; width:10px; height:10px; display:inline-block; border-radius:3px; margin-right:6px;"></span>
                  <% } %>
                  <strong><%= r.entity_name %></strong>
                  <% if (startLane) { %>
                    <span class="start-lane-tag" title="<%= lang === 'es' ? 'Carril de inicio' : 'Starting lane' %>">🚦 P<%= startLane %></span>
                  <% } %>
                </td>
                <td class="matrix-laps matrix-total"><%= r.total_laps %></td>
                <% orderedLanes.forEach(lane => {
                     const pl = laneMap.get(lane);
                     const isStart = lane === startLane;
                %>
                  <td class="matrix-lane-cell matrix-lane-laps <%= isStart ? 'matrix-lane-cell--start' : '' %>">
                    <%= pl ? pl.laps : '—' %>
                  </td>
                <% }) %>
              </tr>

              <!-- Fastest lap row -->
              <tr class="matrix-stat matrix-stat--best">
                <td class="matrix-stat__label">⚡ <%= lang === 'es' ? 'Rápida' : 'Fast' %></td>
                <td class="matrix-stat__total"><%= fmtSec(r.best_lap_ms) %></td>
                <% orderedLanes.forEach(lane => {
                     const pl = laneMap.get(lane);
                     const isRaceBest = pl && pl.best_ms != null && pl.best_ms === raceBestLapMs;
                     const isLaneFastest = pl && pl.best_ms != null && pl.best_ms === laneFastest[lane];
                     const isStart = lane === startLane;
                %>
                  <td class="matrix-lane-cell <%= isRaceBest ? 'race-best' : '' %> <%= isLaneFastest ? 'lane-fastest' : '' %> <%= isStart ? 'matrix-lane-cell--start' : '' %>">
                    <% if (pl && pl.best_ms != null) { %>
                      <% if (isLaneFastest) { %><span class="lane-fastest-dot" title="<%= lang === 'es' ? 'Vuelta rápida del carril' : 'Lane fastest lap' %>"></span><% } %><%= fmtSec(pl.best_ms) %><% if (isRaceBest) { %> <span class="race-best-star">★</span><% } %>
                    <% } else { %>—<% } %>
                  </td>
                <% }) %>
              </tr>

              <!-- Average row -->
              <tr class="matrix-stat matrix-stat--avg">
                <td class="matrix-stat__label"><%= lang === 'es' ? 'Media' : 'Avg' %></td>
                <td class="matrix-stat__total"><%= fmtSec(Math.round(r.avg_lap_ms)) %></td>
                <% orderedLanes.forEach(lane => {
                     const pl = laneMap.get(lane);
                     const isStart = lane === startLane;
                %>
                  <td class="matrix-lane-cell <%= isStart ? 'matrix-lane-cell--start' : '' %>">
                    <%= pl && pl.avg_ms != null ? fmtSec(Math.round(pl.avg_ms)) : '—' %>
                  </td>
                <% }) %>
              </tr>

              <!-- Slowest + exits row -->
              <tr class="matrix-stat matrix-stat--worst">
                <td class="matrix-stat__label">
                  <%= lang === 'es' ? 'Salidas' : 'Exits' %>
                  <span class="exit-total">(<%= (r.perLane||[]).reduce((s,pl)=>s+(pl.exit_count||0),0) %>)</span>
                </td>
                <td class="matrix-stat__total">—</td>
                <% orderedLanes.forEach(lane => {
                     const pl = laneMap.get(lane);
                     const isStart = lane === startLane;
                %>
                  <td class="matrix-lane-cell <%= isStart ? 'matrix-lane-cell--start' : '' %>">
                    <% if (pl && pl.worst_ms != null) { %>
                      <span class="exit-count <%= pl.exit_count > 0 ? 'has-exits' : '' %>">(<%= pl.exit_count || 0 %>)</span>
                      <%= fmtSec(pl.worst_ms) %>
                    <% } else { %>—<% } %>
                  </td>
                <% }) %>
              </tr>

              <!-- Pit-stops row -->
              <%
                const totalPitStops = (r.perLane||[]).reduce((s,pl)=>s+(pl.pit_stop_count||0),0);
              %>
              <tr class="matrix-stat matrix-stat--pit">
                <td class="matrix-stat__label">
                  🔧 <%= lang === 'es' ? 'Pit-stops' : 'Pit-stops' %>
                  <span class="exit-total">(<%= totalPitStops %>)</span>
                </td>
                <td class="matrix-stat__total">—</td>
                <% orderedLanes.forEach(lane => {
                     const pl = laneMap.get(lane);
                     const lapsList = (pl && pl.pit_stop_laps)
                       ? pl.pit_stop_laps.split(',').filter(Boolean).map(n => 'V' + n).join(', ')
                       : '';
                     const isStart = lane === startLane;
                %>
                  <td class="matrix-lane-cell <%= isStart ? 'matrix-lane-cell--start' : '' %>">
                    <% if (pl && pl.pit_stop_count > 0) { %>
                      <span class="exit-count has-exits">(<%= pl.pit_stop_count %>)</span>
                      <span class="pit-laps"><%= lapsList %></span>
                    <% } else { %>—<% } %>
                  </td>
                <% }) %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ── Progression chart ── -->
    <div class="results-panel" id="tab-progression">
      <div class="progression-controls">
        <div class="prog-control prog-control--wide">
          <label><%= lang === 'es' ? 'Equipos / Pilotos (compara)' : 'Teams / Drivers (compare)' %></label>
          <div id="progEntities" class="prog-entities"></div>
        </div>
        <div class="prog-control">
          <label for="progManga"><%= lang === 'es' ? 'Manga' : 'Heat' %></label>
          <select id="progManga" class="prog-select"><option value="all"><%= lang === 'es' ? 'Todas' : 'All' %></option></select>
        </div>
        <div class="prog-control">
          <label for="progDriver"><%= lang === 'es' ? 'Piloto' : 'Driver' %></label>
          <select id="progDriver" class="prog-select"><option value="all"><%= lang === 'es' ? 'Todos' : 'All' %></option></select>
        </div>
        <div class="prog-control">
          <label><%= lang === 'es' ? 'Carriles' : 'Lanes' %></label>
          <div id="progLanes" class="prog-lanes"></div>
        </div>
        <div class="prog-subtabs">
          <button class="prog-subtab active" data-prog="abs">⏱ <%= lang === 'es' ? 'Tiempo' : 'Time' %></button>
          <button class="prog-subtab" data-prog="delta">Δ <%= lang === 'es' ? 'Delta vs media' : 'Delta vs avg' %></button>
        </div>
      </div>
      <div class="prog-chart-wrap">
        <canvas id="progChart"></canvas>
      </div>
      <p class="prog-hint">
        <%= lang === 'es'
          ? 'Incluye todas las vueltas (incluyendo salidas y pit-stops). Los puntos rojos son salidas, los naranjas son pit-stops.'
          : 'Includes every lap (exits and pit-stops too). Red dots = exits, orange = pit-stops.' %>
      </p>
    </div>

<style>
  .progression-controls { display:flex; gap:1rem; align-items:flex-end; flex-wrap:wrap; margin-bottom:1rem; }
  .prog-control { display:flex; flex-direction:column; gap:.25rem; }
  .prog-control > label { color:#8b949e; font-size:.75rem; text-transform:uppercase; letter-spacing:.05em; }
  .prog-select { background:#161b22; color:#c9d1d9; border:1px solid #30363d; border-radius:6px; padding:.45rem .7rem; font-size:.9rem; min-width:140px; }
  .prog-control--wide { flex:1 1 100%; }
  .prog-entities { display:flex; gap:.4rem; flex-wrap:wrap; padding:.3rem 0; max-height:120px; overflow-y:auto; }
  .prog-entity-chip { display:inline-flex; align-items:center; gap:.35rem; padding:.3rem .7rem; border:1px solid #30363d; border-radius:14px; background:#161b22; color:#c9d1d9; font-size:.85rem; cursor:pointer; user-select:none; }
  .prog-entity-chip.active { border-color:#1f6feb; color:#fff; font-weight:600; box-shadow:0 0 0 2px rgba(31,111,235,.18) inset; }
  .prog-entity-chip__dot { width:9px; height:9px; border-radius:50%; }
  .prog-lanes { display:flex; gap:.4rem; flex-wrap:wrap; padding:.3rem 0; }
  .prog-lane-chip { display:inline-flex; align-items:center; gap:.3rem; padding:.25rem .55rem; border:1px solid #30363d; border-radius:14px; background:#161b22; color:#c9d1d9; font-size:.8rem; cursor:pointer; user-select:none; }
  .prog-lane-chip.active { background:rgba(31,111,235,.2); border-color:#1f6feb; color:#58a6ff; font-weight:600; }
  .prog-lane-chip__dot { width:8px; height:8px; border-radius:50%; }
  .prog-subtabs { display:inline-flex; gap:.3rem; margin-left:auto; }
  .prog-subtab { background:#161b22; color:#8b949e; border:1px solid #30363d; padding:.45rem .8rem; border-radius:6px; cursor:pointer; font-size:.85rem; }
  .prog-subtab.active { background:#1f6feb; color:#fff; border-color:#1f6feb; }
  .prog-chart-wrap { background:#000000; border:1px solid #21262d; border-radius:12px; padding:1rem; height: 480px; }
  .prog-hint { color:#6e7681; font-size:.78rem; margin-top:.6rem; font-style:italic; }
</style>

    <!-- ── Position timeline ── -->
    <div class="results-panel" id="tab-positions">
      <div class="prog-chart-wrap" style="height: 560px;">
        <canvas id="positionsChart"></canvas>
      </div>
      <p class="prog-hint">
        <%= lang === 'es'
          ? 'Cada línea muestra la posición de un equipo/piloto a lo largo de la carrera. P1 está arriba. El eje X es el orden cronológico de las vueltas (cada cruce es un punto).'
          : 'Each line shows a team/driver position throughout the race. P1 is at the top. X axis is chronological lap order (each crossing is a point).' %>
      </p>
    </div>

    <!-- ── Advanced stats (per-pilot deep dive + head-to-head) ── -->
    <div class="results-panel" id="tab-advanced">
      <div class="adv-controls">
        <label>
          <%= lang === 'es' ? 'Equipo/piloto:' : 'Team/driver:' %>
          <select id="advEntity" class="prog-select"></select>
        </label>
        <label>
          <%= lang === 'es' ? 'Comparar con:' : 'Compare with:' %>
          <select id="advCompare" class="prog-select">
            <option value=""><%= lang === 'es' ? '— Sin comparar —' : '— None —' %></option>
          </select>
        </label>
        <label style="cursor:pointer; user-select:none">
          <input type="checkbox" id="advIncludeOutliers"> <%= lang === 'es' ? 'Con salidas/pit-stops' : 'With exits/pit-stops' %>
        </label>
      </div>

      <div class="adv-panels" id="advPanels"></div>

      <div class="adv-section" id="advCompareSection" hidden>
        <h3 style="color:#e6edf3; margin:1.5rem 0 .8rem"><%= lang === 'es' ? 'Comparativa head-to-head' : 'Head-to-head' %></h3>
        <table class="adv-compare-table" id="advCompareTable">
          <thead>
            <tr>
              <th></th>
              <th id="advCompA"></th>
              <th></th>
              <th id="advCompB"></th>
              <th><%= lang === 'es' ? 'Diferencia' : 'Difference' %></th>
            </tr>
          </thead>
          <tbody id="advCompareBody"></tbody>
        </table>
      </div>
    </div>

    <style>
      .adv-controls { display:flex; gap:1.2rem; align-items:center; flex-wrap:wrap; margin-bottom:1.2rem }
      .adv-controls label { color:#8b949e; font-size:.85rem; display:flex; align-items:center; gap:.4rem }
      .adv-panels { display:grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap:.7rem }
      .adv-card { background:#161b22; border:1px solid #30363d; border-radius:10px; padding:.8rem 1rem }
      .adv-card__label { color:#8b949e; font-size:.72rem; text-transform:uppercase; letter-spacing:.05em }
      .adv-card__big { font-family:'Share Tech Mono', monospace; color:#e6edf3; font-size:1.6rem; font-weight:700; margin-top:.15rem }
      .adv-card__hint { color:#6e7681; font-size:.75rem; margin-top:.15rem }
      .adv-card--wide { grid-column: 1 / -1 }
      .adv-mangas { display:flex; gap:.5rem; flex-wrap:wrap; margin-top:.3rem }
      .adv-manga { flex:0 0 auto; background:#000000; border:1px solid #21262d; border-radius:8px; padding:.5rem .7rem; min-width:100px }
      .adv-manga__lbl { color:#6e7681; font-size:.7rem; text-transform:uppercase; letter-spacing:.05em }
      .adv-manga__val { font-family:'Share Tech Mono', monospace; color:#c9d1d9; font-weight:700; font-size:1rem }
      .adv-manga__meta { color:#6e7681; font-size:.7rem }
      .adv-compare-table { width:100%; border-collapse:collapse; font-size:.92rem }
      .adv-compare-table th, .adv-compare-table td { padding:.5rem .7rem; border-bottom:1px solid #21262d; color:#c9d1d9 }
      .adv-compare-table th { color:#8b949e; font-size:.72rem; text-transform:uppercase; letter-spacing:.05em; background:#000000 }
      .adv-diff--better { color:#3fb950; font-weight:700 }
      .adv-diff--worse  { color:#f85149; font-weight:700 }
    </style>

    <script id="advancedStatsData" type="application/json"><%- JSON.stringify(advancedStats || []) %></script>
    <script>
      (function() {
        const data = JSON.parse(document.getElementById('advancedStatsData').textContent || '[]');
        if (data.length === 0) return;
        const selEntity  = document.getElementById('advEntity');
        const selCompare = document.getElementById('advCompare');
        const cbOutliers = document.getElementById('advIncludeOutliers');
        const panels     = document.getElementById('advPanels');
        const cmpSection = document.getElementById('advCompareSection');
        let includeOutliers = false;

        // Populate selects
        data.forEach(e => {
          selEntity.innerHTML  += `<option value="${e.key}">${e.entityName}</option>`;
          selCompare.innerHTML += `<option value="${e.key}">${e.entityName}</option>`;
        });
        selEntity.value = data[0].key;

        function fmtMs(ms) { return ms == null ? '—' : (ms/1000).toFixed(3).replace('.', ',') + 's'; }
        function fmtSec(ms) { return ms == null ? '—' : (ms/1000).toFixed(2).replace('.', ',') + 's'; }
        function getStat(e, key) {
          if (key === 'avg')   return includeOutliers ? e.avgAll   : e.avgClean;
          if (key === 'delta') return includeOutliers ? e.deltaAll : e.deltaClean;
          return e[key];
        }

        function renderEntity(e) {
          const avg   = getStat(e, 'avg');
          const delta = getStat(e, 'delta');
          panels.innerHTML = `
            <div class="adv-card">
              <div class="adv-card__label">Total vueltas</div>
              <div class="adv-card__big">${e.totalLaps}</div>
              <div class="adv-card__hint">${e.cleanLaps} limpias</div>
            </div>
            <div class="adv-card">
              <div class="adv-card__label">Mejor vuelta</div>
              <div class="adv-card__big">${fmtMs(e.bestMs)}</div>
            </div>
            <div class="adv-card">
              <div class="adv-card__label">Media ${includeOutliers ? '(con salidas)' : 'limpia'}</div>
              <div class="adv-card__big">${fmtMs(avg)}</div>
            </div>
            <div class="adv-card">
              <div class="adv-card__label">Δ consistencia</div>
              <div class="adv-card__big">${delta != null ? '+' + fmtSec(delta) : '—'}</div>
              <div class="adv-card__hint">avg − best</div>
            </div>
            <div class="adv-card">
              <div class="adv-card__label">Salidas · pit-stops</div>
              <div class="adv-card__big">${e.exitCount} · ${e.pitStopCount}</div>
            </div>
            <div class="adv-card">
              <div class="adv-card__label">⏱ Tiempo perdido</div>
              <div class="adv-card__big">${fmtSec(e.lostMs)}</div>
              <div class="adv-card__hint">≈ ${e.lostLapsEquiv} vueltas</div>
            </div>
            <div class="adv-card adv-card--wide">
              <div class="adv-card__label">📈 Evolución por manga</div>
              <div class="adv-mangas">
                ${e.perManga.map(p => `
                  <div class="adv-manga">
                    <div class="adv-manga__lbl">Manga ${p.manga}</div>
                    <div class="adv-manga__val">${fmtMs(includeOutliers ? p.avgAll : p.avgClean)}</div>
                    <div class="adv-manga__meta">${p.totalLaps}v · ${p.exitCount} salidas</div>
                  </div>
                `).join('')}
              </div>
            </div>
          `;
        }

        function renderCompare(a, b) {
          if (!b) { cmpSection.hidden = true; return; }
          cmpSection.hidden = false;
          document.getElementById('advCompA').textContent = a.entityName;
          document.getElementById('advCompB').textContent = b.entityName;
          const rows = [
            ['Total vueltas',         a.totalLaps,             b.totalLaps,             'higher'],
            ['Mejor vuelta',          fmtMs(a.bestMs),         fmtMs(b.bestMs),         'lowerMs', a.bestMs, b.bestMs],
            ['Media',                 fmtMs(getStat(a,'avg')), fmtMs(getStat(b,'avg')), 'lowerMs', getStat(a,'avg'), getStat(b,'avg')],
            ['Δ consistencia',        fmtSec(getStat(a,'delta')), fmtSec(getStat(b,'delta')), 'lowerMs', getStat(a,'delta'), getStat(b,'delta')],
            ['Salidas',               a.exitCount,             b.exitCount,             'lower'],
            ['Pit-stops',             a.pitStopCount,          b.pitStopCount,          'lower'],
            ['Tiempo perdido',        fmtSec(a.lostMs),        fmtSec(b.lostMs),        'lowerMs', a.lostMs, b.lostMs],
          ];
          document.getElementById('advCompareBody').innerHTML = rows.map(r => {
            const [label, va, vb, cmp, na, nb] = r;
            const aN = na != null ? na : (typeof va === 'number' ? va : null);
            const bN = nb != null ? nb : (typeof vb === 'number' ? vb : null);
            let cls = '';
            let diff = '';
            if (aN != null && bN != null) {
              const d = aN - bN;
              if (cmp === 'higher')  { cls = d > 0 ? 'adv-diff--better' : (d < 0 ? 'adv-diff--worse' : ''); diff = (d > 0 ? '+' : '') + d; }
              if (cmp === 'lower')   { cls = d < 0 ? 'adv-diff--better' : (d > 0 ? 'adv-diff--worse' : ''); diff = (d > 0 ? '+' : '') + d; }
              if (cmp === 'lowerMs') { cls = d < 0 ? 'adv-diff--better' : (d > 0 ? 'adv-diff--worse' : ''); diff = (d > 0 ? '+' : '') + (d/1000).toFixed(2).replace('.',',') + 's'; }
            }
            return `<tr><td>${label}</td><td>${va}</td><td>vs</td><td>${vb}</td><td class="${cls}">${diff || '—'}</td></tr>`;
          }).join('');
        }

        function update() {
          const a = data.find(e => e.key === selEntity.value);
          const b = data.find(e => e.key === selCompare.value);
          if (a) renderEntity(a);
          renderCompare(a, b);
        }

        selEntity.addEventListener('change',  update);
        selCompare.addEventListener('change', update);
        cbOutliers.addEventListener('change', () => { includeOutliers = cbOutliers.checked; update(); });

        document.querySelector('[data-tab="advanced"]')?.addEventListener('click', () => setTimeout(update, 50));
        update();
      })();
    </script>

<script id="positionsData" type="application/json"><%- JSON.stringify(positionData || {}) %></script>
<script id="progressionData" type="application/json"><%- JSON.stringify(progressionByEntity || {}) %></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
  (function() {
    const data = JSON.parse(document.getElementById('progressionData').textContent || '{}');
    const entitiesBox = document.getElementById('progEntities');
    const selManga    = document.getElementById('progManga');
    const selDriver   = document.getElementById('progDriver');
    const lanesBox    = document.getElementById('progLanes');
    const canvas      = document.getElementById('progChart');
    if (!entitiesBox || !canvas) return;
    const ENTITY_PALETTE = ['#58a6ff','#f6c90e','#7ee787','#ff6b9d','#a371f7','#56d4dd','#f97316','#e63946','#fbbf24','#34d399'];
    // Lane variation: solid for first lane, dashed for second, dotted for third...
    const LANE_DASH = [[], [8,4], [2,4], [12,3,2,3]];
    let chart = null;
    let mode  = 'abs';
    const enabledLanes = new Set();
    const selectedEntities = new Set();
    const entityColor = {};

    function renderEntities() {
      const entries = Object.entries(data);
      entries.forEach(([key], i) => { entityColor[key] = ENTITY_PALETTE[i % ENTITY_PALETTE.length]; });
      entitiesBox.innerHTML = entries.map(([key, e]) => {
        const active = selectedEntities.has(key) ? 'active' : '';
        const color = entityColor[key];
        return `<span class="prog-entity-chip ${active}" data-key="${key}" style="${selectedEntities.has(key) ? 'background:' + color + '22;' : ''}">
          <span class="prog-entity-chip__dot" style="background:${color}"></span>${e.name}
        </span>`;
      }).join('');
      entitiesBox.querySelectorAll('.prog-entity-chip').forEach(chip => {
        chip.addEventListener('click', () => {
          const key = chip.dataset.key;
          if (selectedEntities.has(key)) selectedEntities.delete(key);
          else selectedEntities.add(key);
          renderEntities();
          refreshFilters();
          build();
        });
      });
    }

    function collectLaps() {
      const out = [];
      selectedEntities.forEach(key => {
        const e = data[key];
        if (e) e.laps.forEach(l => out.push({ ...l, _entity: key, _entityName: e.name }));
      });
      return out;
    }

    function refreshFilters() {
      const laps = collectLaps();
      // Manga options
      const mangas = [...new Set(laps.map(l => l.manga))].sort((a,b)=>a-b);
      const prevManga = selManga.value;
      selManga.innerHTML = '<option value="all">Todas</option>' +
        mangas.map(m => `<option value="${m}">Manga ${m}</option>`).join('');
      if ([...selManga.options].some(o => o.value === prevManga)) selManga.value = prevManga;
      // Driver options
      const drivers = [...new Set(laps.map(l => l.driver).filter(d => d && d !== '—'))].sort();
      const prevDriver = selDriver.value;
      selDriver.innerHTML = '<option value="all">Todos</option>' +
        drivers.map(d => `<option value="${d}">${d}</option>`).join('');
      if ([...selDriver.options].some(o => o.value === prevDriver)) selDriver.value = prevDriver;
      selDriver.parentElement.style.display = drivers.length > 0 ? '' : 'none';
      // Lanes chips
      const lanes = [...new Set(laps.map(l => l.lane))].sort((a,b)=>a-b);
      // Keep previously enabled lanes that still exist; default-enable any new ones
      const prevEnabled = new Set(enabledLanes);
      enabledLanes.clear();
      lanes.forEach(l => { if (prevEnabled.size === 0 || prevEnabled.has(l)) enabledLanes.add(l); });
      if (enabledLanes.size === 0) lanes.forEach(l => enabledLanes.add(l));
      lanesBox.innerHTML = lanes.map(lane => {
        const cls = enabledLanes.has(lane) ? 'active' : '';
        return `<span class="prog-lane-chip ${cls}" data-lane="${lane}">P${lane}</span>`;
      }).join('');
      lanesBox.querySelectorAll('.prog-lane-chip').forEach(chip => {
        chip.addEventListener('click', () => {
          const lane = Number(chip.dataset.lane);
          if (enabledLanes.has(lane)) { enabledLanes.delete(lane); chip.classList.remove('active'); }
          else { enabledLanes.add(lane); chip.classList.add('active'); }
          build();
        });
      });
    }

    function build() {
      if (selectedEntities.size === 0) {
        if (chart) { chart.destroy(); chart = null; }
        const ctx = canvas.getContext('2d');
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        return;
      }
      const mangaFilter  = selManga.value;
      const driverFilter = selDriver.value;
      const lanes = [...enabledLanes].sort((a,b)=>a-b);
      const datasets = [];

      [...selectedEntities].forEach(key => {
        const entity = data[key];
        if (!entity) return;
        const color = entityColor[key];
        lanes.forEach((lane, laneIdx) => {
          const filtered = entity.laps.filter(l =>
            l.lane === lane
            && (mangaFilter === 'all' || String(l.manga) === mangaFilter)
            && (driverFilter === 'all' || l.driver === driverFilter)
          );
          if (filtered.length === 0) return;
          const avg = filtered.reduce((s, l) => s + l.ms, 0) / filtered.length;
          const points = filtered.map((l, idx) => ({
            x: idx + 1,
            y: mode === 'abs' ? l.ms / 1000 : (l.ms - avg) / 1000,
            _meta: l, _entityName: entity.name,
          }));
          const pointColors = filtered.map(l =>
            l.isPitStop ? '#ff9800' :
            l.isExit    ? '#e63946' : color);
          const pointRadius = filtered.map(l => (l.isPitStop || l.isExit) ? 5 : 2.5);
          datasets.push({
            label: entity.name + ' · P' + lane,
            data: points,
            borderColor: color,
            backgroundColor: color + '22',
            borderDash: LANE_DASH[laneIdx % LANE_DASH.length],
            pointBackgroundColor: pointColors,
            pointBorderColor:     pointColors,
            pointRadius, pointHoverRadius: pointRadius.map(r => r + 2),
            tension: 0.2, borderWidth: 2,
          });
        });
      });

      if (chart) chart.destroy();
      chart = new Chart(canvas, {
        type: 'line',
        data: { datasets },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: {
            legend: { labels: { color: '#c9d1d9', boxWidth: 14 } },
            tooltip: {
              callbacks: {
                label: (ctx) => {
                  const v = ctx.parsed.y;
                  const m = ctx.raw._meta;
                  const sign = mode === 'delta' && v > 0 ? '+' : '';
                  let s = ctx.dataset.label + ': ' + sign + v.toFixed(3) + 's';
                  if (m?.driver && m.driver !== '—') s += ' · ' + m.driver;
                  if (m?.manga) s += ' · M' + m.manga;
                  if (m?.isPitStop) s += ' · 🔧 pit-stop';
                  else if (m?.isExit) s += ' · ⚠️ salida';
                  return s;
                }
              }
            }
          },
          scales: {
            x: {
              type: 'linear',
              title: { display: true, text: 'Vuelta (orden cronológico)', color: '#8b949e' },
              ticks: { color: '#8b949e', stepSize: 1 },
              grid:  { color: '#21262d' },
            },
            y: {
              title: { display: true,
                text: mode === 'abs' ? 'Segundos' : 'Δ vs media (s)', color: '#8b949e' },
              ticks: { color: '#8b949e' },
              grid:  { color: '#21262d',
                       drawBorder: false,
                       lineWidth: (ctx) => (mode === 'delta' && ctx.tick.value === 0) ? 2 : 1,
                       color:     (ctx) => (mode === 'delta' && ctx.tick.value === 0) ? '#58a6ff' : '#21262d' },
            }
          }
        }
      });
    }

    selManga.addEventListener('change', build);
    selDriver.addEventListener('change', build);
    document.querySelectorAll('.prog-subtab').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.prog-subtab').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        mode = btn.dataset.prog;
        build();
      });
    });

    // Pre-select the first entity so the chart shows something on first visit
    const firstKey = Object.keys(data)[0];
    if (firstKey) selectedEntities.add(firstKey);
    renderEntities();
    refreshFilters();

    document.querySelector('[data-tab="progression"]')?.addEventListener('click', () => {
      setTimeout(() => { renderEntities(); refreshFilters(); build(); }, 50);
    });
  })();

  // ── Position timeline chart ────────────────────────────────────────────
  (function() {
    const data = JSON.parse(document.getElementById('positionsData').textContent || '{}');
    const canvas = document.getElementById('positionsChart');
    if (!canvas) return;
    const PALETTE = ['#1F6FEB','#F6C90E','#2DA44E','#FB6A6B','#A371F7','#16BDCA','#F97316','#E63946','#FBBF24','#34D399','#FF6B9D','#56D4DD'];
    let chart = null;

    function build() {
      const entries = Object.entries(data);
      if (entries.length === 0) return;
      const totalEntities = entries.length;
      const datasets = entries.map(([key, e], i) => ({
        label: e.name,
        data: e.points,
        borderColor: e.color || PALETTE[i % PALETTE.length],
        backgroundColor: (e.color || PALETTE[i % PALETTE.length]) + '22',
        tension: 0, stepped: 'before',
        pointRadius: 0, pointHoverRadius: 4, borderWidth: 2.5,
      }));
      if (chart) chart.destroy();
      chart = new Chart(canvas, {
        type: 'line',
        data: { datasets },
        options: {
          responsive: true, maintainAspectRatio: false,
          interaction: { mode: 'nearest', intersect: false },
          plugins: {
            legend: { position: 'right', labels: { color: '#c9d1d9', boxWidth: 14 } },
            tooltip: {
              callbacks: {
                title: (items) => 'Cruce #' + items[0].parsed.x,
                label: (ctx) => ctx.dataset.label + ': P' + ctx.parsed.y,
              }
            }
          },
          scales: {
            x: {
              type: 'linear',
              title: { display: true, text: 'Vueltas acumuladas (orden cronológico)', color: '#8b949e' },
              ticks: { color: '#8b949e' }, grid: { color: '#21262d' },
            },
            y: {
              reverse: true, // P1 at top
              min: 1, max: totalEntities,
              title: { display: true, text: 'Posición', color: '#8b949e' },
              ticks: { color: '#8b949e', stepSize: 1, callback: (v) => 'P' + v },
              grid: { color: '#21262d' },
            }
          }
        }
      });
    }

    document.querySelector('[data-tab="positions"]')?.addEventListener('click', () => {
      setTimeout(build, 50);
    });
  })();
</script>

