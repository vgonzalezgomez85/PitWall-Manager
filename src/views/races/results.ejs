<%- include('../partials/header', { pageTitle: (lang === 'es' ? 'Resultados' : 'Results') + ' — ' + race.name }) %>
<style>
/* ── Race fastest lap banner ── */
.race-best-banner {
  display: flex; align-items: center; gap: 1rem;
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
  color: #1a1a1a; padding: 1rem 1.25rem; border-radius: 12px;
  margin-bottom: 1.25rem; box-shadow: 0 4px 16px rgba(245,158,11,0.25);
}
.race-best-banner__icon { font-size: 2rem; line-height: 1; }
.race-best-banner__label { font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; opacity: .8; }
.race-best-banner__value strong { font-size: 1.5rem; font-weight: 800; font-variant-numeric: tabular-nums; }
.race-best-banner__meta { margin-left: .75rem; font-size: .9rem; opacity: .85; }

/* ── Barra de scroll horizontal espejo, sobre la cabecera de la parrilla ── */
.grid-topscroll {
  overflow-x: auto; overflow-y: hidden;
  border: 1px solid #21262d; border-bottom: none;
  border-radius: 12px 12px 0 0; background: #0d1117;
}
.grid-topscroll__inner { height: 1px; }
/* Barra fina y visible sobre el tema oscuro (WebKit + Firefox). */
.grid-topscroll { scrollbar-width: thin; scrollbar-color: #30363d #0d1117; }
.grid-topscroll::-webkit-scrollbar { height: 12px; }
.grid-topscroll::-webkit-scrollbar-track { background: #0d1117; border-radius: 0 0 0 0; }
.grid-topscroll::-webkit-scrollbar-thumb { background: #30363d; border-radius: 6px; border: 2px solid #0d1117; }
.grid-topscroll::-webkit-scrollbar-thumb:hover { background: #484f58; }
/* Si no hay desbordamiento, se colapsa (JS lo oculta). */
.grid-topscroll.is-hidden { display: none; }

/* ── Comparison matrix table ── */
.matrix-wrapper { overflow-x: auto; border-radius: 12px; border: 1px solid #21262d; background:#000000; }
.grid-topscroll + .matrix-wrapper { border-radius: 0 0 12px 12px; }
.matrix-table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; font-size: .85rem; }
.matrix-table th, .matrix-table td { padding: .55rem .7rem; text-align: center; }
.matrix-table thead th {
  background: #161b22; color: #c9d1d9; font-weight: 600; font-size: .75rem;
  text-transform: uppercase; letter-spacing: .05em; border-bottom: 2px solid #30363d;
  position: sticky; top: 0; z-index: 1;
}
.matrix-table .matrix-name { text-align: left; min-width: 180px; }
.matrix-table .matrix-pos { width: 3rem; }
.matrix-lane__label { font-size: .65rem; color: #8b949e; margin-top: 4px; font-weight: 500; }

/* ── Columnas por ocurrencia (carreras de pasadas / repetir-carril) ── */
/* Marcador de ocurrencia bajo el badge de pista (· 1ª, · 2ª…). */
.matrix-occ__label { font-size: .62rem; color: #8b949e; margin-top: 4px; font-weight: 600; letter-spacing: .02em; }
.matrix-occ__ord { color: #c9d1d9; font-weight: 700; }
/* Separador sutil al inicio de cada nuevo grupo de carril, para que las
   ocurrencias del mismo carril se lean como un bloque. Se aplica a la cabecera
   y a todas las celdas de la primera ocurrencia de cada carril. */
.matrix-occ--group-start { box-shadow: inset 2px 0 0 #30363d; }
thead .matrix-occ--group-start { box-shadow: inset 2px 0 0 #484f58; }
.lane-pill {
  display: inline-flex; align-items: center; justify-content: center;
  width: 1.8rem; height: 1.8rem; border-radius: 6px; color: #fff;
  font-weight: 700; font-size: .8rem;
}
.matrix-entity { border-top: 2px solid #30363d; background: #161b22; }
.matrix-entity .matrix-name { padding-top: .7rem; padding-bottom: .25rem; }
.matrix-entity .matrix-total { font-size: 1.15rem; font-weight: 800; color: #58a6ff; }
.matrix-entity .matrix-lane-laps { font-size: 1rem; font-weight: 700; color: #c9d1d9; }
/* Posición por vueltas dentro del carril, entre paréntesis junto al nº de vueltas */
.lane-rank { font-size: .62em; font-weight: 600; color: #8b949e; margin-left: 3px; font-variant-numeric: tabular-nums; }
.lane-rank--top { color: #fbbf24; }
.matrix-entity.top-1 .matrix-total { color: #fbbf24; }
.matrix-entity.top-2 .matrix-total { color: #d1d5db; }
.matrix-entity.top-3 .matrix-total { color: #d97706; }
.matrix-stat { background:#000000; }
.matrix-stat td { padding: .35rem .7rem; color: #c9d1d9; }
/* Alterna el fondo de las sub-filas para separarlas visualmente de un vistazo. */
.matrix-stat:nth-of-type(even of .matrix-stat) td { background: rgba(255,255,255,.018); }
.matrix-stat__label {
  text-align: left !important; color: #c9d1d9 !important;
  font-size: .72rem; font-weight: 600; padding-left: 1rem !important;
  text-transform: uppercase; letter-spacing: .04em;
}
.matrix-stat__total { color: #8b949e !important; font-size: .8rem; }
.matrix-stat--best td { color: #7ee787; font-weight: 600; }
.matrix-stat--avg td { color: #c9d1d9; }
.matrix-stat--worst td { color: #8b949e; font-size: .78rem; }
.matrix-stat--worst .exit-count { color: #f85149; font-weight: 600; margin-right: 3px; }
.matrix-stat--worst .exit-count:not(.has-exits) { color: #484f58; }
.matrix-stat--pit td { color: #c9d1d9; font-size: .78rem; }
.matrix-stat--pit .exit-count { color: #ff9800; font-weight: 600; margin-right: 3px; }
.matrix-stat--pit .pit-laps { color: #8b949e; font-family: 'Share Tech Mono', monospace; }
.exit-total { color: #f85149; font-weight: 600; margin-left: 4px; }
.matrix-stat--pit .exit-total { color: #ff9800; }

/* Starting lane highlight: subtle left border + tinted background, applied to
   the entity header cell and the 4 stat cells of that lane so the column
   reads as a single visual block. */
.matrix-lane-cell--start {
  background: rgba(88, 166, 255, 0.10) !important;
  box-shadow: inset 3px 0 0 #58a6ff;
}
.start-lane-tag {
  display: inline-block; margin-left: 8px;
  padding: 2px 7px; border-radius: 10px;
  background: rgba(88,166,255,.16); color: #58a6ff;
  font-size: .7rem; font-weight: 700; letter-spacing: .03em;
  vertical-align: middle;
}

.race-best {
  background: linear-gradient(135deg, rgba(251,191,36,0.2), rgba(245,158,11,0.15)) !important;
  color: #fbbf24 !important; font-weight: 800 !important;
  position: relative;
  border-radius: 4px;
}
/* "Mejor de la carrera": etiqueta corta en vez de estrella. */
.race-best-tag {
  display: inline-block; margin-left: 5px; padding: 1px 5px;
  border-radius: 4px; background: rgba(251,191,36,.22);
  color: #fbbf24; font-size: .6rem; font-weight: 800;
  letter-spacing: .04em; text-transform: uppercase; vertical-align: middle;
}

/* ── Consistencia (reutiliza el sistema de niveles de live-stats) ── */
/* Sub-fila por carril */
.matrix-stat--cons td { color: #c9d1d9; font-size: .8rem; font-variant-numeric: tabular-nums; }
.res-cons { font-weight: 700; }
.res-cons--exc  { color: var(--vt-green, #3fb950); }
.res-cons--good { color: #56d364; }
.res-cons--warn { color: var(--vt-amber, #e6a817); }
.res-cons--bad  { color: var(--vt-red, #f85149); }
.res-cons--null { color: var(--vt-mute, #6e7681); font-weight: 500; }
/* Chips de consistencia general en la cabecera de fila */
.res-cons-head { display: inline-flex; align-items: center; gap: 6px; margin-left: 10px; vertical-align: middle; }
.res-cons-head__lbl { color: #8b949e; font-size: .62rem; text-transform: uppercase; letter-spacing: .05em; font-weight: 600; }
.res-cons-chip {
  display: inline-flex; align-items: baseline; gap: 3px;
  padding: 1px 7px; border-radius: 10px; font-size: .74rem; font-weight: 700;
  font-variant-numeric: tabular-nums; background: rgba(255,255,255,.05);
}
.res-cons-chip__scope { font-size: .6rem; font-weight: 600; color: #8b949e; letter-spacing: .02em; }
.res-cons-chip__de { font-size: .62rem; font-weight: 600; color: #6e7681; }
.res-cons-chip--sec { opacity: .85; }
.res-cons-chip.res-cons--exc  { color: var(--vt-green, #3fb950); }
.res-cons-chip.res-cons--good { color: #56d364; }
.res-cons-chip.res-cons--warn { color: var(--vt-amber, #e6a817); }
.res-cons-chip.res-cons--bad  { color: var(--vt-red, #f85149); }
.res-cons-chip.res-cons--null { color: var(--vt-mute, #6e7681); }
/* Redondel azul = vuelta rápida general del carril (mejor entre todos en esa pista) */
.lane-fastest-dot {
  display: inline-block; width: .62em; height: .62em; border-radius: 50%;
  background: #2f81f7; margin-right: .35em; vertical-align: middle;
}

@media print {
  @page { size: A3 portrait; margin: 10mm; }
  .print-hide { display: none !important; }

  /* El layout de pantalla fija body a 100vh con overflow hidden: en papel
     eso recorta todo lo que no cabe en la primera página. */
  html, body { height: auto !important; overflow: visible !important; }
  .main-content { overflow: visible !important; height: auto !important; padding: 0 !important; }
  .vt-page { padding: 0 !important; min-height: 0 !important; }
  .vt-wrap { max-width: none !important; margin: 0 !important; padding: 0 !important; }

  .navbar, .footer, .vt-head__actions, .results-tabs, .vt-back-link, .grid-topscroll { display: none !important; }
  /* Las gráficas (canvas sobre fondo negro) no son imprimibles: siempre se
     imprime la comparativa, esté o no activa esa pestaña. */
  .results-panel { display: none !important; }
  #tab-matrix { display: block !important; }

  html, body, .vt-page, .vt-wrap, .main-content { background: #fff !important; color: #000 !important; }
  .vt-page h1 { color: #000 !important; }
  .vt-page h1::before { content: "<%= race.name %> — "; font-size: 1rem; color: #555; display: block; font-weight: 400; }
  .vt-lead, .vt-lead strong { color: #555 !important; }

  /* Banner de vuelta rápida: blanco con borde, texto negro */
  .race-best-banner {
    background: #fff !important; color: #000 !important;
    border: 2px solid #b45309; box-shadow: none; border-radius: 8px;
  }
  .race-best-banner__label, .race-best-banner__meta { color: #555 !important; opacity: 1; }

  /* Matriz comparativa en claro */
  .matrix-wrapper { overflow: visible; border: none; background: #fff !important; border-radius: 0; }
  .matrix-table { font-size: .72rem; }
  .matrix-table th, .matrix-table td { border: 1px solid #ccc; padding: .3rem .45rem; color: #000 !important; }
  .matrix-table thead th {
    background: #f0f0f0 !important; color: #000 !important;
    border-bottom: 2px solid #999; position: static;
  }
  .matrix-lane__label { color: #555; }
  .matrix-occ__label { color: #555; }
  .matrix-occ__ord { color: #000 !important; }
  .matrix-occ--group-start, thead .matrix-occ--group-start {
    box-shadow: none; border-left: 2px solid #999 !important;
  }
  .matrix-entity { background: #f6f6f6 !important; border-top: 2px solid #999; }
  .matrix-entity td { font-weight: 700; }
  .matrix-entity .matrix-total, .matrix-entity .matrix-lane-laps { color: #000 !important; }
  .lane-rank { color: #666 !important; }
  .lane-rank--top { color: #b45309 !important; }
  .matrix-entity.top-1 .matrix-total { color: #b45309 !important; }
  .matrix-stat { background: #fff !important; }
  .matrix-stat td { color: #000 !important; }
  .matrix-stat__label { color: #555 !important; padding-left: .5rem !important; }
  .matrix-stat__total { color: #555 !important; }
  .matrix-stat--best td { color: #166534 !important; }
  .matrix-stat--worst td, .matrix-stat--pit td { color: #444 !important; font-size: .68rem; }
  .matrix-stat--worst .exit-count.has-exits, .matrix-stat--pit .exit-count.has-exits,
  .exit-total { color: #b91c1c !important; }
  .matrix-stat--worst .exit-count:not(.has-exits) { color: #aaa !important; }
  .pit-laps { color: #555 !important; }

  /* Elementos con color de fondo: forzar que se impriman */
  .lane-pill, .pos-badge, .lane-dot, .lane-fastest-dot {
    -webkit-print-color-adjust: exact; print-color-adjust: exact;
  }
  .pos-badge { border: 1px solid #999; color: #000 !important; background: none !important; }
  .race-best {
    background: none !important; color: #000 !important;
    outline: 2px solid #b45309; outline-offset: -2px;
  }
  .race-best-tag { background: none !important; color: #b45309 !important; border: 1px solid #b45309; }
  /* Consistencia en papel: mismo texto, colores oscuros legibles. */
  .matrix-stat--cons td { color: #000 !important; }
  .res-cons--exc, .res-cons--good, .res-cons-chip.res-cons--exc, .res-cons-chip.res-cons--good { color: #166534 !important; }
  .res-cons--warn, .res-cons-chip.res-cons--warn { color: #b45309 !important; }
  .res-cons--bad, .res-cons-chip.res-cons--bad { color: #b91c1c !important; }
  .res-cons--null, .res-cons-chip.res-cons--null { color: #888 !important; }
  .res-cons-chip { background: none !important; border: 1px solid #ccc; }
  .res-cons-head__lbl { color: #555 !important; }
  .matrix-lane-cell--start {
    background: #e8f0fe !important; box-shadow: none;
    border-left: 3px solid #1a56db !important;
    -webkit-print-color-adjust: exact; print-color-adjust: exact;
  }
  .start-lane-tag { background: none !important; color: #1a56db !important; border: 1px solid #1a56db; }

  /* Evitar cortar las filas de un participante entre páginas */
  .matrix-table tr { break-inside: avoid; page-break-inside: avoid; }
}
</style>
<div class="vt-page vt-page--results">
  <div class="vt-wrap">

    <% var _publicView = (typeof publicView !== 'undefined' && publicView); %>
    <a href="<%= _publicView ? '/results' : '/races/' + race.id %>" class="vt-back-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      <%= _publicView ? (lang === 'es' ? 'Volver a resultados' : 'Back to results') : (lang === 'es' ? 'Volver a la carrera' : 'Back to race') %>
    </a>

  <!-- Header -->
  <div class="vt-head" style="align-items:flex-start">
    <div class="vt-head__title" style="flex-direction:column;align-items:flex-start;gap:6px">
      <h1><%= lang === 'es' ? 'Resultados' : 'Results' %></h1>
      <p class="vt-lead" style="margin-top:0">
        <strong style="color:var(--vt-text);font-weight:600"><%= race.name %></strong>
        · <%= t('races.type.' + race.type) %>
        · <%= t('races.format.' + race.format) %>
      </p>
    </div>
    <div class="vt-head__actions">
      <span class="vt-badge is-info"><span class="vt-badge__d"></span><%= tandas.length %> <%= lang === 'es' ? 'tandas' : 'rounds' %></span>
      <% if (!_publicView) { %>
      <a href="/races/<%= race.id %>/results/xlsx?lang=<%= lang %>" class="vt-btn vt-btn--ghost vt-btn--sm" title="<%= lang === 'es' ? 'Exportar a Excel' : 'Export to Excel' %>">
        <svg viewBox="0 0 24 24"><path d="M14 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13l3 3 3-3M12 16V9"/></svg>
        Excel
      </a>
      <a href="/races/<%= race.id %>/results/points.xlsx?lang=<%= lang %>" class="vt-btn vt-btn--ghost vt-btn--sm" title="<%= lang === 'es' ? 'Exportar puntos de clasificación (Excel)' : 'Export classification points (Excel)' %>">
        <svg viewBox="0 0 24 24"><path d="M8 21h8M12 17v4M7 4h10v6a5 5 0 0 1-10 0z"/><path d="M7 5H4.5A1.5 1.5 0 0 0 3 6.5 3.5 3.5 0 0 0 6.5 10M17 5h2.5A1.5 1.5 0 0 1 21 6.5 3.5 3.5 0 0 1 17.5 10"/></svg>
        <%= lang === 'es' ? 'Puntos (xlsx)' : 'Points (xlsx)' %>
      </a>
      <a href="/races/<%= race.id %>/results/points.csv?lang=<%= lang %>" class="vt-btn vt-btn--ghost vt-btn--sm" title="<%= lang === 'es' ? 'Exportar puntos (CSV)' : 'Export points (CSV)' %>">
        <svg viewBox="0 0 24 24"><path d="M14 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg>
        <%= lang === 'es' ? 'Puntos (csv)' : 'Points (csv)' %>
      </a>
      <a href="/races/<%= race.id %>/results/control.csv" class="vt-btn vt-btn--ghost vt-btn--sm" title="<%= lang === 'es' ? 'Exportar para PitWall Control (CSV TicTacSlot)' : 'Export for PitWall Control (TicTacSlot CSV)' %>">
        <svg viewBox="0 0 24 24"><path d="M14 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M8 13h8M8 17h5"/></svg>
        Control
      </a>
      <a href="/races/<%= race.id %>/results/export.html" class="vt-btn vt-btn--ghost vt-btn--sm" title="<%= lang === 'es' ? 'Descarga un index.html autocontenido para publicar en GitHub Pages' : 'Download a self-contained index.html to publish on GitHub Pages' %>">
        <svg viewBox="0 0 24 24"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
        <%= lang === 'es' ? 'Exportar para GitHub' : 'Export for GitHub' %>
      </a>
      <% } %>
      <button type="button" class="vt-btn vt-btn--ghost vt-btn--sm" onclick="window.print()" title="<%= lang === 'es' ? 'Guardar como PDF' : 'Save as PDF' %>">
        <svg viewBox="0 0 24 24"><path d="M6 9V4h12v5M6 18H4a1 1 0 0 1-1-1v-5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5a1 1 0 0 1-1 1h-2M6 14h12v7H6z"/></svg>
        PDF
      </button>
    </div>
  </div>

  <% if (results.length === 0) { %>
    <div class="vt-empty" style="margin-top:32px">
      <div class="vt-empty__t"><%= lang === 'es' ? 'Sin datos todavía' : 'No data yet' %></div>
      <p style="color:var(--vt-mute);margin:6px 0 0">
        <%= lang === 'es' ? 'Completa al menos una manga para ver resultados.' : 'Complete at least one heat to see results.' %>
      </p>
    </div>
  <% } else { %>

    <%
      function fmtMs(ms) {
        if (ms == null) return '—';
        const totalSec   = Math.floor(ms / 1000);
        const hundredths = Math.floor((ms % 1000) / 10);
        const secs = totalSec % 60;
        const mins = Math.floor(totalSec / 60);
        return (mins > 0 ? mins + ':' : '') + String(secs).padStart(mins > 0 ? 2 : 1, '0') + '.' + String(hundredths).padStart(2, '0');
      }
    %>

    <!-- Tab nav -->
    <div class="results-tabs">
      <button class="results-tab active" data-tab="matrix">
        <%= lang === 'es' ? 'Comparativa' : 'Comparison' %>
      </button>
      <button class="results-tab" data-tab="progression">
        <%= lang === 'es' ? 'Progresión' : 'Progression' %>
      </button>
      <button class="results-tab" data-tab="positions">
        <%= lang === 'es' ? 'Posiciones' : 'Positions' %>
      </button>
      <button class="results-tab" data-tab="gap">
        <%= lang === 'es' ? 'Gap al líder' : 'Gap to leader' %>
      </button>
      <button class="results-tab" data-tab="gapgrid">
        <%= lang === 'es' ? 'Gap (rejilla)' : 'Gap (grid)' %>
      </button>
      <button class="results-tab" data-tab="advanced">
        <%= lang === 'es' ? 'Estadísticas avanzadas' : 'Advanced stats' %>
      </button>
      <% if (typeof pole !== 'undefined' && pole) { %>
      <button class="results-tab" data-tab="pole">Pole</button>
      <% } %>
    </div>

    <% if (typeof pole !== 'undefined' && pole) { %>
    <div class="results-panel" id="tab-pole">
      <%
        const fmtPoleMs = (ms) => {
          if (ms == null) return '—';
          const m = Math.floor(ms / 60000);
          const s = ((ms % 60000) / 1000).toFixed(3).padStart(6, '0').replace('.', ',');
          return (m > 0 ? m + ':' + s : s) + 's';
        };
        const fmtPoleGap = (ms) => (ms == null || ms === 0) ? '—' : '+' + (ms / 1000).toFixed(3).replace('.', ',');
      %>
      <div class="pole-tab">
        <div class="pole-tab__head">
          <span class="pole-tab__title">🏁 <%= lang === 'es' ? 'Clasificación de la pole' : 'Pole classification' %></span>
          <span class="pole-tab__meta"><%= lang === 'es' ? 'Carril de pole' : 'Pole lane' %> <b><%= pole.lane %></b></span>
          <% if (pole.poleHolder) { %><span class="pole-tab__meta">Pole: <b><%= pole.poleHolder %></b></span><% } %>
        </div>
        <table class="pole-tab__table">
          <thead>
            <tr>
              <th>#</th>
              <th><%= lang === 'es' ? 'Participante' : 'Participant' %></th>
              <th><%= lang === 'es' ? 'Tiempo' : 'Time' %></th>
              <th>Gap</th>
            </tr>
          </thead>
          <tbody>
            <% pole.rows.forEach(r => { %>
            <tr class="<%= r.pos === 1 ? 'is-pole' : '' %><%= r.lapTimeMs == null ? ' is-none' : '' %>">
              <td class="pole-tab__pos"><%= r.pos != null ? r.pos : '—' %></td>
              <td class="pole-tab__name"><%= r.name %><% if (r.pos === 1) { %> <span class="pole-tab__badge">POLE</span><% } %></td>
              <td class="pole-tab__time"><%= fmtPoleMs(r.lapTimeMs) %></td>
              <td class="pole-tab__gap"><%= fmtPoleGap(r.gapMs) %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <style>
        .pole-tab{border:1px solid #21262d;border-radius:12px;background:#0d1117;overflow:hidden}
        .pole-tab__head{display:flex;align-items:center;gap:1rem;flex-wrap:wrap;padding:.9rem 1.1rem;border-bottom:1px solid #21262d;background:#161b22}
        .pole-tab__title{font-weight:700;color:#e6edf3}
        .pole-tab__meta{font-size:.8rem;color:#8b949e}
        .pole-tab__meta b{color:#c9d1d9}
        .pole-tab__table{width:100%;border-collapse:collapse}
        .pole-tab__table th{text-align:left;font-size:.72rem;text-transform:uppercase;letter-spacing:.04em;color:#8b949e;font-weight:600;padding:.6rem 1.1rem;border-bottom:1px solid #21262d}
        .pole-tab__table td{padding:.6rem 1.1rem;border-bottom:1px solid #161b22}
        .pole-tab__table th:nth-child(3),.pole-tab__table td:nth-child(3),.pole-tab__table th:last-child,.pole-tab__table td:last-child{text-align:right}
        .pole-tab__pos{font-variant-numeric:tabular-nums;color:#8b949e;font-weight:700;width:3rem}
        .pole-tab__name{font-weight:600;color:#e6edf3}
        .pole-tab__time{font-family:'IBM Plex Mono',monospace;font-variant-numeric:tabular-nums;color:#e6edf3}
        .pole-tab__gap{font-family:'IBM Plex Mono',monospace;color:#8b949e}
        .pole-tab tr.is-pole td{background:linear-gradient(135deg,rgba(251,191,36,.18),rgba(245,158,11,.12))}
        .pole-tab tr.is-pole .pole-tab__pos,.pole-tab tr.is-pole .pole-tab__time{color:#fbbf24}
        .pole-tab__badge{margin-left:.4rem;font-size:.62rem;font-weight:700;color:#fbbf24;background:rgba(251,191,36,.18);padding:.1rem .35rem;border-radius:4px;vertical-align:middle}
        .pole-tab tr.is-none td{color:#6e7681}
      </style>
    </div>
    <% } %>

    <!-- ── Comparison matrix (PDF-style, modern) ── -->
    <div class="results-panel active" id="tab-matrix">
      <%
        const orderedLanes = (laneSequence || []).filter(l => l > 0);
        // Desempate a igual vueltas: primero la coma MEDIA por manga (fracción
        // de vuelta en curso al caer la bandera, promediada entre las mangas que
        // corrió), luego mejor vuelta. Media en vez de suma para que el número
        // sea < 1 e intuitivo; con mangas iguales el orden es idéntico a la suma.
        const comaPM = r => (r.mangas_raced > 0 ? (r.coma_total || 0) / r.mangas_raced : 0);
        const byTotalM = [...results].sort((a,b) => b.total_laps - a.total_laps
          || comaPM(b) - comaPM(a)
          || (a.best_lap_ms||Infinity) - (b.best_lap_ms||Infinity));

        // VR general de cada carril = mejor `best_ms` de ese carril entre todos
        // los participantes. Se marca con un redondel azul en la fila "Rápida".
        const laneFastest = {};
        byTotalM.forEach(r => (r.perLane || []).forEach(pl => {
          if (pl.best_ms != null && (laneFastest[pl.lane] == null || pl.best_ms < laneFastest[pl.lane])) {
            laneFastest[pl.lane] = pl.best_ms;
          }
        }));

        // ── Modo OCURRENCIA (pasadas / repetir-carril) ──
        // Si el backend marca perOccurrence, las columnas son occColumns (una por
        // (carril, ocurrencia)) en vez de los carriles. VR por columna = mejor
        // best_ms de esa columna entre todos los participantes (redondel azul).
        const perOcc = (typeof perOccurrence !== 'undefined' && perOccurrence && Array.isArray(occColumns));
        const occFastest = {};
        if (perOcc) {
          byTotalM.forEach(r => occColumns.forEach(col => {
            const c = (r.occByKey || {})[col.key];
            if (c && c.best_ms != null && (occFastest[col.key] == null || c.best_ms < occFastest[col.key])) {
              occFastest[col.key] = c.best_ms;
            }
          }));
        }

        // ── Ranking por VUELTAS dentro de cada carril (columna) ──
        // En cada pista, el que MÁS vueltas hizo es (1). A igualdad de vueltas se
        // desempata por la MEDIA del carril (menor media = mejor posición). Solo
        // comparten posición si empatan en vueltas Y media (prácticamente nunca).
        // Se pinta entre paréntesis junto al nº de vueltas de cada piloto.
        const keyOf = r => `${r.entity_type}_${r.entity_id}`;
        function rankByLaps(entries) {
          const m = {};
          // "o mejor que e": más vueltas, o mismas vueltas con mejor (menor) media.
          const better = (o, e) => o.laps > e.laps
            || (o.laps === e.laps && o.avg != null && (e.avg == null || o.avg < e.avg));
          entries.forEach(e => { m[e.key] = 1 + entries.filter(o => better(o, e)).length; });
          return m;
        }
        const laneLapRank = {};
        orderedLanes.forEach(lane => {
          const entries = byTotalM
            .map(r => { const pl = (r.perLane || []).find(p => p.lane === lane);
                        return pl && pl.laps != null ? { key: keyOf(r), laps: pl.laps, avg: pl.avg_ms } : null; })
            .filter(Boolean);
          laneLapRank[lane] = rankByLaps(entries);
        });
        const occLapRank = {};
        if (perOcc) {
          occColumns.forEach(col => {
            const entries = byTotalM
              .map(r => { const c = (r.occByKey || {})[col.key];
                          return c && c.laps != null ? { key: keyOf(r), laps: c.laps, avg: c.avg_ms } : null; })
              .filter(Boolean);
            occLapRank[col.key] = rankByLaps(entries);
          });
        }

        function fmtSec(ms) {
          if (ms == null) return '—';
          return (ms / 1000).toFixed(3).replace('.', ',');
        }

        // Consistencia: nivel → clase de color y etiqueta (mismo sistema que live-stats).
        function consClass(level) {
          switch (level) {
            case 'excelente': return 'res-cons--exc';
            case 'buena':     return 'res-cons--good';
            case 'irregular': return 'res-cons--warn';
            case 'erratica':  return 'res-cons--bad';
            default:          return 'res-cons--null';
          }
        }
        function consLabel(level) {
          const es = lang === 'es';
          switch (level) {
            case 'excelente': return es ? 'Excelente' : 'Excellent';
            case 'buena':     return es ? 'Buena'     : 'Good';
            case 'irregular': return es ? 'Irregular' : 'Irregular';
            case 'erratica':  return es ? 'Errática'  : 'Erratic';
            default:          return '—';
          }
        }
        // % con 1 decimal y coma decimal; null → '—'.
        function fmtPct(p) {
          if (p == null) return '—';
          return Number(p).toFixed(1).replace('.', ',') + '%';
        }
        // ±DE en segundos (2 decimales), o cadena vacía si null.
        function fmtConsDe(ms) {
          if (ms == null) return '';
          return '±' + (ms / 1000).toFixed(2).replace('.', ',') + ' s';
        }
      %>

      <% if (raceBestLapMs != null) { %>
        <div class="race-best-banner">
          <div>
            <div class="race-best-banner__label"><%= lang === 'es' ? 'Vuelta rápida de la carrera' : 'Race fastest lap' %></div>
            <div class="race-best-banner__value">
              <strong><%= fmtSec(raceBestLapMs) %>s</strong>
              <span class="race-best-banner__meta"><%= raceBestEntity %> · <%= lang === 'es' ? 'Pista' : 'Lane' %> <%= raceBestLane %></span>
            </div>
          </div>
        </div>
      <% } %>

      <div class="grid-topscroll" id="matrixTopScroll" aria-hidden="true"><div class="grid-topscroll__inner"></div></div>
      <div class="matrix-wrapper" id="matrixWrapper">
        <table class="matrix-table">
          <thead>
            <tr>
              <th class="matrix-pos">#</th>
              <th class="matrix-name"><%= lang === 'es' ? 'Equipo / Piloto' : 'Team / Driver' %></th>
              <th class="matrix-laps"><%= lang === 'es' ? 'Vueltas' : 'Laps' %></th>
              <% if (perOcc) { %>
                <% occColumns.forEach(col => {
                     // Separador de grupo al empezar un carril nuevo (occ === 1).
                     const groupStart = col.occ === 1;
                %>
                  <th class="matrix-lane matrix-occ <%= groupStart ? 'matrix-occ--group-start' : '' %>">
                    <span class="lane-pill" style="background:<%= LANE_COLORS[col.lane-1] || '#8b949e' %>"><%= col.lane %></span>
                    <div class="matrix-occ__label">
                      <% if (col.occCount > 1) { %><span class="matrix-occ__ord"><%= col.occ %>/<%= col.occCount %></span><% } %>
                    </div>
                  </th>
                <% }) %>
              <% } else { %>
                <% orderedLanes.forEach(lane => { %>
                  <th class="matrix-lane">
                    <span class="lane-pill" style="background:<%= LANE_COLORS[lane-1] || '#8b949e' %>"><%= lane %></span>
                    <div class="matrix-lane__label"><%= lang === 'es' ? 'Pista' : 'Lane' %> <%= lane %></div>
                  </th>
                <% }) %>
              <% } %>
            </tr>
          </thead>
          <tbody>
            <% byTotalM.forEach((r, i) => {
                 const laneMap = new Map((r.perLane||[]).map(pl => [pl.lane, pl]));
                 const startKey = `${r.entity_type}_${r.entity_id}`;
                 const startLane = (startLaneByEntity || {})[startKey];
            %>
              <!-- Entity header row -->
              <tr class="matrix-entity <%= i < 3 ? 'top-' + (i+1) : '' %>">
                <td class="matrix-pos" rowspan="6">
                  <span class="pos-badge pos-<%= i+1 %>"><%= i+1 %></span>
                </td>
                <td class="matrix-name">
                  <% if (r.color) { %>
                    <span class="lane-dot" style="background:<%= r.color %>; width:10px; height:10px; display:inline-block; border-radius:3px; margin-right:6px;"></span>
                  <% } %>
                  <strong><%= r.entity_name %></strong>
                  <% if (startLane) { %>
                    <span class="start-lane-tag" title="<%= lang === 'es' ? 'Carril de inicio' : 'Starting lane' %>"><%= lang === 'es' ? 'Sale' : 'Start' %> P<%= startLane %></span>
                  <% } %>
                </td>
                <td class="matrix-laps matrix-total">
                  <%= r.total_laps %><% if (r.coma_total > 0) { %><span style="font-size:.6em; color:#8b949e; margin-left:4px; font-weight:normal;" title="<%= lang === 'es' ? 'Coma: fracción de vuelta en curso al caer la bandera, media por manga. Desempata a igualdad de vueltas.' : 'Coma: unfinished lap in progress at the flag, averaged per heat. Breaks ties on equal laps.' %>">+<%= (r.coma_total / (r.mangas_raced || 1)).toFixed(2).replace('.', ',') %></span><% } %>
                </td>
                <% if (perOcc) { %>
                  <% occColumns.forEach(col => {
                       const c = (r.occByKey || {})[col.key];
                       const groupStart = col.occ === 1;
                  %>
                    <td class="matrix-lane-cell matrix-lane-laps <%= groupStart ? 'matrix-occ--group-start' : '' %>">
                      <% const oRank = (c && c.laps != null && occLapRank[col.key]) ? occLapRank[col.key][startKey] : null; %>
                      <%= c ? c.laps : '—' %><% if (oRank) { %><span class="lane-rank <%= oRank === 1 ? 'lane-rank--top' : '' %>">(<%= oRank %>)</span><% } %>
                    </td>
                  <% }) %>
                <% } else { %>
                  <% orderedLanes.forEach(lane => {
                       const pl = laneMap.get(lane);
                       const isStart = lane === startLane;
                  %>
                    <td class="matrix-lane-cell matrix-lane-laps <%= isStart ? 'matrix-lane-cell--start' : '' %>">
                      <% const lRank = (pl && pl.laps != null && laneLapRank[lane]) ? laneLapRank[lane][startKey] : null; %>
                      <%= pl ? pl.laps : '—' %><% if (lRank) { %><span class="lane-rank <%= lRank === 1 ? 'lane-rank--top' : '' %>">(<%= lRank %>)</span><% } %>
                    </td>
                  <% }) %>
                <% } %>
              </tr>

              <!-- Fastest lap row -->
              <tr class="matrix-stat matrix-stat--best">
                <td class="matrix-stat__label"><%= lang === 'es' ? 'Rápida' : 'Fast' %></td>
                <td class="matrix-stat__total"><%= fmtSec(r.best_lap_ms) %></td>
                <% if (perOcc) { %>
                  <% occColumns.forEach(col => {
                       const c = (r.occByKey || {})[col.key];
                       const isRaceBest = c && c.best_ms != null && c.best_ms === raceBestLapMs;
                       const isColFastest = c && c.best_ms != null && c.best_ms === occFastest[col.key];
                       const groupStart = col.occ === 1;
                  %>
                    <td class="matrix-lane-cell <%= isRaceBest ? 'race-best' : '' %> <%= groupStart ? 'matrix-occ--group-start' : '' %>">
                      <% if (c && c.best_ms != null) { %>
                        <% if (isColFastest) { %><span class="lane-fastest-dot" title="<%= lang === 'es' ? 'Vuelta rápida del carril' : 'Lane fastest lap' %>"></span><% } %><%= fmtSec(c.best_ms) %><% if (isRaceBest) { %><span class="race-best-tag" title="<%= lang === 'es' ? 'Vuelta rápida de la carrera' : 'Race fastest lap' %>"><%= lang === 'es' ? 'Mejor' : 'Best' %></span><% } %>
                      <% } else { %>—<% } %>
                    </td>
                  <% }) %>
                <% } else { %>
                  <% orderedLanes.forEach(lane => {
                       const pl = laneMap.get(lane);
                       const isRaceBest = pl && pl.best_ms != null && pl.best_ms === raceBestLapMs;
                       const isLaneFastest = pl && pl.best_ms != null && pl.best_ms === laneFastest[lane];
                       const isStart = lane === startLane;
                  %>
                    <td class="matrix-lane-cell <%= isRaceBest ? 'race-best' : '' %> <%= isLaneFastest ? 'lane-fastest' : '' %> <%= isStart ? 'matrix-lane-cell--start' : '' %>">
                      <% if (pl && pl.best_ms != null) { %>
                        <% if (isLaneFastest) { %><span class="lane-fastest-dot" title="<%= lang === 'es' ? 'Vuelta rápida del carril' : 'Lane fastest lap' %>"></span><% } %><%= fmtSec(pl.best_ms) %><% if (isRaceBest) { %><span class="race-best-tag" title="<%= lang === 'es' ? 'Vuelta rápida de la carrera' : 'Race fastest lap' %>"><%= lang === 'es' ? 'Mejor' : 'Best' %></span><% } %>
                      <% } else { %>—<% } %>
                    </td>
                  <% }) %>
                <% } %>
              </tr>

              <!-- Average row -->
              <tr class="matrix-stat matrix-stat--avg">
                <td class="matrix-stat__label"><%= lang === 'es' ? 'Media' : 'Avg' %></td>
                <td class="matrix-stat__total"><%= fmtSec(Math.round(r.avg_lap_ms)) %></td>
                <% if (perOcc) { %>
                  <% occColumns.forEach(col => {
                       const c = (r.occByKey || {})[col.key];
                       const groupStart = col.occ === 1;
                  %>
                    <td class="matrix-lane-cell <%= groupStart ? 'matrix-occ--group-start' : '' %>">
                      <%= c && c.avg_ms != null ? fmtSec(Math.round(c.avg_ms)) : '—' %>
                    </td>
                  <% }) %>
                <% } else { %>
                  <% orderedLanes.forEach(lane => {
                       const pl = laneMap.get(lane);
                       const isStart = lane === startLane;
                  %>
                    <td class="matrix-lane-cell <%= isStart ? 'matrix-lane-cell--start' : '' %>">
                      <%= pl && pl.avg_ms != null ? fmtSec(Math.round(pl.avg_ms)) : '—' %>
                    </td>
                  <% }) %>
                <% } %>
              </tr>

              <!-- Consistency row (per lane) -->
              <tr class="matrix-stat matrix-stat--cons">
                <td class="matrix-stat__label"><%= lang === 'es' ? 'Const. sin' : 'Const. clean' %></td>
                <td class="matrix-stat__total">
                  <% if (r.raceConsistency != null) { %><span class="res-cons <%= consClass(r.raceConsistencyLevel) %>"><%= fmtPct(r.raceConsistency) %></span><% } else { %>—<% } %>
                </td>
                <% if (perOcc) { %>
                  <% occColumns.forEach(col => {
                       const c = (r.occByKey || {})[col.key];
                       const groupStart = col.occ === 1;
                  %>
                    <td class="matrix-lane-cell <%= groupStart ? 'matrix-occ--group-start' : '' %>">
                      <% if (c && c.consistency != null) { %>
                        <span class="res-cons <%= consClass(c.consistencyLevel) %>" title="<%= consLabel(c.consistencyLevel) %><%= c.consistencyStdMs != null ? ' · ' + fmtConsDe(c.consistencyStdMs) : '' %>"><%= fmtPct(c.consistency) %></span>
                      <% } else { %>—<% } %>
                    </td>
                  <% }) %>
                <% } else { %>
                  <% orderedLanes.forEach(lane => {
                       const pl = laneMap.get(lane);
                       const isStart = lane === startLane;
                  %>
                    <td class="matrix-lane-cell <%= isStart ? 'matrix-lane-cell--start' : '' %>">
                      <% if (pl && pl.consistency != null) { %>
                        <span class="res-cons <%= consClass(pl.consistencyLevel) %>" title="<%= consLabel(pl.consistencyLevel) %><%= pl.consistencyStdMs != null ? ' · ' + fmtConsDe(pl.consistencyStdMs) : '' %>"><%= fmtPct(pl.consistency) %></span>
                      <% } else { %>—<% } %>
                    </td>
                  <% }) %>
                <% } %>
              </tr>

              <!-- Slowest + exits row -->
              <tr class="matrix-stat matrix-stat--worst">
                <td class="matrix-stat__label">
                  <%= lang === 'es' ? 'Salidas' : 'Exits' %>
                  <span class="exit-total">(<%= (r.perLane||[]).reduce((s,pl)=>s+(pl.exit_count||0),0) %>)</span>
                </td>
                <td class="matrix-stat__total">—</td>
                <% if (perOcc) { %>
                  <% occColumns.forEach(col => {
                       const c = (r.occByKey || {})[col.key];
                       const groupStart = col.occ === 1;
                  %>
                    <td class="matrix-lane-cell <%= groupStart ? 'matrix-occ--group-start' : '' %>">
                      <% if (c && c.worst_ms != null) { %>
                        <span class="exit-count <%= c.exit_count > 0 ? 'has-exits' : '' %>">(<%= c.exit_count || 0 %>)</span>
                        <%= fmtSec(c.worst_ms) %>
                      <% } else { %>—<% } %>
                    </td>
                  <% }) %>
                <% } else { %>
                  <% orderedLanes.forEach(lane => {
                       const pl = laneMap.get(lane);
                       const isStart = lane === startLane;
                  %>
                    <td class="matrix-lane-cell <%= isStart ? 'matrix-lane-cell--start' : '' %>">
                      <% if (pl && pl.worst_ms != null) { %>
                        <span class="exit-count <%= pl.exit_count > 0 ? 'has-exits' : '' %>">(<%= pl.exit_count || 0 %>)</span>
                        <%= fmtSec(pl.worst_ms) %>
                      <% } else { %>—<% } %>
                    </td>
                  <% }) %>
                <% } %>
              </tr>

              <!-- Pit-stops row -->
              <%
                const totalPitStops = (r.perLane||[]).reduce((s,pl)=>s+(pl.pit_stop_count||0),0);
              %>
              <tr class="matrix-stat matrix-stat--pit">
                <td class="matrix-stat__label">
                  <%= lang === 'es' ? 'Pit-stops' : 'Pit-stops' %>
                  <span class="exit-total">(<%= totalPitStops %>)</span>
                </td>
                <td class="matrix-stat__total">—</td>
                <% if (perOcc) { %>
                  <% occColumns.forEach(col => {
                       const c = (r.occByKey || {})[col.key];
                       const lapsList = (c && c.pit_stop_laps)
                         ? c.pit_stop_laps.split(',').filter(Boolean).map(n => 'V' + n).join(', ')
                         : '';
                       const groupStart = col.occ === 1;
                  %>
                    <td class="matrix-lane-cell <%= groupStart ? 'matrix-occ--group-start' : '' %>">
                      <% if (c && c.pit_stop_count > 0) { %>
                        <span class="exit-count has-exits">(<%= c.pit_stop_count %>)</span>
                        <span class="pit-laps"><%= lapsList %></span>
                      <% } else { %>—<% } %>
                    </td>
                  <% }) %>
                <% } else { %>
                  <% orderedLanes.forEach(lane => {
                       const pl = laneMap.get(lane);
                       const lapsList = (pl && pl.pit_stop_laps)
                         ? pl.pit_stop_laps.split(',').filter(Boolean).map(n => 'V' + n).join(', ')
                         : '';
                       const isStart = lane === startLane;
                  %>
                    <td class="matrix-lane-cell <%= isStart ? 'matrix-lane-cell--start' : '' %>">
                      <% if (pl && pl.pit_stop_count > 0) { %>
                        <span class="exit-count has-exits">(<%= pl.pit_stop_count %>)</span>
                        <span class="pit-laps"><%= lapsList %></span>
                      <% } else { %>—<% } %>
                    </td>
                  <% }) %>
                <% } %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ── Progression chart ── -->
    <div class="results-panel" id="tab-progression">
      <div class="progression-controls">
        <div class="prog-control prog-control--wide">
          <label><%= lang === 'es' ? 'Equipos / Pilotos (compara)' : 'Teams / Drivers (compare)' %></label>
          <div id="progEntities" class="prog-entities"></div>
        </div>
        <div class="prog-control">
          <label for="progManga"><%= lang === 'es' ? 'Manga' : 'Heat' %></label>
          <select id="progManga" class="prog-select" disabled title="<%= lang === 'es' ? 'Siempre todas las mangas' : 'Always all heats' %>"><option value="all"><%= lang === 'es' ? 'Todas' : 'All' %></option></select>
        </div>
        <div class="prog-control">
          <label for="progDriver"><%= lang === 'es' ? 'Piloto' : 'Driver' %></label>
          <select id="progDriver" class="prog-select"><option value="all"><%= lang === 'es' ? 'Todos' : 'All' %></option></select>
        </div>
        <div class="prog-control">
          <label>
            <%= lang === 'es' ? 'Carriles' : 'Lanes' %>
            <span class="prog-lane-actions">
              <button type="button" id="progLanesAll"  class="prog-mini-btn"><%= lang === 'es' ? 'Todos' : 'All' %></button>
              <button type="button" id="progLanesNone" class="prog-mini-btn"><%= lang === 'es' ? 'Ninguno' : 'None' %></button>
            </span>
          </label>
          <div id="progLanes" class="prog-lanes"></div>
        </div>
        <div class="prog-control">
          <label><%= lang === 'es' ? 'Mostrar' : 'Show' %></label>
          <div class="prog-checks">
            <label class="prog-check"><input type="checkbox" id="progShowExits" checked> <%= lang === 'es' ? 'Piños' : 'Crashes' %></label>
            <label class="prog-check"><input type="checkbox" id="progShowPits" checked> <%= lang === 'es' ? 'Pit stops' : 'Pit stops' %></label>
          </div>
        </div>
        <div class="prog-subtabs">
          <button class="prog-subtab active" data-prog="abs"><%= lang === 'es' ? 'Tiempo' : 'Time' %></button>
          <button class="prog-subtab" data-prog="delta">Δ <%= lang === 'es' ? 'Delta vs media' : 'Delta vs avg' %></button>
        </div>
      </div>
      <div class="prog-chart-wrap" style="height: 620px;">
        <canvas id="progChart"></canvas>
      </div>
      <p class="prog-hint">
        <%= lang === 'es'
          ? 'Incluye todas las vueltas (incluyendo salidas y pit-stops). Los puntos rojos son salidas, los naranjas son pit-stops.'
          : 'Includes every lap (exits and pit-stops too). Red dots = exits, orange = pit-stops.' %>
      </p>
    </div>

<style>
  .progression-controls { display:flex; gap:1rem; align-items:flex-end; flex-wrap:wrap; margin-bottom:1rem; }
  .prog-control { display:flex; flex-direction:column; gap:.25rem; }
  .prog-control > label { color:#8b949e; font-size:.75rem; text-transform:uppercase; letter-spacing:.05em; }
  .prog-select { background:#161b22; color:#c9d1d9; border:1px solid #30363d; border-radius:6px; padding:.45rem .7rem; font-size:.9rem; min-width:140px; }
  .prog-control--wide { flex:1 1 100%; }
