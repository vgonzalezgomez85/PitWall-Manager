<script>
  document.querySelectorAll('.results-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.results-tab').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.results-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('tab-' + btn.dataset.tab).classList.add('active');
    });
  });

  // ── Barra de scroll horizontal espejo (arriba) sincronizada con la parrilla ──
  (function () {
    const top   = document.getElementById('matrixTopScroll');
    const wrap  = document.getElementById('matrixWrapper');
    if (!top || !wrap) return;
    const inner = top.querySelector('.grid-topscroll__inner');
    const table = wrap.querySelector('.matrix-table');

    // Iguala el ancho del inner al contenido real y oculta la barra si no desborda.
    function sync() {
      const w = table ? table.scrollWidth : wrap.scrollWidth;
      inner.style.width = w + 'px';
      top.classList.toggle('is-hidden', w <= wrap.clientWidth + 1);
    }

    // Sincronización bidireccional del scrollLeft con guard anti-bucle.
    let lock = false;
    top.addEventListener('scroll', () => {
      if (lock) { lock = false; return; }
      lock = true; wrap.scrollLeft = top.scrollLeft;
    });
    wrap.addEventListener('scroll', () => {
      if (lock) { lock = false; return; }
      lock = true; top.scrollLeft = wrap.scrollLeft;
    });

    sync();
    window.addEventListener('resize', sync);
    // Recalcula tras cargar fuentes/imágenes que puedan cambiar el ancho.
    window.addEventListener('load', sync);
  })();
</script>

