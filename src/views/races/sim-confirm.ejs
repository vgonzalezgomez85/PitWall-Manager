<%- include('../partials/header', { pageTitle: t('sim.titulo_confirmar') }) %>
<div class="container container--narrow">
  <a href="/races/sim/new" class="vt-back-link" style="margin-top:1rem">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    <%= t('sim.volver') %>
  </a>
  <h1 class="page-title"><%= t('sim.h1_confirmar') %></h1>

  <div class="alert" style="background:rgba(88,166,255,.1);border:1px solid #30363d;border-radius:10px;padding:.9rem 1.1rem;margin-bottom:1.2rem">
    <b><%= t('sim.detectado', { src: source }) %></b><br>
    <%= a.mangas === 1 ? t('sim.una_manga') : t('sim.n_mangas', { n: a.mangas }) %> ·
    <%= a.durationMin != null ? t('sim.min_manga', { n: a.durationMin }) : t('sim.duracion_no_detectada') %> ·
    <%= t('sim.n_carriles', { n: a.lanes }) %> ·
    <%= t('sim.circuitos') %> <%= a.circuits.length ? a.circuits.map(c => c.lanes).join(' + ') : '—' %> ·
    <%= t('sim.n_cruces', { n: a.crossings.toLocaleString(localeFor(lang)) }) %>
  </div>

  <form action="/races/sim/create" method="POST" enctype="multipart/form-data" class="form-card">
    <input type="hidden" name="token" value="<%= token %>">
    <input type="hidden" name="source" value="<%= source %>">

    <div class="form-group">
      <label class="form-label" for="name"><%= t('sim.nombre_carrera') %></label>
      <input class="form-input" id="name" name="name" value="<%= raceName %>" placeholder="<%= t('sim.carrera_simulada') %>" required>
    </div>

    <div class="circuits-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
      <div class="form-group">
        <label class="form-label" for="lanes"><%= t('sim.carriles') %></label>
        <input class="form-input" id="lanes" name="lanes" type="number" min="1" max="64" value="<%= a.lanes || '' %>" required>
      </div>
      <div class="form-group">
        <label class="form-label" for="rests"><%= t('sim.descansos') %></label>
        <input class="form-input" id="rests" name="rests" type="number" min="0" max="64" value="0">
        <p class="form-hint"><%= t('sim.descansos_d') %></p>
      </div>
      <div class="form-group">
        <label class="form-label" for="manga_minutes"><%= t('sim.minutos') %></label>
        <input class="form-input" id="manga_minutes" name="manga_minutes" type="number" min="1" max="600" value="<%= a.durationMin || 5 %>" required>
        <p class="form-hint"><%= t('sim.minutos_d') %></p>
      </div>
      <div class="form-group">
        <label class="form-label" for="min_lap_ms"><%= t('sim.vuelta_minima') %></label>
        <input class="form-input" id="min_lap_ms" name="min_lap_ms" type="number" min="0" max="60000" value="8500">
        <p class="form-hint"><%= t('sim.vuelta_minima_d') %></p>
      </div>
    </div>

    <div class="form-group">
      <label class="form-label"><%= t('sim.pasadas_y_repeticion') %></label>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem">
        <div>
          <label class="form-label" for="passes" style="font-size:.85rem;color:var(--vt-mute,#9aa0a6)"><%= t('sim.pasadas') %></label>
          <input class="form-input form-input--sm" type="number" id="passes" name="passes" min="1" step="1" value="1">
          <p class="form-hint" style="margin-top:.35rem">
            <%= t('sim.pasadas_d') %>
          </p>
        </div>
        <div>
          <label class="form-label" for="lane_repeat" style="font-size:.85rem;color:var(--vt-mute,#9aa0a6)"><%= t('sim.repetir_carril') %></label>
          <input class="form-input form-input--sm" type="number" id="lane_repeat" name="lane_repeat" min="1" step="1" value="1">
          <p class="form-hint" style="margin-top:.35rem">
            <%= t('sim.repetir_carril_d') %>
          </p>
        </div>
      </div>
      <p class="form-hint">
        <%- t('sim.total_cubrir', { n: a.mangas }) %>
      </p>
    </div>

    <div class="form-group">
      <label class="form-label" for="lane_order"><%= t('sim.orden_carril') %></label>
      <p class="form-hint"><%= t('sim.orden_carril_d') %></p>
      <textarea class="form-input" id="lane_order" name="lane_order" rows="8" style="font-family:ui-monospace,Menlo,monospace" placeholder="<%= t('sim.ph_orden') %>"></textarea>
      <label class="form-label" for="lane_csv" style="margin-top:.6rem"><%= t('sim.o_subir_csv') %></label>
      <input class="form-input" id="lane_csv" name="lane_csv" type="file" accept=".csv">
    </div>

    <div class="form-actions">
      <button type="submit" class="vt-btn vt-btn--primary"><%= t('sim.crear') %></button>
    </div>
  </form>
</div>
<%- include('../partials/footer') %>
