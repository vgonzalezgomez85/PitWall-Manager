<%- include('../partials/header', { pageTitle: lang === 'es' ? 'Nueva Tanda' : 'New Heat Group' }) %>
<div class="container" style="max-width:860px">

  <a href="/races/<%= race.id %>" class="back-link">← <%= t('race.back_to_list') %></a>
  <h1 class="page-title"><%= lang === 'es' ? 'Nueva Tanda' : 'New Heat Group' %></h1>
  <p class="page-subtitle"><%= race.name %> · <%= t('races.format.' + race.format) %> · <%= laneSequence.length %> <%= t('races.lanes') %></p>

  <% if (errors.length > 0) { %>
    <div class="alert alert--error">
      <% errors.forEach(e => { %><p><%= t('errors.' + e) %></p><% }) %>
    </div>
  <% } %>

  <div class="form-card">

    <div class="seq-display" style="margin-bottom:1.75rem">
      <span class="seq-display__label"><%= lang === 'es' ? 'Secuencia:' : 'Sequence:' %></span>
      <% laneSequence.forEach((lane, i) => { %>
        <% if (lane === 0) { %>
          <span class="seq-display__lane" style="background:#30363d;color:#8b949e;font-size:.65rem"><%= lang === 'es' ? 'DSC' : 'REST' %></span>
        <% } else { %>
          <span class="seq-display__lane" style="background:<%= LANE_COLORS[lane-1] %>"><%= lane %></span>
        <% } %>
        <% if (i < laneSequence.length - 1) { %><span class="seq-display__arrow">→</span><% } %>
      <% }) %>
    </div>

    <div id="restInfo" class="alert" style="display:none;background:rgba(88,166,255,.08);border:1px solid rgba(88,166,255,.25);color:#58a6ff;margin-bottom:1.25rem">
      <span id="restInfoText"></span>
    </div>

    <form action="/races/<%= race.id %>/tandas" method="POST">

      <% if (race.format === 'individual') { %>

        <p class="form-hint" style="margin-bottom:1.25rem">
          <%= lang === 'es'
            ? `Mínimo ${laneSequence.length} pilotos. Añade más para rotaciones con descanso.`
            : `Minimum ${laneSequence.length} drivers. Add more for rotation with rest slots.` %>
        </p>

        <div id="driversGrid" class="drivers-grid">
          <% const initD = Math.max(laneSequence.length, body.drivers ? body.drivers.length : 0); %>
          <% for (let i = 0; i < initD; i++) { %>
            <div class="driver-row participant-row" data-row="<%= i %>">
              <%
                const slotLane = i < laneSequence.length ? laneSequence[i] : 0;
                const slotColor = slotLane > 0 ? LANE_COLORS[(slotLane - 1) % LANE_COLORS.length] : '#30363d';
                // Rest slots: DSC1 = first to start racing (rests least at start)
                const restIdx = slotLane === 0 ? (initD - i) : 0;
                const slotLabel = slotLane > 0
                  ? slotLane
                  : ((lang === 'es' ? 'DSC' : 'REST') + (restIdx > 0 ? restIdx : ''));
              %>
              <span class="lane-badge participant-badge" style="background:<%= slotColor %>;<%= slotLane === 0 ? 'color:#8b949e;font-size:.65rem' : '' %>" data-index="<%= i %>"><%= slotLabel %></span>
              <div class="driver-field participant-fields">
                <input
                  class="form-input participant-name"
                  type="text"
                  name="drivers[]"
                  placeholder="<%= t('wizard.driver_name_ph') %>"
                  value="<%= (body.drivers && body.drivers[i]) || '' %>"
                  autocomplete="off"
                  <%= i < laneSequence.length ? 'required' : '' %>>
              </div>
              <% if (i >= laneSequence.length) { %>
                <button type="button" class="btn btn--danger btn--sm remove-row" title="<%= lang === 'es' ? 'Eliminar' : 'Remove' %>">✕</button>
              <% } %>
            </div>
          <% } %>
        </div>

        <button type="button" id="addDriver" class="btn btn--ghost btn--sm" style="margin-top:.75rem">
          + <%= lang === 'es' ? 'Añadir piloto' : 'Add driver' %>
        </button>

      <% } else { %>

        <%
          const activeLanes = laneSequence.filter(l => l !== 0);
        %>

        <div id="teamAssignUI" style="display:flex;gap:1.25rem;align-items:flex-start;flex-wrap:wrap">

          <!-- Left: catalog -->
          <div style="flex:0 0 220px;min-width:180px">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.6rem">
              <span class="form-label" style="margin:0"><%= lang === 'es' ? 'Equipos disponibles' : 'Available teams' %></span>
              <button type="button" id="btnNewTeamModal" class="btn btn--ghost btn--sm">+ <%= lang === 'es' ? 'Nuevo' : 'New' %></button>
            </div>
            <div id="catalogList" style="display:flex;flex-direction:column;gap:.4rem;max-height:420px;overflow-y:auto;padding-right:2px">
              <% teamsCatalog.forEach(ct => { %>
                <%
                  const flag = ct.country ? ct.country.split('|')[1] : null;
                  const isSvg = flag === '__SVG__';
                %>
                <div class="catalog-card" draggable="true" data-team-id="<%= ct.id %>" data-team-name="<%= ct.name %>" data-team-country="<%= ct.country || '' %>">
                  <% if (isSvg) { %>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 9 6" width="20" height="13" style="border-radius:2px;flex-shrink:0"><rect width="9" height="6" fill="#FCDD09"/><rect y="0.667" width="9" height="0.889" fill="#DA121A"/><rect y="2.222" width="9" height="0.889" fill="#DA121A"/><rect y="3.778" width="9" height="0.889" fill="#DA121A"/><rect y="5.333" width="9" height="0.667" fill="#DA121A"/></svg>
                  <% } else if (flag) { %>
                    <span style="font-size:1.1rem;line-height:1;flex-shrink:0"><%= flag %></span>
                  <% } %>
                  <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= ct.name %></span>
                  <span style="font-size:.75rem;color:#8b949e;flex-shrink:0"><%= ct.members.length %>👤</span>
                </div>
              <% }) %>
              <% if (teamsCatalog.length === 0) { %>
                <p id="emptyCatalogMsg" class="form-hint" style="text-align:center;padding:.75rem 0">
                  <%= lang === 'es' ? 'No hay equipos. Crea uno.' : 'No teams. Create one.' %>
                </p>
              <% } %>
            </div>
          </div>

          <!-- Right: lane slots -->
          <div style="flex:1;min-width:260px">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.6rem;flex-wrap:wrap;gap:.5rem">
              <span class="form-label" style="margin:0"><%= lang === 'es' ? 'Asignación de carriles' : 'Lane assignment' %></span>
              <button type="button" id="btnAddSlot" class="btn btn--ghost btn--sm">
                + <%= lang === 'es' ? 'Añadir participante' : 'Add participant' %>
              </button>
            </div>
            <div id="restInfoTeams" class="alert" style="display:none;background:rgba(88,166,255,.08);border:1px solid rgba(88,166,255,.25);color:#58a6ff;margin-bottom:.75rem;font-size:.85rem">
            </div>
            <div id="slotList" style="display:flex;flex-direction:column;gap:.4rem">
              <% activeLanes.forEach((lane, i) => { %>
                <div class="lane-slot" data-slot="<%= i %>" data-lane="<%= lane %>">
                  <span class="slot-lane-badge" style="background:<%= LANE_COLORS[lane-1] %>"><%= lane %></span>
                  <span class="slot-empty-label"><%= lang === 'es' ? 'Arrastra un equipo aquí' : 'Drag a team here' %></span>
                  <div class="slot-team" style="display:none"></div>
                  <button type="button" class="slot-remove btn btn--danger btn--sm" style="display:none" title="<%= lang === 'es' ? 'Quitar' : 'Remove' %>">✕</button>
                </div>
              <% }) %>
            </div>
          </div>

        </div>

        <!-- Hidden inputs submitted -->
        <div id="hiddenInputs"></div>

      <% } %>

      <div class="form-actions" style="margin-top:1.5rem">
        <a href="/races/<%= race.id %>" class="btn btn--ghost">← <%= t('wizard.back') %></a>
        <button type="submit" class="btn btn--primary">
          🏁 <%= lang === 'es' ? 'Crear Tanda' : 'Create Heat Group' %>
        </button>
      </div>

    </form>
  </div>
</div>

<script>
const LANES     = <%= laneSequence.length %>;
const LANE_SEQ  = <%- JSON.stringify(laneSequence) %>;
const LANG      = "<%= lang %>";
const COLORS    = <%- JSON.stringify(LANE_COLORS) %>;
function slotLabel(i, total){
  if (i < LANE_SEQ.length && LANE_SEQ[i] > 0) return LANE_SEQ[i];
  const t = total ?? document.querySelectorAll('.participant-row').length;
  const restIdx = t - i;
  return (LANG==='es'?'DSC':'REST') + (restIdx > 0 ? restIdx : '');
}
function slotColor(i){ const l = i < LANE_SEQ.length ? LANE_SEQ[i] : 0; return l > 0 ? COLORS[(l-1) % COLORS.length] : '#30363d'; }
const DRIVER_PH = "<%= t('wizard.driver_name_ph') %>";
const TEAM_PH   = "<%= t('wizard.team_name_ph') %>";
const MEMBER_PH = "<%= t('wizard.member_ph') %>";
const OPT_LBL   = "<%= t('wizard.optional') %>";

// Flat list of all profiles with their category for the autocomplete
const ALL_PROFILES = <%- JSON.stringify(
  (profiles || []).map(p => ({ name: p.name, category: p.category }))
) %>;

const CAT_ICONS = { platino: '💎', oro: '🥇', plata: '🥈', bronce: '🥉' };

// ── Autocomplete ──────────────────────────────────────────────────────────────
const acDrop = document.createElement('div');
acDrop.className = 'ac-dropdown';
document.body.appendChild(acDrop);

let acTarget = null;
let acActive = -1;

function acItems() { return acDrop.querySelectorAll('.ac-item'); }

function acFilter(query) {
  if (!query) return [];
  const q = query.toLowerCase();
  return ALL_PROFILES.filter(p => p.name.toLowerCase().includes(q)).slice(0, 10);
}

function acShow(input, results) {
  if (!results.length) { acHide(); return; }
  acTarget = input;
  acActive = -1;

  const rect = input.getBoundingClientRect();
  acDrop.style.left  = (rect.left  + window.scrollX) + 'px';
  acDrop.style.top   = (rect.bottom + window.scrollY + 2) + 'px';
  acDrop.style.width = rect.width + 'px';

  acDrop.innerHTML = results.map(p =>
    `<div class="ac-item" data-name="${p.name}">
      <span class="ac-cat">${CAT_ICONS[p.category] || ''}</span>
      <span class="ac-name">${p.name}</span>
    </div>`
  ).join('');
  acDrop.classList.add('ac-dropdown--open');
}

function acHide() {
  acDrop.classList.remove('ac-dropdown--open');
  acTarget = null;
  acActive = -1;
}

function acSelect(name) {
  if (acTarget) {
    acTarget.value = name;
    acTarget.dispatchEvent(new Event('input', { bubbles: true }));
  }
  acHide();
}

function acHighlight(idx) {
  const items = acItems();
  items.forEach((el, i) => el.classList.toggle('ac-item--active', i === idx));
  if (items[idx]) items[idx].scrollIntoView({ block: 'nearest' });
}

// Input event → show suggestions
document.addEventListener('input', e => {
  if (!e.target.classList.contains('participant-name')) return;
  acShow(e.target, acFilter(e.target.value));
});

// Keyboard navigation
document.addEventListener('keydown', e => {
  if (!acDrop.classList.contains('ac-dropdown--open')) return;
  const items = acItems();
  if (e.key === 'ArrowDown') {
    e.preventDefault();
    acActive = Math.min(acActive + 1, items.length - 1);
    acHighlight(acActive);
  } else if (e.key === 'ArrowUp') {
    e.preventDefault();
    acActive = Math.max(acActive - 1, 0);
    acHighlight(acActive);
  } else if (e.key === 'Enter' && acActive >= 0) {
    e.preventDefault();
    acSelect(items[acActive].dataset.name);
  } else if (e.key === 'Escape') {
    acHide();
  }
});

// Click on suggestion
acDrop.addEventListener('mousedown', e => {
  const item = e.target.closest('.ac-item');
  if (item) { e.preventDefault(); acSelect(item.dataset.name); }
});

// Hide when clicking outside
document.addEventListener('focusout', e => {
  if (e.target.classList.contains('participant-name')) {
    setTimeout(acHide, 150);
  }
});

// ── Rest info banner ──────────────────────────────────────────────────────────
function updateRestInfo() {
  const container = document.getElementById('driversGrid') || document.getElementById('teamsContainer');
  if (!container) return;
  const total = container.querySelectorAll('.participant-row').length;
  const info  = document.getElementById('restInfo');
  if (total > LANES) {
    document.getElementById('restInfoText').textContent = LANG === 'es'
      ? `Con ${total} participantes y ${LANES} carriles: ${total - LANES} descansarán por manga. Ciclo = ${total} mangas.`
      : `With ${total} participants and ${LANES} lanes: ${total - LANES} will rest per heat. Cycle = ${total} heats.`;
    info.style.display = '';
  } else {
    info.style.display = 'none';
  }
}

// ── Re-number rows ────────────────────────────────────────────────────────────
function renumber(containerId) {
  const container = document.getElementById(containerId);
  if (!container) return;
  const isTeams = containerId === 'teamsContainer';
  container.querySelectorAll('.participant-row').forEach((row, i) => {
    row.dataset.row = i;
    const badge = row.querySelector('.participant-badge');
    if (badge) {
      badge.dataset.index = i;
      badge.textContent   = slotLabel(i);
      const color = slotColor(i);
      badge.style.background = color;
      if (isTeams) {
        const hdr = row.querySelector('.team-block__header');
        if (hdr) hdr.style.borderLeftColor = color;
      }
    }
    if (isTeams) {
      const nameInp = row.querySelector('.team-name-input');
      if (nameInp) nameInp.name = `teams[${i}][name]`;
      row.querySelectorAll('.team-members input').forEach(inp => { inp.name = `teams[${i}][members][]`; });
    }
  });
  updateRestInfo();
}

// ── Add driver row ────────────────────────────────────────────────────────────
document.getElementById('addDriver')?.addEventListener('click', () => {
  const grid  = document.getElementById('driversGrid');
  const idx   = grid.querySelectorAll('.participant-row').length;
  const color = slotColor(idx);
  const div   = document.createElement('div');
  div.className  = 'driver-row participant-row';
  div.dataset.row = idx;
  div.innerHTML = `
    <span class="lane-badge participant-badge" style="background:${color}" data-index="${idx}">${slotLabel(idx)}</span>
    <div class="driver-field participant-fields" style="display:flex;flex:1">
      <input class="form-input participant-name" type="text" name="drivers[]"
        placeholder="${DRIVER_PH}" autocomplete="off">
    </div>
    <button type="button" class="btn btn--danger btn--sm remove-row"
      title="${LANG === 'es' ? 'Eliminar' : 'Remove'}">✕</button>`;
  grid.appendChild(div);
  div.querySelector('.participant-name').focus();
  // Relabel existing rest slots since total just increased
  renumber('driversGrid');
  updateRestInfo();
});

document.getElementById('driversGrid')?.addEventListener('click', e => {
  if (e.target.classList.contains('remove-row')) {
    e.target.closest('.participant-row').remove();
    renumber('driversGrid');
  }
});

// ── Team drag-drop assignment ─────────────────────────────────────────────────
if (document.getElementById('teamAssignUI')) {
  const ACTIVE_LANES = <%- JSON.stringify(laneSequence.filter(l => l !== 0)) %>;
  const slotList     = document.getElementById('slotList');
  const hiddenInputs = document.getElementById('hiddenInputs');
  const restInfoEl   = document.getElementById('restInfoTeams');
  const catalogList  = document.getElementById('catalogList');

  const SENYERA = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 9 6" width="20" height="13" style="border-radius:2px;flex-shrink:0"><rect width="9" height="6" fill="#FCDD09"/><rect y="0.667" width="9" height="0.889" fill="#DA121A"/><rect y="2.222" width="9" height="0.889" fill="#DA121A"/><rect y="3.778" width="9" height="0.889" fill="#DA121A"/><rect y="5.333" width="9" height="0.667" fill="#DA121A"/></svg>`;

  function flagHtml(country) {
    if (!country) return '';
    const flag = country.split('|')[1];
    if (!flag) return '';
    if (flag === '__SVG__') return SENYERA;
    return `<span style="font-size:1.1rem;line-height:1">${flag}</span>`;
  }

  function syncHidden() {
    hiddenInputs.innerHTML = '';
    slotList.querySelectorAll('.lane-slot').forEach(slot => {
      const tid = slot.dataset.assignedTeamId;
      if (tid) {
        const inp = document.createElement('input');
        inp.type  = 'hidden';
        inp.name  = 'team_catalog_ids[]';
        inp.value = tid;
        hiddenInputs.appendChild(inp);
      }
    });
  }

  function updateRestBanner() {
    const total  = slotList.querySelectorAll('.lane-slot').length;
    const lanes  = ACTIVE_LANES.length;
    const filled = slotList.querySelectorAll('.lane-slot[data-assigned-team-id]').length;
    if (total > lanes) {
      restInfoEl.style.display = '';
      restInfoEl.textContent = LANG === 'es'
        ? `Con ${total} equipos y ${lanes} carriles: ${total - lanes} descansarán por manga. Ciclo = ${total} mangas.`
        : `With ${total} teams and ${lanes} lanes: ${total - lanes} will rest per heat. Cycle = ${total} heats.`;
    } else {
      restInfoEl.style.display = 'none';
    }
  }

  function greyUsed() {
    const usedIds = new Set(
      [...slotList.querySelectorAll('.lane-slot[data-assigned-team-id]')]
        .map(s => s.dataset.assignedTeamId)
    );
    catalogList.querySelectorAll('.catalog-card').forEach(card => {
      const used = usedIds.has(card.dataset.teamId);
      card.style.opacity  = used ? '0.35' : '1';
      card.draggable      = !used;
    });
  }

  function assignTeam(slot, teamId, teamName, teamCountry) {
    slot.dataset.assignedTeamId = teamId;
    slot.querySelector('.slot-empty-label').style.display = 'none';
    const teamDiv = slot.querySelector('.slot-team');
    teamDiv.style.display = 'flex';
    teamDiv.innerHTML = `${flagHtml(teamCountry)}<span style="flex:1;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${teamName}</span>`;
    slot.querySelector('.slot-remove').style.display = '';
    greyUsed();
    syncHidden();
    updateRestBanner();
  }

  function unassignSlot(slot) {
    delete slot.dataset.assignedTeamId;
    slot.querySelector('.slot-empty-label').style.display = '';
    const teamDiv = slot.querySelector('.slot-team');
    teamDiv.style.display = 'none';
    teamDiv.innerHTML = '';
    slot.querySelector('.slot-remove').style.display = 'none';
    greyUsed();
    syncHidden();
    updateRestBanner();
  }

  function makeSlot(slotIdx, lane) {
    const div = document.createElement('div');
    div.className = 'lane-slot';
    div.dataset.slot = slotIdx;
    div.dataset.lane = lane || 'rest';
    const badge = lane
      ? `<span class="slot-lane-badge" style="background:${COLORS[lane-1]}">${lane}</span>`
      : `<span class="slot-lane-badge" style="background:#30363d;font-size:.65rem">${LANG === 'es' ? 'DSC' : 'REST'}</span>`;
    div.innerHTML = `
      ${badge}
      <span class="slot-empty-label" style="color:#8b949e;font-size:.85rem">${LANG === 'es' ? 'Arrastra un equipo aquí' : 'Drag a team here'}</span>
      <div class="slot-team" style="display:none;align-items:center;gap:.4rem;flex:1;overflow:hidden"></div>
      <button type="button" class="slot-remove btn btn--danger btn--sm" style="display:none" title="${LANG === 'es' ? 'Quitar' : 'Remove'}">✕</button>`;
    return div;
  }

  // ── Drag from catalog ────────────────────────────────────────────────────────
  let dragTeamId = null, dragTeamName = null, dragTeamCountry = null;

  catalogList.addEventListener('dragstart', e => {
    const card = e.target.closest('.catalog-card');
    if (!card || !card.draggable) { e.preventDefault(); return; }
    dragTeamId      = card.dataset.teamId;
    dragTeamName    = card.dataset.teamName;
    dragTeamCountry = card.dataset.teamCountry;
    e.dataTransfer.effectAllowed = 'move';
    card.style.opacity = '0.5';
  });

  catalogList.addEventListener('dragend', e => {
    const card = e.target.closest('.catalog-card');
    if (card) greyUsed();
  });

  slotList.addEventListener('dragover', e => {
    if (dragTeamId) { e.preventDefault(); e.dataTransfer.dropEffect = 'move'; }
    const slot = e.target.closest('.lane-slot');
    if (slot) slot.classList.add('slot--over');
  });

  slotList.addEventListener('dragleave', e => {
    const slot = e.target.closest('.lane-slot');
    if (slot) slot.classList.remove('slot--over');
  });

  slotList.addEventListener('drop', e => {
    e.preventDefault();
    const slot = e.target.closest('.lane-slot');
    if (!slot || !dragTeamId) return;
    slot.classList.remove('slot--over');
    // If slot already had a team, free it first
    if (slot.dataset.assignedTeamId) unassignSlot(slot);
    assignTeam(slot, dragTeamId, dragTeamName, dragTeamCountry);
    dragTeamId = null;
  });

  // ── Remove from slot ─────────────────────────────────────────────────────────
  slotList.addEventListener('click', e => {
    if (e.target.closest('.slot-remove')) {
      unassignSlot(e.target.closest('.lane-slot'));
    }
  });

  // ── Add extra participant slot ───────────────────────────────────────────────
  document.getElementById('btnAddSlot').addEventListener('click', () => {
    const slots = slotList.querySelectorAll('.lane-slot');
    const idx   = slots.length;
    const slot  = makeSlot(idx, null);
    slotList.appendChild(slot);
    updateRestBanner();
  });

  updateRestBanner();

  // ── Modal: nuevo equipo ──────────────────────────────────────────────────────
  const SENYERA_SVG_MODAL = SENYERA;
  const COUNTRIES_MODAL = [
    ['Catalunya','__SVG__'],
    ['Afghanistan','🇦🇫'],['Albania','🇦🇱'],['Algeria','🇩🇿'],['Andorra','🇦🇩'],['Angola','🇦🇴'],
    ['Argentina','🇦🇷'],['Armenia','🇦🇲'],['Australia','🇦🇺'],['Austria','🇦🇹'],['Azerbaijan','🇦🇿'],
    ['Bahrain','🇧🇭'],['Bangladesh','🇧🇩'],['Belarus','🇧🇾'],['Belgium','🇧🇪'],['Bolivia','🇧🇴'],
    ['Bosnia','🇧🇦'],['Brazil','🇧🇷'],['Bulgaria','🇧🇬'],['Canada','🇨🇦'],['Chile','🇨🇱'],
    ['China','🇨🇳'],['Colombia','🇨🇴'],['Croatia','🇭🇷'],['Cuba','🇨🇺'],['Cyprus','🇨🇾'],
    ['Czech Republic','🇨🇿'],['Denmark','🇩🇰'],['Ecuador','🇪🇨'],['Egypt','🇪🇬'],['Estonia','🇪🇪'],
    ['Finland','🇫🇮'],['France','🇫🇷'],['Georgia','🇬🇪'],['Germany','🇩🇪'],['Greece','🇬🇷'],
    ['Hungary','🇭🇺'],['Iceland','🇮🇸'],['India','🇮🇳'],['Ireland','🇮🇪'],['Italy','🇮🇹'],
    ['Japan','🇯🇵'],['Mexico','🇲🇽'],['Netherlands','🇳🇱'],['New Zealand','🇳🇿'],['Norway','🇳🇴'],
    ['Poland','🇵🇱'],['Portugal','🇵🇹'],['Romania','🇷🇴'],['Russia','🇷🇺'],['Serbia','🇷🇸'],
    ['Slovakia','🇸🇰'],['Slovenia','🇸🇮'],['South Korea','🇰🇷'],['Spain','🇪🇸'],['Sweden','🇸🇪'],
    ['Switzerland','🇨🇭'],['Turkey','🇹🇷'],['Ukraine','🇺🇦'],['United Kingdom','🇬🇧'],['United States','🇺🇸'],
    ['Uruguay','🇺🇾'],['Venezuela','🇻🇪'],
  ];

  // Build modal DOM
  const modal = document.createElement('div');
  modal.id = 'newTeamModal';
  modal.style.cssText = 'display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,.6);align-items:center;justify-content:center';
  modal.innerHTML = `
    <div style="background:#161b22;border:1px solid #30363d;border-radius:10px;padding:1.5rem;width:420px;max-width:96vw;max-height:90vh;overflow-y:auto">
      <h3 style="margin:0 0 1rem;color:#e6edf3">${LANG === 'es' ? 'Nuevo equipo' : 'New team'}</h3>
      <div class="form-group">
        <label class="form-label">${LANG === 'es' ? 'Nombre del equipo' : 'Team name'}</label>
        <input id="modalTeamName" class="form-input" type="text" autocomplete="off"
               placeholder="${LANG === 'es' ? 'Ej: Red Racers' : 'e.g. Red Racers'}">
      </div>
      <div class="form-group">
        <label class="form-label">${LANG === 'es' ? 'País (opcional)' : 'Country (optional)'}</label>
        <div style="position:relative">
          <div id="modalFlagBtn" class="form-input" style="cursor:pointer;display:flex;align-items:center;gap:.6rem;user-select:none">
            <span id="modalFlagDisplay" style="font-size:1.2rem">🌐</span>
            <span id="modalFlagLabel" style="flex:1;color:#8b949e;font-size:.9rem">${LANG === 'es' ? 'Selecciona...' : 'Select...'}</span>
            <span style="color:#8b949e;font-size:.75rem">▼</span>
          </div>
          <input type="hidden" id="modalCountryVal">
          <div id="modalFlagDrop" style="display:none;position:absolute;bottom:calc(100% + 4px);left:0;right:0;z-index:10;background:#161b22;border:1px solid #30363d;border-radius:8px;box-shadow:0 -4px 16px rgba(0,0,0,.5);overflow:hidden">
            <div style="padding:.4rem">
              <input id="modalFlagSearch" class="form-input form-input--sm" type="text"
                     placeholder="${LANG === 'es' ? 'Buscar...' : 'Search...'}" autocomplete="off" style="width:100%">
            </div>
            <ul id="modalFlagList" style="margin:0;padding:0 0 .3rem;list-style:none;max-height:160px;overflow-y:auto"></ul>
          </div>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">${LANG === 'es' ? 'Pilotos' : 'Drivers'}</label>
        <div id="modalMembersList" style="display:flex;flex-direction:column;gap:.4rem;margin-bottom:.5rem"></div>
        <button type="button" id="modalAddMember" class="btn btn--ghost btn--sm">
          + ${LANG === 'es' ? 'Añadir piloto' : 'Add driver'}
        </button>
      </div>
      <div id="modalError" style="display:none;color:#f85149;font-size:.85rem;margin-bottom:.75rem"></div>
      <div style="display:flex;gap:.5rem;justify-content:flex-end">
        <button type="button" id="modalCancel" class="btn btn--ghost">${LANG === 'es' ? 'Cancelar' : 'Cancel'}</button>
        <button type="button" id="modalSave" class="btn btn--primary">${LANG === 'es' ? 'Crear equipo' : 'Create team'}</button>
      </div>
    </div>`;
  document.body.appendChild(modal);

  const MODAL_PROFILES = <%- JSON.stringify((profiles||[]).map(p => ({ id: p.id, name: p.name, category: p.category||'' }))) %>;
  const CAT_ICONS_M = { platino: '💎', oro: '🥇', plata: '🥈', bronce: '🥉' };

  function addModalMemberRow(name = '', driverId = null) {
    const row = document.createElement('div');
    row.style.cssText = 'display:flex;gap:.4rem;align-items:center;position:relative';
    row.innerHTML = `
      <div style="flex:1;position:relative">
        <input type="text" class="form-input modal-member-name"
               placeholder="${LANG === 'es' ? 'Nombre piloto' : 'Driver name'}"
               value="${name.replace(/"/g,'&quot;')}" autocomplete="off">
        <input type="hidden" class="modal-member-driver-id" value="${driverId || ''}">
        <ul class="modal-ac-drop" style="display:none;position:absolute;top:calc(100% + 2px);left:0;right:0;background:#161b22;border:1px solid #30363d;border-radius:6px;margin:0;padding:0;list-style:none;z-index:200;max-height:160px;overflow-y:auto;box-shadow:0 4px 12px rgba(0,0,0,.4)"></ul>
      </div>
      <span class="modal-member-linked" style="font-size:.9rem;visibility:${driverId ? 'visible' : 'hidden'}">🔗</span>
      <button type="button" class="btn btn--danger btn--sm modal-member-remove" title="${LANG === 'es' ? 'Quitar' : 'Remove'}">✕</button>`;
    document.getElementById('modalMembersList').appendChild(row);

    const input   = row.querySelector('.modal-member-name');
    const hidden  = row.querySelector('.modal-member-driver-id');
    const linked  = row.querySelector('.modal-member-linked');
    const drop    = row.querySelector('.modal-ac-drop');
    let _matches  = [];

    function clearLink() { hidden.value = ''; linked.style.visibility = 'hidden'; }

    function selectProfile(p) {
      input.value  = p.name;
      hidden.value = p.id;
      linked.style.visibility = 'visible';
      drop.style.display = 'none';
      _matches = [];
    }

    function showSuggestions(q) {
      if (!q) { drop.style.display = 'none'; return; }
      _matches = MODAL_PROFILES.filter(p => p.name.toLowerCase().includes(q.toLowerCase()));
      if (!_matches.length) { drop.style.display = 'none'; return; }
      drop.innerHTML = _matches.map((p, i) =>
        `<li data-idx="${i}" style="padding:.4rem .65rem;cursor:pointer;display:flex;align-items:center;gap:.5rem;font-size:.875rem;color:#e6edf3">
          <span>${CAT_ICONS_M[p.category] || ''}</span><span>${p.name}</span>
          <span style="margin-left:auto;font-size:.75rem;color:#8b949e">${p.category}</span>
        </li>`
      ).join('');
      drop.style.display = 'block';
    }

    input.addEventListener('input', () => { clearLink(); showSuggestions(input.value.trim()); });
    input.addEventListener('blur',  () => setTimeout(() => { drop.style.display = 'none'; }, 150));
    drop.addEventListener('mousedown', e => {
      const li = e.target.closest('li');
      if (li) selectProfile(_matches[+li.dataset.idx]);
    });
    input.addEventListener('keydown', e => {
      const items = drop.querySelectorAll('li');
      if (!items.length) return;
      const active = drop.querySelector('li.ac-hi');
      let idx = active ? +active.dataset.idx : -1;
      if (e.key === 'ArrowDown') { e.preventDefault(); idx = Math.min(idx+1, items.length-1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); idx = Math.max(idx-1, 0); }
      else if (e.key === 'Enter' && idx >= 0) { e.preventDefault(); selectProfile(_matches[idx]); return; }
      else if (e.key === 'Escape') { drop.style.display = 'none'; return; }
      items.forEach(li => li.classList.toggle('ac-hi', +li.dataset.idx === idx));
      if (items[idx]) items[idx].style.background = '#21262d';
    });

    input.focus();
  }

  function openModal() {
    modal.style.display = 'flex';
    document.getElementById('modalTeamName').value = '';
    document.getElementById('modalCountryVal').value = '';
    document.getElementById('modalFlagDisplay').textContent = '🌐';
    document.getElementById('modalFlagLabel').textContent = LANG === 'es' ? 'Selecciona...' : 'Select...';
    document.getElementById('modalFlagLabel').style.color = '#8b949e';
    document.getElementById('modalError').style.display = 'none';
    document.getElementById('modalFlagDrop').style.display = 'none';
    document.getElementById('modalMembersList').innerHTML = '';
    addModalMemberRow();
    setTimeout(() => document.getElementById('modalTeamName').focus(), 50);
  }

  document.getElementById('modalMembersList').addEventListener('click', e => {
    if (e.target.closest('.modal-member-remove')) {
      e.target.closest('div').remove();
    }
  });

  document.getElementById('modalAddMember').addEventListener('click', () => addModalMemberRow());
  function closeModal() { modal.style.display = 'none'; }

  document.getElementById('btnNewTeamModal').addEventListener('click', openModal);
  document.getElementById('modalCancel').addEventListener('click', closeModal);
  modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });

  // Modal flag picker
  function renderModalFlags(q = '') {
    const list = document.getElementById('modalFlagList');
    const filtered = q ? COUNTRIES_MODAL.filter(([n]) => n.toLowerCase().includes(q.toLowerCase())) : COUNTRIES_MODAL;
    list.innerHTML = filtered.map(([name, flag]) => {
      const ico = flag === '__SVG__' ? SENYERA_SVG_MODAL : `<span style="font-size:1.1rem">${flag}</span>`;
      return `<li data-name="${name}" data-flag="${flag}"
        style="padding:.35rem .6rem;cursor:pointer;display:flex;align-items:center;gap:.5rem;font-size:.85rem;color:#e6edf3"
        onmouseover="this.style.background='#21262d'" onmouseout="this.style.background=''">
        ${ico}${name}</li>`;
    }).join('');
  }

  document.getElementById('modalFlagBtn').addEventListener('click', () => {
    const drop = document.getElementById('modalFlagDrop');
    const open = drop.style.display !== 'none';
    drop.style.display = open ? 'none' : 'block';
    if (!open) { renderModalFlags(); document.getElementById('modalFlagSearch').value = ''; document.getElementById('modalFlagSearch').focus(); }
  });
  document.getElementById('modalFlagSearch').addEventListener('input', e => renderModalFlags(e.target.value));
  document.getElementById('modalFlagList').addEventListener('mousedown', e => {
    const li = e.target.closest('li');
    if (!li) return;
    const { name, flag } = li.dataset;
    document.getElementById('modalCountryVal').value = `${name}|${flag}`;
    document.getElementById('modalFlagDisplay').innerHTML = flag === '__SVG__' ? SENYERA_SVG_MODAL : '';
    if (flag !== '__SVG__') document.getElementById('modalFlagDisplay').textContent = flag;
    document.getElementById('modalFlagLabel').textContent = name;
    document.getElementById('modalFlagLabel').style.color = '#e6edf3';
    document.getElementById('modalFlagDrop').style.display = 'none';
  });

  // Save new team
  document.getElementById('modalSave').addEventListener('click', async () => {
    const name    = document.getElementById('modalTeamName').value.trim();
    const country = document.getElementById('modalCountryVal').value || null;
    const errEl   = document.getElementById('modalError');
    if (name.length < 2) {
      errEl.textContent = LANG === 'es' ? 'El nombre es obligatorio (mín. 2 caracteres).' : 'Name is required (min 2 chars).';
      errEl.style.display = '';
      return;
    }
    const members = [...document.getElementById('modalMembersList').querySelectorAll('div')]
      .map(row => ({
        name:      (row.querySelector('.modal-member-name')?.value || '').trim(),
        driver_id: parseInt(row.querySelector('.modal-member-driver-id')?.value, 10) || null,
      }))
      .filter(m => m.name);
    if (members.length === 0) {
      errEl.textContent = LANG === 'es' ? 'Añade al menos un piloto.' : 'Add at least one driver.';
      errEl.style.display = '';
      return;
    }

    document.getElementById('modalSave').disabled = true;
    try {
      const res = await fetch('/api/teams-catalog/quick', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, country, members }),
      });
      const data = await res.json();
      if (!data.ok) throw new Error(data.error);

      const ct = data.team;
      const flag = ct.country ? ct.country.split('|')[1] : null;
      const icoHtml = flag === '__SVG__' ? SENYERA : (flag ? `<span style="font-size:1.1rem">${flag}</span>` : '');
      const card = document.createElement('div');
      card.className = 'catalog-card';
      card.draggable = true;
      card.dataset.teamId      = ct.id;
      card.dataset.teamName    = ct.name;
      card.dataset.teamCountry = ct.country || '';
      card.innerHTML = `${icoHtml}<span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${ct.name}</span><span style="font-size:.75rem;color:#8b949e">${ct.members.length}👤</span>`;
      const emptyMsg = document.getElementById('emptyCatalogMsg');
      if (emptyMsg) emptyMsg.remove();
      catalogList.appendChild(card);
      closeModal();
    } catch(err) {
      errEl.textContent = LANG === 'es' ? 'Error al crear el equipo.' : 'Error creating team.';
      errEl.style.display = '';
    } finally {
      document.getElementById('modalSave').disabled = false;
    }
  });
}

updateRestInfo();
</script>

<%- include('../partials/footer') %>
