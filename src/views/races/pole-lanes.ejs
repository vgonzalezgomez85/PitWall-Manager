<%
function formatMs(ms) {
  if (!ms) return '—';
  const m = Math.floor(ms / 60000);
  const s = ((ms % 60000) / 1000).toFixed(3).padStart(6, '0');
  return m > 0 ? m + ':' + s : s + 's';
}
function fmtSeconds3(ms) {
  if (!ms) return '—';
  return (ms / 1000).toFixed(3);
}
const poleHolderName = entries[0]?.entity_name || '';
%>
<%- include('../partials/header', { pageTitle: lang === 'es' ? 'Elección de Carriles' : 'Lane Selection' }) %>

<link href="https://fonts.googleapis.com/css2?family=Saira+Condensed:wght@500;600;700;800&family=Saira:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">

<div class="pole-broadcast">
  <div class="pole-bcast-wrap">

    <!-- ── Cabecera ──────────────────────────────────────────────────── -->
    <a href="/races/<%= race.id %>/pole/results" class="pole-back">← <%= lang === 'es' ? 'Volver a resultados' : 'Back to results' %></a>

    <div class="pole-title-row">
      <div class="pole-flag" aria-hidden="true"></div>
      <h1 class="pole-h1"><%= lang === 'es' ? 'Elección de carril' : 'Lane selection' %></h1>
    </div>

    <div class="pole-meta">
      <span class="pole-meta-club"><%= race.name %></span>
      <span class="pole-dot"></span>
      <span>1c–<%= race.lanes_count %>c</span>
      <span class="pole-dot"></span>
      <span class="pole-lane-badge">
        <%= lang === 'es' ? 'Carriles activos' : 'Active lanes' %>
        <span class="pole-lane-num"><%= activeLanes.length %></span>
      </span>
      <% if (poleHolderName) { %>
        <span class="pole-dot"></span>
        <span class="pole-meta-pole"><%= lang === 'es' ? 'Pole:' : 'Pole:' %> <b><%= poleHolderName %></b></span>
      <% } %>
    </div>

    <p class="pole-lanes-hint">
      <%= lang === 'es'
        ? 'Elige en orden de clasificación. El primero es el poleman.'
        : 'Pick in classification order. The pole sitter picks first.' %>
    </p>

    <!-- ── Indicador del que toca elegir ──────────────────────────────── -->
    <div class="pole-pick-banner" id="pickBanner">
      <span class="pole-pick-banner__lbl"><%= lang === 'es' ? 'Eligiendo ahora' : 'Picking now' %></span>
      <span class="pole-pick-banner__name" id="pickPrompt"><%= poleHolderName %></span>
    </div>

    <!-- ── Grid: orden de elección + tablero de carriles ─────────────── -->
    <div class="pole-lanes-grid">

      <!-- Orden de elección -->
      <section class="pole-bcast-card pole-pickers-card" aria-label="<%= lang === 'es' ? 'Orden de elección' : 'Pick order' %>">
        <div class="pole-bcast-title">
          <span class="pole-bcast-ico">▶</span>
          <%= lang === 'es' ? 'Orden de elección' : 'Pick order' %>
        </div>
        <div class="pole-pickers-list">
          <% entries.forEach((entry, idx) => { %>
            <div class="pole-picker-row" id="picker-<%= idx %>" data-idx="<%= idx %>">
              <span class="pole-picker-pos"><%= idx + 1 %></span>
              <span class="pole-picker-name"><%= entry.entity_name %></span>
              <span class="pole-picker-time"><%= fmtSeconds3(entry.lap_time_ms) %></span>
              <span class="pole-picker-lane" id="picked-<%= idx %>"></span>
            </div>
          <% }) %>
        </div>
      </section>

      <!-- Tablero de carriles -->
      <section class="pole-bcast-card pole-laneboard" aria-label="<%= lang === 'es' ? 'Carriles disponibles' : 'Available lanes' %>">
        <div class="pole-bcast-title">
          <span class="pole-bcast-ico">🚦</span>
          <%= lang === 'es' ? 'Carriles disponibles' : 'Available lanes' %>
        </div>
        <div class="pole-laneboard-grid" id="laneGrid">
          <% activeLanes.forEach(lane => { %>
            <button type="button"
                    class="pole-laneboard-btn"
                    id="lane-btn-<%= lane %>"
                    data-lane="<%= lane %>"
                    style="--lane-color: <%= LANE_COLORS[lane - 1] %>">
              <span class="pole-laneboard-num"><%= lane %></span>
              <span class="pole-laneboard-owner" id="lane-owner-<%= lane %>"></span>
            </button>
          <% }) %>
        </div>
      </section>

    </div>

    <% if (entries.length > activeLanes.length) { %>
      <p class="pole-rest-note">
        ℹ️ <%= lang === 'es'
          ? `Los últimos ${entries.length - activeLanes.length} participante(s) descansarán en la manga 1 y entrarán en rotación en las siguientes.`
          : `The last ${entries.length - activeLanes.length} participant(s) will rest in heat 1 and rotate in from heat 2.` %>
      </p>
    <% } %>

    <!-- ── Form de submit (oculto hasta que todos elijan) ─────────────── -->
    <form id="laneForm" action="/races/<%= race.id %>/pole/lanes" method="POST" class="pole-lanes-form">
      <div id="hiddenInputs"></div>
      <div id="formActions" class="pole-lanes-actions" style="display:none">
        <a href="/races/<%= race.id %>/pole/results" class="pole-btn-edit">← <%= lang === 'es' ? 'Volver' : 'Back' %></a>
        <button type="submit" class="pole-btn-confirm">
          🏁 <%= lang === 'es' ? 'Crear Primera Tanda' : 'Create First Heat Group' %>
        </button>
      </div>
    </form>

    <div class="pole-bcast-foot">
      <%= lang === 'es' ? 'SI POLE · elección de carril en orden de clasificación' : 'Pole order lane selection' %>
    </div>

  </div>
</div>

<script>
const LANG          = "<%= lang %>";
const ACTIVE_LANES  = <%- JSON.stringify(activeLanes) %>;
const LANE_COLORS   = <%- JSON.stringify(LANE_COLORS) %>;
const ENTRIES       = <%- JSON.stringify(entries.map(e => ({ name: e.entity_name }))) %>;
const TOTAL_PICKERS = Math.min(ENTRIES.length, ACTIVE_LANES.length);

let currentPicker = 0;
const laneOrder = Array(ACTIVE_LANES.length).fill(null);

function pickerName(idx) { return ENTRIES[idx]?.name || ''; }

function updatePrompt() {
  const el = document.getElementById('pickPrompt');
  const banner = document.getElementById('pickBanner');
  if (currentPicker >= TOTAL_PICKERS) {
    el.textContent = LANG === 'es' ? '✓ Todos han elegido' : '✓ All lanes assigned';
    banner.classList.add('pole-pick-banner--done');
    return;
  }
  el.textContent = pickerName(currentPicker);
}

function highlightCurrentPicker() {
  document.querySelectorAll('.pole-picker-row').forEach((row, i) => {
    row.classList.toggle('pole-picker-row--active', i === currentPicker);
    row.classList.toggle('pole-picker-row--done',   i < currentPicker);
  });
}

function pickLane(lane) {
  if (currentPicker >= TOTAL_PICKERS) return;
  const seqIdx = ACTIVE_LANES.indexOf(lane);
  if (seqIdx < 0 || laneOrder[seqIdx] !== null) return;

  const name = pickerName(currentPicker);
  laneOrder[seqIdx] = name;

  const btn = document.getElementById('lane-btn-' + lane);
  if (btn) {
    btn.classList.add('pole-laneboard-btn--taken');
    btn.disabled = true;
    document.getElementById('lane-owner-' + lane).textContent = name;
  }

  const picked = document.getElementById('picked-' + currentPicker);
  if (picked) {
    picked.innerHTML = `<span class="pole-picker-lane-chip" style="background:${LANE_COLORS[lane-1]}">${lane}</span>`;
  }

  currentPicker++;
  updatePrompt();
  highlightCurrentPicker();

  if (currentPicker >= TOTAL_PICKERS) {
    buildForm();
    document.getElementById('formActions').style.display = '';
  }
}

function buildForm() {
  const wrap = document.getElementById('hiddenInputs');
  wrap.innerHTML = '';
  laneOrder.forEach((name, i) => {
    if (name) {
      const inp = document.createElement('input');
      inp.type = 'hidden'; inp.name = 'order[]'; inp.value = name;
      wrap.appendChild(inp);
    }
  });
  ENTRIES.slice(TOTAL_PICKERS).forEach(e => {
    const inp = document.createElement('input');
    inp.type = 'hidden'; inp.name = 'order[]'; inp.value = e.name;
    wrap.appendChild(inp);
  });
}

document.getElementById('laneGrid').addEventListener('click', e => {
  const btn = e.target.closest('.pole-laneboard-btn');
  if (btn && !btn.disabled) pickLane(parseInt(btn.dataset.lane, 10));
});

highlightCurrentPicker();
updatePrompt();
</script>

<%- include('../partials/footer') %>
