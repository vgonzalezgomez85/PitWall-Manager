<%
function formatMs(ms) {
  if (!ms) return '—';
  const m = Math.floor(ms / 60000);
  const s = ((ms % 60000) / 1000).toFixed(3).padStart(6, '0');
  return m > 0 ? m + ':' + s : s + 's';
}
function fmtSeconds3(ms) {
  if (!ms) return '—';
  return (ms / 1000).toFixed(3);
}
const poleHolderName = entries[0]?.entity_name || '';
%>
<%- include('../partials/header', { pageTitle: lang === 'es' ? 'Elección de Carriles' : 'Lane Selection' }) %>

<link href="https://fonts.googleapis.com/css2?family=Saira+Condensed:wght@500;600;700;800&family=Saira:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">

<div class="pole-broadcast">
  <div class="pole-bcast-wrap">

    <!-- ── Cabecera ──────────────────────────────────────────────────── -->
    <a href="/races/<%= race.id %>/pole/results" class="pole-back">← <%= lang === 'es' ? 'Volver a resultados' : 'Back to results' %></a>

    <div class="pole-title-row">
      <div class="pole-flag" aria-hidden="true"></div>
      <h1 class="pole-h1"><%= lang === 'es' ? 'Elección de carril' : 'Lane selection' %></h1>
    </div>

    <div class="pole-meta">
      <span class="pole-meta-club"><%= race.name %></span>
      <span class="pole-dot"></span>
      <span>1c–<%= race.lanes_count %>c</span>
      <span class="pole-dot"></span>
      <span class="pole-lane-badge">
        <%= lang === 'es' ? 'Carriles activos' : 'Active lanes' %>
        <span class="pole-lane-num"><%= activeLanes.length %></span>
      </span>
      <% if (poleHolderName) { %>
        <span class="pole-dot"></span>
        <span class="pole-meta-pole"><%= lang === 'es' ? 'Pole:' : 'Pole:' %> <b><%= poleHolderName %></b></span>
      <% } %>
    </div>

    <p class="pole-lanes-hint">
      <%= lang === 'es'
        ? 'Elige en orden de clasificación. El primero es el poleman.'
        : 'Pick in classification order. The pole sitter picks first.' %>
    </p>

    <!-- ── Nº de tandas ───────────────────────────────────────────────── -->
    <div class="pole-tandas-ctrl">
      <label for="numTandas"><%= lang === 'es' ? 'Nº de tandas' : 'Number of heat groups' %></label>
      <input type="number" id="numTandas" min="1" max="<%= entries.length %>" value="1" inputmode="numeric">
      <span class="pole-tandas-hint">
        <%= lang === 'es'
          ? 'Con 1 tanda, se eligen carriles por orden de pole. Con más, reparte los clasificados en tandas (de tamaño libre) y en cada una los carriles van por orden de pole.'
          : 'With 1 group, lanes are picked in pole order. With more, split the field into groups (any size); each group gets lanes in pole order.' %>
      </span>
    </div>

    <!-- ── Reparto en tandas (solo con Nº de tandas > 1) ──────────────── -->
    <div class="pole-tandas-panel" id="tandasPanel" hidden>
      <p class="pole-lanes-hint">
        <%= lang === 'es'
          ? 'Mueve cada clasificado a su tanda con ◀ ▶. El reparto inicial sigue el orden de pole; las tandas pueden ser de distinto tamaño.'
          : 'Move each entrant to its group with ◀ ▶. The initial split follows pole order; groups may differ in size.' %>
      </p>
      <div class="pole-tandas-cols" id="tandasCols"></div>
    </div>

    <!-- ── Bloque clásico (1 tanda): banner + tablero de carriles ─────── -->
    <div id="classicPick">
    <!-- ── Indicador del que toca elegir ──────────────────────────────── -->
    <div class="pole-pick-banner" id="pickBanner">
      <span class="pole-pick-banner__lbl"><%= lang === 'es' ? 'Eligiendo ahora' : 'Picking now' %></span>
      <span class="pole-pick-banner__name" id="pickPrompt"><%= poleHolderName %></span>
    </div>

    <!-- ── Grid: orden de elección + tablero de carriles ─────────────── -->
    <div class="pole-lanes-grid">

      <!-- Orden de elección -->
      <section class="pole-bcast-card pole-pickers-card" aria-label="<%= lang === 'es' ? 'Orden de elección' : 'Pick order' %>">
        <div class="pole-bcast-title">
          <span class="pole-bcast-ico">▶</span>
          <%= lang === 'es' ? 'Orden de elección' : 'Pick order' %>
        </div>
        <div class="pole-pickers-list">
          <% entries.forEach((entry, idx) => { %>
            <div class="pole-picker-row" id="picker-<%= idx %>" data-idx="<%= idx %>">
              <span class="pole-picker-pos"><%= idx + 1 %></span>
              <span class="pole-picker-name"><%= entry.entity_name %></span>
              <span class="pole-picker-time"><%= fmtSeconds3(entry.lap_time_ms) %></span>
              <span class="pole-picker-lane" id="picked-<%= idx %>"></span>
            </div>
          <% }) %>
        </div>
      </section>

      <!-- Tablero de carriles -->
      <section class="pole-bcast-card pole-laneboard" aria-label="<%= lang === 'es' ? 'Carriles disponibles' : 'Available lanes' %>">
        <div class="pole-bcast-title">
          <span class="pole-bcast-ico">🚦</span>
          <%= lang === 'es' ? 'Carriles disponibles' : 'Available lanes' %>
        </div>
        <div class="pole-laneboard-grid" id="laneGrid">
          <% activeLanes.forEach(lane => { %>
            <button type="button"
                    class="pole-laneboard-btn"
                    id="lane-btn-<%= lane %>"
                    data-lane="<%= lane %>"
                    style="--lane-color: <%= LANE_COLORS[lane - 1] %>">
              <span class="pole-laneboard-num"><%= lane %></span>
              <span class="pole-laneboard-owner" id="lane-owner-<%= lane %>"></span>
            </button>
          <% }) %>
          <%# Descansos seleccionables: uno por cada equipo que sobra de los carriles %>
          <% const restCount = Math.max(0, entries.length - activeLanes.length); %>
          <% for (let r = 0; r < restCount; r++) { %>
            <button type="button"
                    class="pole-laneboard-btn pole-laneboard-btn--rest"
                    id="rest-btn-<%= r %>"
                    data-rest="<%= r %>">
              <span class="pole-laneboard-num">💤</span>
              <span class="pole-laneboard-owner" id="rest-owner-<%= r %>"><%= lang === 'es' ? 'Descanso' : 'Rest' %></span>
            </button>
          <% } %>
        </div>
      </section>

    </div>

    <% if (entries.length > activeLanes.length) { %>
      <p class="pole-rest-note">
        ℹ️ <%= lang === 'es'
          ? `Hay ${entries.length - activeLanes.length} plaza(s) de descanso (💤): cada equipo, en su turno, elige carril o descanso. Quien elija descanso no corre la manga 1 y entra en rotación desde la 2.`
          : `There are ${entries.length - activeLanes.length} rest slot(s) (💤): each team picks a lane or rest on their turn. Resting teams skip heat 1 and rotate in from heat 2.` %>
      </p>
    <% } %>
    </div><!-- /#classicPick -->

    <!-- ── Form de submit ─────────────────────────────────────────────── -->
    <form id="laneForm" action="/races/<%= race.id %>/pole/lanes" method="POST" class="pole-lanes-form">
      <div id="hiddenInputs"></div>
      <div id="formActions" class="pole-lanes-actions" style="display:none">
        <a href="/races/<%= race.id %>/pole/results" class="pole-btn-edit">← <%= lang === 'es' ? 'Volver' : 'Back' %></a>
        <button type="submit" class="pole-btn-confirm" id="confirmBtn">
          🏁 <span id="confirmLbl"><%= lang === 'es' ? 'Crear Primera Tanda' : 'Create First Heat Group' %></span>
        </button>
      </div>
    </form>

    <div class="pole-bcast-foot">
      <%= lang === 'es' ? 'SI POLE · elección de carril en orden de clasificación' : 'Pole order lane selection' %>
    </div>

  </div>
</div>

<script>
const LANG          = "<%= lang %>";
const ACTIVE_LANES  = <%- JSON.stringify(activeLanes) %>;
const LANE_COLORS   = <%- JSON.stringify(LANE_COLORS) %>;
const ENTRIES       = <%- JSON.stringify(entries.map(e => ({ name: e.entity_name }))) %>;
// Eligen TODOS: los carriles (ACTIVE_LANES) + los descansos (el resto).
const TOTAL_PICKERS = ENTRIES.length;

let currentPicker = 0;
const laneOrder = Array(ACTIVE_LANES.length).fill(null);
const restOrder = [];   // equipos que han elegido descanso, en orden de elección

function pickerName(idx) { return ENTRIES[idx]?.name || ''; }

function updatePrompt() {
  const el = document.getElementById('pickPrompt');
  const banner = document.getElementById('pickBanner');
  if (currentPicker >= TOTAL_PICKERS) {
    el.textContent = LANG === 'es' ? '✓ Todos han elegido' : '✓ All lanes assigned';
    banner.classList.add('pole-pick-banner--done');
    return;
  }
  el.textContent = pickerName(currentPicker);
}

function highlightCurrentPicker() {
  document.querySelectorAll('.pole-picker-row').forEach((row, i) => {
    row.classList.toggle('pole-picker-row--active', i === currentPicker);
    row.classList.toggle('pole-picker-row--done',   i < currentPicker);
  });
}

function pickLane(lane) {
  if (currentPicker >= TOTAL_PICKERS) return;
  const seqIdx = ACTIVE_LANES.indexOf(lane);
  if (seqIdx < 0 || laneOrder[seqIdx] !== null) return;

  const name = pickerName(currentPicker);
  laneOrder[seqIdx] = name;

  const btn = document.getElementById('lane-btn-' + lane);
  if (btn) {
    btn.classList.add('pole-laneboard-btn--taken');
    btn.disabled = true;
    document.getElementById('lane-owner-' + lane).textContent = name;
  }

  const picked = document.getElementById('picked-' + currentPicker);
  if (picked) {
    picked.innerHTML = `<span class="pole-picker-lane-chip" style="background:${LANE_COLORS[lane-1]}">${lane}</span>`;
  }

  advancePicker();
}

// Elegir DESCANSO (slot equivalente a un carril, pero sin carril → is_rest).
function pickRest(restIdx) {
  if (currentPicker >= TOTAL_PICKERS) return;
  const name = pickerName(currentPicker);
  restOrder.push(name);

  const btn = document.getElementById('rest-btn-' + restIdx);
  if (btn) {
    btn.classList.add('pole-laneboard-btn--taken');
    btn.disabled = true;
    document.getElementById('rest-owner-' + restIdx).textContent = name;
  }

  const picked = document.getElementById('picked-' + currentPicker);
  if (picked) {
    picked.innerHTML = `<span class="pole-picker-lane--rest">💤 ${LANG === 'es' ? 'Descanso' : 'Rest'}</span>`;
  }

  advancePicker();
}

function advancePicker() {
  currentPicker++;
  updatePrompt();
  highlightCurrentPicker();
  if (currentPicker >= TOTAL_PICKERS) {
    buildForm();
    document.getElementById('formActions').style.display = '';
  }
}

function buildForm() {
  const wrap = document.getElementById('hiddenInputs');
  wrap.innerHTML = '';
  // Primero los equipos con carril (en orden de carril), luego los de descanso.
  laneOrder.forEach(name => {
    if (name) {
      const inp = document.createElement('input');
      inp.type = 'hidden'; inp.name = 'order[]'; inp.value = name;
      wrap.appendChild(inp);
    }
  });
  restOrder.forEach(name => {
    const inp = document.createElement('input');
    inp.type = 'hidden'; inp.name = 'order[]'; inp.value = name;
    wrap.appendChild(inp);
  });
}

document.getElementById('laneGrid').addEventListener('click', e => {
  const btn = e.target.closest('.pole-laneboard-btn');
  if (!btn || btn.disabled) return;
  if (btn.dataset.rest != null) pickRest(parseInt(btn.dataset.rest, 10));
  else                          pickLane(parseInt(btn.dataset.lane, 10));
});

highlightCurrentPicker();
updatePrompt();

// ── Multi-tanda ─────────────────────────────────────────────────────────────
// Con Nº de tandas > 1 se oculta el tablero por-persona (los carriles van por
// orden de pole en cada tanda) y se reparte el campo en columnas. `tandaByName`
// guarda la tanda (1..N) de cada clasificado; el reparto inicial es contiguo por
// orden de pole y lo más parejo posible, pero se puede desequilibrar con ◀ ▶.
const numTandasInput = document.getElementById('numTandas');
const classicPick    = document.getElementById('classicPick');
const tandasPanel     = document.getElementById('tandasPanel');
const tandasCols      = document.getElementById('tandasCols');
const formActions     = document.getElementById('formActions');
const confirmLbl      = document.getElementById('confirmLbl');
const hiddenInputs    = document.getElementById('hiddenInputs');
const LBL_CREATE_1    = <%- JSON.stringify(lang === 'es' ? 'Crear Primera Tanda' : 'Create First Heat Group') %>;
const LBL_CREATE_N    = <%- JSON.stringify(lang === 'es' ? 'Crear las tandas' : 'Create the groups') %>;

let tandaByName = {};   // nombre → nº de tanda (1..N)

function splitContiguous(n) {
  // Reparto contiguo por orden de pole, lo más parejo posible.
  const total = ENTRIES.length;
  const base = Math.floor(total / n), extra = total % n;
  const map = {}; let idx = 0;
  for (let t = 1; t <= n; t++) {
    const size = base + (t <= extra ? 1 : 0);
    for (let k = 0; k < size; k++) map[ENTRIES[idx++].name] = t;
  }
  return map;
}

function renderTandas(n) {
  tandasCols.innerHTML = '';
  const cols = [];
  for (let t = 1; t <= n; t++) {
    const col = document.createElement('div');
    col.className = 'pole-tanda-col';
    col.innerHTML = `<div class="pole-tanda-col__hd">${LANG === 'es' ? 'Tanda' : 'Group'} ${t}
      <span class="pole-tanda-col__count" id="tcount-${t}"></span></div>`;
    tandasCols.appendChild(col);
    cols[t] = col;
  }
  // Chips en orden de pole dentro de cada tanda.
  ENTRIES.forEach((e, i) => {
    const t = tandaByName[e.name] || 1;
    const chip = document.createElement('div');
    chip.className = 'pole-tanda-chip';
    chip.innerHTML =
      `<button type="button" class="pole-tanda-move" data-name="${encodeURIComponent(e.name)}" data-dir="-1"${t <= 1 ? ' disabled' : ''}>◀</button>` +
      `<span class="pole-tanda-chip__pos">P${i + 1}</span>` +
      `<span class="pole-tanda-chip__name">${e.name}</span>` +
      `<button type="button" class="pole-tanda-move" data-name="${encodeURIComponent(e.name)}" data-dir="1"${t >= n ? ' disabled' : ''}>▶</button>`;
    cols[t].appendChild(chip);
  });
  for (let t = 1; t <= n; t++) {
    const c = cols[t].querySelectorAll('.pole-tanda-chip').length;
    document.getElementById('tcount-' + t).textContent = c;
  }
}

tandasCols.addEventListener('click', e => {
  const btn = e.target.closest('.pole-tanda-move');
  if (!btn) return;
  const name = decodeURIComponent(btn.dataset.name);
  const dir  = parseInt(btn.dataset.dir, 10);
  const n    = parseInt(numTandasInput.value, 10) || 1;
  const cur  = tandaByName[name] || 1;
  const next = Math.min(n, Math.max(1, cur + dir));
  if (next === cur) return;
  tandaByName[name] = next;
  renderTandas(n);
});

function buildMultiForm(n) {
  hiddenInputs.innerHTML = '';
  const addHidden = (name, value) => {
    const inp = document.createElement('input');
    inp.type = 'hidden'; inp.name = name; inp.value = value;
    hiddenInputs.appendChild(inp);
  };
  addHidden('num_tandas', String(n));
  ENTRIES.forEach(e => addHidden('tanda_of[' + e.name + ']', String(tandaByName[e.name] || 1)));
}

function onNumTandasChange() {
  let n = parseInt(numTandasInput.value, 10) || 1;
  n = Math.min(ENTRIES.length, Math.max(1, n));
  numTandasInput.value = n;

  if (n <= 1) {
    // Modo clásico: tablero por persona; el submit lo destapa buildForm().
    classicPick.hidden = false;
    tandasPanel.hidden = true;
    confirmLbl.textContent = LBL_CREATE_1;
    hiddenInputs.innerHTML = '';
    // El botón vuelve a depender de que todos hayan elegido carril.
    formActions.style.display = (currentPicker >= TOTAL_PICKERS) ? '' : 'none';
    if (currentPicker >= TOTAL_PICKERS) buildForm();
    return;
  }

  // Modo multi: se reparte por pole y los carriles van por orden de pole.
  classicPick.hidden = true;
  tandasPanel.hidden = false;
  confirmLbl.textContent = LBL_CREATE_N;
  tandaByName = splitContiguous(n);
  renderTandas(n);
  formActions.style.display = '';
}

numTandasInput.addEventListener('input', onNumTandasChange);

// Deep-link: ?tandas=N pre-selecciona el nº de tandas (útil para volver a un
// reparto ya pensado sin re-teclear).
const _qTandas = parseInt(new URLSearchParams(location.search).get('tandas'), 10);
if (_qTandas > 1) { numTandasInput.value = Math.min(ENTRIES.length, _qTandas); onNumTandasChange(); }

// El submit del modo multi arma sus inputs justo antes de enviar (el clásico ya
// los tiene puestos por buildForm()).
document.getElementById('laneForm').addEventListener('submit', () => {
  const n = parseInt(numTandasInput.value, 10) || 1;
  if (n > 1) buildMultiForm(n);
});
</script>

<%- include('../partials/footer') %>
