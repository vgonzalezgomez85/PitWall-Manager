<%
  const _hasPole = typeof hasPole !== 'undefined' ? !!hasPole : false;
  const _skipSeq = typeof skipSequence !== 'undefined' && !!skipSequence;
  const _all = [
    { key: 'type',         show: true },
    { key: 'sequence',     show: !_skipSeq },
    { key: 'participants', show: _hasPole },
    { key: 'confirm',      show: _hasPole || !_skipSeq },
    { key: 'tanda',        show: !_hasPole },
  ];
  const _visible = _all.filter(s => s.show).map(s => s.key);
  const _curIdx = _visible.indexOf(current);
%>
<ol class="nr-steps" id="nrSteps" data-current="<%= current %>">
  <% _all.forEach(s => {
       const i = _visible.indexOf(s.key);
       const state = i < 0 ? '' : (i < _curIdx ? 'is-done' : (i === _curIdx ? 'is-active' : '')); %>
    <li class="nr-step <%= state %>" data-step="<%= s.key %>" <%= s.show ? '' : 'hidden' %>>
      <span class="nr-step__n"><%= i >= 0 && i < _curIdx ? '✓' : (i + 1) %></span><%= t('wizard.steps.' + s.key) %>
    </li>
  <% }) %>
</ol>
