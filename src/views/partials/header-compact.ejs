<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' — ' : '' %>PitWall</title>
  <link rel="icon" type="image/svg+xml" href="/img/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32"  href="/img/favicon-32.png">
  <link rel="icon" type="image/png" sizes="256x256" href="/img/favicon-256.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Rajdhani:wght@500;600;700&family=Barlow+Condensed:wght@300;400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar navbar--slim">
    <a href="/" class="brand">
      <img src="/img/pitwall-logo.svg" alt="PitWall" class="brand-logo">
    </a>
  </nav>
  <% if (typeof flash !== 'undefined' && flash) { %>
    <div class="flash flash--<%= flash.type %>"><%- flash.text %></div>
  <% } %>
  <main class="main-content">
