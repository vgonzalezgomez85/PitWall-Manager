<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' — ' : '' %>Voltrace Manager</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <a href="/" class="brand">
      <svg class="brand-flag" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="2" y="2" width="5" height="5" fill="white"/>
        <rect x="7" y="2" width="5" height="5" fill="black"/>
        <rect x="2" y="7" width="5" height="5" fill="black"/>
        <rect x="7" y="7" width="5" height="5" fill="white"/>
        <rect x="2" y="12" width="5" height="5" fill="white"/>
        <rect x="7" y="12" width="5" height="5" fill="black"/>
        <line x1="14" y1="2" x2="14" y2="22" stroke="white" stroke-width="2"/>
      </svg>
      <span class="brand-name">Voltrace Manager</span>
    </a>
    <div class="nav-links">
      <a href="/races" class="nav-link">🚦 <%= t('nav.races') %></a>
      <% if (tier === 'pro') { %>
        <a href="/drivers" class="nav-link">👥 <%= lang === 'es' ? 'Pilotos' : 'Drivers' %></a>
        <a href="/teams" class="nav-link">🤝 <%= lang === 'es' ? 'Equipos' : 'Teams' %></a>
      <% } %>
      <a href="/circuits" class="nav-link" style="display:inline-flex;align-items:center;gap:.35rem">
        <svg viewBox="0 0 64 40" width="22" height="14" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0">
          <rect x="2" y="2" width="60" height="36" rx="10" ry="10" stroke="currentColor" stroke-width="3" fill="none"/>
          <rect x="10" y="10" width="44" height="20" rx="6" ry="6" stroke="currentColor" stroke-width="2.5" fill="none"/>
          <line x1="10" y1="20" x2="16" y2="14" stroke="#f6c90e" stroke-width="2" stroke-linecap="round"/>
          <line x1="16" y1="14" x2="22" y2="20" stroke="#f6c90e" stroke-width="2" stroke-linecap="round"/>
          <line x1="32" y1="2" x2="32" y2="10" stroke="#e63946" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
        <%= lang === 'es' ? 'Circuitos' : 'Circuits' %>
      </a>
      <a href="/training" class="nav-link">⏱️ <%= lang === 'es' ? 'Entrenamiento' : 'Training' %></a>
      <a href="/settings" class="nav-link">⚙️ <%= lang === 'es' ? 'Ajustes' : 'Settings' %></a>
      <a href="/races/new" class="nav-link nav-link--cta"><%= t('nav.new_race') %></a>
    </div>
    <div class="lang-switcher">
      <% if (typeof tier !== 'undefined') { %>
        <a href="/license" class="tier-badge tier--<%= tier %>" style="text-decoration:none;margin-right:.5rem"><%= tier.toUpperCase() %></a>
      <% } %>
      <a href="?lang=es" class="lang-btn <%= lang === 'es' ? 'active' : '' %>">ES</a>
      <a href="?lang=en" class="lang-btn <%= lang === 'en' ? 'active' : '' %>">EN</a>
    </div>
  </nav>
  <% if (typeof flash !== 'undefined' && flash) { %>
    <div class="flash flash--<%= flash.type %>"><%- flash.text %></div>
  <% } %>
  <main class="main-content">
