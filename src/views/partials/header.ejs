<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
<%- include('i18n-client') %>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' — ' : '' %>PitWall</title>
  <link rel="icon" type="image/svg+xml" href="/img/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32"  href="/img/favicon-32.png">
  <link rel="icon" type="image/png" sizes="256x256" href="/img/favicon-256.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png">
  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="stylesheet" href="/css/style.css">
  <script>try { if (localStorage.getItem('pw-text') === 'big') document.documentElement.classList.add('pw-big'); } catch (e) {}</script>
</head>
<body>
  <% if (typeof hideNavbar === 'undefined' || !hideNavbar) { %>
  <nav class="navbar navbar--slim navbar--brand">
    <a href="/" class="vh-brand vh-brand--nav" aria-label="PitWall">
      <svg class="vh-mark" viewBox="0 0 100 100" aria-hidden="true">
        <rect x="6" y="6" width="88" height="88" rx="22" ry="22" fill="none" stroke="currentColor" stroke-width="6.5"/>
        <polyline points="30,34 51,50 30,66" fill="none" stroke="currentColor" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>
        <rect x="56" y="58" width="17" height="11" rx="3" fill="#F0404C"/>
      </svg>
      <span class="vh-wordmark">
        <span class="vh-nm">PIT<span class="vh-nm-t">W</span>ALL</span>
        
      </span>
    </a>
    <div class="pw-textsize" role="group" aria-label="<%= t('header.tamano_de_letra') %>">
      <span class="pw-textsize__lbl"><%= t('header.tamano_de_letra') %></span>
      <button type="button" class="pw-textsize__btn" data-size="normal" aria-label="<%= t('header.letra_normal') %>">A</button>
      <button type="button" class="pw-textsize__btn pw-textsize__btn--big" data-size="big" aria-label="<%= t('header.letra_grande') %>">A+</button>
    </div>
    <script>
      (function () {
        var btns = document.querySelectorAll('.pw-textsize__btn');
        function paint() {
          var big = document.documentElement.classList.contains('pw-big');
          btns.forEach(function (b) { b.setAttribute('aria-pressed', String((b.dataset.size === 'big') === big)); });
        }
        btns.forEach(function (b) {
          b.addEventListener('click', function () {
            var big = b.dataset.size === 'big';
            document.documentElement.classList.toggle('pw-big', big);
            try { localStorage.setItem('pw-text', big ? 'big' : 'normal'); } catch (e) {}
            paint();
          });
        });
        paint();
      })();
    </script>
  </nav>
  <% } %>
  <% if (typeof flash !== 'undefined' && flash) { %>
    <div class="flash flash--<%= flash.type %>"><%- flash.text %></div>
  <% } %>
  <main class="main-content">
