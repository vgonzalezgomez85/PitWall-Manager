<%- include('../partials/header', { pageTitle: (lang === 'es' ? 'Gestión de base de datos' : 'Database management') }) %>
<%
  function humanSize(bytes) {
    if (bytes == null) return '—';
    if (bytes < 1024) return bytes + ' B';
    const u = ['KB','MB','GB'];
    let n = bytes / 1024, i = 0;
    while (n >= 1024 && i < u.length - 1) { n /= 1024; i++; }
    return n.toFixed(n < 10 ? 1 : 0) + ' ' + u[i];
  }
%>
<div class="container container--narrow">

  <a class="vt-back-link" href="/">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    <%= lang === 'es' ? 'Volver al inicio' : 'Back to home' %>
  </a>

  <h1 class="page-title"><%= lang === 'es' ? 'Gestión de base de datos' : 'Database management' %></h1>

  <% if (flash) { %>
    <div class="flash flash--<%= flash.type %>" style="margin-bottom:1rem"><%- flash.text %></div>
  <% } %>

  <!-- Estado actual de la BD -->
  <div class="form-card" style="margin-bottom:1rem">
    <div style="display:flex;align-items:center;gap:.6rem;flex-wrap:wrap">
      <span class="form-hint"><%= lang === 'es' ? 'Tamaño actual:' : 'Current size:' %></span>
      <strong style="color:#58a6ff"><%= humanSize(sizeBytes) %></strong>
    </div>
    <% if (dbPath) { %>
      <p class="form-hint" style="margin-top:.4rem;word-break:break-all;opacity:.7"><%= dbPath %></p>
    <% } %>
  </div>

  <!-- Copia de seguridad -->
  <div class="form-card" style="margin-bottom:1rem">
    <div class="form-label" style="font-size:1.05rem;margin-bottom:.35rem">
      💾 <%= lang === 'es' ? 'Copia de seguridad' : 'Backup' %>
    </div>
    <p class="form-hint" style="margin:0 0 1rem">
      <%= lang === 'es'
        ? 'Descarga un archivo .db con todos los datos (carreras, equipos, pilotos, circuitos y ajustes). Guárdalo para trasladarlo a otro PC o como respaldo. Es seguro hacerlo aunque haya una carrera en curso.'
        : 'Download a .db file with all your data (races, teams, drivers, circuits and settings). Keep it to move to another PC or as a backup. Safe to run even during a race.' %>
    </p>
    <a href="/database/backup" class="btn btn--primary">
      ⬇ <%= lang === 'es' ? 'Descargar copia de seguridad' : 'Download backup' %>
    </a>
  </div>

  <!-- Importar copia -->
  <div class="form-card">
    <div class="form-label" style="font-size:1.05rem;margin-bottom:.35rem">
      ⬆ <%= lang === 'es' ? 'Importar copia' : 'Import backup' %>
    </div>

    <% if (pendingRestore) { %>
      <div class="flash flash--info" style="margin-bottom:1rem">
        <%= lang === 'es'
          ? `Hay una copia pendiente de aplicar (${humanSize(pendingRestore.sizeBytes)}, subida el ${pendingRestore.uploadedAt.toLocaleString('es-ES')}). Se aplicará al cerrar PitWall por completo y volver a abrirlo, sustituyendo TODOS los datos actuales.`
          : `A pending import is waiting to be applied (${humanSize(pendingRestore.sizeBytes)}, uploaded ${pendingRestore.uploadedAt.toLocaleString('en-US')}). It will be applied the next time you fully close and reopen PitWall, replacing ALL current data.` %>
      </div>
      <form action="/database/restore/cancel" method="POST" style="margin-bottom:1rem"
            onsubmit="return confirm('<%= lang === 'es' ? '¿Cancelar la importación pendiente? No se aplicará.' : 'Cancel the pending import? It will not be applied.' %>')">
        <button type="submit" class="btn btn--ghost"><%= lang === 'es' ? 'Cancelar importación pendiente' : 'Cancel pending import' %></button>
      </form>
    <% } %>

    <p class="form-hint" style="margin:0 0 1rem">
      <%= lang === 'es'
        ? 'Sube un archivo .db (de "Descargar copia de seguridad", de esta u otra instalación de PitWall) para restaurar todos los datos en este PC. No se aplica al momento: hace falta cerrar PitWall por completo y volver a abrirlo. Antes de aplicarla se guarda automáticamente una copia de los datos actuales, por si hace falta deshacer.'
        : 'Upload a .db file (from "Download backup", from this or another PitWall install) to restore all data on this PC. It does not apply instantly: you need to fully close PitWall and reopen it. The current data is backed up automatically before applying it, in case you need to undo it.' %>
    </p>
    <form action="/database/restore" method="POST" enctype="multipart/form-data" style="display:flex;gap:.6rem;align-items:center;flex-wrap:wrap">
      <input type="file" name="backup_file" accept=".db" required class="form-input" style="flex:1;min-width:220px">
      <button type="submit" class="btn btn--primary"
              onclick="return confirm('<%= lang === 'es' ? 'Esto reemplazará TODOS los datos actuales la próxima vez que abras PitWall. ¿Continuar?' : 'This will replace ALL current data the next time you open PitWall. Continue?' %>')">
        ⬆ <%= lang === 'es' ? 'Subir copia' : 'Upload backup' %>
      </button>
    </form>
  </div>

</div>

<%- include('../partials/footer') %>
