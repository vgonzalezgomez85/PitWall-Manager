<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#000000">
  <title><%= team.name %> — PitWall Lap</title>
  <link rel="stylesheet" href="/css/lap.css">
</head>
<body>
  <div class="wrap">
    <div class="toprow">
      <div class="brand"><span class="dot"></span> PitWall <small>Lap</small></div>
      <a href="/lap/<%= race.id %>">Cambiar equipo</a>
    </div>

    <div class="teamhead">
      <span class="swatch" style="background:<%= team.color || '#8b949e' %>"></span>
      <h1><%= team.name %></h1>
    </div>
    <div class="status">
      <span class="led" id="led"></span>
      <span id="statusText"><%= race.name %></span>
    </div>

    <div class="audiobar">
      <button id="audioToggle" class="audiobtn" type="button" aria-pressed="false">🔇 Cantar vueltas</button>
      <select id="audioMode" class="audiomode" title="Qué cantar">
        <option value="time" selected>Tiempo</option>
        <option value="number">Nº de vuelta</option>
        <option value="both">Ambos</option>
      </select>
    </div>
    <div class="sung" id="lastSung"></div>

    <div class="hero">
      <div class="pos"><span id="pos">—</span><small id="posOf"></small></div>
      <div class="heroSub" id="gapLeader">—</div>
    </div>

    <div class="grid">
      <div class="stat" id="cardLast"><div class="k">Última vuelta</div><div class="v" id="lastLap">—</div></div>
      <div class="stat"><div class="k">Mejor vuelta</div><div class="v" id="bestLap">—</div></div>
      <div class="stat"><div class="k">Vueltas</div><div class="v" id="laps">—</div></div>
      <div class="stat"><div class="k">Media carrera</div><div class="v" id="avgLap">—</div></div>
      <div class="stat"><div class="k">Pit stops</div><div class="v" id="pits">—</div></div>
      <div class="stat"><div class="k">Gap al líder</div><div class="v" id="gapLapsCard">—</div></div>
    </div>

    <div id="projWrap" style="display:none">
      <div class="section-title">Estimación al final</div>
      <div class="proj">
        <div class="p"><div class="k">Posición estimada</div><div class="v" id="projPos">—</div></div>
        <div class="p"><div class="k">Vueltas proyectadas</div><div class="v" id="projTotal">—</div></div>
      </div>
    </div>

    <div class="footnote" id="foot">—</div>
  </div>

  <script id="snap" type="application/json"><%- JSON.stringify(snapshot) %></script>
  <script src="/socket.io/socket.io.js"></script>
  <script>
  (function(){
    var RACE_ID = <%= race.id %>, TEAM_ID = <%= team.id %>;
    var TEAM_NAME = <%- JSON.stringify(team.name) %>;

    function fmtLap(ms){
      if (ms == null) return '—';
      if (ms < 60000) return (ms/1000).toFixed(3);
      var s = ms/1000, m = Math.floor(s/60); s = (s - m*60);
      return m + ':' + (s < 10 ? '0' : '') + s.toFixed(3);
    }
    function fmtClock(ms){
      if (ms == null) return '—';
      var s = Math.floor(ms/1000), h = Math.floor(s/3600);
      var mm = Math.floor((s%3600)/60), ss = s%60;
      var p = function(n){ return (n<10?'0':'')+n; };
      return (h>0? h+':' : '') + p(mm) + ':' + p(ss);
    }
    function set(id, v){ var el = document.getElementById(id); if (el) el.textContent = v; }

    var lastLapShown = null;

    // ── Audio: "cantar" cada vuelta del equipo (beep + voz) ──────────────────
    var audioOn = false;
    var audioMode = 'time';
    var audioCtx = null;
    var currentLane = null;      // carril actual del equipo (del snapshot en vivo)
    var lastTotalLaps = null;    // vueltas acumuladas conocidas (para cantar el nº)

    function ensureAudio(){
      try {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === 'suspended') audioCtx.resume();
      } catch(e){}
    }
    function tone(freq, start, dur){
      var o = audioCtx.createOscillator(), g = audioCtx.createGain();
      o.type = 'sine'; o.frequency.value = freq;
      g.gain.setValueAtTime(0.0001, start);
      g.gain.exponentialRampToValueAtTime(0.3, start + 0.012);
      g.gain.exponentialRampToValueAtTime(0.0001, start + dur);
      o.connect(g); g.connect(audioCtx.destination);
      o.start(start); o.stop(start + dur + 0.02);
    }
    function beep(){
      if (!audioCtx) return;
      try { var t = audioCtx.currentTime; tone(880, t, 0.10); tone(1320, t + 0.11, 0.12); } catch(e){}
    }
    function speak(text){
      try {
        if (!('speechSynthesis' in window)) return;
        var u = new SpeechSynthesisUtterance(text);
        u.lang = 'es-ES'; u.rate = 1.08;
        // iOS suspende la cola; resume() la reactiva. No usamos cancel() porque
        // en algunos navegadores deja la síntesis muda tras la primera vez.
        try { window.speechSynthesis.resume(); } catch(e){}
        window.speechSynthesis.speak(u);
      } catch(e){}
    }
    // Anuncia una vuelta del equipo: beep + voz (según el modo elegido).
    function announceLap(lapMs, lapNumber){
      if (!audioOn) return;
      beep();
      var ph = lapPhrase(lapNumber, lapMs);
      if (ph) {
        speak(ph);
        var el = document.getElementById('lastSung');
        if (el){ el.textContent = '🔊 ' + ph; el.classList.remove('show'); void el.offsetWidth; el.classList.add('show'); }
      }
    }
    // Frase a cantar para una vuelta completada.
    function lapPhrase(lapNumber, lapMs){
      var parts = [];
      if ((audioMode === 'number' || audioMode === 'both') && lapNumber != null)
        parts.push('Vuelta ' + lapNumber);
      if ((audioMode === 'time' || audioMode === 'both') && lapMs != null)
        parts.push((lapMs/1000).toFixed(1).replace('.', ' coma '));
      return parts.join(', ');
    }

    function render(snap){
      if (!snap || !snap.ok) return;
      var t = snap.timing, live = snap.live || {}, proj = snap.projection;

      set('pos', t.position != null ? 'P' + t.position : '—');
      set('posOf', snap.teamsTotal ? (' de ' + snap.teamsTotal) : '');

      if (t.gapLaps > 0) set('gapLeader', t.gapLaps + (t.gapLaps === 1 ? ' vuelta tras el líder' : ' vueltas tras el líder'));
      else if (t.position === 1) set('gapLeader', '🏁 Líder de la carrera');
      else set('gapLeader', 'A la par del líder');

      // Última vuelta: flash si cambió
      var prev = lastLapShown;
      set('lastLap', fmtLap(t.lastLapMs));
      if (t.lastLapMs != null && prev != null && t.lastLapMs !== prev){
        var c = document.getElementById('cardLast');
        c.classList.remove('flash'); void c.offsetWidth; c.classList.add('flash');
      }
      lastLapShown = t.lastLapMs;
      lastTotalLaps = (t.totalLaps != null) ? t.totalLaps : lastTotalLaps;
      currentLane   = (snap.live && snap.live.lane != null) ? snap.live.lane : currentLane;

      set('bestLap', fmtLap(t.bestLapMs));
      set('laps', t.totalLaps != null ? t.totalLaps : '—');
      set('avgLap', fmtLap(t.avgLapMs));
      set('pits', t.pitStops != null ? t.pitStops : '—');
      set('gapLapsCard', t.gapLaps != null ? '-' + t.gapLaps : '—');

      // Proyección (solo en vivo)
      if (proj && proj.position != null){
        document.getElementById('projWrap').style.display = '';
        set('projPos', 'P' + proj.position);
        set('projTotal', proj.projectedTotal != null ? proj.projectedTotal : '—');
      } else {
        document.getElementById('projWrap').style.display = 'none';
      }

      // Estado
      var led = document.getElementById('led');
      led.className = 'led';
      if (live.running){
        led.classList.add('on');
        var bits = [];
        if (live.mangaNumber != null) bits.push('Manga ' + live.mangaNumber);
        if (live.onTrack && live.lane != null) bits.push('Carril ' + live.lane);
        else bits.push('En descanso');
        if (live.remainingMs != null) bits.push('quedan ' + fmtClock(live.remainingMs));
        set('statusText', bits.join(' · '));
      } else {
        led.classList.add(snap.race.status === 'finished' ? 'off' : '');
        set('statusText', snap.race.status === 'finished' ? 'Carrera finalizada' : 'Esperando próxima manga');
      }

      var d = new Date(snap.updatedAt);
      set('foot', 'Actualizado ' + d.toLocaleTimeString('es-ES'));
    }

    // Estado inicial (renderizado en servidor → instantáneo)
    try { render(JSON.parse(document.getElementById('snap').textContent || '{}')); } catch(e){}

    // Refresco bajo demanda (debounced) del snapshot.
    var pending = false, timer = null;
    function refresh(){
      if (pending) return; pending = true;
      fetch('/api/lap/' + RACE_ID + '/team/' + TEAM_ID, { headers: { 'Accept':'application/json' } })
        .then(function(r){ return r.ok ? r.json() : null; })
        .then(function(j){ pending = false; if (j) render(j); })
        .catch(function(){ pending = false; });
    }
    function scheduleRefresh(){ if (timer) return; timer = setTimeout(function(){ timer = null; refresh(); }, 400); }

    // ── Controles de audio (cantar vueltas) ─────────────────────────────────
    var btn = document.getElementById('audioToggle');
    var modeSel = document.getElementById('audioMode');
    try { audioMode = localStorage.getItem('lapAudioMode') || 'time'; if (modeSel) modeSel.value = audioMode; } catch(e){}
    function setAudio(on){
      audioOn = on;
      if (btn){
        btn.textContent = (on ? '🔊' : '🔇') + ' Cantar vueltas';
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
        btn.classList.toggle('on', on);
      }
    }
    if (btn) btn.addEventListener('click', function(){
      var on = !audioOn;
      // El navegador exige un gesto para habilitar audio: lo desbloqueamos aquí.
      if (on){ ensureAudio(); speak('Cantando vueltas'); }
      setAudio(on);
    });
    if (modeSel) modeSel.addEventListener('change', function(){
      audioMode = modeSel.value;
      try { localStorage.setItem('lapAudioMode', audioMode); } catch(e){}
    });

    // Socket: cualquier evento relevante dispara un refresco del snapshot.
    try {
      var socket = io({ query: { view: 'lap' } });
      // Mi propia vuelta → cantar al instante (el evento trae el tiempo exacto)
      // + refresco visual. Identifico mi vuelta por nombre de equipo o por el
      // carril en el que está ahora mismo (más robusto ante nombres con matices).
      socket.on('lap', function(d){
        if (!d) return;
        var mine = (d.name === TEAM_NAME) || (currentLane != null && d.lane === currentLane);
        if (mine) {
          if (!d.isExit && !d.isFirstCrossing) {
            var n = (lastTotalLaps != null) ? lastTotalLaps + 1 : (d.lapNumber || null);
            announceLap(d.lapTimeMs, n);
          }
          if (lastTotalLaps != null) lastTotalLaps += 1;
          refresh();
        } else {
          scheduleRefresh();
        }
      });
      ['standings','manga:started','manga:stopped','manga:paused','manga:resumed',
       'manga:cancelled','race_finished','race:finished'].forEach(function(ev){
        socket.on(ev, scheduleRefresh);
      });
    } catch(e){}

    // Poll de respaldo (entre mangas el socket no emite standings).
    setInterval(refresh, 5000);
  })();
  </script>
</body>
</html>
