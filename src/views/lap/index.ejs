<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#000000">
  <title>PitWall Lap</title>
  <link rel="stylesheet" href="/css/lap.css">
</head>
<body>
  <div class="wrap">
    <a href="/" style="display:inline-flex;align-items:center;gap:6px;color:var(--muted);text-decoration:none;font-weight:600;font-size:.9rem;margin-bottom:12px">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Inicio
    </a>
    <div class="brand"><span class="dot"></span> PitWall <small>Lap</small></div>
    <h1>Elige tu carrera</h1>
    <p class="sub">Sigue el timing de tu equipo en directo desde el móvil.</p>

    <% if (races.length === 0) { %>
      <div class="card">No hay carreras de resistencia activas ahora mismo.</div>
    <% } else { %>
      <div class="list">
        <% races.forEach(r => { %>
          <a class="item" href="/lap/<%= r.id %>">
            <span><%= r.name %></span>
            <% if (r.status === 'active') { %>
              <span class="chip live">EN VIVO</span>
            <% } else { %>
              <span class="chip"><%= r.teamsCount %> equipos</span>
            <% } %>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>
</body>
</html>
