<%
  const isEdit = !!circuit;
  const formTitle = isEdit
    ? (lang === 'es' ? 'Editar circuito' : 'Edit circuit')
    : (lang === 'es' ? 'Nuevo circuito' : 'New circuit');
  const formAction = isEdit ? '/circuits/' + circuit.id : '/circuits';
  const CIRCUIT_COLORS = ['#e63946','#2196f3','#4caf50','#ff9800','#9c27b0','#00bcd4'];
%>
<%- include('../partials/header', { pageTitle: formTitle }) %>
<div class="vt-page vt-page--circuits-form">
  <div class="vt-wrap vt-wrap--narrow">

  <a href="/circuits" class="vt-back-link">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    <%= lang === 'es' ? 'Volver a circuitos' : 'Back to circuits' %>
  </a>
  <h1><%= formTitle %></h1>

  <% if (errors.length > 0) { %>
    <div class="vt-alert" style="margin-top:16px">
      <% errors.forEach(e => { %>
        <p>
          <% if (e === 'name_required') { %><%= lang === 'es' ? 'El nombre es obligatorio (mínimo 2 caracteres).' : 'Name is required (min 2 characters).' %>
          <% } else if (e === 'lanes_invalid') { %><%= lang === 'es' ? 'Número de carriles no válido (2–8 por circuito).' : 'Invalid lane count (2–8 per sub-circuit).' %>
          <% } else { %><%= e %><% } %>
        </p>
      <% }) %>
    </div>
  <% } %>

  <form action="<%= formAction %>" method="POST" class="vt-panel">

    <div class="form-group">
      <label class="form-label" for="cName"><%= lang === 'es' ? 'Nombre' : 'Name' %></label>
      <input class="form-input <%= errors.includes('name_required') ? 'form-input--error' : '' %>"
             type="text" id="cName" name="name"
             placeholder="<%= lang === 'es' ? 'Ej: Pista principal' : 'e.g. Main track' %>"
             value="<%= body.name || '' %>" autocomplete="off" autofocus required>
    </div>

    <div class="form-group">
      <label class="form-label">
        <%= lang === 'es' ? 'Configuración de carriles' : 'Lane configuration' %>
      </label>

      <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:1rem">
        <span class="form-hint" style="flex-shrink:0">
          <%= lang === 'es' ? 'Número de circuitos:' : 'Number of sub-circuits:' %>
        </span>
        <div class="circ-pills" id="circPills">
          <% for (let i = 1; i <= 6; i++) { %>
            <button type="button" class="circ-pill<%= (parseInt(body.circuits_count)||1) === i ? ' active' : '' %>"
                    data-n="<%= i %>"><%= i %></button>
          <% } %>
        </div>
        <input type="hidden" name="circuits_count" id="circuitsCount" value="<%= body.circuits_count || 1 %>">
      </div>

      <div class="circuits-grid" id="circuitsGrid">
        <% for (let i = 1; i <= 6; i++) { %>
          <div class="circuit-cfg-row" data-idx="<%= i %>"
               style="<%= (parseInt(body.circuits_count)||1) < i ? 'display:none' : '' %>">
            <span class="circuit-num-badge" style="background:<%= CIRCUIT_COLORS[i-1] %>">C<%= i %></span>
            <input class="form-input form-input--sm <%= errors.includes('lanes_invalid') ? 'form-input--error' : '' %>"
                   type="number" name="circuit_lanes_<%= i %>" id="circLanes_<%= i %>"
                   min="2" max="8" value="<%= body['circuit_lanes_' + i] || (i === 1 ? 6 : 4) %>">
            <span class="form-hint"><%= lang === 'es' ? 'carriles' : 'lanes' %></span>
          </div>
        <% } %>
      </div>

      <div class="circuits-total">
        <span class="form-hint"><%= lang === 'es' ? 'Total:' : 'Total:' %></span>
        <strong id="totalLanesDisplay" style="color:#58a6ff">—</strong>
        <span class="form-hint"> <%= lang === 'es' ? 'carriles' : 'lanes' %></span>
      </div>
    </div>

    <div class="form-group">
      <label class="form-label">
        <%= lang === 'es' ? 'Secuencia de carriles (rotación)' : 'Lane rotation sequence' %>
      </label>
      <p class="form-hint" style="margin-bottom:.5rem">
        <%= lang === 'es'
          ? 'Arrastra para reordenar. Esta secuencia determina la rotación de pilotos entre mangas. Cualquier carrera asignada a este circuito la heredará automáticamente.'
          : 'Drag to reorder. This sequence drives the lane rotation between heats. Any race assigned to this circuit inherits it.' %>
      </p>
      <div id="seqLanes" class="seq-lanes-edit" style="display:flex;flex-wrap:wrap;gap:.5rem;padding:.6rem;background:#000000;border:1px solid #21262d;border-radius:6px;min-height:3.5rem"></div>
      <input type="hidden" name="lane_sequence" id="laneSequenceInput" value="<%= body.lane_sequence || '' %>">
      <div style="display:flex;gap:.5rem;margin-top:.5rem;flex-wrap:wrap">
        <button type="button" id="btnAddRest" class="btn btn--ghost btn--sm">
          + <%= lang === 'es' ? 'Añadir descanso (DSC)' : 'Add rest (DSC)' %>
        </button>
        <button type="button" id="btnSmartSeq" class="btn btn--ghost btn--sm">
          ⚡ <%= lang === 'es' ? 'Distribución automática' : 'Auto distribute' %>
        </button>
        <button type="button" id="btnResetSeq" class="btn btn--ghost btn--sm">
          ↺ <%= lang === 'es' ? 'Restablecer' : 'Reset' %>
        </button>
      </div>
      <p class="form-hint" style="margin-top:.4rem">
        <%= lang === 'es'
          ? 'Los descansos (DSC) se usan cuando una carrera tiene más pilotos que carriles. Arrástralos a la posición donde quieras que ocurra el reposo dentro de la rotación.'
          : 'Rest slots (DSC) apply when a race has more drivers than lanes. Drag them where you want the rest to happen within the rotation.' %>
      </p>
    </div>

    <div class="form-group">
      <label class="form-label" for="minLapS">
        <%= lang === 'es' ? 'Vuelta mínima por defecto (segundos)' : 'Default minimum lap (seconds)' %>
      </label>
      <div class="input-row">
        <input class="form-input form-input--sm"
               type="number" id="minLapS" name="min_lap_s" step="0.01" min="0" max="999"
               placeholder="<%= lang === 'es' ? 'Ej: 3.50' : 'e.g. 3.50' %>"
               value="<%= body.min_lap_s || '' %>">
        <span class="form-hint">s</span>
      </div>
      <p class="form-hint" style="margin-top:.35rem">
        <%= lang === 'es'
          ? 'Se usa cuando una carrera no tiene tiempo específico para su categoría. Vueltas más rápidas se marcarán automáticamente como fantasma. Dejar vacío para desactivar.'
          : 'Used when a race has no category-specific time. Faster laps will be auto-marked as ghost. Leave empty to disable.' %>
      </p>
    </div>

    <div class="form-group">
      <label class="form-label">
        <%= lang === 'es' ? 'Vueltas mínimas por categoría (opcional)' : 'Per-category minimum laps (optional)' %>
      </label>
      <p class="form-hint" style="margin-bottom:.6rem">
        <%= lang === 'es'
          ? 'Sobrescribe el tiempo por defecto cuando la carrera pertenece a una categoría concreta. Deja vacío para usar el valor por defecto.'
          : 'Overrides the default time when the race belongs to a specific category. Leave empty to use the default.' %>
      </p>

      <div id="categoryGrid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:.6rem">
        <% (categories || []).forEach(cat => { %>
          <div class="cat-row" data-cat-id="<%= cat.id %>" style="display:flex;align-items:center;gap:.5rem;background:#000000;border:1px solid #21262d;border-radius:6px;padding:.5rem .7rem">
            <span style="flex:1;font-weight:600;font-size:.95rem"><%= cat.name %></span>
            <input class="form-input form-input--sm"
                   type="number" step="0.01" min="0" max="999"
                   name="category_min_lap_s_<%= cat.id %>"
                   placeholder="—"
                   style="width:5.5rem"
                   value="<%= body['category_min_lap_s_' + cat.id] || '' %>">
            <span class="form-hint">s</span>
          </div>
        <% }) %>
      </div>

      <% if (!categories || categories.length === 0) { %>
        <p id="catEmpty" class="form-hint" style="margin:.6rem 0">
          <%= lang === 'es' ? 'No hay categorías todavía. Crea una abajo para asignarle un tiempo mínimo.' : 'No categories yet. Create one below to assign it a minimum lap time.' %>
        </p>
      <% } %>

      <!-- Inline create category -->
      <div style="display:flex;gap:.5rem;align-items:center;margin-top:.6rem;flex-wrap:wrap">
        <input id="newCatName" type="text" class="form-input form-input--sm"
               placeholder="<%= lang === 'es' ? 'Nombre de categoría (p. ej. GT, GRUPO C)' : 'Category name (e.g. GT, GROUP C)' %>"
               style="flex:1;min-width:200px" maxlength="40" autocomplete="off">
        <button type="button" id="btnAddCategory" class="btn btn--ghost btn--sm">
          + <%= lang === 'es' ? 'Crear categoría' : 'Create category' %>
        </button>
      </div>
      <p id="catFeedback" class="form-hint" style="margin-top:.35rem;display:none"></p>
    </div>

    <div class="form-group">
      <label class="form-label" for="cDesc">
        <%= lang === 'es' ? 'Notas (opcional)' : 'Notes (optional)' %>
      </label>
      <input class="form-input" type="text" id="cDesc" name="description"
             placeholder="<%= lang === 'es' ? 'Descripción o ubicación...' : 'Description or location...' %>"
             value="<%= body.description || '' %>">
    </div>

    <!-- ── Trazado del circuito (opcional) ─────────────────────────────── -->
    <details class="form-group" <%= (isEdit && circuit && circuit.track_image_b64) ? 'open' : '' %>>
      <summary style="cursor:pointer; padding:.6rem 0; font-weight:600; color:#c9d1d9">
        🗺 <%= lang === 'es' ? 'Trazado del circuito (minimapa)' : 'Track outline (minimap)' %>
      </summary>
      <p class="form-hint" style="margin:.4rem 0 .8rem">
        <%= lang === 'es'
          ? 'Sube una foto cenital del circuito y clicka sobre el trazado para marcar puntos. Se conectarán con líneas para mostrar la posición estimada de los coches en la vista de carrera.'
          : 'Upload an overhead photo and click along the track to mark points. They are connected to estimate car positions during a race.' %>
      </p>

      <input type="file" id="trackImageInput" accept="image/*" style="position:absolute;left:-9999px">
      <div style="display:flex; gap:.5rem; flex-wrap:wrap; margin-bottom:.6rem; align-items:center">
        <button type="button" id="trackBtnUpload" class="btn btn--primary btn--sm">
          📷 <%= lang === 'es' ? 'Subir foto del circuito' : 'Upload circuit photo' %>
        </button>
        <button type="button" id="trackBtnBlank" class="btn btn--ghost btn--sm">
          ✏️ <%= lang === 'es' ? 'Dibujar sin foto' : 'Draw without photo' %>
        </button>
        <button type="button" id="trackBtnTrace" class="btn btn--ghost btn--sm" title="<%= lang === 'es' ? 'Mantén el ratón pulsado y arrastra para trazar curvas con muchos puntos automáticamente' : 'Hold mouse and drag to auto-trace curves with many points' %>" disabled>✏️ <%= lang === 'es' ? 'Trazar a mano alzada' : 'Free-hand trace' %></button>
        <button type="button" id="trackBtnSmooth" class="btn btn--ghost btn--sm" title="<%= lang === 'es' ? 'Mostrar curva suave (Catmull-Rom) para previsualizar cómo se verá en la simulación' : 'Show smooth curve preview' %>" disabled>~ <%= lang === 'es' ? 'Vista suave' : 'Smooth preview' %></button>
        <button type="button" id="trackBtnUndo" class="btn btn--ghost btn--sm" title="<%= lang === 'es' ? 'Deshacer último punto' : 'Undo last point' %>" disabled>↶ <%= lang === 'es' ? 'Deshacer' : 'Undo' %></button>
        <button type="button" id="trackBtnClose" class="btn btn--ghost btn--sm" disabled><%= lang === 'es' ? 'Cerrar/abrir trazado' : 'Toggle closed loop' %></button>
        <button type="button" id="trackBtnClear" class="btn btn--ghost btn--sm" disabled><%= lang === 'es' ? 'Limpiar puntos' : 'Clear points' %></button>
        <button type="button" id="trackBtnRemoveImg" class="btn btn--ghost btn--sm" style="color:#e63946" disabled><%= lang === 'es' ? 'Quitar imagen' : 'Remove image' %></button>
        <span id="trackPointCount" class="form-hint" style="margin-left:auto"></span>
      </div>

      <div id="trackCanvasWrap" style="position:relative; max-width:760px; border:1px dashed #30363d; border-radius:8px; background:#000; display:flex; align-items:center; justify-content:center; min-height:200px; overflow:hidden">
        <canvas id="trackCanvas" style="display:block; max-width:100%; height:auto; cursor:crosshair"></canvas>
        <div id="trackPlaceholder" style="color:#c9d1d9; padding:2.5rem 1rem; text-align:center">
          <div style="font-size:2.5rem; opacity:.5; margin-bottom:.6rem">📷</div>
          <div style="font-size:1rem; font-weight:600">
            <%= lang === 'es' ? 'Elige cómo crear el trazado' : 'Choose how to create the outline' %>
          </div>
          <div style="font-size:.85rem; color:#8b949e; margin-top:.4rem; line-height:1.5">
            <%= lang === 'es' ? '• "Subir foto" — pon una imagen cenital de fondo' : '• "Upload photo" — drop an overhead image as background' %><br>
            <%= lang === 'es' ? '• "Dibujar sin foto" — empieza con un lienzo en negro' : '• "Draw without photo" — start with a blank canvas' %>
          </div>
        </div>
      </div>

      <p class="form-hint" style="margin-top:.5rem; font-size:.8rem; line-height:1.55">
        <%= lang === 'es' ? '<b>Click izquierdo</b>: añadir punto · Si haces click <b>sobre la línea</b>, el punto se inserta entre los dos puntos vecinos · <b>Click derecho</b> sobre un punto: borrarlo · <b>Arrastrar</b> un punto: moverlo · El primer punto (verde) marca la salida.'
          : '<b>Left click</b>: add point · Clicking <b>on the line</b> inserts a point between the two neighbors · <b>Right click</b> on a point: delete · <b>Drag</b> a point: move · The first point (green) marks the start.' %>
      </p>
      <p class="form-hint" style="margin-top:.3rem; font-size:.8rem; line-height:1.55">
        <%= lang === 'es'
          ? '💡 Para curvas: pulsa <b>"Vista suave"</b> para ver cómo se redondearán los puntos. Con 3-4 puntos por curva basta. O usa <b>"Trazar a mano alzada"</b> y arrastra el ratón siguiendo el trazado.'
          : '💡 For curves: hit <b>"Smooth preview"</b> to see how points get rounded — 3-4 points per curve are enough. Or use <b>"Free-hand trace"</b> and drag along the track.' %>
      </p>

      <!-- ── Sentido del circuito ─────────────────────────────────────── -->
      <%
        const trackDir = (typeof body !== 'undefined' && body && body.track_direction)
          ? body.track_direction
          : ((isEdit && circuit && circuit.track_direction) ? circuit.track_direction : 'cw');
      %>
      <div class="form-group" style="margin-top:1.1rem">
        <label class="form-label" style="display:block;margin-bottom:.6rem">
          <%= lang === 'es' ? 'Sentido del circuito' : 'Track direction' %>
        </label>
        <div class="dir-opts">
          <label class="dir-opt <%= trackDir !== 'ccw' ? 'is-sel' : '' %>" data-dir="cw">
            <input type="radio" name="track_direction" value="cw" <%= trackDir !== 'ccw' ? 'checked' : '' %>>
            <svg class="dir-opt__ico" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M40 24a16 16 0 1 1-4.7-11.3"/>
              <path d="M40 6v8h-8"/>
            </svg>
            <div class="dir-opt__txt">
              <div class="dir-opt__t"><%= lang === 'es' ? 'Horario' : 'Clockwise' %></div>
              <div class="dir-opt__d"><%= lang === 'es' ? 'Sentido de las agujas del reloj' : 'Same as clock hands' %></div>
            </div>
          </label>
          <label class="dir-opt <%= trackDir === 'ccw' ? 'is-sel' : '' %>" data-dir="ccw">
            <input type="radio" name="track_direction" value="ccw" <%= trackDir === 'ccw' ? 'checked' : '' %>>
            <svg class="dir-opt__ico" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 24a16 16 0 1 0 4.7-11.3"/>
              <path d="M8 6v8h8"/>
            </svg>
            <div class="dir-opt__txt">
              <div class="dir-opt__t"><%= lang === 'es' ? 'Antihorario' : 'Counter-clockwise' %></div>
              <div class="dir-opt__d"><%= lang === 'es' ? 'Contra las agujas del reloj' : 'Against clock hands' %></div>
            </div>
          </label>
        </div>
        <p class="form-hint" style="margin-top:.5rem">
          <%= lang === 'es'
            ? 'Indica en qué sentido recorren los coches el trazado. La simulación del minimapa mueve las bolitas siguiendo este sentido.'
            : 'Sets the direction cars travel along the outline. The minimap animation follows this direction.' %>
        </p>
      </div>

      <input type="hidden" name="track_image_b64" id="trackImageB64Input"
             value="<%= (isEdit && circuit) ? (circuit.track_image_b64 || '') : '' %>">
      <input type="hidden" name="track_outline_json" id="trackOutlineJsonInput"
             value='<%= (isEdit && circuit) ? (circuit.track_outline_json || "[]") : "[]" %>'>
    </details>

    <div class="vt-form-actions">
      <a href="/circuits" class="vt-btn vt-btn--ghost"><%= lang === 'es' ? 'Cancelar' : 'Cancel' %></a>
      <button type="submit" class="vt-btn vt-btn--primary">
        <%= isEdit ? (lang === 'es' ? 'Guardar cambios' : 'Save changes') : (lang === 'es' ? 'Crear circuito' : 'Create circuit') %>
      </button>
    </div>

  </form>
  </div>
</div>

<!-- ── Track outline editor — vanilla JS, autoinit cuando el details se abre ──── -->
<script>
(function () {
  const canvas       = document.getElementById('trackCanvas');
  const wrap         = document.getElementById('trackCanvasWrap');
  const placeholder  = document.getElementById('trackPlaceholder');
  const fileInput    = document.getElementById('trackImageInput');
  const imgInput     = document.getElementById('trackImageB64Input');
  const outlineInput = document.getElementById('trackOutlineJsonInput');
  const btnUpload    = document.getElementById('trackBtnUpload');
  const btnUndo      = document.getElementById('trackBtnUndo');
  const btnClose     = document.getElementById('trackBtnClose');
  const btnClear     = document.getElementById('trackBtnClear');
  const btnRemoveImg = document.getElementById('trackBtnRemoveImg');
  const btnTrace     = document.getElementById('trackBtnTrace');
  const btnSmooth    = document.getElementById('trackBtnSmooth');
  const countLabel   = document.getElementById('trackPointCount');
  if (!canvas) return;

  const ctx = canvas.getContext('2d');
  let img      = null;            // Image obj cargada (null en modo lienzo blanco)
  let blank    = false;           // true → lienzo sin imagen
  const BLANK_W = 1000, BLANK_H = 600;
  let points   = [];              // [[x_rel, y_rel], ...]   0..1
  let closed   = true;
  let dragIdx  = -1;
  let traceMode = false;          // trazado a mano alzada (drag continuo)
  let showSmooth = true;          // preview Catmull-Rom
  let isTracing = false;          // mouse pulsado en modo trace
  const HIT_R   = 12;             // radio de hit en px CSS para puntos
  const SEG_HIT_R = 8;            // distancia para insertar sobre un segmento
  const TRACE_MIN_DIST_PX = 22;   // distancia mínima entre puntos en modo trace
  const LANG   = "<%= lang %>";

  function hasCanvas() { return !!img || blank; }

  function setPlaceholderVisible(visible) {
    placeholder.style.display = visible ? 'block' : 'none';
    canvas.style.display      = visible ? 'none'  : 'block';
    [btnUndo, btnClose, btnClear, btnRemoveImg, btnTrace, btnSmooth].forEach(b => { if (b) b.disabled = visible; });
  }

  function updateCount() {
    countLabel.textContent = points.length + ' ' + (LANG === 'es' ? 'puntos' : 'points');
  }

  function sync() {
    outlineInput.value = JSON.stringify(points);
    updateCount();
  }

  // ── Catmull-Rom centrípeto para previsualización ─────────────────────
  const SAMPLES_PER_SEG = 14;
  function catmullRom(p0, p1, p2, p3, t) {
    const t2 = t * t, t3 = t2 * t;
    return [
      0.5 * ((2 * p1[0]) + (-p0[0] + p2[0]) * t + (2 * p0[0] - 5 * p1[0] + 4 * p2[0] - p3[0]) * t2 + (-p0[0] + 3 * p1[0] - 3 * p2[0] + p3[0]) * t3),
      0.5 * ((2 * p1[1]) + (-p0[1] + p2[1]) * t + (2 * p0[1] - 5 * p1[1] + 4 * p2[1] - p3[1]) * t2 + (-p0[1] + 3 * p1[1] - 3 * p2[1] + p3[1]) * t3),
    ];
  }
  function smoothPath(pts, isClosed) {
    if (pts.length < 3) return pts.slice();
    const N = pts.length;
    const out = [];
    const upto = isClosed ? N : N - 1;
    for (let i = 0; i < upto; i++) {
      const p0 = pts[isClosed ? (i - 1 + N) % N : Math.max(0, i - 1)];
      const p1 = pts[i];
      const p2 = pts[isClosed ? (i + 1) % N : Math.min(N - 1, i + 1)];
      const p3 = pts[isClosed ? (i + 2) % N : Math.min(N - 1, i + 2)];
      for (let s = 0; s < SAMPLES_PER_SEG; s++) out.push(catmullRom(p0, p1, p2, p3, s / SAMPLES_PER_SEG));
    }
    return out;
  }

  function draw() {
    if (!hasCanvas()) return;
    if (img) {
      canvas.width  = img.naturalWidth;
      canvas.height = img.naturalHeight;
      ctx.drawImage(img, 0, 0);
    } else {
      canvas.width  = BLANK_W;
      canvas.height = BLANK_H;
      ctx.fillStyle = '#0a0a0a';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.strokeStyle = 'rgba(255,255,255,.05)';
      ctx.lineWidth = 1;
      for (let x = 0; x < canvas.width;  x += 50) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); ctx.stroke(); }
      for (let y = 0; y < canvas.height; y += 50) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width,  y); ctx.stroke(); }
    }

    if (points.length === 0) return;

    // 1) Curva suave (preview de cómo se verá en la simulación)
    if (showSmooth && points.length >= 3) {
      const sm = smoothPath(points, closed);
      ctx.beginPath();
      sm.forEach(([x, y], i) => {
        const px = x * canvas.width, py = y * canvas.height;
        if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
      });
      if (closed) ctx.closePath();
      ctx.lineWidth   = Math.max(5, canvas.width / 220);
      ctx.strokeStyle = 'rgba(56,189,248,.55)';
      ctx.stroke();
    }

    // 2) Polilínea de control (rectos entre puntos)
    ctx.lineWidth   = Math.max(2, canvas.width / 600);
    ctx.strokeStyle = showSmooth ? 'rgba(251,191,36,.6)' : '#fbbf24';
    ctx.setLineDash(showSmooth ? [6, 5] : []);
    ctx.beginPath();
    points.forEach(([x, y], i) => {
      const px = x * canvas.width;
      const py = y * canvas.height;
      if (i === 0) ctx.moveTo(px, py);
      else         ctx.lineTo(px, py);
    });
    if (closed && points.length > 2) ctx.closePath();
    ctx.stroke();
    ctx.setLineDash([]);

    // 3) Puntos
    const r = Math.max(4, canvas.width / 220);
    points.forEach(([x, y], i) => {
      const px = x * canvas.width;
      const py = y * canvas.height;
      ctx.beginPath();
      ctx.arc(px, py, r, 0, Math.PI * 2);
      ctx.fillStyle = (i === 0) ? '#3fb950' : '#fbbf24';
      ctx.fill();
      ctx.lineWidth = 1.5;
      ctx.strokeStyle = '#000';
      ctx.stroke();
    });
  }

  function eventToPx(e) {
    const rect = canvas.getBoundingClientRect();
    const sx = canvas.width  / rect.width;
    const sy = canvas.height / rect.height;
    return { x: (e.clientX - rect.left) * sx, y: (e.clientY - rect.top) * sy, rect };
  }

  function pickPoint(e) {
    const { x, y, rect } = eventToPx(e);
    const sx = canvas.width  / rect.width;
    const hitRpx = HIT_R * sx;
    for (let i = points.length - 1; i >= 0; i--) {
      const px = points[i][0] * canvas.width;
      const py = points[i][1] * canvas.height;
      if (Math.hypot(px - x, py - y) <= hitRpx) return i;
    }
    return -1;
  }

  // Devuelve { index, t } del segmento más cercano si está dentro de SEG_HIT_R,
  // o null. `index` = índice del segmento i→i+1; nuevo punto se inserta en i+1.
  function pickSegment(e) {
    if (points.length < 2) return null;
    const { x, y, rect } = eventToPx(e);
    const sx = canvas.width  / rect.width;
    const limitPx = SEG_HIT_R * sx;
    let best = null;
    const N = points.length;
    const maxI = closed ? N : N - 1;
    for (let i = 0; i < maxI; i++) {
      const ax = points[i][0] * canvas.width;
      const ay = points[i][1] * canvas.height;
      const bx = points[(i + 1) % N][0] * canvas.width;
      const by = points[(i + 1) % N][1] * canvas.height;
      const dx = bx - ax, dy = by - ay;
      const len2 = dx * dx + dy * dy;
      if (len2 < 1) continue;
      let t = ((x - ax) * dx + (y - ay) * dy) / len2;
      t = Math.max(0, Math.min(1, t));
      const cx = ax + t * dx, cy = ay + t * dy;
      const d = Math.hypot(cx - x, cy - y);
      if (d <= limitPx && (!best || d < best.d)) best = { index: i, t, d, cx, cy };
    }
    return best;
  }

  let lastTracePx = null;
  canvas.addEventListener('mousedown', (e) => {
    if (!hasCanvas() || e.button !== 0) return;

    // Modo trace: arrastrar pintando puntos a intervalos
    if (traceMode) {
      isTracing = true;
      const { x, y } = eventToPx(e);
      points.push([x / canvas.width, y / canvas.height]);
      lastTracePx = { x, y };
      sync(); draw();
      return;
    }

    // Click sobre punto existente → arrastrar para mover
    const idx = pickPoint(e);
    if (idx >= 0) { dragIdx = idx; return; }

    // Click sobre la línea entre dos puntos → insertar ahí
    const seg = pickSegment(e);
    if (seg) {
      points.splice(seg.index + 1, 0, [seg.cx / canvas.width, seg.cy / canvas.height]);
      sync(); draw();
      return;
    }

    // Sino → añadir al final
    const { x, y } = eventToPx(e);
    points.push([x / canvas.width, y / canvas.height]);
    sync(); draw();
  });

  canvas.addEventListener('mousemove', (e) => {
    // Modo trace activo
    if (isTracing) {
      const { x, y } = eventToPx(e);
      const sx = canvas.width / canvas.getBoundingClientRect().width;
      const minDistPx = TRACE_MIN_DIST_PX * sx;
      if (!lastTracePx || Math.hypot(x - lastTracePx.x, y - lastTracePx.y) >= minDistPx) {
        points.push([x / canvas.width, y / canvas.height]);
        lastTracePx = { x, y };
        sync(); draw();
      }
      return;
    }
    // Arrastre de punto
    if (dragIdx < 0) return;
    const { x, y } = eventToPx(e);
    points[dragIdx] = [
      Math.max(0, Math.min(1, x / canvas.width)),
      Math.max(0, Math.min(1, y / canvas.height)),
    ];
    sync(); draw();
  });
  function endDrag() { dragIdx = -1; isTracing = false; lastTracePx = null; }
  canvas.addEventListener('mouseup',   endDrag);
  canvas.addEventListener('mouseleave', endDrag);

  // Cursor dinámico según modo
  function updateCursor() {
    canvas.style.cursor = traceMode ? 'crosshair' : 'crosshair';
  }
  updateCursor();

  canvas.addEventListener('contextmenu', (e) => {
    e.preventDefault();
    if (!hasCanvas()) return;
    const idx = pickPoint(e);
    if (idx >= 0) {
      points.splice(idx, 1);
      sync(); draw();
    }
  });

  btnUpload.addEventListener('click', () => fileInput.click());

  document.getElementById('trackBtnBlank').addEventListener('click', () => {
    img = null;
    blank = true;
    imgInput.value = '__CLEAR__';
    setPlaceholderVisible(false);
    draw();
  });

  btnUndo.addEventListener('click', () => {
    if (points.length === 0) return;
    points.pop();
    sync(); draw();
  });
  btnClose.addEventListener('click', () => { closed = !closed; draw(); });
  btnClear.addEventListener('click', () => {
    if (points.length === 0) return;
    if (!confirm(LANG === 'es' ? '¿Borrar todos los puntos del trazado?' : 'Clear all outline points?')) return;
    points = []; sync(); draw();
  });

  // Quitar imagen — SOLO la imagen. Los puntos se conservan: pasamos a
  // modo "lienzo en blanco" para que el trazado siga visible y editable.
  btnRemoveImg.addEventListener('click', () => {
    if (!confirm(LANG === 'es' ? '¿Quitar la imagen del circuito? (el trazado se conserva)' : 'Remove the circuit image? (outline is kept)')) return;
    img = null;
    blank = true;             // mantener canvas activo con fondo neutro
    imgInput.value = '__CLEAR__';
    setPlaceholderVisible(false);
    draw();
  });

  // Modo trace toggle
  btnTrace.addEventListener('click', () => {
    traceMode = !traceMode;
    btnTrace.classList.toggle('btn--primary', traceMode);
    btnTrace.classList.toggle('btn--ghost', !traceMode);
    updateCursor();
  });

  // Preview curva suave toggle
  function refreshSmoothBtn() {
    btnSmooth.classList.toggle('btn--primary', showSmooth);
    btnSmooth.classList.toggle('btn--ghost', !showSmooth);
  }
  btnSmooth.addEventListener('click', () => {
    showSmooth = !showSmooth;
    refreshSmoothBtn();
    draw();
  });
  refreshSmoothBtn();

  fileInput.addEventListener('change', (e) => {
    const f = e.target.files && e.target.files[0];
    if (!f) return;
    const reader = new FileReader();
    reader.onload = () => {
      const dataUrl = reader.result;
      imgInput.value = dataUrl;
      loadImage(dataUrl, /*resetPoints=*/false);
    };
    reader.readAsDataURL(f);
  });

  function loadImage(src, resetPoints) {
    const i = new Image();
    i.onload = () => {
      img = i;
      if (resetPoints) { points = []; sync(); }
      setPlaceholderVisible(false);
      draw();
    };
    i.onerror = () => { img = null; setPlaceholderVisible(true); };
    i.src = src;
  }

  // Init
  try {
    const initialOutline = JSON.parse(outlineInput.value || '[]');
    if (Array.isArray(initialOutline)) points = initialOutline.filter(p => Array.isArray(p) && p.length === 2);
  } catch {}
  updateCount();
  const initialImg = imgInput.value;
  if (initialImg && initialImg !== '__CLEAR__') {
    loadImage(initialImg, false);
  } else if (points.length > 0) {
    // Hay trazado guardado pero no imagen → entrar directo en modo lienzo blanco
    blank = true;
    setPlaceholderVisible(false);
    draw();
  } else {
    setPlaceholderVisible(true);
  }
})();
</script>

<script>
const circPills    = document.getElementById('circPills');
const circCount    = document.getElementById('circuitsCount');
const circGrid     = document.getElementById('circuitsGrid');
const totalDisplay = document.getElementById('totalLanesDisplay');

function updateTotal() {
  const n = parseInt(circCount.value, 10);
  let total = 0;
  for (let i = 1; i <= n; i++) {
    total += parseInt(document.getElementById('circLanes_' + i)?.value || 0, 10) || 0;
  }
  totalDisplay.textContent = total;
}

function setCircuitCount(n) {
  circCount.value = n;
  circPills.querySelectorAll('.circ-pill').forEach(btn => {
    btn.classList.toggle('active', parseInt(btn.dataset.n) === n);
  });
  circGrid.querySelectorAll('.circuit-cfg-row').forEach(row => {
    row.style.display = parseInt(row.dataset.idx) <= n ? '' : 'none';
  });
  updateTotal();
}

circPills.addEventListener('click', e => {
  const btn = e.target.closest('.circ-pill');
  if (btn) setCircuitCount(parseInt(btn.dataset.n));
});

circGrid.addEventListener('input', () => { updateTotal(); rebuildSeqIfMismatch(); });
updateTotal();

// ── Lane sequence (drag-to-reorder) ────────────────────────────────────────
const LANE_COLORS = ['#e63946','#2196f3','#4caf50','#ff9800','#9c27b0','#00bcd4','#ff5722','#607d8b','#795548','#e91e63','#3f51b5','#009688'];
const seqEl   = document.getElementById('seqLanes');
const seqHidd = document.getElementById('laneSequenceInput');

function totalLanesNow() {
  const n = parseInt(circCount.value, 10);
  let t = 0;
  for (let i = 1; i <= n; i++) t += parseInt(document.getElementById('circLanes_' + i)?.value || 0, 10) || 0;
  return t;
}

// Compute which sub-circuit a global lane belongs to (1-based).
function laneToCircuit(lane) {
  if (lane <= 0) return 0;
  const sizes = getCircuitSizes();
  let acc = 0;
  for (let i = 0; i < sizes.length; i++) {
    acc += sizes[i];
    if (lane <= acc) return i + 1;
  }
  return sizes.length;
}

function renderSeq(seq) {
  seqEl.innerHTML = '';
  // Walk sequence to assign DSC labels per sub-circuit
  const sizesCount = getCircuitSizes().length;
  let currentCircuit = 1;
  const restCounters = Array(sizesCount + 1).fill(0); // 1-based
  seq.forEach((lane, idx) => {
    const chip = document.createElement('div');
    chip.className = 'seq-chip';
    chip.draggable = true;
    chip.dataset.lane = lane;
    chip.dataset.idx  = idx;
    const isRest = lane === 0;

    let label = '';
    if (isRest) {
      restCounters[currentCircuit] = (restCounters[currentCircuit] || 0) + 1;
      label = sizesCount > 1
        ? `DSC${restCounters[currentCircuit]}-C${currentCircuit}`
        : `DSC${restCounters[currentCircuit]}`;
    } else {
      currentCircuit = laneToCircuit(lane);
      label = String(lane);
    }

    const minW = isRest && sizesCount > 1 ? '4.2rem' : '2.4rem';
    chip.style.cssText = `
      display:inline-flex;align-items:center;justify-content:center;
      min-width:${minW};height:2.4rem;padding:0 .4rem;border-radius:6px;font-weight:700;
      cursor:grab;user-select:none;font-family:'Rajdhani',sans-serif;font-size:${isRest ? '.7rem' : '1rem'};
      ${isRest ? 'background:#30363d;color:#8b949e' : 'background:'+LANE_COLORS[(lane-1)%LANE_COLORS.length]+';color:#0d1117'}
    `;
    chip.textContent = label;
    seqEl.appendChild(chip);
  });
  syncHidden();
}

function syncHidden() {
  const arr = [...seqEl.children].map(c => parseInt(c.dataset.lane, 10));
  seqHidd.value = arr.join(',');
}

function defaultSeq(total) {
  const odds = [], evens = [];
  for (let i = 1; i <= total; i++) (i % 2 ? odds : evens).push(i);
  return [...odds, ...evens.reverse()];
}
function parseSeqFromValue(val, total) {
  if (!val) return defaultSeq(total);
  const arr = val.split(',').map(s => parseInt(s.trim(), 10)).filter(n => Number.isFinite(n) && n >= 0);
  return arr.length ? arr : defaultSeq(total);
}

function rebuildSeqIfMismatch() {
  const total = totalLanesNow();
  const current = [...seqEl.children].map(c => parseInt(c.dataset.lane, 10));
  const nonRestCurrent = current.filter(n => n > 0).sort((a,b)=>a-b);
  const expectedLanes = Array.from({length: total}, (_, i) => i + 1);
  // Only rebuild if non-rest lanes don't match the expected set
  if (nonRestCurrent.length !== expectedLanes.length || nonRestCurrent.some((v,i)=>v!==expectedLanes[i])) {
    renderSeq(defaultSeq(total));
  }
}

// Drag-and-drop
let dragSrc = null;
seqEl.addEventListener('dragstart', e => {
  const chip = e.target.closest('.seq-chip');
  if (!chip) return;
  dragSrc = chip;
  chip.style.opacity = '.4';
});
seqEl.addEventListener('dragend', e => {
  const chip = e.target.closest('.seq-chip');
  if (chip) chip.style.opacity = '1';
  dragSrc = null;
});
seqEl.addEventListener('dragover', e => {
  e.preventDefault();
  const chip = e.target.closest('.seq-chip');
  if (!chip || chip === dragSrc) return;
  const rect = chip.getBoundingClientRect();
  const after = (e.clientX - rect.left) > rect.width / 2;
  seqEl.insertBefore(dragSrc, after ? chip.nextSibling : chip);
});
seqEl.addEventListener('drop', e => {
  e.preventDefault();
  // Re-render so DSC labels (DSCn-Cm) reflect the new positions
  const arr = [...seqEl.children].map(c => parseInt(c.dataset.lane, 10));
  renderSeq(arr);
});

// ── DSC slot management ───────────────────────────────────────────────────
function getCircuitSizes() {
  const n = parseInt(circCount.value, 10);
  const sizes = [];
  for (let i = 1; i <= n; i++) sizes.push(parseInt(document.getElementById('circLanes_' + i)?.value || 0, 10) || 0);
  return sizes;
}

// Smart distribution: in each sub-circuit, place rest slot after local lane 2
// (odd Cs) or after lane M-1 (even Cs). Mirrors the old wizard logic.
function buildSmartSeq(numRests) {
  const sizes = getCircuitSizes();
  const total = sizes.reduce((a,b)=>a+b, 0);
  if (total === 0) return [];
  const totalRests = Math.max(0, numRests);
  const numCircuits = sizes.length;
  const perCircuit = Array(numCircuits).fill(Math.floor(totalRests / numCircuits));
  for (let i = 0; i < totalRests % numCircuits; i++) perCircuit[i]++;

  const seq = [];
  let globalStart = 1;
  sizes.forEach((M, ci) => {
    const isEven = (ci + 1) % 2 === 0;
    const restAfterLocal = isEven ? (M - 1) : 2;
    const rests = perCircuit[ci];
    for (let local = 1; local <= M; local++) {
      seq.push(globalStart + local - 1);
      if (local === restAfterLocal) {
        for (let r = 0; r < rests; r++) seq.push(0);
      }
    }
    globalStart += M;
  });
  return seq;
}

document.getElementById('btnAddRest')?.addEventListener('click', () => {
  const chips = [...seqEl.children].map(c => parseInt(c.dataset.lane, 10));
  chips.push(0);
  renderSeq(chips);
});

document.getElementById('btnSmartSeq')?.addEventListener('click', () => {
  // Preserve the current rest count if any; otherwise default to 1 per sub-circuit.
  const currentRests = [...seqEl.children].filter(c => parseInt(c.dataset.lane, 10) === 0).length;
  const sizes = getCircuitSizes();
  const numRests = currentRests > 0 ? currentRests : sizes.length;
  renderSeq(buildSmartSeq(numRests));
});

document.getElementById('btnResetSeq')?.addEventListener('click', () => {
  renderSeq(defaultSeq(totalLanesNow()));
});

// Remove a DSC chip by click (besides drag)
seqEl.addEventListener('click', e => {
  const chip = e.target.closest('.seq-chip');
  if (!chip) return;
  if (parseInt(chip.dataset.lane, 10) === 0) {
    chip.remove();
    const arr = [...seqEl.children].map(c => parseInt(c.dataset.lane, 10));
    renderSeq(arr); // renumber remaining DSCs
  }
});

// Initial render: from saved value or default rotation
renderSeq(parseSeqFromValue(seqHidd.value, totalLanesNow()));

// ── Crear categoría inline (POST /api/categories) ──────────────────────
(function () {
  const input = document.getElementById('newCatName');
  const btn   = document.getElementById('btnAddCategory');
  const grid  = document.getElementById('categoryGrid');
  const empty = document.getElementById('catEmpty');
  const feed  = document.getElementById('catFeedback');
  if (!input || !btn || !grid) return;

  function showFeedback(msg, isError) {
    feed.textContent = msg;
    feed.style.display = 'block';
    feed.style.color = isError ? '#e63946' : '#4caf50';
    if (!isError) setTimeout(() => { feed.style.display = 'none'; }, 2500);
  }

  function addCardToGrid(cat) {
    const div = document.createElement('div');
    div.className = 'cat-row';
    div.dataset.catId = cat.id;
    div.style.cssText = 'display:flex;align-items:center;gap:.5rem;background:#000000;border:1px solid #21262d;border-radius:6px;padding:.5rem .7rem';
    div.innerHTML = `
      <span style="flex:1;font-weight:600;font-size:.95rem">${cat.name}</span>
      <input class="form-input form-input--sm" type="number" step="0.01" min="0" max="999"
             name="category_min_lap_s_${cat.id}" placeholder="—" style="width:5.5rem">
      <span class="form-hint">s</span>
    `;
    grid.appendChild(div);
    if (empty) empty.style.display = 'none';
  }

  async function createCategory() {
    const name = input.value.trim();
    if (!name) { showFeedback('Escribe un nombre primero', true); input.focus(); return; }
    btn.disabled = true;
    try {
      const res = await fetch('/api/categories', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name })
      });
      const data = await res.json();
      if (!res.ok) {
        showFeedback(data.error || 'Error', true);
      } else {
        addCardToGrid({ id: data.id, name: data.name });
        input.value = '';
        showFeedback(`Categoría "${data.name}" creada`, false);
      }
    } catch (e) {
      showFeedback('Error de red', true);
    } finally {
      btn.disabled = false;
      input.focus();
    }
  }

  btn.addEventListener('click', createCategory);
  input.addEventListener('keydown', e => {
    if (e.key === 'Enter') { e.preventDefault(); createCategory(); }
  });
})();
</script>

<script>
/* Sentido del circuito — sync visual al cambiar el radio */
document.querySelectorAll('.dir-opt[data-dir]').forEach(opt => {
  opt.addEventListener('click', () => {
    document.querySelectorAll('.dir-opt[data-dir]').forEach(o => o.classList.remove('is-sel'));
    opt.classList.add('is-sel');
  });
