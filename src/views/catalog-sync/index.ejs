<%- include('../partials/header', { pageTitle }) %>
<%
  const es = lang === 'es';
  const withChanges = diffs.filter(d => d.hasChanges).length;
%>

<div class="vt-page st-page st-page--solo">
  <div class="st-top">
    <a href="/" class="vt-back-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      <%= t('common.inicio') %>
    </a>
    <span class="st-top__sep"></span>
    <h1 class="st-top__h"><%= t('common.sincronizar_catalogo') %></h1>
    <span class="st-top__fill"></span>
    <div class="vt-port-pill <%= withChanges ? 'is-sim' : '' %>">
      <span class="dot"></span>
      <%= withChanges
        ? (es ? (withChanges === 1 ? '1 carrera con cambios' : withChanges + ' carreras con cambios') : (withChanges === 1 ? '1 race with changes' : withChanges + ' races with changes'))
        : (t('catalog-sync.todo_al_dia')) %>
    </div>
  </div>

  <div class="st-solo">
    <header class="st-sec__h">
      <h2><%= t('catalog-sync.del_catalogo_a_las_carreras') %></h2>
      <p><%- es
        ? 'Vuelca los cambios del <a href="/teams">catálogo de equipos</a> (pilotos y país) a las carreras que <b>todavía no han arrancado ninguna manga</b>, sin pasar por «Editar tanda». Empareja equipos por nombre y deja la plantilla <b>idéntica al catálogo</b>: añade y quita pilotos. No toca la parrilla ni añade o quita equipos.'
        : 'Pushes <a href="/teams">team-catalog</a> changes (drivers and country) into races that <b>have not started any heat yet</b>, without going through “Edit heat group”. Matches teams by name and makes the roster <b>identical to the catalog</b>: adds and removes drivers. Does not touch the grid or add/remove teams.' %></p>
    </header>

    <% if (diffs.length === 0) { %>
      <div class="st-card">
        <div class="st-row">
          <span class="dg-ok"><svg viewBox="0 0 24 24"><path d="M5 12l4 4L19 7"/></svg></span>
          <div class="st-row__txt">
            <div class="st-row__t"><%= t('catalog-sync.nada_que_sincronizar') %></div>
            <div class="st-row__d"><%= t('catalog-sync.no_hay_carreras_en_formato_equipos_pendientes') %></div>
          </div>
        </div>
      </div>
    <% } else { %>
      <form method="post" action="/catalog-sync/apply" id="csForm" class="cs-list">
        <% if (focus) { %><input type="hidden" name="return" value="/races/<%= focus %>"><% } %>

        <% diffs.forEach(d => { %>
          <% const isFocus = focus && d.raceId === focus; %>
          <div class="st-card cs-race <%= isFocus ? 'is-focus' : '' %> <%= d.hasChanges ? '' : 'is-done' %>" id="race-<%= d.raceId %>">
            <label class="st-row cs-race__h">
              <input type="checkbox" name="race_ids[]" value="<%= d.raceId %>"
                     <%= d.hasChanges ? 'checked' : 'disabled' %>>
              <span class="st-row__txt">
                <span class="st-row__t"><%= d.raceName %></span>
              </span>
              <% if (d.hasChanges) { %>
                <span class="st-chip st-chip--warn"><%= t('catalog-sync.con_cambios') %></span>
              <% } else { %>
                <span class="cs-done"><span class="st-dot st-dot--ok"></span><%= t('catalog-sync.al_dia') %></span>
              <% } %>
              <a href="/races/<%= d.raceId %>" class="cs-open"><%= t('common.abrir') %></a>
            </label>

            <% d.teams.filter(tm => !tm.unchanged).forEach(tm => { %>
              <div class="st-row st-row--wrap cs-team">
                <span class="cs-team__n"><%= tm.name %></span>
                <span class="cs-chips">
                  <% tm.add.forEach(n => { %><span class="cs-chip cs-chip--add">+ <%= n %></span><% }) %>
                  <% tm.remove.forEach(n => { %><span class="cs-chip cs-chip--del">− <%= n %></span><% }) %>
                  <% if (tm.country) { %>
                    <span class="cs-chip cs-chip--meta">
                      <%= t('catalog-sync.pais') %>:
                      <%= tm.country.from.map(c => String(c).split('|')[0]).join(' / ') %>
                      →
                      <%= String(tm.country.to).split('|')[0] %>
                    </span>
                  <% } %>
                </span>
              </div>
            <% }) %>

            <% if (d.unmatched.length) { %>
              <div class="st-row st-row--hint">
                <div class="st-row__d">
                  <%= t('catalog-sync.sin_emparejar_nombre_distinto_se_ignoran') %>
                  <%= d.unmatched.join(', ') %>
                </div>
              </div>
            <% } %>
          </div>
        <% }) %>

        <% if (withChanges) { %>
          <div class="st-bar is-dirty" id="csBar">
            <div class="st-bar__in">
              <span class="st-dot st-dot--warn" id="csDot"></span>
              <span class="st-bar__msg" id="csMsg"></span>
              <span class="st-top__fill"></span>
              <button type="submit" class="vt-btn vt-btn--primary" id="csApply"><%= t('catalog-sync.aplicar') %></button>
            </div>
          </div>
        <% } %>
      </form>
    <% } %>
  </div>
</div>

<script>
(function () {
  const ES = <%- JSON.stringify(es) %>;
  const form = document.getElementById('csForm');
  const msg = document.getElementById('csMsg');
  if (form && msg) {
    const update = () => {
      const n = form.querySelectorAll('input[name="race_ids[]"]:checked').length;
      msg.textContent = n === 0
        ? (ES ? 'Ninguna carrera marcada' : 'No race selected')
        : ES ? `Se aplicará a ${n} ${n === 1 ? 'carrera' : 'carreras'}` : `Will apply to ${n} ${n === 1 ? 'race' : 'races'}`;
      document.getElementById('csApply').disabled = n === 0;
      document.getElementById('csBar').classList.toggle('is-dirty', n > 0);
      document.getElementById('csDot').className = 'st-dot' + (n > 0 ? ' st-dot--warn' : '');
    };
    form.addEventListener('change', update);
    update();
  }
  <% if (focus) { %>
  document.getElementById('race-<%= focus %>')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  <% } %>
})();
</script>

<%- include('../partials/footer') %>
