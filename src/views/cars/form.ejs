<%- include('../partials/header', { lang, pageTitle: typeof pageTitle !== 'undefined' ? pageTitle : '' }) %>

<div class="vt-page">
  <div class="vt-wrap vt-wrap--narrow">

    <a href="/cars" class="vt-back-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      <%= lang === 'es' ? 'Volver a coches' : 'Back to cars' %>
    </a>

    <h1>
      <% if (car) { %>
        <%= lang === 'es' ? 'Editar coche' : 'Edit car' %>
      <% } else { %>
        <%= lang === 'es' ? 'Nuevo coche' : 'New car' %>
      <% } %>
    </h1>

    <% if (error) { %>
      <div class="vt-alert" style="margin-top:16px">
        <p><strong><%= lang === 'es' ? 'Error' : 'Error' %>:</strong> <%= error %></p>
      </div>
    <% } %>

    <form action="<%= car ? '/cars/' + car.id : '/cars' %>" method="POST" class="vt-panel">

      <div class="vt-fields vt-fields--2">
        <div class="vt-field">
          <label><%= lang === 'es' ? 'Marca' : 'Brand' %> *</label>
          <input class="vt-inp" type="text" id="brand" name="brand" maxlength="50" list="brandList"
            value="<%= car?.brand || '' %>"
            placeholder="<%= lang === 'es' ? 'Ej: Slot.it, NSR' : 'E.g: Slot.it, NSR' %>"
            autocomplete="off" autofocus required>
          <datalist id="brandList">
            <% brands.forEach(b => { %><option value="<%= b %>"><% }) %>
          </datalist>
        </div>

        <div class="vt-field">
          <label><%= lang === 'es' ? 'Modelo' : 'Model' %> *</label>
          <input class="vt-inp" type="text" name="model" maxlength="100"
            value="<%= car?.model || '' %>"
            placeholder="<%= lang === 'es' ? 'Ej: Ferrari 360 GTC' : 'E.g: Ferrari 360 GTC' %>"
            autocomplete="off" required>
        </div>
      </div>

      <div class="vt-form-group" style="margin-top:18px">
        <label class="vt-form-group__label" for="category"><%= lang === 'es' ? 'Categoría' : 'Category' %> *</label>
        <input class="vt-inp" type="text" id="category" name="category_name" maxlength="100" list="categoryList"
          value="<%= car?.category_name || '' %>"
          placeholder="<%= lang === 'es' ? 'Escribe o selecciona…' : 'Type or select…' %>"
          autocomplete="off" required>
        <datalist id="categoryList">
          <% categories.forEach(cat => { %><option value="<%= cat.name %>"><% }) %>
        </datalist>
        <p class="vt-hint">
          <%= lang === 'es'
            ? 'Categoría a la que pertenece este coche. Escribe el nombre o selecciona una existente.'
            : 'Category this car belongs to. Type a name or select an existing one.' %>
        </p>
      </div>

      <div class="vt-form-group">
        <label class="vt-form-group__label" for="description"><%= lang === 'es' ? 'Descripción' : 'Description' %></label>
        <textarea class="vt-inp" id="description" name="description" rows="3" maxlength="200"
          style="height:auto;padding-top:12px;padding-bottom:12px;line-height:1.5;resize:vertical"
          placeholder="<%= lang === 'es' ? 'Descripción opcional…' : 'Optional description…' %>"><%= car?.description || '' %></textarea>
        <p class="vt-hint"><%= lang === 'es' ? 'Información adicional sobre este coche.' : 'Additional information about this car.' %></p>
      </div>

      <div class="vt-form-actions">
        <a href="/cars" class="vt-btn vt-btn--ghost"><%= lang === 'es' ? 'Cancelar' : 'Cancel' %></a>
        <button type="submit" class="vt-btn vt-btn--primary">
          <% if (car) { %>
            <%= lang === 'es' ? 'Guardar cambios' : 'Save changes' %>
          <% } else { %>
            <%= lang === 'es' ? 'Crear coche' : 'Create car' %>
          <% } %>
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
