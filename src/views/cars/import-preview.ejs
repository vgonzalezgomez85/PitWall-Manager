<%- include('../partials/header', { pageTitle: t('import-preview.previsualizar_importacion_de_coches') }) %>

<div class="vt-page">
  <div class="vt-wrap">

    <a href="/cars" class="vt-back-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      <%= t('client.common.cancelar') %>
    </a>

    <div class="vt-head">
      <div class="vt-head__title">
        <h1><%= t('import-preview.previsualizacion') %></h1>
        <span class="vt-cnt"><%= stats.total %> <%= t('import-preview.filas') %></span>
      </div>
    </div>

    <p class="vt-lead" style="margin-top:8px">
      <%= t('import-preview.los_duplicados_se_detectan_por_marca_modelo_por') %>
    </p>

    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:18px">
      <span class="vt-badge is-ok"><span class="vt-badge__d"></span><%= stats.new %> <%= t('import-preview.nuevos') %></span>
      <span class="vt-badge is-warn"><span class="vt-badge__d"></span><%= stats.duplicate %> <%= t('import-preview.duplicados') %></span>
      <% if (stats.error > 0) { %><span class="vt-badge is-bad"><span class="vt-badge__d"></span><%= stats.error %> <%= t('import-preview.con_errores') %></span><% } %>
    </div>

    <form action="/cars/import" method="POST">
      <input type="hidden" name="csv_content" value="<%= csv_content %>">

      <% if (stats.duplicate > 0) { %>
        <div class="vt-card" style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
          <strong style="color:var(--vt-mute);font-size:13px;text-transform:uppercase;letter-spacing:.1em">
            <%= t('import-preview.aplicar_a_todos_los_duplicados') %>
          </strong>
          <button type="button" class="vt-btn vt-btn--ghost vt-btn--sm" data-bulk="update"><%= t('import-preview.actualizar_todos') %></button>
          <button type="button" class="vt-btn vt-btn--ghost vt-btn--sm" data-bulk="skip"><%= t('import-preview.omitir_todos') %></button>
          <button type="button" class="vt-btn vt-btn--ghost vt-btn--sm" data-bulk="duplicate"><%= t('import-preview.crear_duplicados') %></button>
        </div>
      <% } %>

      <div class="vt-table-card" style="margin-top:16px">
        <table class="vt-table">
          <thead>
            <tr>
              <th style="width:48px">#</th>
              <th style="width:120px"><%= t('common.estado') %></th>
              <th><%= t('common.marca') %></th>
              <th><%= t('common.modelo') %></th>
              <th><%= t('client.common.categoria') %></th>
              <th><%= t('common.descripcion') %></th>
              <th><%= t('import-preview.accion') %></th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach(r => { %>
              <tr>
                <td class="is-mono is-mute"><%= r.idx + 1 %></td>
                <td>
                  <% if (r.status === 'new') { %>
                    <span class="vt-badge is-ok"><span class="vt-badge__d"></span><%= t('common.nuevo') %></span>
                  <% } else if (r.status === 'duplicate') { %>
                    <span class="vt-badge is-warn"><span class="vt-badge__d"></span><%= t('import-preview.duplicado_en_bd') %></span>
                  <% } else if (r.status === 'duplicate_in_csv') { %>
                    <span class="vt-badge is-warn"><span class="vt-badge__d"></span><%= t('import-preview.repetido_en_csv') %></span>
                  <% } else { %>
                    <span class="vt-badge is-bad"><span class="vt-badge__d"></span><%= t('client.common.error') %></span>
                  <% } %>
                </td>
                <td class="is-name"><%= r.brand || '—' %></td>
                <td class="is-name">
                  <%= r.model || '—' %>
                  <% if (r.status === 'duplicate' && r.existing) { %>
                    <div style="font-size:11.5px;color:var(--vt-mute);margin-top:3px;font-family:'IBM Plex Mono',monospace">
                      → <%= t('import-preview.existente') %><%= r.existing.brand %> <%= r.existing.model %>
                    </div>
                  <% } else if (r.status === 'duplicate_in_csv') { %>
                    <div style="font-size:11.5px;color:var(--vt-mute);margin-top:3px;font-family:'IBM Plex Mono',monospace">
                      → <%= t('import-preview.fila') %><%= r.existingIdx + 1 %>
                    </div>
                  <% } else if (r.status === 'error') { %>
                    <div style="font-size:11.5px;color:var(--vt-red);margin-top:3px">
                      <%= r.reason === 'missing_brand_or_model'
                        ? (t('import-preview.falta_marca_o_modelo'))
                        : (t('import-preview.falta_categoria')) %>
                    </div>
                  <% } %>
                </td>
                <td>
                  <% if (r.categoryName) { %>
                    <span class="vt-badge is-info" style="font-size:11.5px"><span class="vt-badge__d"></span><%= r.categoryName %></span>
                    <% if (r.status === 'duplicate' && r.existing && r.existing.category_name && r.existing.category_name !== r.categoryName) { %>
                      <div style="font-size:11.5px;color:var(--vt-mute);margin-top:3px;font-family:'IBM Plex Mono',monospace">
                        <%= t('import-preview.antes') %><%= r.existing.category_name %>
                      </div>
                    <% } %>
                  <% } else { %>
                    <span class="is-mute">—</span>
                  <% } %>
                </td>
                <td class="is-mute" style="max-width:200px">
                  <%= r.description || '—' %>
                  <% if (r.status === 'duplicate' && r.existing && r.existing.description && r.existing.description !== r.description) { %>
                    <div style="font-size:11.5px;color:var(--vt-mute-2);margin-top:3px;font-family:'IBM Plex Mono',monospace">
                      <%= t('import-preview.antes') %><%= r.existing.description %>
                    </div>
                  <% } %>
                </td>
                <td>
                  <% if (r.status === 'new') { %>
                    <span class="vt-badge is-ok" style="font-size:11.5px"><%= t('import-preview.crear') %></span>
                  <% } else if (r.status === 'error') { %>
                    <span class="vt-badge is-neutral" style="font-size:11.5px"><%= t('import-preview.omitir') %></span>
                  <% } else { %>
                    <div class="vt-selw" style="min-width:160px">
                      <select name="decisions[<%= r.idx %>]" class="vt-dup-action" style="height:36px">
                        <option value="update" selected><%= t('import-preview.actualizar') %></option>
                        <option value="skip"><%= t('import-preview.omitir') %></option>
                        <option value="duplicate"><%= t('import-preview.crear_duplicado') %></option>
                      </select>
                    </div>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <div class="vt-form-actions">
        <a href="/cars" class="vt-btn vt-btn--ghost"><%= t('client.common.cancelar') %></a>
        <button type="submit" class="vt-btn vt-btn--primary vt-btn--lg">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4L19 7"/></svg>
          <%= t('import-preview.confirmar_importacion') %>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
document.querySelectorAll('[data-bulk]').forEach(btn => {
  btn.addEventListener('click', () => {
    const v = btn.dataset.bulk;
    document.querySelectorAll('.vt-dup-action').forEach(sel => { sel.value = v; });
  });
});
</script>

<%- include('../partials/footer') %>
