<%- include('../partials/header', { lang, pageTitle: lang === 'es' ? 'Coches' : 'Cars' }) %>

<div class="vt-page">
  <div class="vt-wrap">

    <a href="/" class="vt-back-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      <%= lang === 'es' ? 'Inicio' : 'Home' %>
    </a>

    <% if (flash) { %>
      <div class="flash flash--<%= flash.type %>" style="margin-bottom:1rem"><%- flash.text %></div>
    <% } %>

    <div class="vt-head">
      <div class="vt-head__title">
        <h1><%= lang === 'es' ? 'Coches' : 'Cars' %></h1>
        <span class="vt-cnt"><%= cars.length %></span>
      </div>
      <div class="vt-head__actions">
        <a href="/plantilla_coches.csv" download class="vt-btn vt-btn--ghost vt-btn--sm">
          <svg viewBox="0 0 24 24"><path d="M12 4v12M6 11l6 6 6-6M5 21h14"/></svg>
          <%= lang === 'es' ? 'Plantilla CSV' : 'CSV Template' %>
        </a>
        <button type="button" class="vt-btn vt-btn--ghost vt-btn--sm" id="toggleCsv">
          <svg viewBox="0 0 24 24"><path d="M14 3h5a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"/><path d="M12 3v12M8 11l4 4 4-4"/></svg>
          <%= lang === 'es' ? 'Importar CSV' : 'Import CSV' %>
        </button>
        <a href="/cars/new" class="vt-btn vt-btn--primary">
          + <%= lang === 'es' ? 'Nuevo coche' : 'New car' %>
        </a>
      </div>
    </div>

    <!-- CSV Import panel -->
    <div id="csv-import-panel" style="display:none;margin-top:18px">
      <div class="vt-card">
        <div class="vt-card-h">
          <svg viewBox="0 0 24 24"><path d="M14 3h5a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"/></svg>
          <%= lang === 'es' ? 'Importar coches desde CSV' : 'Import cars from CSV' %>
        </div>
        <p class="vt-hint" style="margin-bottom:12px">
          <%= lang === 'es'
            ? 'CSV con cabecera: marca,modelo,categoria,descripcion (descripción opcional). Las categorías inexistentes se crean automáticamente.'
            : 'CSV with header: brand,model,category,description (description optional). Missing categories are created automatically.' %>
        </p>
        <form action="/cars/import" method="POST" id="csv-form">
          <input type="hidden" name="csv_content" id="csv-content-input">
          <div class="vt-csv-row">
            <input type="file" id="csv-file-picker" accept=".csv,text/csv">
            <span id="csv-file-name" class="vt-hint"></span>
            <button type="submit" id="csv-submit" class="vt-btn vt-btn--primary vt-btn--sm" disabled>
              <%= lang === 'es' ? 'Importar' : 'Import' %>
            </button>
          </div>
        </form>
      </div>
    </div>

    <% if (cars.length === 0) { %>
      <div class="vt-empty" style="margin-top:32px">
        <div class="vt-empty__t"><%= lang === 'es' ? 'Sin coches' : 'No cars' %></div>
        <p style="color:var(--vt-mute);margin:6px 0 16px"><%= lang === 'es' ? 'Añade tu primer coche al catálogo.' : 'Add your first car to the catalog.' %></p>
        <a href="/cars/new" class="vt-btn vt-btn--primary"><%= lang === 'es' ? 'Crear primer coche' : 'Create first car' %></a>
      </div>
    <% } else { %>

      <div class="vt-table-card">
        <table class="vt-table">
          <thead>
            <tr>
              <th><%= lang === 'es' ? 'Marca' : 'Brand' %></th>
              <th><%= lang === 'es' ? 'Modelo' : 'Model' %></th>
              <th><%= lang === 'es' ? 'Categoría' : 'Category' %></th>
              <th><%= lang === 'es' ? 'Descripción' : 'Description' %></th>
              <th><%= lang === 'es' ? 'Creado' : 'Created' %></th>
              <th class="is-actions"></th>
            </tr>
          </thead>
          <tbody>
            <% cars.forEach(car => {
              const created = car.created_at
                ? new Date(car.created_at.replace(' ', 'T') + 'Z').toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US')
                : '—';
            %>
              <tr>
                <td class="is-name"><%= car.brand %></td>
                <td class="is-name"><%= car.model %></td>
                <td>
                  <% if (car.category_name) { %>
                    <span class="vt-badge is-info"><span class="vt-badge__d"></span><%= car.category_name %></span>
                  <% } else { %>
                    <span class="is-mute">—</span>
                  <% } %>
                </td>
                <td class="is-mute"><%= car.description || '—' %></td>
                <td class="is-mute is-mono"><%= created %></td>
                <td class="is-actions">
                  <a href="/cars/<%= car.id %>/edit" class="vt-icon-btn" title="<%= lang === 'es' ? 'Editar' : 'Edit' %>">
                    <svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                  </a>
                  <form action="/cars/<%= car.id %>/delete" method="POST" style="display:inline"
                        onsubmit="return confirm('<%= lang === 'es' ? '¿Eliminar coche?' : 'Delete car?' %>')">
                    <button type="submit" class="vt-icon-btn is-danger" title="<%= lang === 'es' ? 'Eliminar' : 'Delete' %>">
                      <svg viewBox="0 0 24 24"><path d="M4 7h16M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M6 7l1 13a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-13"/></svg>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

  </div>
</div>

<script>
document.getElementById('toggleCsv')?.addEventListener('click', () => {
  const p = document.getElementById('csv-import-panel');
  p.style.display = p.style.display === 'none' ? '' : 'none';
});
document.getElementById('csv-file-picker')?.addEventListener('change', function() {
  const file = this.files[0];
  if (!file) return;
  document.getElementById('csv-file-name').textContent = file.name;
  const reader = new FileReader();
  reader.onload = e => {
    document.getElementById('csv-content-input').value = e.target.result;
    document.getElementById('csv-submit').disabled = false;
  };
  reader.readAsText(file, 'UTF-8');
});
</script>

<%- include('../partials/footer') %>
