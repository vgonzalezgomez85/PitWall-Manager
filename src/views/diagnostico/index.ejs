<%- include('../partials/header', { lang, pageTitle: 'Solución de problemas' }) %>

<%
const boundary = !!timing.tandaBoundary;
const allOk = link.connected && !boundary && stuck.length === 0;
const serialKind = link.simulating ? 'warn' : (link.connected ? 'ok' : 'bad');
const serialText = link.simulating ? 'Simulación' : (link.connected ? 'Conectado' : 'Sin conexión');
const issues = [];
if (stuck.length) issues.push({ sec: 'stuck', kind: 'bad', t: stuck.length + (stuck.length === 1 ? ' manga atascada' : ' mangas atascadas'), d: 'Figuran como activas en la base de datos pero no están corriendo.' });
if (!link.connected && !link.simulating) issues.push({ sec: 'serial', kind: 'bad', t: 'El cronómetro no está conectado', d: 'No llegan cruces. Revisa el cable o reconecta el serial.' });
if (boundary) issues.push({ sec: 'timing', kind: 'warn', t: 'Límite de tanda activo', d: 'El próximo GO se ignorará hasta limpiarlo.' });
const navItems = [
  { key: 'status', label: 'Estado', dot: allOk ? 'ok' : (issues.some(i => i.kind === 'bad') ? 'bad' : 'warn'),
    icon: '<path d="M3 12h4l3-8 4 16 3-8h4"/>' },
  { key: 'timing', label: 'Cronometraje', dot: boundary || timing.pendingSetup ? 'warn' : (timing.isRunning ? 'ok' : ''),
    icon: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 1.5M9 2h6M12 2v3"/>' },
  { key: 'serial', label: 'Cronómetro', dot: serialKind,
    icon: '<path d="M9 2v5M15 2v5M7 7h10v3a5 5 0 0 1-10 0zM12 15v6"/>' },
  { key: 'stuck', label: 'Mangas atascadas', dot: stuck.length ? 'bad' : '',
    icon: '<path d="M10.3 3.8 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.8a2 2 0 0 0-3.4 0z"/><path d="M12 9v4M12 17h.01"/>' },
  { key: 'conn', label: 'Conexiones', dot: '',
    icon: '<circle cx="9" cy="8" r="3"/><circle cx="17" cy="9.5" r="2.3"/><path d="M3 20v-1a5 5 0 0 1 5-5h2a5 5 0 0 1 5 5v1M16 14a4 4 0 0 1 5 4v1"/>' },
];
const warnIco = '<svg class="dg-warn" viewBox="0 0 24 24"><path d="M10.3 3.8 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.8a2 2 0 0 0-3.4 0z"/><path d="M12 9v4M12 17h.01"/></svg>';
%>

<div class="vt-page st-page">
  <div class="st-top">
    <a href="/" class="vt-back-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Inicio
    </a>
    <span class="st-top__sep"></span>
    <h1 class="st-top__h">Solución de problemas</h1>
    <span class="st-top__fill"></span>
    <div class="vt-port-pill <%= allOk ? '' : (issues.some(i => i.kind === 'bad') ? 'is-off' : 'is-sim') %>">
      <span class="dot"></span> <%= allOk ? 'Sin incidencias' : (issues.length === 1 ? '1 incidencia' : issues.length + ' incidencias') %>
    </div>
  </div>

  <div class="st-layout">
    <nav class="st-nav" aria-label="Secciones">
      <% navItems.forEach(it => { %>
        <button type="button" class="st-nav__item <%= it.key === 'status' ? 'is-active' : '' %>" data-sec="<%= it.key %>">
          <svg viewBox="0 0 24 24"><%- it.icon %></svg>
          <span class="st-nav__lbl"><%= it.label %></span>
          <span class="st-dot <%= it.dot ? 'st-dot--' + it.dot : '' %>"></span>
        </button>
      <% }) %>
      <div class="st-nav__note">
        <span><%- warnIco %> Las acciones en rojo borran datos. Todas piden confirmación.</span>
      </div>
    </nav>

    <div class="st-main">

      <!-- ══ Estado ══════════════════════════════════════════════════════ -->
      <section class="st-sec is-active" data-sec="status">
        <header class="st-sec__h">
          <h2>Estado</h2>
          <p>Cómo está el sistema ahora mismo y qué hay que revisar.</p>
        </header>

        <div class="st-card">
          <div class="db-stats dg-stats">
            <div class="db-stat">
              <div class="dg-stat__v"><span class="st-dot st-dot--<%= serialKind %>"></span><%= serialText %></div>
              <div class="db-stat__l">Cronómetro</div>
            </div>
            <div class="db-stat">
              <div class="dg-stat__v"><span class="st-dot <%= timing.isRunning ? 'st-dot--ok' : 'st-dot--off' %>"></span><%= timing.isRunning ? 'En curso' : 'Parada' %></div>
              <div class="db-stat__l">Manga</div>
            </div>
            <div class="db-stat">
              <div class="dg-stat__v"><span class="st-dot <%= boundary ? 'st-dot--warn' : 'st-dot--ok' %>"></span><%= boundary ? 'Bloquea GO' : 'Libre' %></div>
              <div class="db-stat__l">Límite de tanda</div>
            </div>
            <div class="db-stat">
              <div class="dg-stat__v"><span class="st-dot <%= stuck.length ? 'st-dot--bad' : 'st-dot--ok' %>"></span><%= stuck.length %></div>
              <div class="db-stat__l">Mangas atascadas</div>
            </div>
          </div>
        </div>

        <% if (allOk) { %>
          <div class="st-card">
            <div class="st-row">
              <span class="dg-ok"><svg viewBox="0 0 24 24"><path d="M5 12l4 4L19 7"/></svg></span>
              <div class="st-row__txt">
                <div class="st-row__t">Todo en orden</div>
                <div class="st-row__d">No hay incidencias detectadas.</div>
              </div>
            </div>
          </div>
        <% } else { %>
          <div class="st-card">
            <% issues.forEach(i => { %>
              <button type="button" class="st-row st-row--link dg-issue" data-goto="<%= i.sec %>">
                <span class="st-dot st-dot--lg st-dot--<%= i.kind %>"></span>
                <span class="st-row__txt">
                  <span class="st-row__t"><%= i.t %></span>
                  <span class="st-row__d"><%= i.d %></span>
                </span>
                <span class="dg-go">Revisar</span>
                <svg class="st-chev" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
              </button>
            <% }) %>
          </div>
        <% } %>
      </section>

      <!-- ══ Cronometraje ═════════════════════════════════════════════════ -->
      <section class="st-sec" data-sec="timing">
        <header class="st-sec__h">
          <h2>Cronometraje</h2>
          <p>La manga que se está cronometrando y lo que espera al próximo GO.</p>
        </header>
        <div class="st-card">
          <div class="st-row st-row--wrap">
            <div class="st-row__txt"><div class="st-row__t">Manga activa</div></div>
            <% if (timing.activeMangaLabel) { %>
              <span class="dg-val"><span class="st-dot st-dot--ok"></span><span class="vt-mono"><%= timing.activeMangaLabel %></span></span>
            <% } else { %>
              <span class="dg-val dg-val--mute">Ninguna</span>
            <% } %>
          </div>
          <div class="st-row st-row--wrap">
            <div class="st-row__txt">
              <div class="st-row__t">Límite de tanda</div>
              <div class="st-row__d">Al acabar una tanda, PitWall ignora el GO hasta que se prepara la siguiente.</div>
            </div>
            <span class="dg-val"><span class="st-dot <%= boundary ? 'st-dot--warn' : 'st-dot--ok' %>"></span><%= boundary ? 'Activo (bloquea GO)' : 'Libre' %></span>
          </div>
          <div class="st-row st-row--wrap">
            <div class="st-row__txt">
              <div class="st-row__t">Preparada para el próximo GO</div>
              <div class="st-row__d">La manga que arrancará con el próximo GO.</div>
            </div>
            <% if (timing.pendingSetup) { %>
              <span class="dg-val"><span class="st-dot st-dot--warn"></span><span class="vt-mono"><%= timing.pendingSetup.label %></span></span>
            <% } else { %>
              <span class="dg-val dg-val--mute">Ninguna</span>
            <% } %>
          </div>
        </div>

        <% if (boundary || timing.isRunning || timing.pendingSetup) { %>
          <div class="st-card">
            <% if (boundary) { %>
              <form class="st-row st-row--wrap" action="/diagnostico/clear-boundary" method="POST" onsubmit="return confirm('¿Limpiar el boundary de tanda? El próximo GO será aceptado.');">
                <div class="st-row__txt">
                  <div class="st-row__t">Limpiar límite de tanda</div>
                  <div class="st-row__d">El próximo GO se aceptará. No borra nada.</div>
                </div>
                <button class="vt-btn vt-btn--ghost" type="submit">Limpiar límite</button>
              </form>
            <% } %>
            <% if (timing.isRunning) { %>
              <form class="st-row st-row--wrap" action="/diagnostico/cancel-active" method="POST" onsubmit="return confirm('¿Cancelar la manga activa? Se ELIMINARÁN todas sus vueltas y volverá a pending.');">
                <div class="st-row__txt">
                  <div class="st-row__t">Cancelar manga activa</div>
                  <div class="st-row__d dg-danger-d"><%- warnIco %> Borra todas sus vueltas y la deja pendiente.</div>
                </div>
                <button class="vt-btn vt-btn--danger" type="submit">Cancelar manga</button>
              </form>
            <% } %>
            <% if (timing.pendingSetup && !timing.isRunning) { %>
              <form class="st-row st-row--wrap" action="/diagnostico/clear-pending" method="POST" onsubmit="return confirm('¿Eliminar el pending setup? El GO quedará sin destino hasta que se vuelva a abrir una vista live.');">
                <div class="st-row__txt">
                  <div class="st-row__t">Quitar la manga preparada</div>
                  <div class="st-row__d dg-danger-d"><%- warnIco %> El GO quedará sin destino hasta que abras de nuevo una vista en directo.</div>
                </div>
                <button class="vt-btn vt-btn--danger" type="submit">Quitar</button>
              </form>
            <% } %>
          </div>
        <% } %>
      </section>

      <!-- ══ Cronómetro (serial) ══════════════════════════════════════════ -->
      <section class="st-sec" data-sec="serial">
        <header class="st-sec__h">
          <h2>Cronómetro</h2>
          <p>La conexión con el cronometraje (o la simulación).</p>
        </header>
        <div class="st-card">
          <div class="st-row st-row--wrap">
            <div class="st-row__txt"><div class="st-row__t">Estado</div></div>
            <span class="dg-val"><span class="st-dot st-dot--<%= serialKind %>"></span><%= serialText %></span>
          </div>
          <div class="st-row st-row--wrap">
            <div class="st-row__txt"><div class="st-row__t">Modo</div></div>
            <span class="dg-val"><%= link.simulating ? 'Simulación' : 'Serial (USB/RS-232)' %></span>
          </div>
          <div class="st-row st-row--wrap st-row--top">
            <div class="st-row__txt"><div class="st-row__t">Puertos</div></div>
            <div class="st-addrs">
              <% if (link.ports && link.ports.length) { %>
                <% link.ports.forEach(p => { %><div><%= p %></div><% }) %>
              <% } else { %>
                <span>—</span>
              <% } %>
            </div>
          </div>
        </div>
        <div class="st-card">
          <form class="st-row st-row--wrap" action="/diagnostico/reconnect-serial" method="POST" onsubmit="return confirm('¿Forzar reconexión del Serial / Simulación?');">
            <div class="st-row__txt">
              <div class="st-row__t">Reconectar</div>
              <div class="st-row__d">Cierra y vuelve a abrir los puertos. No borra nada.</div>
            </div>
            <button class="vt-btn vt-btn--ghost" type="submit">Reconectar serial</button>
          </form>
          <a class="st-row st-row--link" href="/diagnostico/tramas">
            <div class="st-row__txt">
              <div class="st-row__t">Visor de tramas en vivo</div>
              <div class="st-row__d">Las tramas del cronómetro según llegan.</div>
            </div>
            <svg class="st-chev" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
          </a>
        </div>
      </section>

      <!-- ══ Mangas atascadas ═════════════════════════════════════════════ -->
      <section class="st-sec" data-sec="stuck">
        <header class="st-sec__h">
          <h2>Mangas atascadas</h2>
          <p>Mangas que figuran como activas en la base de datos pero no están corriendo (por ejemplo, tras un cierre inesperado).</p>
        </header>
        <div class="st-card">
          <% if (stuck.length === 0) { %>
            <div class="st-row">
              <span class="dg-ok"><svg viewBox="0 0 24 24"><path d="M5 12l4 4L19 7"/></svg></span>
              <div class="st-row__txt"><div class="st-row__t">No hay mangas atascadas</div></div>
            </div>
          <% } else { %>
            <% stuck.forEach(m => { %>
              <form class="st-row st-row--wrap" action="/diagnostico/reset-manga/<%= m.id %>" method="POST"
                    onsubmit="return confirm('¿Resetear manga <%= m.id %>? Se eliminarán <%= m.lap_count %> vueltas y volverá a pending.');">
                <span class="st-dot st-dot--lg st-dot--bad"></span>
                <div class="st-row__txt">
                  <div class="st-row__t">Tanda <%= m.tanda_number %> · Manga <%= m.number %> <span class="dg-id">#<%= m.id %></span></div>
                  <div class="st-row__d">
                    <a href="/races/<%= m.race_id %>">Carrera <%= m.race_id %></a>
                    · iniciada <span class="vt-mono"><%= m.started_at || '—' %></span>
                    · <%= m.lap_count %> vueltas
                  </div>
                </div>
                <button class="vt-btn vt-btn--danger vt-btn--sm" type="submit">Resetear</button>
              </form>
            <% }) %>
          <% } %>
        </div>
        <% if (stuck.length) { %>
          <div class="st-row__d dg-danger-d dg-note"><%- warnIco %> Resetear borra las vueltas de esa manga y la deja pendiente.</div>
        <% } %>
      </section>

      <!-- ══ Conexiones ═══════════════════════════════════════════════════ -->
      <section class="st-sec" data-sec="conn">
        <header class="st-sec__h">
          <h2>Conexiones</h2>
          <p>Dispositivos conectados ahora mismo, sin contar este equipo. Se actualiza solo.</p>
        </header>
        <div class="st-card">
          <div class="db-stats dg-stats--3">
            <div class="db-stat">
              <div class="db-stat__n" id="conn-web"><%= connections.web %></div>
              <div class="db-stat__l">Navegadores</div>
            </div>
            <div class="db-stat">
              <div class="db-stat__n" id="conn-mobile"><%= connections.mobile %></div>
              <div class="db-stat__l">App móvil</div>
            </div>
            <div class="db-stat">
              <div class="db-stat__n" id="conn-infolap"><%= connections.infolap %></div>
              <div class="db-stat__l">Infolap</div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
  const DG_SECS = Array.from(document.querySelectorAll('.st-sec')).map(s => s.dataset.sec);
  function showSection(sec) {
    if (!DG_SECS.includes(sec)) sec = DG_SECS[0];
    document.querySelectorAll('.st-sec').forEach(s => s.classList.toggle('is-active', s.dataset.sec === sec));
    document.querySelectorAll('.st-nav__item').forEach(b => {
      const on = b.dataset.sec === sec;
      b.classList.toggle('is-active', on);
      if (on) b.setAttribute('aria-current', 'true'); else b.removeAttribute('aria-current');
    });
    try { sessionStorage.setItem('pw.diag.sec', sec); } catch {}
  }
  function goSection(sec) {
    showSection(sec);
    history.replaceState(null, '', '#' + sec);
  }
  document.querySelectorAll('.st-nav__item').forEach(b => b.addEventListener('click', () => goSection(b.dataset.sec)));
  document.querySelectorAll('[data-goto]').forEach(b => b.addEventListener('click', () => goSection(b.dataset.goto)));
  (function () {
    let saved = null;
    try { saved = sessionStorage.getItem('pw.diag.sec'); } catch {}
    showSection(location.hash.slice(1) || saved || DG_SECS[0]);
  })();

  // Actualización en vivo de las cuentas de conexiones (excluye localhost).
  (function () {
    const s = io();
    s.on('connections', (c) => {
      const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
      set('conn-web', c.web); set('conn-mobile', c.mobile); set('conn-infolap', c.infolap);
    });
  })();
</script>

<%- include('../partials/footer') %>
