<%- include('../partials/header', { lang, pageTitle: 'Solución de problemas' }) %>

<%
const allOk = link.connected && !timing.tandaBoundary && stuck.length === 0;
const healthCls = allOk ? '' : (stuck.length > 0 || !link.connected ? 'is-bad' : 'is-warn');
%>

<div class="vt-page">
  <div class="vt-wrap vt-wrap--narrow">

    <a href="/" class="vt-back-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Inicio
    </a>

    <% if (flash) { %>
      <div class="flash flash--<%= flash.type %>" style="margin-bottom:1rem"><%- flash.text %></div>
    <% } %>

    <div class="vt-head" style="align-items:flex-start;justify-content:flex-start;gap:16px;flex-wrap:nowrap">
      <div class="vt-head__icon">
        <svg viewBox="0 0 24 24"><path d="M14.5 6.5a3.5 3.5 0 0 0-4.8 4.4l-5.4 5.4a1.6 1.6 0 0 0 2.3 2.3l5.4-5.4a3.5 3.5 0 0 0 4.4-4.8l-2.3 2.3-2-2z"/></svg>
      </div>
      <div>
        <h1>Solución de problemas</h1>
        <p class="vt-lead">
          Estado actual del sistema y acciones de recuperación.
          <span class="vt-warn-inline">
            <svg viewBox="0 0 24 24"><path d="M10.3 3.8 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.8a2 2 0 0 0-3.4 0z"/><path d="M12 9v4M12 17h.01"/></svg>
            Algunas acciones eliminan datos.
          </span>
        </p>
      </div>
    </div>

    <!-- SALUD GENERAL -->
    <div class="vt-health <%= healthCls %>">
      <div class="vt-health__icon">
        <% if (allOk) { %>
          <svg viewBox="0 0 24 24"><path d="M5 12l4 4L19 7"/></svg>
        <% } else { %>
          <svg viewBox="0 0 24 24"><path d="M10.3 3.8 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.8a2 2 0 0 0-3.4 0z"/><path d="M12 9v4M12 17h.01"/></svg>
        <% } %>
      </div>
      <div>
        <div class="vt-health__t"><%= allOk ? 'Sistema operativo' : 'Atención requerida' %></div>
        <div class="vt-health__s"><%= allOk ? 'Sin incidencias detectadas' : 'Revisa los puntos marcados abajo' %></div>
      </div>
      <div class="vt-health__stats">
        <span class="vt-badge <%= link.connected ? 'is-ok' : (link.simulating ? 'is-warn' : 'is-bad') %>">
          <span class="vt-badge__d"></span>
          <%= link.simulating ? 'Simulación' : (link.connected ? 'Serial conectado' : 'Sin serial') %>
        </span>
        <span class="vt-badge <%= stuck.length === 0 ? 'is-ok' : 'is-bad' %>">
          <span class="vt-badge__d"></span>
          <%= stuck.length === 0 ? 'Sin mangas colgadas' : (stuck.length + ' colgada' + (stuck.length === 1 ? '' : 's')) %>
        </span>
        <span class="vt-badge <%= timing.isRunning ? 'is-ok is-live' : 'is-neutral' %>">
          <span class="vt-badge__d"></span>
          <%= timing.isRunning ? 'Carrera en curso' : 'Sin carrera activa' %>
        </span>
      </div>
    </div>

    <!-- TIMING -->
    <div class="vt-card">
      <div class="vt-card-h">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 1.5M9 2h6M12 2v3"/></svg>
        Timing
      </div>
      <div class="vt-row">
        <div class="vt-row__k">En carrera</div>
        <div class="vt-row__v">
          <span class="vt-badge <%= timing.isRunning ? 'is-ok is-live' : 'is-neutral' %>">
            <span class="vt-badge__d"></span> <%= timing.isRunning ? 'Sí' : 'No' %>
          </span>
        </div>
      </div>
      <div class="vt-row">
        <div class="vt-row__k">Manga activa</div>
        <div class="vt-row__v">
          <% if (timing.activeMangaLabel) { %>
            <span class="vt-mono"><%= timing.activeMangaLabel %></span>
          <% } else { %>
            <span style="color:var(--vt-mute-2)">Ninguna</span>
          <% } %>
        </div>
      </div>
      <div class="vt-row">
        <div class="vt-row__k">Límite de tanda</div>
        <div class="vt-row__v">
          <span class="vt-badge <%= timing.tandaBoundary ? 'is-warn' : 'is-ok' %>">
            <span class="vt-badge__d"></span>
            <%= timing.tandaBoundary ? 'Activo (bloquea GO)' : 'Libre' %>
          </span>
        </div>
      </div>
      <div class="vt-row">
        <div class="vt-row__k">Configuración pendiente</div>
        <div class="vt-row__v">
          <% if (timing.pendingSetup) { %>
            <span class="vt-badge is-warn"><span class="vt-badge__d"></span> <%= timing.pendingSetup.label %></span>
            <span class="vt-note">(pending)</span>
          <% } else { %>
            <span style="color:var(--vt-mute-2)">Ninguna</span>
          <% } %>
        </div>
      </div>

      <% if (timing.tandaBoundary || timing.isRunning || timing.pendingSetup) { %>
        <div class="vt-actions">
          <% if (timing.tandaBoundary) { %>
            <form action="/diagnostico/clear-boundary" method="POST" style="display:inline" onsubmit="return confirm('¿Limpiar el boundary de tanda? El próximo GO del DS-300 será aceptado.');">
              <button class="vt-btn vt-btn--ghost" type="submit">
                <svg viewBox="0 0 24 24"><path d="M5 12h14"/></svg> Limpiar boundary
              </button>
            </form>
          <% } %>
          <% if (timing.isRunning) { %>
            <form action="/diagnostico/cancel-active" method="POST" style="display:inline" onsubmit="return confirm('¿Cancelar la manga activa? Se ELIMINARÁN todas sus vueltas y volverá a pending.');">
              <button class="vt-btn vt-btn--danger" type="submit">
                <svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg> Cancelar manga activa
              </button>
            </form>
            <span class="vt-act-note">
              <svg viewBox="0 0 24 24"><path d="M10.3 3.8 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.8a2 2 0 0 0-3.4 0z"/></svg>
              Elimina datos
            </span>
          <% } %>
          <% if (timing.pendingSetup && !timing.isRunning) { %>
            <form action="/diagnostico/clear-pending" method="POST" style="display:inline" onsubmit="return confirm('¿Eliminar el pending setup? El GO del DS-300 quedará sin destino hasta que se vuelva a abrir una vista live.');">
              <button class="vt-btn vt-btn--danger" type="submit">
                <svg viewBox="0 0 24 24"><path d="M4 7h16M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M6 7l1 13a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-13"/></svg>
                Limpiar pendiente
              </button>
            </form>
            <span class="vt-act-note">
              <svg viewBox="0 0 24 24"><path d="M10.3 3.8 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.8a2 2 0 0 0-3.4 0z"/></svg>
              Elimina datos
            </span>
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- CONEXIONES -->
    <div class="vt-card">
      <div class="vt-card-h">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9.5" r="2.3"/><path d="M3 20v-1a5 5 0 0 1 5-5h2a5 5 0 0 1 5 5v1"/><path d="M16 14a4 4 0 0 1 5 4v1"/></svg>
        Conexiones <span class="vt-note" style="font-weight:400">(no cuenta localhost)</span>
      </div>
      <div class="vt-row">
        <div class="vt-row__k">🌐 Web (navegadores)</div>
        <div class="vt-row__v"><span class="vt-badge is-neutral"><span class="vt-badge__d"></span> <span id="conn-web"><%= connections.web %></span></span></div>
      </div>
      <div class="vt-row">
        <div class="vt-row__k">📱 App móvil</div>
        <div class="vt-row__v"><span class="vt-badge is-neutral"><span class="vt-badge__d"></span> <span id="conn-mobile"><%= connections.mobile %></span></span></div>
      </div>
      <div class="vt-row">
        <div class="vt-row__k">📡 Infolap (móvil legacy)</div>
        <div class="vt-row__v"><span class="vt-badge is-neutral"><span class="vt-badge__d"></span> <span id="conn-infolap"><%= connections.infolap %></span></span></div>
      </div>
    </div>

    <!-- SERIAL -->
    <div class="vt-card">
      <div class="vt-card-h">
        <svg viewBox="0 0 24 24"><path d="M9 2v5M15 2v5M7 7h10v3a5 5 0 0 1-10 0zM12 15v6"/></svg>
        Serial / DS-300
      </div>
      <div class="vt-row">
        <div class="vt-row__k">Conectado</div>
        <div class="vt-row__v">
          <span class="vt-badge <%= link.connected ? 'is-ok' : 'is-bad' %>">
            <span class="vt-badge__d"></span> <%= link.connected ? 'Sí' : 'No' %>
          </span>
        </div>
      </div>
      <div class="vt-row">
        <div class="vt-row__k">Modo</div>
        <div class="vt-row__v"><%= link.simulating ? 'Simulación' : 'Serial (USB/RS-232)' %></div>
      </div>
      <div class="vt-row">
        <div class="vt-row__k">Puertos</div>
        <div class="vt-row__v">
          <% if (link.ports && link.ports.length) { %>
            <% link.ports.forEach(p => { %>
              <span class="vt-mono"><%= p %></span>
            <% }) %>
          <% } else { %>
            <span style="color:var(--vt-mute-2)">—</span>
          <% } %>
        </div>
      </div>
      <div class="vt-actions">
        <form action="/diagnostico/reconnect-serial" method="POST" style="display:inline" onsubmit="return confirm('¿Forzar reconexión del Serial / Simulación?');">
          <button class="vt-btn vt-btn--ghost" type="submit">
            <svg viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-2.6-6.4M21 3v5h-5"/></svg>
            Reconectar serial
          </button>
        </form>
        <span class="vt-act-note" style="color:var(--vt-mute-2)">
          Acción segura · no borra nada
        </span>
      </div>
    </div>

    <!-- MANGAS ATASCADAS -->
    <div class="vt-card<%= stuck.length > 0 ? ' is-alert' : '' %>">
      <div class="vt-card-h">
        <svg viewBox="0 0 24 24"><path d="M10.3 3.8 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.8a2 2 0 0 0-3.4 0z"/><path d="M12 9v4M12 17h.01"/></svg>
        Mangas atascadas
      </div>
      <div class="vt-card-sub">Mangas en BD con status=active pero sin proceso en ejecución.</div>

      <% if (stuck.length === 0) { %>
        <div class="vt-ok-state">
          <svg viewBox="0 0 24 24"><path d="M5 12l4 4L19 7"/></svg>
          No hay mangas colgadas.
        </div>
      <% } else { %>
        <% stuck.forEach(m => { %>
          <div class="vt-stuck-row">
            <div class="vt-stuck-row__main">
              <div class="vt-stuck-row__title">#<%= m.id %> · M<%= m.number %></div>
              <div class="vt-stuck-row__meta">
                <a href="/races/<%= m.race_id %>">R<%= m.race_id %></a>
                · T<%= m.tanda_number %>
                · iniciada <%= m.started_at || '—' %>
                · <%= m.lap_count %> vueltas
              </div>
            </div>
            <form action="/diagnostico/reset-manga/<%= m.id %>" method="POST"
                  onsubmit="return confirm('¿Resetear manga <%= m.id %>? Se eliminarán <%= m.lap_count %> vueltas y volverá a pending.');">
              <button class="vt-btn vt-btn--danger vt-btn--sm" type="submit">
                <svg viewBox="0 0 24 24"><path d="M4 7h16M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M6 7l1 13a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-13"/></svg>
                Resetear
              </button>
            </form>
          </div>
        <% }) %>
      <% } %>
    </div>

    <div class="vt-foot">
      <a class="vt-back" href="/">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Inicio
      </a>
    </div>

  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
  // Actualización en vivo de las cuentas de conexiones (excluye localhost).
  (function () {
    const s = io();
    s.on('connections', (c) => {
      const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
      set('conn-web', c.web); set('conn-mobile', c.mobile); set('conn-infolap', c.infolap);
    });
  })();
</script>

<%- include('../partials/footer') %>
