<%- include('../partials/header', { pageTitle: lang === 'es' ? 'Sincronizar carrera' : 'Sync race' }) %>

<div class="vt-page">
  <div class="vt-wrap vt-wrap--narrow">

    <a href="/" class="vt-back-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      <%= lang === 'es' ? 'Inicio' : 'Home' %>
    </a>

    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="flash flash--<%= flash.type %>" style="margin-bottom:1rem"><%- flash.text %></div>
    <% } %>

    <div class="vt-head">
      <div class="vt-head__title">
        <h1><%= lang === 'es' ? 'Sincronizar carrera desde el maestro' : 'Sync race from master' %></h1>
      </div>
    </div>

    <p class="vt-sub" style="margin:-6px 0 20px;color:var(--vt-mute);max-width:60ch;line-height:1.5">
      <%= lang === 'es'
        ? 'El esclavo (BART) descarga la carrera del maestro (DS) para que ambos tengan el mismo calendario.'
        : 'The slave (BART) downloads the race from the master (DS) so both share the same schedule.' %>
    </p>

    <!-- ── Configuración del enlace (rol / URL / token) ──────────── -->
    <% var _cfg = (typeof linkCfg !== 'undefined' && linkCfg) ? linkCfg : { role:'off', slaveUrl:'', token:'' };
       var _st  = (typeof linkState !== 'undefined' && linkState) ? linkState : { activeMangaId:null, isRunning:false, isPaused:false }; %>
    <div class="vt-panel" style="margin-bottom:18px">
      <div class="vt-sec-lbl"><%= lang === 'es' ? 'Enlace maestro / esclavo' : 'Master / slave link' %></div>

      <p style="color:var(--vt-mute);margin:2px 0 14px;line-height:1.5;max-width:62ch">
        <%= lang === 'es'
          ? 'El MAESTRO (DS) reenvía el estado de carrera al ESCLAVO (BART), que replica GO/pausa/stop sin operador. Con el rol en "off", PitWall funciona como siempre.'
          : 'The MASTER (DS) forwards the race state to the SLAVE (BART), which replays GO/pause/stop with no operator. With role "off", PitWall behaves as usual.' %>
      </p>

      <form id="linkCfgForm" onsubmit="return false">
        <div class="vt-field" style="margin-bottom:12px">
          <label for="linkRole"><%= lang === 'es' ? 'Rol de esta instancia' : 'This instance role' %></label>
          <select id="linkRole" class="vt-inp" style="max-width:260px">
            <option value="off"    <%= _cfg.role === 'off'    ? 'selected' : '' %>><%= lang === 'es' ? 'Off (desactivado)' : 'Off (disabled)' %></option>
            <option value="master" <%= _cfg.role === 'master' ? 'selected' : '' %>>Master (DS)</option>
            <option value="slave"  <%= _cfg.role === 'slave'  ? 'selected' : '' %>>Slave (BART)</option>
          </select>
        </div>

        <div class="vt-field" id="linkSlaveUrlField" style="margin-bottom:12px;<%= _cfg.role === 'master' ? '' : 'display:none' %>">
          <label for="linkSlaveUrl"><%= lang === 'es' ? 'URL del esclavo (solo maestro)' : 'Slave URL (master only)' %></label>
          <input type="text" id="linkSlaveUrl" class="vt-inp is-mono" style="max-width:320px"
                 placeholder="192.168.10.108:3000" autocomplete="off" spellcheck="false"
                 value="<%= _cfg.slaveUrl %>">
        </div>

        <div class="vt-field" style="margin-bottom:14px">
          <label for="linkToken"><%= lang === 'es' ? 'Token compartido' : 'Shared token' %></label>
          <input type="text" id="linkToken" class="vt-inp is-mono" style="max-width:320px"
                 placeholder="secreto" autocomplete="off" spellcheck="false"
                 value="<%= _cfg.token %>">
        </div>

        <div style="display:flex;align-items:center;gap:12px">
          <button type="button" id="btnSaveCfg" class="vt-btn vt-btn--primary">
            <%= lang === 'es' ? 'Guardar enlace' : 'Save link' %>
          </button>
          <span id="cfgMsg" class="link-msg" style="display:none"></span>
        </div>
      </form>

      <div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--vt-line, rgba(255,255,255,.08));color:var(--vt-mute);font-size:13px">
        <strong style="color:var(--vt-text)"><%= lang === 'es' ? 'Estado local del cronómetro:' : 'Local timing state:' %></strong>
        <span id="linkLiveState" class="is-mono">
          <%= _st.activeMangaId != null
              ? ('manga ' + _st.activeMangaId + ' · ' + (_st.isRunning ? 'running' : _st.isPaused ? 'paused' : 'idle'))
              : (lang === 'es' ? 'sin manga activa' : 'no active heat') %>
        </span>
      </div>
    </div>

    <!-- ── Buscar carreras en el maestro ─────────────────────────── -->
    <div class="vt-panel">
      <div class="vt-sec-lbl"><%= lang === 'es' ? 'Dirección del maestro' : 'Master address' %></div>

      <div class="vt-field" style="margin-bottom:14px">
        <label for="masterHost"><%= lang === 'es' ? 'Host o IP:puerto' : 'Host or IP:port' %></label>
        <div style="display:flex;gap:10px;flex-wrap:wrap">
          <input type="text" id="masterHost" class="vt-inp is-mono" placeholder="192.168.1.50:3000"
                 style="flex:1;min-width:220px" autocomplete="off" spellcheck="false">
          <button type="button" id="btnSearch" class="vt-btn vt-btn--primary">
            <%= lang === 'es' ? 'Buscar carreras' : 'Search races' %>
          </button>
        </div>
      </div>

      <div id="searchMsg" class="link-msg" style="display:none"></div>

      <div id="racesWrap" style="display:none;margin-top:8px">
        <div class="vt-table-card">
          <table class="vt-table">
            <thead>
              <tr>
                <th><%= lang === 'es' ? 'Carrera' : 'Race' %></th>
                <th class="is-num"><%= lang === 'es' ? 'Tandas' : 'Rounds' %></th>
                <th class="is-num"><%= lang === 'es' ? 'Pilotos' : 'Drivers' %></th>
                <th><%= lang === 'es' ? 'Clave' : 'Key' %></th>
                <th class="is-actions"></th>
              </tr>
            </thead>
            <tbody id="racesBody"></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ── Importar desde fichero (plan B) ───────────────────────── -->
    <details class="vt-panel" style="margin-top:18px">
      <summary style="cursor:pointer;font-weight:600;color:var(--vt-text);list-style:none;display:flex;align-items:center;gap:8px">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M9 6l6 6-6 6"/></svg>
        <%= lang === 'es' ? 'Importar desde fichero' : 'Import from file' %>
      </summary>

      <p style="color:var(--vt-mute);margin:12px 0 12px;line-height:1.5">
        <%= lang === 'es'
          ? 'Pega el JSON exportado del maestro (ruta /link/races/ID/export.json) si no hay red disponible.'
          : 'Paste the JSON exported from the master (/link/races/ID/export.json) when there is no network.' %>
      </p>

      <div class="vt-field">
        <label for="importJson"><%= lang === 'es' ? 'Contenido JSON' : 'JSON payload' %></label>
        <textarea id="importJson" class="vt-inp is-mono" rows="8"
                  style="resize:vertical;min-height:140px;line-height:1.4"
                  placeholder='{"raceKey":"…","race":{…}}' spellcheck="false"></textarea>
      </div>

      <div style="display:flex;align-items:center;gap:12px;margin-top:12px">
        <button type="button" id="btnImport" class="vt-btn vt-btn--ghost">
          <%= lang === 'es' ? 'Importar' : 'Import' %>
        </button>
        <span id="importMsg" class="link-msg" style="display:none"></span>
      </div>
    </details>

  </div>
</div>

<style>
  .link-msg { font-size: 13.5px; font-weight: 600; padding: 6px 0; }
  .link-msg.is-ok   { color: #8ee6ab; }
  .link-msg.is-warn { color: #f3d579; }
  .link-msg.is-bad  { color: #ff8e95; }
  .link-msg.is-mute { color: var(--vt-mute); font-weight: 500; }
  .link-cell-msg { font-size: 12.5px; font-weight: 600; margin-top: 4px; }
  .link-cell-msg.is-ok   { color: #8ee6ab; }
  .link-cell-msg.is-warn { color: #f3d579; }
  .link-cell-msg.is-bad  { color: #ff8e95; }
</style>

<script>
(function () {
  var LANG = <%- JSON.stringify(lang) %>;
  var T = LANG === 'es'
    ? {
        needHost: 'Escribe la dirección del maestro.',
        searching: 'Buscando…',
        netErr: 'No se pudo conectar. Revisa la red y la dirección.',
        noRaces: 'El maestro no tiene carreras.',
        found: function (n) { return n + (n === 1 ? ' carrera encontrada.' : ' carreras encontradas.'); },
        create: 'Crear aquí',
        creating: 'Creando…',
        created: function (id) { return '✓ Creada (id ' + id + ')'; },
        exists: function (id) { return 'Ya la tienes (id ' + id + ')'; },
        needJson: 'Pega el JSON a importar.',
        badJson: 'El texto no es JSON válido.',
        importing: 'Importando…',
        imported: function (id) { return '✓ Importada (id ' + id + ')'; },
      }
    : {
        needHost: 'Enter the master address.',
        searching: 'Searching…',
        netErr: 'Could not connect. Check the network and address.',
        noRaces: 'The master has no races.',
        found: function (n) { return n + (n === 1 ? ' race found.' : ' races found.'); },
        create: 'Create here',
        creating: 'Creating…',
        created: function (id) { return '✓ Created (id ' + id + ')'; },
        exists: function (id) { return 'Already present (id ' + id + ')'; },
        needJson: 'Paste the JSON to import.',
        badJson: 'The text is not valid JSON.',
        importing: 'Importing…',
        imported: function (id) { return '✓ Imported (id ' + id + ')'; },
      };

  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c];
    });
  }
  function setMsg(el, text, tone) {
    el.className = 'link-msg' + (tone ? ' is-' + tone : '');
    el.textContent = text;
    el.style.display = text ? '' : 'none';
  }

  var hostInp   = document.getElementById('masterHost');
  var btnSearch = document.getElementById('btnSearch');
  var searchMsg = document.getElementById('searchMsg');
  var racesWrap = document.getElementById('racesWrap');
  var racesBody = document.getElementById('racesBody');

  function currentHost() { return (hostInp.value || '').trim(); }

  function fmtType(r) {
    var parts = [];
    if (r.type)   parts.push(r.type);
    if (r.format) parts.push(r.format);
    return parts.join(' · ');
  }

  function renderRaces(races) {
    racesBody.innerHTML = '';
    races.forEach(function (r) {
      var tr = document.createElement('tr');
      var key = r.raceKey ? String(r.raceKey).slice(0, 8) : '—';
      var typeLine = fmtType(r);
      tr.innerHTML =
        '<td class="is-name">' + esc(r.name) +
          (typeLine ? '<div class="is-mute" style="font-weight:500;font-size:12.5px;margin-top:2px">' + esc(typeLine) + '</div>' : '') +
          '<div class="link-cell-msg" style="display:none"></div>' +
        '</td>' +
        '<td class="is-num">' + (r.tandaCount != null ? esc(r.tandaCount) : '—') + '</td>' +
        '<td class="is-num">' + (r.driverCount != null ? esc(r.driverCount) : '—') + '</td>' +
        '<td class="is-mono">' + esc(key) + '</td>' +
        '<td class="is-actions"><button type="button" class="vt-btn vt-btn--ghost vt-btn--sm">' + esc(T.create) + '</button></td>';

      var btn    = tr.querySelector('button');
      var cellMsg = tr.querySelector('.link-cell-msg');
      btn.addEventListener('click', function () { provision(r, btn, cellMsg); });
      racesBody.appendChild(tr);
    });
    racesWrap.style.display = '';
  }

  function provision(race, btn, cellMsg) {
    var host = currentHost();
    if (!host) { setMsg(searchMsg, T.needHost, 'bad'); return; }
    btn.disabled = true;
    var prev = btn.textContent;
    btn.textContent = T.creating;
    cellMsg.style.display = 'none';

    fetch('/link/provision', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ masterUrl: host, raceId: race.id }),
    })
      .then(function (res) { return res.json().then(function (b) { return { status: res.status, body: b }; }); })
      .then(function (r) {
        if (r.status === 200 && r.body.ok) {
          cellMsg.className = 'link-cell-msg is-ok';
          cellMsg.textContent = T.created(r.body.raceId);
          cellMsg.style.display = '';
          btn.textContent = prev;      // keep enabled? leave disabled to avoid dup — re-enable
          btn.disabled = false;
        } else if (r.status === 409) {
          cellMsg.className = 'link-cell-msg is-warn';
          cellMsg.textContent = T.exists(r.body.existingId);
          cellMsg.style.display = '';
          btn.textContent = prev;
          btn.disabled = false;
        } else {
          cellMsg.className = 'link-cell-msg is-bad';
          cellMsg.textContent = (r.body && r.body.error) ? r.body.error : T.netErr;
          cellMsg.style.display = '';
          btn.textContent = prev;
          btn.disabled = false;
        }
      })
      .catch(function () {
        cellMsg.className = 'link-cell-msg is-bad';
        cellMsg.textContent = T.netErr;
        cellMsg.style.display = '';
        btn.textContent = prev;
        btn.disabled = false;
      });
  }

  function search() {
    var host = currentHost();
    if (!host) { setMsg(searchMsg, T.needHost, 'bad'); return; }
    btnSearch.disabled = true;
    racesWrap.style.display = 'none';
    setMsg(searchMsg, T.searching, 'mute');

    fetch('/link/master/races?url=' + encodeURIComponent(host))
      .then(function (res) { return res.json().then(function (b) { return { status: res.status, body: b }; }); })
      .then(function (r) {
        btnSearch.disabled = false;
        if (r.status !== 200 || !r.body.races) {
          setMsg(searchMsg, (r.body && r.body.error) ? r.body.error : T.netErr, 'bad');
          return;
        }
        var races = r.body.races || [];
        if (!races.length) { setMsg(searchMsg, T.noRaces, 'warn'); return; }
        setMsg(searchMsg, T.found(races.length), 'ok');
        renderRaces(races);
      })
      .catch(function () {
        btnSearch.disabled = false;
        setMsg(searchMsg, T.netErr, 'bad');
      });
  }

  btnSearch.addEventListener('click', search);
  hostInp.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); search(); } });

  // ── Config del enlace (rol / URL / token) ─────────────────────────
  var roleSel      = document.getElementById('linkRole');
  var slaveUrlFld  = document.getElementById('linkSlaveUrlField');
  var slaveUrlInp  = document.getElementById('linkSlaveUrl');
  var tokenInp     = document.getElementById('linkToken');
  var btnSaveCfg   = document.getElementById('btnSaveCfg');
  var cfgMsg       = document.getElementById('cfgMsg');

  function syncRoleUI() {
    slaveUrlFld.style.display = (roleSel.value === 'master') ? '' : 'none';
  }
  if (roleSel) roleSel.addEventListener('change', syncRoleUI);

  if (btnSaveCfg) btnSaveCfg.addEventListener('click', function () {
    btnSaveCfg.disabled = true;
    setMsg(cfgMsg, LANG === 'es' ? 'Guardando…' : 'Saving…', 'mute');
    fetch('/link/config', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({
        role: roleSel.value,
        slaveUrl: (slaveUrlInp.value || '').trim(),
        token: (tokenInp.value || '').trim(),
      }),
    })
      .then(function (res) { return res.json().then(function (b) { return { status: res.status, body: b }; }); })
      .then(function (r) {
        btnSaveCfg.disabled = false;
        if (r.status === 200 && r.body.ok) {
          setMsg(cfgMsg, LANG === 'es' ? '✓ Enlace guardado.' : '✓ Link saved.', 'ok');
        } else {
          setMsg(cfgMsg, (r.body && r.body.error) ? r.body.error : (LANG === 'es' ? 'No se pudo guardar.' : 'Could not save.'), 'bad');
        }
      })
      .catch(function () {
        btnSaveCfg.disabled = false;
        setMsg(cfgMsg, LANG === 'es' ? 'No se pudo guardar.' : 'Could not save.', 'bad');
      });
  });

  // ── Importar desde fichero ─────────────────────────────────────
  var btnImport  = document.getElementById('btnImport');
  var importJson = document.getElementById('importJson');
  var importMsg  = document.getElementById('importMsg');

  btnImport.addEventListener('click', function () {
    var raw = (importJson.value || '').trim();
    if (!raw) { setMsg(importMsg, T.needJson, 'bad'); return; }
    var payload;
    try { payload = JSON.parse(raw); }
    catch (e) { setMsg(importMsg, T.badJson, 'bad'); return; }

    btnImport.disabled = true;
    setMsg(importMsg, T.importing, 'mute');

    fetch('/link/import', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    })
      .then(function (res) { return res.json().then(function (b) { return { status: res.status, body: b }; }); })
      .then(function (r) {
        btnImport.disabled = false;
        if (r.status === 200 && r.body.ok) {
          setMsg(importMsg, T.imported(r.body.raceId), 'ok');
        } else if (r.status === 409) {
          setMsg(importMsg, T.exists(r.body.existingId), 'warn');
        } else {
          setMsg(importMsg, (r.body && r.body.error) ? r.body.error : T.netErr, 'bad');
        }
      })
      .catch(function () {
        btnImport.disabled = false;
        setMsg(importMsg, T.netErr, 'bad');
      });
  });
})();
</script>

<%- include('../partials/footer') %>
