<%- include('partials/header', { lang, pageTitle: lang === 'es' ? 'Inicio' : 'Home' }) %>

<div style="display:flex;flex-direction:column;align-items:center;padding:3rem 2rem">

  <div style="text-align:center;margin-bottom:3rem">
    <h1 class="page-title" style="font-size:2.5rem">Voltrace Manager</h1>
    <p class="page-subtitle"><%= lang === 'es' ? 'Selecciona un módulo para comenzar.' : 'Select a module to get started.' %></p>
  </div>

  <div class="home-grid">

    <a href="/drivers" class="home-card">
      <div class="home-card__icon">👥</div>
      <div class="home-card__title"><%= lang === 'es' ? 'Pilotos' : 'Drivers' %></div>
      <div class="home-card__desc"><%= lang === 'es' ? 'Registra y gestiona los pilotos.' : 'Register and manage drivers.' %></div>
    </a>

    <a href="/teams" class="home-card">
      <div class="home-card__icon">🤝</div>
      <div class="home-card__title"><%= lang === 'es' ? 'Equipos' : 'Teams' %></div>
      <div class="home-card__desc"><%= lang === 'es' ? 'Crea y gestiona el catálogo de equipos con sus pilotos.' : 'Create and manage your team catalog with their drivers.' %></div>
    </a>

    <a href="/categories" class="home-card">
      <div class="home-card__icon">🏷️</div>
      <div class="home-card__title"><%= lang === 'es' ? 'Categorías' : 'Categories' %></div>
      <div class="home-card__desc"><%= lang === 'es' ? 'Gestiona las categorías de carreras y tiempos mínimos.' : 'Manage race categories and minimum times.' %></div>
    </a>

    <a href="/cars" class="home-card">
      <div class="home-card__icon">🏎️</div>
      <div class="home-card__title"><%= lang === 'es' ? 'Coches' : 'Cars' %></div>
      <div class="home-card__desc"><%= lang === 'es' ? 'Gestiona el catálogo de coches y su categoría.' : 'Manage your car catalog and their category.' %></div>
    </a>

    <a href="/circuits" class="home-card">
      <div class="home-card__icon">
        <svg viewBox="0 0 64 40" width="48" height="30" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- outer track -->
          <rect x="2" y="2" width="60" height="36" rx="10" ry="10" stroke="#8b949e" stroke-width="3" fill="none"/>
          <!-- inner cutout -->
          <rect x="10" y="10" width="44" height="20" rx="6" ry="6" stroke="#8b949e" stroke-width="2.5" fill="none"/>
          <!-- chicane left -->
          <line x1="10" y1="20" x2="16" y2="14" stroke="#f6c90e" stroke-width="2" stroke-linecap="round"/>
          <line x1="16" y1="14" x2="22" y2="20" stroke="#f6c90e" stroke-width="2" stroke-linecap="round"/>
          <!-- start/finish line -->
          <line x1="32" y1="2" x2="32" y2="10" stroke="#e63946" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
      </div>
      <div class="home-card__title"><%= lang === 'es' ? 'Circuitos' : 'Circuits' %></div>
      <div class="home-card__desc"><%= lang === 'es' ? 'Define los circuitos y su configuración de carriles.' : 'Define circuits and their lane configuration.' %></div>
    </a>

    <a href="/training" class="home-card">
      <div class="home-card__icon">⏱️</div>
      <div class="home-card__title"><%= lang === 'es' ? 'Entrenamientos' : 'Training' %></div>
      <div class="home-card__desc"><%= lang === 'es' ? 'Sesiones de entrenamiento libre o de competición.' : 'Free or competition training sessions.' %></div>
    </a>

    <a href="/races" class="home-card">
      <div class="home-card__icon">🚦</div>
      <div class="home-card__title"><%= lang === 'es' ? 'Carrera' : 'Race' %></div>
      <div class="home-card__desc"><%= lang === 'es' ? 'Gestiona y controla tus carreras en tiempo real.' : 'Manage and control your races in real time.' %></div>
    </a>

    <a href="/settings" class="home-card">
      <div class="home-card__icon">⚙️</div>
      <div class="home-card__title"><%= lang === 'es' ? 'Ajustes' : 'Settings' %></div>
      <div class="home-card__desc"><%= lang === 'es' ? 'Configura el puerto serie, simulación y preferencias.' : 'Configure serial port, simulation and preferences.' %></div>
    </a>

  </div>

</div>

<%- include('partials/footer') %>
