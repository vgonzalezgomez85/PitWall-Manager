.page-subtitle { color:#8b949e; font-size:.9rem; margin-top:.25rem; }
.eula-body { background:#000000; border:1px solid #21262d; border-radius:12px; padding:2rem; line-height:1.7; }
.eula-body h2 { color:#e6edf3; font-size:1rem; font-weight:600; margin:1.75rem 0 .5rem; padding-bottom:.4rem; border-bottom:1px solid #21262d; }
