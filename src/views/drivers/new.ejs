<%- include('../partials/header', { pageTitle: lang === 'es' ? 'Nuevo piloto' : 'New driver' }) %>

<%
const CATS = [
  { key: 'platino', label_es: 'Platino', label_en: 'Platinum' },
  { key: 'oro',     label_es: 'Oro',     label_en: 'Gold' },
  { key: 'plata',   label_es: 'Plata',   label_en: 'Silver' },
  { key: 'bronce',  label_es: 'Bronce',  label_en: 'Bronze' },
];
const selectedCat = body.category || 'bronce';
%>

<div class="vt-page">
  <div class="vt-wrap vt-wrap--narrow">

    <a href="/drivers" class="vt-back-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      <%= lang === 'es' ? 'Volver a pilotos' : 'Back to drivers' %>
    </a>
    <h1><%= lang === 'es' ? 'Añadir piloto' : 'Add driver' %></h1>

    <% if (errors.length > 0) { %>
      <div class="vt-alert" style="margin-top:16px">
        <% errors.forEach(e => { %><p><%= t('errors.' + e) %></p><% }) %>
      </div>
    <% } %>

    <form action="/drivers" method="POST" class="vt-panel">

      <div class="vt-form-group">
        <label class="vt-form-group__label" for="name"><%= lang === 'es' ? 'Nombre del piloto' : 'Driver name' %></label>
        <input
          class="vt-inp"
          type="text" id="name" name="name"
          placeholder="<%= lang === 'es' ? 'Ej: Max Verstappen' : 'E.g.: Max Verstappen' %>"
          value="<%= body.name || '' %>"
          autocomplete="off" autofocus required>
      </div>

      <div class="vt-form-group">
        <label class="vt-form-group__label"><%= lang === 'es' ? 'Categoría' : 'Category' %></label>
        <div class="vt-opts vt-opts--4">
          <% CATS.forEach(c => { %>
            <label class="vt-opt vt-opt--compact <%= selectedCat === c.key ? 'is-sel' : '' %>" data-cat="<%= c.key %>">
              <input type="radio" name="category" value="<%= c.key %>" <%= selectedCat === c.key ? 'checked' : '' %> required>
              <div class="vt-opt__radio"><svg viewBox="0 0 24 24"><path d="M5 12l4 4 10-10"/></svg></div>
              <div class="vt-opt__ico" style="background:rgba(255,255,255,.04)">
                <span class="vt-cat-dot vt-cat--<%= c.key %>" style="width:18px;height:18px"></span>
              </div>
              <div class="vt-opt__t vt-cat--<%= c.key %>"><%= lang === 'es' ? c.label_es : c.label_en %></div>
            </label>
          <% }) %>
        </div>
      </div>

      <div class="vt-form-actions">
        <a href="/drivers" class="vt-btn vt-btn--ghost"><%= lang === 'es' ? 'Cancelar' : 'Cancel' %></a>
        <button type="submit" class="vt-btn vt-btn--primary"><%= lang === 'es' ? 'Guardar piloto' : 'Save driver' %></button>
      </div>
    </form>
  </div>
</div>

<script>
document.querySelectorAll('.vt-opt[data-cat]').forEach(opt => {
  opt.addEventListener('click', () => {
    document.querySelectorAll('.vt-opt[data-cat]').forEach(o => o.classList.remove('is-sel'));
    opt.classList.add('is-sel');
    opt.querySelector('input[type="radio"]').checked = true;
  });
});
</script>

<%- include('../partials/footer') %>
