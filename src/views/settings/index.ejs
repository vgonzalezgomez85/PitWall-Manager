function makeCircuitRow(){
  const div = document.createElement('div');
  div.className = 'vt-circuit-row circuit-row';
  div.innerHTML = circuitRowHTML();
  wirePortFields(div.querySelector('.circuit-row__field--port'));
  wireBaudFields(div.querySelector('.js-baud-field'));
  wireCircuitRef(div);
  return div;
}

/* ── add circuit ── */
document.getElementById('addCircuit')?.addEventListener('click', () => {
  document.getElementById('circuitList').appendChild(makeCircuitRow());
  renumberCircuitRows();
  updateLaneBadges();
});

/* ── remove circuit ── */
document.getElementById('circuitList').addEventListener('click', e => {
  const btn = e.target.closest('.btn-remove-circuit');
  if (!btn) return;
  const rows = document.querySelectorAll('.circuit-row');
  if (rows.length > 1) { btn.closest('.circuit-row').remove(); renumberCircuitRows(); updateLaneBadges(); }
});

/* ── refresh COM ports ── */
async function refreshPortsHandler(e) {
  const btn = e.currentTarget;
  const originalHTML = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<svg viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-2.6-6.4"/><path d="M21 3v5h-5"/></svg>' + (LANG === 'es' ? 'Buscando…' : 'Searching…');
  try {
    const res = await fetch('/api/settings/ports');
    const { ports } = await res.json();
    document.querySelectorAll('.port-select').forEach(sel => {
      const current = sel.value;
      const opts = '<option value="">— ' + (LANG === 'es' ? 'seleccionar' : 'select') + ' —</option>' +
        ports.map(p => `<option value="${p.path}"${p.path === current ? ' selected' : ''}>${p.path}${p.manufacturer ? ' — ' + p.manufacturer : ''}</option>`).join('');
      let extra = '';
      if (current && !ports.find(p => p.path === current)) extra = `<option value="${current}" selected>${current}</option>`;
      sel.innerHTML = opts + extra;
    });
    btn.innerHTML = '✓ ' + (LANG === 'es' ? `${ports.length} puertos` : `${ports.length} ports`);
    setTimeout(() => { btn.innerHTML = originalHTML; btn.disabled = false; }, 1500);
  } catch (err) {
    btn.innerHTML = '✗ ' + (LANG === 'es' ? 'Error' : 'Error');
    setTimeout(() => { btn.innerHTML = originalHTML; btn.disabled = false; }, 2000);
  }
}
document.getElementById('refreshPorts')?.addEventListener('click', refreshPortsHandler);
document.getElementById('refreshPortsAgg')?.addEventListener('click', refreshPortsHandler);

/* ── túnel público (Cloudflare del club) ── */
function tunnelModeUi() {
  const mode = document.getElementById('tunnelMode').value;
  document.getElementById('tunnelTokenFields').style.display = mode === 'token' ? '' : 'none';
  document.getElementById('tunnelQuickHelp').style.display   = mode === 'quick' ? '' : 'none';
}
function tunnelRender(s) {
  const dot   = document.getElementById('tunnelDot');
  const state = document.getElementById('tunnelState');
  const url   = document.getElementById('tunnelUrl');
  const hint  = document.getElementById('tunnelHint');
  const inst  = document.getElementById('tunnelInstallBtn');
  const dotKind = s.running ? 'ok' : (s.lastError ? 'bad' : 'off');
  dot.className = 'st-dot st-dot--lg st-dot--' + dotKind;
  setNavDot('web', dotKind);
  state.textContent = s.installing
    ? (LANG === 'es' ? 'Descargando cloudflared…' : 'Downloading cloudflared…')
    : s.running
      ? (LANG === 'es' ? 'Túnel en marcha' : 'Tunnel running')
      : (LANG === 'es' ? 'Túnel parado' : 'Tunnel stopped');
  url.innerHTML = s.publicUrl
    ? `<a href="${s.publicUrl}" target="_blank" rel="noopener">${s.publicUrl}</a>`
    : (s.running && s.mode === 'quick' ? (LANG === 'es' ? 'Esperando URL… (tarda unos segundos)' : 'Waiting for URL… (takes a few seconds)') : '');
  inst.style.display = (!s.binaryFound && !s.installing) ? '' : 'none';
  document.getElementById('tunnelStartBtn').style.display = s.binaryFound ? '' : 'none';
  let h = '';
  if (s.installing) h = LANG === 'es' ? '⏳ Descargando el binario oficial de Cloudflare (~20 MB)…' : '⏳ Downloading the official Cloudflare binary (~20 MB)…';
  else if (s.installError) h = '⚠️ ' + s.installError;
  else if (!s.binaryFound) h = LANG === 'es'
    ? 'cloudflared no está instalado. Pulsa «Instalar cloudflared» (se descarga de Cloudflare a la carpeta de datos de PitWall, sin permisos de administrador) o instálalo tú: brew install cloudflared.'
    : 'cloudflared is not installed. Click “Install cloudflared” (downloaded from Cloudflare into PitWall\'s data folder, no admin rights) or install it yourself: brew install cloudflared.';
  else if (s.lastError) h = '⚠️ ' + s.lastError;
  hint.textContent = h;
  document.getElementById('tunnelHintRow').hidden = !h;
}
async function tunnelAction(op) {
  try {
    const opts = { method: 'POST' };
    if (op === 'start') {
      // Arrancar aplica lo que hay EN PANTALLA (no hace falta "Guardar y aplicar").
      opts.headers = { 'Content-Type': 'application/json' };
      opts.body = JSON.stringify({
        tunnel_mode:      document.getElementById('tunnelMode').value,
        tunnel_token:     document.querySelector('input[name="tunnel_token"]')?.value || '',
        tunnel_hostname:  document.querySelector('input[name="tunnel_hostname"]')?.value || '',
        tunnel_autostart: document.querySelector('input[name="tunnel_autostart"]')?.checked ? '1' : '0',
      });
    }
    const r = await fetch('/tunnel/' + op, opts);
    tunnelRender(await r.json());
    if (op === 'start') setTimeout(tunnelRefresh, 2500); // la URL quick tarda un par de segundos
  } catch {}
}
async function tunnelInstall() {
  const btn = document.getElementById('tunnelInstallBtn');
  btn.disabled = true;
  document.getElementById('tunnelState').textContent = LANG === 'es' ? 'Descargando cloudflared…' : 'Downloading cloudflared…';
  document.getElementById('tunnelHint').textContent = LANG === 'es' ? '⏳ Descargando el binario oficial de Cloudflare (~20 MB)…' : '⏳ Downloading the official Cloudflare binary (~20 MB)…';
  try {
    const r = await fetch('/tunnel/install', { method: 'POST' });
    tunnelRender(await r.json());
  } catch {
    document.getElementById('tunnelHint').textContent = LANG === 'es' ? '⚠️ Error de red durante la descarga.' : '⚠️ Network error during download.';
  }
  btn.disabled = false;
}
async function tunnelRefresh() {
  try { const r = await fetch('/tunnel/status'); tunnelRender(await r.json()); } catch {}
}
tunnelModeUi();
tunnelRefresh();
setInterval(tunnelRefresh, 5000);

initialForm = formSnapshot(settingsForm);
initialRestart = restartSnapshot(settingsForm);
updateSaveBar();
</script>

