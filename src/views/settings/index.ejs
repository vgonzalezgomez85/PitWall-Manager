          <option value="9600">9600</option><option value="19200">19200</option><option value="38400">38400</option><option value="56000">56000</option><option value="57600" selected>57600</option><option value="115200">115200</option><option value="230400">230400</option><option value="460800">460800</option><option value="921600">921600</option>
