<%- include('../partials/header', { pageTitle: lang === 'es' ? 'Configuración' : 'Settings' }) %>

<%
const es = lang === 'es';
const portsList = (connectedPorts || []).map(p => String(p).split('/').pop()).join(' · ');
const portState = isSimulating ? 'sim' : (connectedPorts && connectedPorts.length > 0 ? 'ok' : 'off');
const restartChip = '<span class="st-chip st-chip--warn">' + (es ? 'Reinicio' : 'Restart') + '</span>';
const navItems = [
  { key: 'timing', label: es ? 'Fuente de datos' : 'Data source', dot: portState === 'ok' ? 'ok' : (portState === 'sim' ? 'warn' : 'bad'),
    icon: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2M10 2h4M12 2v3"/>' },
  { key: 'live', label: es ? 'Preferencias' : 'Preferences', dot: '',
    icon: '<path d="M4 6h9M17 6h3M4 12h3M11 12h9M4 18h11M19 18h1"/><circle cx="15" cy="6" r="2"/><circle cx="9" cy="12" r="2"/><circle cx="17" cy="18" r="2"/>' },
  { key: 'net', label: es ? 'Red local' : 'Local network', dot: '',
    icon: '<path d="M5 12.5a10 10 0 0 1 14 0M8.5 16a5 5 0 0 1 7 0M12 19.5h.01M2 9a15 15 0 0 1 20 0"/>' },
  { key: 'sec', label: es ? 'Seguridad' : 'Security', dot: passwordEnabled ? 'ok' : '',
    icon: '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>' },
  { key: 'web', label: es ? 'Seguimiento online' : 'Online tracking', dot: 'off',
    icon: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.9 5.7 3.9 9S14.5 18.4 12 21c-2.5-2.6-3.9-5.7-3.9-9S9.5 5.6 12 3z"/>' },
  { key: 'int', label: es ? 'Integraciones' : 'Integrations', dot: '',
    icon: '<path d="M3 12h4l3-7 4 14 3-7h4"/>' },
  { key: 'diag', label: es ? 'Diagnóstico' : 'Diagnostics', dot: cfg.debug_mode === '1' ? 'warn' : '',
    icon: '<rect x="8" y="8" width="8" height="10" rx="4"/><path d="M12 8V5M8 11H4M16 11h4M8 15H4M16 15h4"/>' },
];
%>

<div class="vt-page st-page">
  <div class="st-top">
    <a href="/" class="vt-back-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      <%= es ? 'Inicio' : 'Home' %>
    </a>
    <span class="st-top__sep"></span>
    <h1 class="st-top__h"><%= es ? 'Configuración' : 'Settings' %></h1>
    <span class="st-top__fill"></span>
    <% if (portState === 'sim') { %>
      <div class="vt-port-pill is-sim"><span class="dot"></span> <%= es ? 'Modo simulación activo' : 'Simulation mode active' %></div>
    <% } else if (portState === 'ok') { %>
      <div class="vt-port-pill" title="<%= connectedPorts.join('  ·  ') %>">
        <span class="dot"></span>
        <%= es ? 'Conectado' : 'Connected' %>
        <span class="vt-mono"><%= connectedPorts.length > 1 ? connectedPorts.length + (es ? ' circuitos · ' : ' circuits · ') : '' %><%= portsList %></span>
      </div>
    <% } else { %>
      <div class="vt-port-pill is-off"><span class="dot"></span> <%= es ? 'Sin conexión' : 'Not connected' %></div>
    <% } %>
  </div>

  <form action="/settings" method="POST" class="st-form" id="settingsForm" novalidate>
    <div class="st-layout">

      <nav class="st-nav" aria-label="<%= es ? 'Secciones' : 'Sections' %>">
        <% navItems.forEach(it => { %>
          <button type="button" class="st-nav__item <%= it.key === 'timing' ? 'is-active' : '' %>" data-sec="<%= it.key %>" <%= it.key === 'timing' ? 'aria-current=true' : '' %>>
            <svg viewBox="0 0 24 24"><%- it.icon %></svg>
            <span class="st-nav__lbl"><%= it.label %></span>
            <span class="st-dot <%= it.dot ? 'st-dot--' + it.dot : '' %>" id="navDot-<%= it.key %>"></span>
          </button>
        <% }) %>
        <div class="st-nav__note">
          <span><%= es ? 'Los cambios se aplican al pulsar «Guardar y aplicar».' : 'Changes apply when you press “Save & apply”.' %></span>
          <span><%= es ? 'Los marcados con' : 'Those marked' %> <%- restartChip %> <%= es ? 'necesitan además reiniciar PitWall.' : 'also need a PitWall restart.' %></span>
        </div>
      </nav>

      <div class="st-main">
        <!-- ══ Fuente de datos ═══════════════════════════════════════════ -->
        <section class="st-sec is-active" data-sec="timing">
          <header class="st-sec__h">
            <h2><%= es ? 'Fuente de datos' : 'Data source' %></h2>
            <p><%= es ? 'De dónde llegan las vueltas.' : 'Where laps come from.' %></p>
          </header>

      <datalist id="baud-options">
        <option value="9600"></option>
        <option value="19200"></option>
        <option value="38400"></option>
        <option value="56000"></option>
        <option value="57600"></option>
        <option value="115200"></option>
        <option value="230400"></option>
        <option value="460800"></option>
        <option value="921600"></option>
      </datalist>

      <div class="vt-opts">
        <label class="vt-opt <%= (cfg.serial_mode || 'simulation') === 'simulation' ? 'is-sel' : '' %>" id="optSim">
          <input type="radio" name="serial_mode" value="simulation" <%= (cfg.serial_mode || 'simulation') === 'simulation' ? 'checked' : '' %>>
          <div class="vt-opt__radio"><svg viewBox="0 0 24 24"><path d="M5 12l4 4 10-10"/></svg></div>
          <div class="vt-opt__ico">
            <svg viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="11" rx="5.5"/><path d="M7.5 11v3M6 12.5h3"/><circle cx="16" cy="11.5" r="1"/><circle cx="18" cy="14" r="1"/></svg>
          </div>
          <div class="vt-opt__t"><%= lang === 'es' ? 'Simulación' : 'Simulation' %></div>
          <div class="vt-opt__d"><%= lang === 'es' ? 'Genera vueltas aleatorias. Ideal para pruebas.' : 'Generates random laps. Ideal for testing.' %></div>
        </label>

        <label class="vt-opt <%= cfg.serial_mode === 'serial' ? 'is-sel' : '' %>" id="optDs">
          <input type="radio" name="serial_mode" value="serial" <%= cfg.serial_mode === 'serial' ? 'checked' : '' %>>
          <div class="vt-opt__radio"><svg viewBox="0 0 24 24"><path d="M5 12l4 4 10-10"/></svg></div>
          <div class="vt-opt__ico">
            <svg viewBox="0 0 24 24"><path d="M9 2v5M15 2v5"/><path d="M7 7h10v3a5 5 0 0 1-10 0z"/><path d="M12 15v6"/></svg>
          </div>
          <div class="vt-opt__t">DS-300</div>
          <div class="vt-opt__d"><%= lang === 'es' ? 'Uno o varios DS-300 por USB/RS-232.' : 'One or more DS-300 via USB/RS-232.' %></div>
        </label>

        <label class="vt-opt <%= cfg.serial_mode === 'serial_agg' ? 'is-sel' : '' %>" id="optAgg">
          <input type="radio" name="serial_mode" value="serial_agg" <%= cfg.serial_mode === 'serial_agg' ? 'checked' : '' %>>
          <div class="vt-opt__radio"><svg viewBox="0 0 24 24"><path d="M5 12l4 4 10-10"/></svg></div>
          <div class="vt-opt__ico">
            <svg viewBox="0 0 24 24"><path d="M9 2v5M15 2v5"/><path d="M7 7h10v3a5 5 0 0 1-10 0z"/><path d="M4 21h16"/><path d="M8 21v-3M12 21v-3M16 21v-3"/></svg>
          </div>
          <div class="vt-opt__t"><%= lang === 'es' ? 'DS-300 agrupador' : 'DS-300 aggregator' %></div>
          <div class="vt-opt__d"><%= lang === 'es' ? 'Varias cajas DS por un solo puerto COM.' : 'Several DS boxes over one COM port.' %></div>
        </label>

        <label class="vt-opt <%= cfg.serial_mode === 'bart' ? 'is-sel' : '' %>" id="optBart">
          <input type="radio" name="serial_mode" value="bart" <%= cfg.serial_mode === 'bart' ? 'checked' : '' %>>
          <div class="vt-opt__radio"><svg viewBox="0 0 24 24"><path d="M5 12l4 4 10-10"/></svg></div>
          <div class="vt-opt__ico">
            <svg viewBox="0 0 24 24"><path d="M7 7l10 10-5 4V3l5 4L7 17"/></svg>
          </div>
          <div class="vt-opt__t">BART</div>
          <div class="vt-opt__d"><%= lang === 'es' ? 'Cronómetro BLE (Slot.it/Policar) vía puente.' : 'BLE timer (Slot.it/Policar) via bridge.' %></div>
        </label>
      </div>

      <!-- ── Simulation ──────────────────────────────────────────────────── -->
      <div id="simSettings" style="margin-top:22px">
        <div class="vt-sec-lbl"><%= lang === 'es' ? 'Parámetros de simulación' : 'Simulation parameters' %></div>
        <div class="vt-fields vt-fields--2">
          <div class="vt-field">
            <label><%= lang === 'es' ? 'Carriles a simular' : 'Lanes to simulate' %></label>
            <input class="vt-inp is-mono" type="number" name="sim_lanes" min="1" max="32" value="<%= cfg.sim_lanes || 6 %>">
          </div>
          <div class="vt-field">
            <label><%= lang === 'es' ? 'Vuelta media (ms)' : 'Avg lap time (ms)' %></label>
            <input class="vt-inp is-mono" type="number" name="sim_avg_ms" min="3000" max="60000" step="1000" value="<%= cfg.sim_avg_ms || 12000 %>">
          </div>
        </div>
      </div>

      <!-- ── BART (BLE timer via bridge) ──────────────────────────────────── -->
      <div id="bartSettings" style="display:none;margin-top:26px">
        <div class="vt-sub">
          <div>
            <h3><%= lang === 'es' ? 'Cronómetro BART (BLE)' : 'BART timer (BLE)' %></h3>
            <p class="vt-sub__p">
              <%= lang === 'es'
                ? 'Cada Master BART (p. ej. BART_TRACK1, BART_TRACK2…) es un aparato independiente que hay que emparejar por separado — no comparten carriles entre sí. Añade una fila por cada Master físico; los carriles se numeran de forma global en el orden de la lista.'
                : 'Each BART Master (e.g. BART_TRACK1, BART_TRACK2…) is an independent device that must be paired separately — they don\'t share lanes with each other. Add one row per physical Master; lanes are numbered globally in list order.' %>
            </p>
          </div>
          <div class="vt-sub__actions">
            <button type="button" class="vt-btn vt-btn--ghost vt-btn--sm" id="addBartMaster">
              <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
              <%= lang === 'es' ? 'Añadir Master' : 'Add Master' %>
            </button>
          </div>
        </div>

        <div class="vt-fields vt-fields--2" style="margin-top:14px">
          <div class="vt-field">
            <label><%= lang === 'es' ? 'Transporte' : 'Transport' %></label>
            <div class="vt-selw">
              <select name="bart_transport" id="bartTransport">
                <option value="ble" <%= (cfg.bart_transport || 'ble') === 'ble' ? 'selected' : '' %>>BLE (<%= lang === 'es' ? 'directo' : 'direct' %>)</option>
                <option value="tcp" <%= cfg.bart_transport === 'tcp' ? 'selected' : '' %>><%= lang === 'es' ? 'TCP (emulador / puente)' : 'TCP (emulator / bridge)' %></option>
              </select>
            </div>
          </div>
          <div class="vt-field">
            <label><%= lang === 'es' ? 'MinLap del Master (ms)' : 'Master MinLap (ms)' %></label>
            <input class="vt-inp is-mono" type="number" name="bart_minlap" min="0" max="65535" step="100"
                   value="<%= cfg.bart_minlap || 2000 %>"
                   title="<%= lang === 'es' ? 'Filtro anti-rebote del hardware: descarta cruces más rápidos que esto' : 'Hardware debounce: drops crossings faster than this' %>">
          </div>
        </div>

        <div id="bartList" style="margin-top:14px">
          <% bartCircuits.forEach((c, i) => { %>
            <div class="vt-circuit-row bart-row" data-index="<%= i %>">
              <div class="vt-circuit-row__h">
                <div class="vt-circuit-row__num bnum"><%= i + 1 %></div>
                <div class="vt-circuit-row__title bname"><%= lang === 'es' ? 'Master' : 'Master' %> <%= i + 1 %></div>
                <span class="vt-circuit-row__lanes-badge bart-lanes-badge"></span>
                <% if (bartCircuits.length > 1) { %>
                  <button type="button" class="vt-circuit-row__x btn-remove-bart" data-index="<%= i %>" title="<%= lang === 'es' ? 'Eliminar' : 'Remove' %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
                  </button>
                <% } %>
              </div>
              <div class="vt-fields vt-fields--2 circuit-row__body">
                <div class="vt-field">
                  <label><%= lang === 'es' ? 'Nombre BLE del Master' : 'Master BLE name' %></label>
                  <input class="vt-inp is-mono bart-name-input" type="text" name="bart_master_name" placeholder="BART_TRACK<%= i + 1 %>" value="<%= c.name || '' %>">
                </div>
                <div class="vt-field">
                  <label><%= lang === 'es' ? 'Nº de carriles' : 'Lanes' %></label>
                  <input class="vt-inp is-mono bart-lanes-input" type="number" name="bart_master_lanes" min="2" max="32" value="<%= c.lanes || 8 %>">
                </div>
              </div>
              <div class="vt-fields vt-fields--2 bart-tcp-fields" style="margin-top:14px<%= (cfg.bart_transport || 'ble') === 'tcp' ? '' : ';display:none' %>">
                <div class="vt-field">
                  <label><%= lang === 'es' ? 'Host del puente' : 'Bridge host' %></label>
                  <input class="vt-inp is-mono" type="text" name="bart_master_host" placeholder="127.0.0.1" value="<%= c.host || '127.0.0.1' %>">
                </div>
                <div class="vt-field">
                  <label><%= lang === 'es' ? 'Puerto' : 'Port' %></label>
                  <input class="vt-inp is-mono" type="number" name="bart_master_port" min="1" max="65535" value="<%= c.port || 9300 %>">
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- ── DS-300 agrupador (varias cajas por un puerto) ────────────────── -->
      <div id="aggSettings" style="display:none;margin-top:26px">
        <div class="vt-sub">
          <div>
            <h3><%= lang === 'es' ? 'DS-300 agrupador' : 'DS-300 aggregator' %></h3>
            <p class="vt-sub__p">
              <%= lang === 'es'
                ? 'Un aparato agrupa varias cajas DS-300 y las entrega por un único puerto COM. PitWall separa las cajas por su identificador de trama (byte 4) y numera los carriles de forma global: caja 1 → 1–8, caja 2 → 9–16, y así sucesivamente.'
                : 'A device aggregates several DS-300 boxes and delivers them over one COM port. PitWall separates boxes by their frame id (byte 4) and numbers lanes globally: box 1 → 1–8, box 2 → 9–16, and so on.' %>
            </p>
          </div>
          <div class="vt-sub__actions">
            <button type="button" class="vt-btn vt-btn--ghost vt-btn--sm" id="refreshPortsAgg" title="<%= lang === 'es' ? 'Buscar puertos COM' : 'Search COM ports' %>">
              <svg viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-2.6-6.4"/><path d="M21 3v5h-5"/></svg>
              <%= lang === 'es' ? 'Buscar puertos' : 'Refresh ports' %>
            </button>
          </div>
        </div>

        <div class="vt-fields vt-fields--3" style="margin-top:14px">
          <div class="vt-field circuit-row__field--port">
            <label><%= lang === 'es' ? 'Puerto' : 'Port' %></label>
            <div class="vt-selw">
              <select class="port-select" name="agg_port" id="aggPortSelect">
                <option value="">— <%= lang === 'es' ? 'seleccionar' : 'select' %> —</option>
                <% ports.forEach(p => { %>
                  <option value="<%= p.path %>" <%= cfg.agg_port === p.path ? 'selected' : '' %>>
                    <%= p.path %><%= p.manufacturer ? ` — ${p.manufacturer}` : '' %>
                  </option>
                <% }) %>
                <% if (cfg.agg_port && !ports.find(p => p.path === cfg.agg_port)) { %>
                  <option value="<%= cfg.agg_port %>" selected><%= cfg.agg_port %></option>
                <% } %>
              </select>
            </div>
            <% const _aggCustomPort = cfg.agg_port && !ports.find(p => p.path === cfg.agg_port); %>
            <button type="button" class="port-manual-toggle <%= _aggCustomPort ? 'is-open' : '' %>" aria-expanded="<%= _aggCustomPort ? 'true' : 'false' %>">
              <svg class="port-manual-toggle__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
              <span><%= lang === 'es' ? 'Escribir el path a mano' : 'Type the path manually' %></span>
            </button>
            <input class="vt-inp is-mono port-manual <%= _aggCustomPort ? '' : 'is-hidden' %>" type="text"
              placeholder="<%= lang === 'es' ? 'p. ej. /dev/ttys003' : 'e.g. COM3' %>"
              value="<%= cfg.agg_port || '' %>" style="margin-top:7px;font-size:13px">
          </div>
          <% const _aggBauds = [9600,19200,38400,56000,57600,115200,230400,460800,921600]; %>
          <% const _aggCur = Number(cfg.agg_baud || 57600); %>
          <% const _aggCustomBaud = !_aggBauds.includes(_aggCur); %>
          <div class="vt-field js-baud-field">
            <label>Baud rate</label>
            <div class="vt-selw">
              <select class="baud-select" name="agg_baud">
                <% if (_aggCustomBaud) { %><option value="<%= _aggCur %>" selected><%= _aggCur %></option><% } %>
                <% _aggBauds.forEach(b => { %>
                  <option value="<%= b %>" <%= _aggCur === b ? 'selected' : '' %>><%= b %></option>
                <% }) %>
              </select>
            </div>
            <button type="button" class="port-manual-toggle baud-manual-toggle <%= _aggCustomBaud ? 'is-open' : '' %>" aria-expanded="<%= _aggCustomBaud ? 'true' : 'false' %>">
              <svg class="port-manual-toggle__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
              <span><%= lang === 'es' ? 'Escribir a mano' : 'Type manually' %></span>
            </button>
            <input class="vt-inp is-mono baud-manual <%= _aggCustomBaud ? '' : 'is-hidden' %>" type="number"
              min="300" max="921600" step="1" placeholder="<%= lang === 'es' ? 'p. ej. 57600' : 'e.g. 57600' %>"
              value="<%= _aggCur %>" style="margin-top:7px;font-size:13px">
          </div>
          <div class="vt-field">
            <label><%= lang === 'es' ? 'Nº de cajas en el puerto' : 'Boxes on the port' %></label>
            <div class="vt-selw">
              <select name="agg_boxes" id="aggBoxes">
                <% [2, 3, 4].forEach(v => { %>
                  <option value="<%= v %>" <%= String(cfg.agg_boxes || '2') === String(v) ? 'selected' : '' %>><%= v %> (<%= v * 8 %> <%= lang === 'es' ? 'carriles' : 'lanes' %>)</option>
                <% }) %>
              </select>
            </div>
          </div>
        </div>
        <div class="vt-hint" style="margin-top:10px">
          <%= lang === 'es'
            ? 'Las cajas deben estar direccionadas en orden (1, 2, 3…) en el agrupador. 8N1, igual que un DS-300 suelto.'
            : 'Boxes must be addressed in order (1, 2, 3…) on the aggregator. 8N1, same as a standalone DS-300.' %>
        </div>
      </div>

      <!-- ── Multi-circuit serial ───────────────────────────────────────── -->
      <div id="serialSettings" style="display:none;margin-top:26px">

        <div class="vt-sub">
          <div>
            <h3><%= lang === 'es' ? 'Circuitos DS-300' : 'DS-300 circuits' %></h3>
            <p class="vt-sub__p">
              <%= lang === 'es'
                ? 'Cada DS-300 controla un circuito independiente. Los carriles se numeran de forma global.'
                : 'Each DS-300 controls one independent circuit. Lanes are numbered globally.' %>
            </p>
          </div>
          <div class="vt-sub__actions">
            <button type="button" class="vt-btn vt-btn--ghost vt-btn--sm" id="refreshPorts" title="<%= lang === 'es' ? 'Buscar puertos COM' : 'Search COM ports' %>">
              <svg viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-2.6-6.4"/><path d="M21 3v5h-5"/></svg>
              <%= lang === 'es' ? 'Buscar puertos' : 'Refresh ports' %>
            </button>
            <button type="button" class="vt-btn vt-btn--ghost vt-btn--sm" id="addCircuit">
              <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
              <%= lang === 'es' ? 'Añadir circuito' : 'Add circuit' %>
            </button>
          </div>
        </div>

        <div id="circuitList">
          <% let globalLaneStart = 1; %>
          <% circuits.forEach((c, i) => { %>
            <div class="vt-circuit-row circuit-row" data-index="<%= i %>">
              <div class="vt-circuit-row__h">
                <div class="vt-circuit-row__num cnum"><%= i + 1 %></div>
                <div class="vt-circuit-row__title cname"><%= lang === 'es' ? 'Circuito' : 'Circuit' %> <%= i + 1 %></div>
                <span class="vt-circuit-row__lanes-badge circuit-row__lanes-badge">
                  <%= lang === 'es' ? 'Carriles' : 'Lanes' %>&nbsp;<%= globalLaneStart %>–<%= globalLaneStart + (c.lanes || 8) - 1 %>
                </span>
                <% if (multiCircuit) { %>
                  <button type="button" class="vt-circuit-row__x btn-remove-circuit" data-index="<%= i %>" title="Eliminar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
                  </button>
                <% } %>
              </div>

              <div class="vt-group-lbl"><%= lang === 'es' ? 'Conexión serie' : 'Serial connection' %></div>
              <div class="vt-fields vt-fields--3 circuit-row__body">
                <div class="vt-field circuit-row__field circuit-row__field--port">
                  <label><%= lang === 'es' ? 'Puerto' : 'Port' %></label>
                  <div class="vt-selw">
                    <select class="port-select" name="circuit_port">
                      <option value="">— <%= lang === 'es' ? 'seleccionar' : 'select' %> —</option>
                      <% ports.forEach(p => { %>
                        <option value="<%= p.path %>" <%= c.port === p.path ? 'selected' : '' %>>
                          <%= p.path %><%= p.manufacturer ? ` — ${p.manufacturer}` : '' %>
                        </option>
                      <% }) %>
                      <% if (c.port && !ports.find(p => p.path === c.port)) { %>
                        <option value="<%= c.port %>" selected><%= c.port %></option>
                      <% } %>
                    </select>
                  </div>
                  <% const isCustomPort = c.port && !ports.find(p => p.path === c.port); %>
                  <button type="button" class="port-manual-toggle <%= isCustomPort ? 'is-open' : '' %>" aria-expanded="<%= isCustomPort ? 'true' : 'false' %>">
                    <svg class="port-manual-toggle__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
                    <span><%= lang === 'es' ? 'Escribir el path a mano' : 'Type the path manually' %></span>
                  </button>
                  <input class="vt-inp is-mono port-manual <%= isCustomPort ? '' : 'is-hidden' %>" type="text"
                    placeholder="<%= lang === 'es' ? 'p. ej. /dev/ttys003' : 'e.g. COM3' %>"
                    value="<%= c.port || '' %>" style="margin-top:7px;font-size:13px">
                </div>
                <% const _bauds = [9600,19200,38400,56000,57600,115200,230400,460800,921600]; %>
                <% const _curBaud = Number(c.baud || 57600); %>
                <% const _customBaud = !_bauds.includes(_curBaud); %>
                <div class="vt-field circuit-row__field circuit-row__field--baud js-baud-field">
                  <label>Baud rate</label>
                  <div class="vt-selw">
                    <select class="baud-select" name="circuit_baud" required>
                      <% if (_customBaud) { %><option value="<%= _curBaud %>" selected><%= _curBaud %></option><% } %>
                      <% _bauds.forEach(b => { %>
                        <option value="<%= b %>" <%= _curBaud === b ? 'selected' : '' %>><%= b %></option>
                      <% }) %>
                    </select>
                  </div>
                  <button type="button" class="port-manual-toggle baud-manual-toggle <%= _customBaud ? 'is-open' : '' %>" aria-expanded="<%= _customBaud ? 'true' : 'false' %>">
                    <svg class="port-manual-toggle__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
                    <span><%= lang === 'es' ? 'Escribir a mano' : 'Type manually' %></span>
                  </button>
                  <input class="vt-inp is-mono baud-manual <%= _customBaud ? '' : 'is-hidden' %>" type="number"
                    min="300" max="921600" step="1" placeholder="<%= lang === 'es' ? 'p. ej. 57600' : 'e.g. 57600' %>"
                    value="<%= _curBaud %>" style="margin-top:7px;font-size:13px">
                </div>
              </div>

              <details class="vt-adv circuit-row__adv">
                <summary>
                  <svg class="vt-adv__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
                  <%= lang === 'es' ? 'Opciones avanzadas del puerto' : 'Advanced port options' %>
                </summary>
                <div class="vt-adv__body vt-fields vt-fields--3">
                  <div class="vt-field circuit-row__field">
                    <label>Data bits</label>
                    <div class="vt-selw">
                      <select name="circuit_databits">
                        <% [7, 8].forEach(v => { %>
                          <option value="<%= v %>" <%= (c.dataBits || 8) == v ? 'selected' : '' %>><%= v %></option>
                        <% }) %>
                      </select>
                    </div>
                  </div>
                  <div class="vt-field circuit-row__field">
                    <label><%= lang === 'es' ? 'Paridad' : 'Parity' %></label>
                    <div class="vt-selw">
                      <select name="circuit_parity">
                        <% ['none','even','odd'].forEach(v => { %>
                          <option value="<%= v %>" <%= (c.parity || 'none') === v ? 'selected' : '' %>><%= v %></option>
                        <% }) %>
                      </select>
                    </div>
                  </div>
                  <div class="vt-field circuit-row__field">
                    <label>Stop bits</label>
                    <div class="vt-selw">
                      <select name="circuit_stopbits">
                        <% [1, 2].forEach(v => { %>
                          <option value="<%= v %>" <%= (c.stopBits || 1) == v ? 'selected' : '' %>><%= v %></option>
                        <% }) %>
                      </select>
                    </div>
                  </div>
                  <div class="vt-field circuit-row__field">
                    <label><%= lang === 'es' ? 'Control de flujo' : 'Flow control' %></label>
                    <div class="vt-selw">
                      <select name="circuit_flow">
                        <% ['none','rtscts','xonxoff'].forEach(v => { %>
                          <option value="<%= v %>" <%= (c.flowControl || 'none') === v ? 'selected' : '' %>><%= v %></option>
                        <% }) %>
                      </select>
                    </div>
                  </div>
                </div>
              </details>

              <div class="vt-divider"></div>

              <div class="vt-group-lbl"><%= lang === 'es' ? 'Asignación de carriles' : 'Lane assignment' %></div>
              <div class="vt-fields vt-fields--2">
                <div class="vt-field circuit-row__field circuit-row__field--circuit">
                  <label><%= lang === 'es' ? 'Circuito' : 'Circuit' %></label>
                  <div class="vt-selw">
                    <select class="circuit-ref-select" name="circuit_ref">
                      <option value="">— <%= lang === 'es' ? 'Manual' : 'Manual' %> —</option>
                      <% allCircuits.forEach(ac => { %>
                        <option value="<%= ac.id %>" data-lanes="<%= ac.lanes_count %>"
                          data-config='<%= (ac.circuits_config && ac.circuits_config !== "[]") ? ac.circuits_config : ("[" + ac.lanes_count + "]") %>'
                          <%= String(c.circuit_id || '') === String(ac.id) ? 'selected' : '' %>>
                          <%= ac.name %> (<%= ac.lanes_count %>)
                        </option>
                      <% }) %>
                    </select>
                  </div>
                </div>
                <div class="vt-field circuit-row__field circuit-row__field--lanes">
                  <label><%= lang === 'es' ? 'Nº de carriles' : 'Lanes' %></label>
                  <input class="vt-inp is-mono circuit-lanes-input" type="number" name="circuit_lanes" min="2" max="8"
                    value="<%= c.lanes || 8 %>" <%= c.circuit_id ? 'readonly' : '' %>>
                  <input type="hidden" class="circuit-sub-input" name="circuit_sub" value="<%= (c.circuit_id != null && c.sub_index != null) ? c.sub_index : '' %>">
                </div>
              </div>
            </div>
            <% globalLaneStart += (c.lanes || 8); %>
          <% }) %>
        </div>


        <details>
          <summary>
            <span class="ar"></span>
            <svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            <%= lang === 'es' ? 'Avanzado: timing del parser DS-300' : 'Advanced: DS-300 parser timing' %>
          </summary>
          <div class="vt-disc-body">
            <div class="vt-field" style="max-width:160px;margin-top:10px">
              <label>FRAME_GAP_MS</label>
              <input class="vt-inp is-mono" type="number" name="serial_frame_gap_ms" min="10" max="500" value="<%= cfg.serial_frame_gap_ms || 75 %>">
            </div>
            <div class="vt-hint">
              <%= lang === 'es'
                ? 'Silencio (ms) entre bytes que separa dos tramas. Por defecto 75. Bájalo si tu DS encadena tramas muy rápido (Tic-Tac usa ~1).'
                : 'Silence (ms) between bytes that separates two frames. Default 75. Lower it if your DS chains frames fast.' %>
            </div>
          </div>
        </details>
      </div>
        </section>

        <!-- ══ Preferencias ══════════════════════════════════════════════ -->
        <section class="st-sec" data-sec="live">
          <header class="st-sec__h">
            <h2><%= es ? 'Preferencias' : 'Preferences' %></h2>
            <p><%= es ? 'Cómo prefieres ver la información de la carrera.' : 'How you prefer to see race information.' %></p>
          </header>
          <div class="st-card">
            <div class="st-row st-row--wrap">
              <div class="st-row__txt">
                <div class="st-row__t"><%= es ? 'Orden del directo' : 'Live view order' %></div>
                <div class="st-row__d"><%= es ? 'Cómo se ordenan tarjetas y filas, y qué posición (P.x) muestra cada equipo o piloto. La clasificación estimada del panel lateral no cambia.' : 'How cards and rows are ordered, and which position (P.x) each team or driver shows. The projected standings side panel does not change.' %></div>
              </div>
              <div class="vt-selw st-row__ctl st-row__ctl--wide">
                <select name="live_order" aria-label="<%= es ? 'Ordenar por' : 'Order by' %>">
                  <option value="projected" <%= cfg.live_order !== 'laps' ? 'selected' : '' %>><%= es ? 'Clasificación estimada (recomendado)' : 'Projected standings (recommended)' %></option>
                  <option value="laps" <%= cfg.live_order === 'laps' ? 'selected' : '' %>><%= es ? 'Vueltas reales (a igualdad, menos tiempo total)' : 'Actual laps (ties: lower total time)' %></option>
                </select>
              </div>
            </div>
          </div>
          <div class="st-card">
            <div class="st-row st-row--wrap">
              <div class="st-row__txt">
                <div class="st-row__t"><%= es ? 'Modo de la app' : 'App mode' %></div>
                <div class="st-row__d"><%= es ? 'Básico: el inicio solo muestra entreno libre, carrera sprint, resultados, categorías, escenarios y ajustes. Avanzado: todos los accesos. Se guarda al momento.' : 'Basic: home only shows free practice, sprint race, results, categories, scenarios and settings. Advanced: every shortcut. Saved instantly.' %></div>
              </div>
              <div class="vt-selw st-row__ctl st-row__ctl--wide">
                <select data-pref="ui_mode" aria-label="<%= es ? 'Modo de la app' : 'App mode' %>">
                  <option value="advanced" <%= uiMode === 'advanced' ? 'selected' : '' %>><%= es ? 'Avanzado (todo)' : 'Advanced (everything)' %></option>
                  <option value="basic" <%= uiMode === 'basic' ? 'selected' : '' %>><%= es ? 'Básico' : 'Basic' %></option>
                </select>
              </div>
            </div>
            <div class="st-row st-row--wrap">
              <div class="st-row__txt">
                <div class="st-row__t"><%= es ? 'Historial de vueltas en entrenos' : 'Practice lap history' %></div>
                <div class="st-row__d"><%= es ? 'Las 10 vueltas que muestra cada carril en la vista «Con historial» de los entrenos. Se guarda al momento; en un entreno abierto se aplica al recargar.' : 'The 10 laps each lane shows in the practice "With history" view. Saved instantly; an open practice picks it up on reload.' %></div>
              </div>
              <div class="vt-selw st-row__ctl st-row__ctl--wide">
                <select data-pref="training_history_mode" aria-label="<%= es ? 'Historial de vueltas en entrenos' : 'Practice lap history' %>">
                  <option value="recent" <%= trainingHistoryMode === 'recent' ? 'selected' : '' %>><%= es ? 'Las 10 últimas (la más reciente arriba)' : 'Last 10 (newest first)' %></option>
                  <option value="best" <%= trainingHistoryMode === 'best' ? 'selected' : '' %>><%= es ? 'Las 10 mejores (de mejor a peor)' : 'Best 10 (best first)' %></option>
                </select>
              </div>
            </div>
            <div class="st-row st-row--wrap">
              <div class="st-row__txt">
                <div class="st-row__t"><%= es ? 'Corrección manual de la coma' : 'Manual correction of the fraction' %></div>
                <div class="st-row__d"><%= es ? 'La coma (la fracción de vuelta de cada coche al caer la bandera) se calcula sola. Actívalo para poder corregirla a mano por carril en la pantalla de correcciones de una manga cerrada; la coma corregida manda en el desempate a igualdad de vueltas. Se guarda al momento.' : 'The fraction (each car’s partial lap when the flag falls) is calculated automatically. Turn this on to fix it by hand, per lane, in the corrections screen of a finished heat; a corrected fraction wins tie-breaks on equal laps. Saved instantly.' %></div>
              </div>
              <div class="vt-selw st-row__ctl st-row__ctl--wide">
                <select data-pref="manual_coma" aria-label="<%= es ? 'Corrección manual de la coma' : 'Manual correction of the fraction' %>">
                  <option value="auto" <%= manualComa === 'auto' ? 'selected' : '' %>><%= es ? 'Automática (recomendado)' : 'Automatic (recommended)' %></option>
                  <option value="manual" <%= manualComa === 'manual' ? 'selected' : '' %>><%= es ? 'Permitir corregirla a mano' : 'Allow manual correction' %></option>
                </select>
              </div>
            </div>
            <div class="st-row st-row--wrap">
              <div class="st-row__txt">
                <div class="st-row__t"><%= es ? 'Espera de cruces tras el final (s)' : 'Wait for crossings after the end (s)' %></div>
                <div class="st-row__d"><%= es ? 'Tiempo durante el que, al terminar la manga, un coche que cruza la meta cuenta como vuelta de bandera con su tiempo real. Con las mismas vueltas gana quien cruzó antes. 0 lo desactiva (la vuelta se repone con el tiempo medio). Se guarda al momento y se aplica desde la siguiente manga.' : 'How long after the heat ends a car crossing the line still counts as a flag lap with its real time. On equal laps, whoever crossed first wins. 0 disables it (the lap is restored at the average time). Saved instantly; applies from the next heat.' %></div>
              </div>
              <input type="number" min="0" max="10" step="0.1" class="vt-inp is-mono st-row__ctl" value="<%= (lateCrossingGraceMs / 1000).toString() %>" data-pref-ms="late_crossing_grace_ms" aria-label="<%= es ? 'Espera de cruces tras el final (s)' : 'Wait for crossings after the end (s)' %>">
            </div>
            <div class="st-row st-row--hint" hidden><div class="st-row__d" id="prefsMsg" role="status"></div></div>
          </div>
          <%
            const gLaneColors = globalLaneColors();
          %>
          <div class="st-card">
            <div class="st-row st-row--wrap">
              <div class="st-row__txt">
                <div class="st-row__t"><%= es ? 'Colores de carril' : 'Lane colors' %></div>
                <div class="st-row__d"><%= es ? 'Los que usan todas las pantallas cuando no hay circuito o el circuito no tiene colores propios (se ponen en la ficha de cada circuito). Se guardan al momento, sin tocar la conexión del cronometraje.' : 'Used on every screen when there is no circuit or the circuit has no colors of its own (set them on each circuit). Saved instantly, without touching the timing connection.' %></div>
              </div>
            </div>
            <div class="st-row st-row--wrap" style="display:block">
              <div class="lc-grid" id="globalLaneColorsGrid">
                <% for (let i = 1; i <= gLaneColors.length; i++) { const c = gLaneColors[i - 1]; %>
                  <label class="lc-swatch" style="background:<%= c %>;color:<%= laneInk(c) %>">
                    <%= i %>
                    <input type="color" value="<%= c %>" aria-label="<%= (es ? 'Color del carril ' : 'Lane color ') + i %>">
                  </label>
                <% } %>
              </div>
              <div class="lc-actions">
                <button type="button" class="vt-btn vt-btn--primary vt-btn--sm" id="laneColorsSave" disabled><%= es ? 'Guardar colores' : 'Save colors' %></button>
                <button type="button" class="vt-btn vt-btn--ghost vt-btn--sm" id="laneColorsDefault"><%= es ? 'Colores de fábrica' : 'Factory colors' %></button>
                <span class="st-row__d" id="laneColorsMsg" role="status"></span>
              </div>
            </div>
          </div>
        </section>

        <!-- ══ Red local ═════════════════════════════════════════════════ -->
        <section class="st-sec" data-sec="net">
          <header class="st-sec__h">
            <h2><%= es ? 'Red local' : 'Local network' %></h2>
            <p><%= es ? 'Quién puede entrar a PitWall desde la red del circuito.' : 'Who can reach PitWall from the venue network.' %></p>
          </header>

          <div class="st-card">
            <div class="st-row st-row--wrap">
              <div class="st-row__txt">
                <div class="st-row__t"><%= es ? 'Interfaz de red' : 'Network interface' %> <%- restartChip %></div>
                <div class="st-row__d"><%= es ? '«Todas» lo hace accesible por cable y WiFi a la vez; elige una para limitarlo a esa red.' : '"All" makes it reachable on LAN and WiFi at once; pick one to limit it.' %></div>
              </div>
              <div class="vt-selw st-row__ctl st-row__ctl--wide">
                <select name="server_bind_iface" data-restart aria-label="<%= es ? 'Interfaz de red' : 'Network interface' %>">
                  <option value="" <%= !bindIface ? 'selected' : '' %>><%= es ? 'Todas las interfaces (recomendado)' : 'All interfaces (recommended)' %></option>
                  <% (netInterfaces || []).forEach(function (i) { %>
                    <option value="<%= i.name %>" <%= bindIface === i.name ? 'selected' : '' %>><%= i.name %> — <%= i.ip %></option>
                  <% }); %>
                </select>
              </div>
            </div>
            <div class="st-row st-row--wrap st-row--top">
              <div class="st-row__txt"><div class="st-row__t st-row__t--sm"><%= es ? 'Direcciones ahora' : 'Addresses now' %></div></div>
              <div class="st-addrs">
                <% if (!serverIps || serverIps.length === 0) { %>
                  <span class="st-row__d"><%= es ? 'Sin interfaces de red detectadas.' : 'No network interfaces detected.' %></span>
                <% } else { %>
                  <% serverIps.forEach(function (i) { %>
                    <div>http://<%= i.ip %>:<%= serverPort %> <span>(<%= i.name %>)</span></div>
                  <% }); %>
                <% } %>
              </div>
            </div>
          </div>

          <div class="st-card">
            <div class="st-row">
              <div class="st-row__txt">
                <div class="st-row__t"><%= es ? 'Restringir acceso web' : 'Restrict web access' %></div>
                <div class="st-row__d"><%= es ? 'Solo este equipo (localhost) y las IPs de la lista. La app móvil e Infolap siguen recibiendo el vuelta a vuelta.' : 'Only this machine (localhost) and the listed IPs. The mobile app and Infolap keep receiving live laps.' %></div>
              </div>
              <button type="button" class="vt-switch <%= cfg.access_restrict_enabled !== '0' ? 'is-on' : '' %>" id="accessSwitch" data-switch="accessInput" role="switch" aria-checked="<%= cfg.access_restrict_enabled !== '0' %>" aria-label="<%= es ? 'Restringir acceso web' : 'Restrict web access' %>"></button>
              <input type="hidden" name="access_restrict_enabled" id="accessInput" value="<%= cfg.access_restrict_enabled !== '0' ? '1' : '' %>">
            </div>
            <div class="st-row st-row--wrap st-row--top" data-show-when="accessInput" <%= cfg.access_restrict_enabled !== '0' ? '' : 'hidden' %>>
              <div class="st-row__txt">
                <label class="st-row__t st-row__t--sm" for="accessAllowlist"><%= es ? 'IPs o rangos permitidos' : 'Allowed IPs or ranges' %></label>
                <div class="st-row__d"><%= es ? 'Uno por línea. Admite CIDR, p. ej. 192.168.1.50 o 192.168.1.0/24.' : 'One per line. CIDR ok, e.g. 192.168.1.50 or 192.168.1.0/24.' %></div>
              </div>
              <textarea name="access_allowlist" id="accessAllowlist" class="vt-inp is-mono st-row__ctl st-row__ctl--wide" rows="4"
                placeholder="192.168.1.50&#10;192.168.1.0/24"><%= (function(){ try { return JSON.parse(cfg.access_allowlist || '[]').join('\n'); } catch (e) { return ''; } })() %></textarea>
            </div>
          </div>

          <div class="st-card">
            <div class="st-row">
              <div class="st-row__txt">
                <div class="st-row__t"><%= es ? 'HTTPS local' : 'Local HTTPS' %> <%- restartChip %></div>
                <div class="st-row__d"><%= es ? 'El escáner QR del control de pilotos usa la cámara, y el navegador solo la deja usar por HTTPS en los móviles y tablets que entran por la IP. PitWall sirve HTTPS con un certificado propio, en paralelo al HTTP normal.' : 'The driver-control QR scanner uses the camera, which browsers only allow over HTTPS on phones/tablets connecting by IP. PitWall serves HTTPS with its own certificate, alongside normal HTTP.' %></div>
              </div>
              <button type="button" class="vt-switch <%= httpsEnabled ? 'is-on' : '' %>" id="httpsSwitch" data-switch="httpsInput" role="switch" aria-checked="<%= !!httpsEnabled %>" aria-label="<%= es ? 'HTTPS local' : 'Local HTTPS' %>"></button>
              <input type="hidden" name="https_enabled" id="httpsInput" data-restart value="<%= httpsEnabled ? '1' : '' %>">
            </div>
            <div data-show-when="httpsInput" <%= httpsEnabled ? '' : 'hidden' %>>
              <div class="st-row st-row--wrap">
                <div class="st-row__txt">
                  <label class="st-row__t st-row__t--sm" for="httpsPort"><%= es ? 'Puerto HTTPS' : 'HTTPS port' %></label>
                  <% if (httpsEnabled && serverIps && serverIps.length) { %>
                    <div class="st-addrs">
                      <% serverIps.forEach(function (i) { %>
                        <div>https://<%= i.ip %>:<%= httpsPort %>/control/shifts <span>(<%= i.name %>)</span></div>
                      <% }); %>
                    </div>
                  <% } %>
                </div>
                <input type="number" name="https_port" id="httpsPort" data-restart class="vt-inp is-mono st-row__ctl" min="1" max="65535" value="<%= httpsPort %>">
              </div>
              <div class="st-row st-row--wrap">
                <div class="st-row__txt">
                  <div class="st-row__t st-row__t--sm"><%= es ? 'Certificado en los dispositivos' : 'Certificate on devices' %></div>
                  <div class="st-row__d"><%= es ? 'Sin él, el navegador avisa una vez («conexión no privada → continuar»).' : 'Without it the browser warns once (“not private → proceed”).' %></div>
                  <% if (caFingerprint) { %>
                    <div class="st-row__d st-fp"><%= es ? 'Huella SHA-256 de la CA:' : 'CA SHA-256 fingerprint:' %> <%= caFingerprint %></div>
                  <% } %>
                </div>
                <div class="st-btns">
                  <a class="vt-btn vt-btn--ghost vt-btn--sm" href="/cert" target="_blank"><%= es ? 'Instalar certificado (guía)' : 'Install certificate (guide)' %></a>
                  <a class="vt-btn vt-btn--ghost vt-btn--sm" href="/cert/ca" download><%= es ? 'Descargar CA' : 'Download CA' %></a>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- ══ Seguridad ═════════════════════════════════════════════════ -->
        <section class="st-sec" data-sec="sec">
          <header class="st-sec__h">
            <h2><%= es ? 'Seguridad' : 'Security' %></h2>
            <p><%= es ? 'Para que quien no conoce el programa no toque lo que no debe: pide contraseña para Sistema (Ajustes, Base de datos, sincronizaciones, ecosistema, solución de problemas) y Catálogo (Pilotos, Equipos, Coches, Categorías, Escenarios), también en este equipo y en la app de escritorio. El inicio, las carreras, los entrenos, los resultados y el directo siguen sin contraseña.' : 'So that people who do not know the program do not touch what they should not: asks for a password for System (Settings, Database, syncs, ecosystem, troubleshooting) and Catalog (Drivers, Teams, Cars, Categories, Scenarios), also on this machine and in the desktop app. Home, races, practice, results and live stay open.' %></p>
          </header>
          <div class="st-card">
            <div class="st-row">
              <div class="st-row__txt">
                <div class="st-row__t"><%= es ? 'Pedir contraseña de acceso' : 'Require an access password' %></div>
                <div class="st-row__d"><%= es ? 'Se guarda al momento, sin tocar la conexión del cronometraje.' : 'Saved instantly, without touching the timing connection.' %></div>
              </div>
              <button type="button" class="vt-switch <%= passwordEnabled ? 'is-on' : '' %>" id="pwSwitch" role="switch" aria-checked="<%= passwordEnabled %>" aria-label="<%= es ? 'Pedir contraseña de acceso' : 'Require an access password' %>"></button>
            </div>
            <div class="st-row st-row--wrap st-row--top" id="pwFields" <%= passwordEnabled ? 'hidden' : '' %>>
              <div class="st-row__txt">
                <label class="st-row__t st-row__t--sm" for="pwNew" id="pwFieldsTitle"><%= passwordEnabled ? (es ? 'Cambiar contraseña' : 'Change password') : (es ? 'Contraseña' : 'Password') %></label>
                <div class="st-row__d"><%= es ? 'Mínimo 4 caracteres. Si se olvida, arranca PitWall con PITWALL_DISABLE_PASSWORD=1 y ponla de nuevo aquí.' : 'At least 4 characters. If forgotten, start PitWall with PITWALL_DISABLE_PASSWORD=1 and set it again here.' %></div>
              </div>
              <div class="st-row__ctl st-row__ctl--wide" style="display:grid;gap:8px">
                <input type="password" id="pwNew" class="vt-inp" autocomplete="new-password" placeholder="<%= es ? 'Contraseña nueva' : 'New password' %>">
                <input type="password" id="pwConfirm" class="vt-inp" autocomplete="new-password" placeholder="<%= es ? 'Repítela' : 'Repeat it' %>">
                <button type="button" class="vt-btn vt-btn--primary vt-btn--sm" id="pwSave"><%= passwordEnabled ? (es ? 'Cambiar contraseña' : 'Change password') : (es ? 'Activar con esta contraseña' : 'Enable with this password') %></button>
              </div>
            </div>
            <div class="st-row st-row--wrap" id="pwActions" <%= passwordEnabled ? '' : 'hidden' %>>
              <div class="st-btns">
                <button type="button" class="vt-btn vt-btn--ghost vt-btn--sm" id="pwChange"><%= es ? 'Cambiar contraseña' : 'Change password' %></button>
                <a class="vt-btn vt-btn--ghost vt-btn--sm" href="/logout"><%= es ? 'Cerrar sesión' : 'Sign out' %></a>
              </div>
            </div>
            <% if (passwordOverridden) { %>
              <div class="st-row st-row--hint"><div class="st-row__d"><%= es ? 'PITWALL_DISABLE_PASSWORD=1 está puesto: ahora mismo no se pide contraseña.' : 'PITWALL_DISABLE_PASSWORD=1 is set: no password is being asked right now.' %></div></div>
            <% } %>
            <div class="st-row st-row--hint" hidden><div class="st-row__d" id="pwMsg" role="status"></div></div>
          </div>
        </section>

        <!-- ══ Seguimiento online ═══════════════════════════════════════ -->
        <section class="st-sec" data-sec="web">
          <header class="st-sec__h">
            <h2><%= es ? 'Seguimiento online' : 'Online tracking' %></h2>
            <p><%= es ? 'Publica el directo, los resultados y Lap con un túnel de Cloudflare propio del club. El control de la app queda bloqueado desde fuera.' : 'Publishes live, results and Lap via your club\'s own Cloudflare tunnel. App control stays blocked from outside.' %></p>
          </header>
          <div class="st-card">
            <div class="st-row st-row--wrap">
              <span class="st-dot st-dot--lg" id="tunnelDot"></span>
              <div class="st-row__txt">
                <div class="st-row__t" id="tunnelState"><%= es ? 'Comprobando…' : 'Checking…' %></div>
                <div id="tunnelUrl" class="st-addrs"></div>
              </div>
              <div class="st-btns">
                <button type="button" class="vt-btn vt-btn--primary" id="tunnelStartBtn" onclick="tunnelAction('start')"><%= es ? 'Arrancar túnel' : 'Start tunnel' %></button>
                <button type="button" class="vt-btn vt-btn--ghost" id="tunnelStopBtn" onclick="tunnelAction('stop')"><%= es ? 'Parar' : 'Stop' %></button>
                <button type="button" class="vt-btn vt-btn--primary" id="tunnelInstallBtn" style="display:none" onclick="tunnelInstall()"><%= es ? 'Instalar cloudflared' : 'Install cloudflared' %></button>
              </div>
            </div>
            <div class="st-row st-row--hint" id="tunnelHintRow"><div class="st-row__d" id="tunnelHint"></div></div>
            <div class="st-row st-row--wrap">
              <div class="st-row__txt">
                <div class="st-row__t st-row__t--sm"><%= es ? 'Modo' : 'Mode' %></div>
                <div id="tunnelQuickHelp" class="st-row__d" style="display:none">
                  <%= es ? 'Genera una URL aleatoria *.trycloudflare.com al arrancar (cambia en cada arranque). Ideal para probar o para un evento puntual.' : 'Generates a random *.trycloudflare.com URL on start (changes every start). Great for testing or one-off events.' %>
                </div>
              </div>
              <div class="vt-selw st-row__ctl st-row__ctl--wide">
                <select name="tunnel_mode" id="tunnelMode" onchange="tunnelModeUi()" aria-label="<%= es ? 'Modo' : 'Mode' %>">
                  <option value="off"   <%= (cfg.tunnel_mode || 'off') === 'off'   ? 'selected' : '' %>><%= es ? 'Desactivado' : 'Disabled' %></option>
                  <option value="quick" <%= cfg.tunnel_mode === 'quick' ? 'selected' : '' %>><%= es ? 'Rápido — URL temporal (sin cuenta ni dominio)' : 'Quick — temporary URL (no account/domain)' %></option>
                  <option value="token" <%= cfg.tunnel_mode === 'token' ? 'selected' : '' %>><%= es ? 'Cloudflare propio — token del club' : 'Own Cloudflare — club token' %></option>
                </select>
              </div>
            </div>
            <div id="tunnelTokenFields" style="display:none">
              <div class="st-row st-row--wrap">
                <div class="st-row__txt">
                  <label class="st-row__t st-row__t--sm" for="tunnelToken"><%= es ? 'Token del túnel' : 'Tunnel token' %></label>
                  <div class="st-row__d">Cloudflare → Zero Trust → Networks → Tunnels</div>
                </div>
                <input type="password" name="tunnel_token" id="tunnelToken" class="vt-inp is-mono st-row__ctl st-row__ctl--wide"
                       placeholder="eyJhIjoi…" value="<%= cfg.tunnel_token || '' %>" autocomplete="off">
              </div>
              <div class="st-row st-row--wrap">
                <div class="st-row__txt">
                  <label class="st-row__t st-row__t--sm" for="tunnelHost"><%= es ? 'Dominio público' : 'Public hostname' %></label>
                  <div class="st-row__d"><%= es ? 'Informativo, p. ej. directo.miclub.com' : 'Informational, e.g. live.myclub.com' %></div>
                </div>
                <input type="text" name="tunnel_hostname" id="tunnelHost" class="vt-inp is-mono st-row__ctl st-row__ctl--wide"
                       placeholder="directo.miclub.com" value="<%= cfg.tunnel_hostname || '' %>" autocomplete="off">
              </div>
              <details class="st-row st-howto">
                <summary><span class="ar"></span><%= es ? 'Cómo configurarlo (una sola vez)' : 'How to set it up (one time)' %></summary>
                <ol>
                  <li><%= es ? 'Entra en el' : 'Open the' %> <a href="https://one.dash.cloudflare.com/" target="_blank" rel="noopener">Cloudflare Zero Trust dashboard</a> <%= es ? '(cuenta gratuita) con tu dominio ya añadido a Cloudflare.' : '(free account) with your domain already added to Cloudflare.' %></li>
                  <li><b>Networks → Tunnels → Create a tunnel</b> (Cloudflared) · <%= es ? 'dale un nombre (p. ej. el del club).' : 'give it a name (e.g. your club).' %></li>
                  <li><%= es ? 'Copia el' : 'Copy the' %> <b>token</b> <%= es ? 'del conector (la cadena larga que empieza por «eyJ…») y pégalo arriba.' : 'from the connector (the long string starting with “eyJ…”) and paste it above.' %></li>
                  <li><%= es ? 'En' : 'Under' %> <b>Public Hostnames</b>, <%= es ? 'añade el subdominio (p. ej. directo.miclub.com) apuntando a' : 'add the subdomain (e.g. live.myclub.com) pointing at' %> <code>http://localhost:3000</code>.</li>
                </ol>
                <a href="https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/get-started/create-remote-tunnel/" target="_blank" rel="noopener"><%= es ? 'Guía oficial de Cloudflare (crear un túnel remoto)' : 'Official Cloudflare guide (create a remote tunnel)' %></a>
              </details>
            </div>
            <label class="st-row st-check">
              <input type="checkbox" name="tunnel_autostart" value="1" <%= cfg.tunnel_autostart === '1' ? 'checked' : '' %>>
              <span><%= es ? 'Arrancar el túnel automáticamente con PitWall' : 'Start the tunnel automatically with PitWall' %></span>
            </label>
          </div>
        </section>

        <!-- ══ Integraciones ═════════════════════════════════════════════ -->
        <section class="st-sec" data-sec="int">
          <header class="st-sec__h">
            <h2><%= es ? 'Integraciones' : 'Integrations' %></h2>
            <p><%= es ? 'Conexión con apps de terceros.' : 'Connection with third-party apps.' %></p>
          </header>
          <div class="st-card">
            <div class="st-row">
              <div class="st-row__txt">
                <div class="st-row__t"><%= es ? 'Compatibilidad Infolap' : 'Infolap compatibility' %></div>
                <div class="st-row__d"><%= es ? 'La app móvil de Tic Tac Slot Infolap se conecta a PitWall y recibe vueltas en directo. Abre UDP :4441.' : 'The Tic Tac Slot Infolap mobile app connects to PitWall and receives live laps. Opens UDP :4441.' %></div>
              </div>
              <button type="button" class="vt-switch <%= cfg.infolap_enabled === '1' ? 'is-on' : '' %>" id="infolapSwitch" data-switch="infolapInput" role="switch" aria-checked="<%= cfg.infolap_enabled === '1' %>" aria-label="<%= es ? 'Compatibilidad Infolap' : 'Infolap compatibility' %>"></button>
              <input type="hidden" name="infolap_enabled" id="infolapInput" value="<%= cfg.infolap_enabled === '1' ? '1' : '' %>">
            </div>
          </div>
        </section>

        <!-- ══ Diagnóstico ═══════════════════════════════════════════════ -->
        <section class="st-sec" data-sec="diag">
          <header class="st-sec__h">
            <h2><%= es ? 'Diagnóstico' : 'Diagnostics' %></h2>
            <p><%= es ? 'Herramientas para investigar un problema.' : 'Tools to investigate a problem.' %></p>
          </header>
          <div class="st-card">
            <div class="st-row">
              <div class="st-row__txt">
                <div class="st-row__t"><%= es ? 'Modo debug' : 'Debug mode' %></div>
                <div class="st-row__d"><%= es ? 'Registra tramas DS-300 crudas, cruces de carril, eventos de manga y errores en logs/debug/ (.jsonl + .log). Un par de ficheros por manga.' : 'Logs raw DS-300 frames, lane crossings, manga events and errors under logs/debug/ (.jsonl + .log). One pair per manga.' %></div>
              </div>
              <button type="button" class="vt-switch <%= cfg.debug_mode === '1' ? 'is-on' : '' %>" id="dbgSwitch" data-switch="dbgInput" role="switch" aria-checked="<%= cfg.debug_mode === '1' %>" aria-label="<%= es ? 'Modo debug' : 'Debug mode' %>"></button>
              <input type="hidden" name="debug_mode" id="dbgInput" value="<%= cfg.debug_mode === '1' ? '1' : '' %>">
            </div>
            <a class="st-row st-row--link" href="/diagnostico/tramas">
              <div class="st-row__txt">
                <div class="st-row__t"><%= es ? 'Visor de tramas en vivo' : 'Live frame viewer' %></div>
                <div class="st-row__d"><%= es ? 'Las tramas del cronómetro según llegan.' : 'Timer frames as they arrive.' %></div>
              </div>
              <svg class="st-chev" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
            </a>
            <a class="st-row st-row--link" href="/diagnostico">
              <div class="st-row__txt">
                <div class="st-row__t"><%= es ? 'Diagnóstico de mangas' : 'Manga diagnostics' %></div>
                <div class="st-row__d"><%= es ? 'Mangas atascadas, activas o pendientes.' : 'Stuck, active or pending mangas.' %></div>
              </div>
              <svg class="st-chev" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
            </a>
            <% if (rawLog.length > 0) { %>
              <details class="st-row st-howto">
                <summary><span class="ar"></span><%= es ? 'Últimos bytes recibidos' : 'Last received bytes' %></summary>
                <div class="vt-bytes"><% rawLog.forEach(({ byte }) => { %><%= '0x' + byte.toString(16).padStart(2,'0').toUpperCase() + ' ' %><% }) %></div>
              </details>
            <% } %>
          </div>
        </section>
      </div>
    </div>

    <div class="st-bar" id="stBar">
      <div class="st-bar__in">
        <span class="st-dot" id="stBarDot"></span>
        <span class="st-bar__msg" id="stBarMsg"><%= es ? 'Sin cambios' : 'No changes' %></span>
        <span id="stBarRestart" hidden><%- restartChip %></span>
        <span class="st-top__fill"></span>
        <a href="/settings" class="vt-btn vt-btn--ghost" id="stDiscard" hidden><%= es ? 'Descartar' : 'Discard' %></a>
        <button type="submit" class="vt-btn vt-btn--primary"><%= es ? 'Guardar y aplicar' : 'Save & apply' %></button>
      </div>
    </div>
  </form>
</div>

<script src="/js/laneColors.js"></script>
<script>
const LANG = "<%= lang %>";

/* ── radio source ── */
const sim = document.getElementById('optSim');
const ds  = document.getElementById('optDs');
const agg = document.getElementById('optAgg');
const bart = document.getElementById('optBart');
const simDiv = document.getElementById('simSettings');
const serialDiv = document.getElementById('serialSettings');
const aggDiv = document.getElementById('aggSettings');
const bartDiv = document.getElementById('bartSettings');
function pickSource(){
  const mode = document.querySelector('input[name="serial_mode"]:checked')?.value;
  sim.classList.toggle('is-sel', mode === 'simulation');
  ds.classList.toggle('is-sel',  mode === 'serial');
  if (agg) agg.classList.toggle('is-sel', mode === 'serial_agg');
  if (bart) bart.classList.toggle('is-sel', mode === 'bart');
  simDiv.style.display    = mode === 'simulation' ? '' : 'none';
  serialDiv.style.display = mode === 'serial'     ? '' : 'none';
  if (aggDiv)  aggDiv.style.display  = mode === 'serial_agg' ? '' : 'none';
  if (bartDiv) bartDiv.style.display = mode === 'bart' ? '' : 'none';
}
document.querySelectorAll('input[name="serial_mode"]').forEach(r => r.addEventListener('change', pickSource));
pickSource();

/* ── BART: transporte TCP vs BLE (aplica a todos los Master de la lista) ── */
const bartTransport = document.getElementById('bartTransport');
function pickBartTransport(){
  const t = bartTransport ? bartTransport.value : 'ble';
  document.querySelectorAll('.bart-tcp-fields').forEach(el => { el.style.display = t === 'ble' ? 'none' : ''; });
}
if (bartTransport) { bartTransport.addEventListener('change', pickBartTransport); pickBartTransport(); }

/* ── BART: varios Master, numeración de carriles global ── */
function updateBartBadges(){
  let offset = 1;
  document.querySelectorAll('.bart-row').forEach((row, idx) => {
    const lanes = parseInt(row.querySelector('.bart-lanes-input')?.value || '8', 10) || 8;
    const badge = row.querySelector('.bart-lanes-badge');
    const title = row.querySelector('.bname');
    if (title) title.textContent = (LANG === 'es' ? 'Master ' : 'Master ') + (idx + 1);
    if (badge) badge.textContent = (LANG === 'es' ? 'Carriles ' : 'Lanes ') + offset + '–' + (offset + lanes - 1);
    offset += lanes;
  });
}
function renumberBartRows(){
  document.querySelectorAll('.bart-row').forEach((row, i) => { row.dataset.index = i; });
}
function bartRowHTML(idx){
  const tcpHidden = (bartTransport && bartTransport.value === 'tcp') ? '' : 'display:none';
  return `
    <div class="vt-circuit-row__h">
      <div class="vt-circuit-row__num bnum"></div>
      <div class="vt-circuit-row__title bname"></div>
      <span class="vt-circuit-row__lanes-badge bart-lanes-badge"></span>
      <button type="button" class="vt-circuit-row__x btn-remove-bart" title="${LANG === 'es' ? 'Eliminar' : 'Remove'}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <div class="vt-fields vt-fields--2 circuit-row__body">
      <div class="vt-field">
        <label>${LANG === 'es' ? 'Nombre BLE del Master' : 'Master BLE name'}</label>
        <input class="vt-inp is-mono bart-name-input" type="text" name="bart_master_name" placeholder="BART_TRACK${idx + 1}" value="">
      </div>
      <div class="vt-field">
        <label>${LANG === 'es' ? 'Nº de carriles' : 'Lanes'}</label>
        <input class="vt-inp is-mono bart-lanes-input" type="number" name="bart_master_lanes" min="2" max="32" value="8">
      </div>
    </div>
    <div class="vt-fields vt-fields--2 bart-tcp-fields" style="margin-top:14px;${tcpHidden}">
      <div class="vt-field">
        <label>${LANG === 'es' ? 'Host del puente' : 'Bridge host'}</label>
        <input class="vt-inp is-mono" type="text" name="bart_master_host" placeholder="127.0.0.1" value="127.0.0.1">
      </div>
      <div class="vt-field">
        <label>${LANG === 'es' ? 'Puerto' : 'Port'}</label>
        <input class="vt-inp is-mono" type="number" name="bart_master_port" min="1" max="65535" value="9300">
      </div>
    </div>`;
}
document.getElementById('addBartMaster')?.addEventListener('click', () => {
  const list = document.getElementById('bartList');
  const div = document.createElement('div');
  div.className = 'vt-circuit-row bart-row';
  div.innerHTML = bartRowHTML(document.querySelectorAll('.bart-row').length);
  list.appendChild(div);
  renumberBartRows();
  updateBartBadges();
});
document.getElementById('bartList')?.addEventListener('click', e => {
  const btn = e.target.closest('.btn-remove-bart');
  if (!btn) return;
  const rows = document.querySelectorAll('.bart-row');
  if (rows.length > 1) { btn.closest('.bart-row').remove(); renumberBartRows(); updateBartBadges(); }
});
document.getElementById('bartList')?.addEventListener('input', e => {
  if (e.target.classList.contains('bart-lanes-input')) updateBartBadges();
});
updateBartBadges();

/* ── interruptores: botón visual + input oculto que viaja en el formulario ── */
document.querySelectorAll('[data-switch]').forEach(btn => {
  const input = document.getElementById(btn.dataset.switch);
  btn.addEventListener('click', () => {
    const on = btn.classList.toggle('is-on');
    btn.setAttribute('aria-checked', on ? 'true' : 'false');
    input.value = on ? '1' : '';
    document.querySelectorAll(`[data-show-when="${input.id}"]`).forEach(el => { el.hidden = !on; });
    if (input.id === 'dbgInput') setNavDot('diag', on ? 'warn' : '');
    input.dispatchEvent(new Event('change', { bubbles: true }));
  });
});

function setNavDot(sec, kind){
  const dot = document.getElementById('navDot-' + sec);
  if (dot) dot.className = 'st-dot' + (kind ? ' st-dot--' + kind : '');
}

/* ── secciones: menú lateral. Se recuerda la última para volver a ella tras guardar ── */
const SECS = Array.from(document.querySelectorAll('.st-sec')).map(s => s.dataset.sec);
function showSection(sec){
  if (!SECS.includes(sec)) sec = SECS[0];
  document.querySelectorAll('.st-sec').forEach(s => s.classList.toggle('is-active', s.dataset.sec === sec));
  document.querySelectorAll('.st-nav__item').forEach(b => {
    const on = b.dataset.sec === sec;
    b.classList.toggle('is-active', on);
    if (on) b.setAttribute('aria-current', 'true'); else b.removeAttribute('aria-current');
  });
  try { sessionStorage.setItem('pw.settings.sec', sec); } catch {}
}
document.querySelectorAll('.st-nav__item').forEach(b => b.addEventListener('click', () => {
  showSection(b.dataset.sec);
  history.replaceState(null, '', '#' + b.dataset.sec);
  if (window.matchMedia('(max-width: 900px)').matches) window.scrollTo({ top: 0 });
}));
(function initSection(){
  let saved = null;
  try { saved = sessionStorage.getItem('pw.settings.sec'); } catch {}
  showSection(location.hash.slice(1) || saved || SECS[0]);
})();

/* ── barra de cambios sin guardar ── */
const settingsForm = document.getElementById('settingsForm');
/* ── Colores de carril globales: guardado propio (no reinicia la conexión) ── */
(function () {
  const grid = document.getElementById('globalLaneColorsGrid');
  if (!grid) return;
  const FACTORY = <%- JSON.stringify(defaultLaneColors) %>;
  const saveBtn = document.getElementById('laneColorsSave');
  const msg     = document.getElementById('laneColorsMsg');
  let saved = PWLaneColors.values(grid).join(',');
  const refresh = () => { saveBtn.disabled = PWLaneColors.values(grid).join(',') === saved; msg.textContent = ''; };
  PWLaneColors.bind(grid, refresh);
  document.getElementById('laneColorsDefault').addEventListener('click', () => { PWLaneColors.setAll(grid, FACTORY); refresh(); });
  saveBtn.addEventListener('click', async () => {
    saveBtn.disabled = true;
    try {
      const r = await fetch('/settings/lane-colors', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
        body: new URLSearchParams({ colors: PWLaneColors.values(grid).join(',') }),
      });
      if (!r.ok) throw new Error(r.status);
      saved = PWLaneColors.values(grid).join(',');
      msg.textContent = LANG === 'es' ? 'Guardados ✓' : 'Saved ✓';
    } catch {
      saveBtn.disabled = false;
      msg.textContent = LANG === 'es' ? 'No se han podido guardar' : 'Could not save';
    }
  });
})();

/* ── Preferencias de guardado inmediato (no reinician la conexión) ── */
(function () {
  const msgEl = document.getElementById('prefsMsg');
  const msg = { set textContent(v) { msgEl.textContent = v; msgEl.parentElement.hidden = !v; } };
  document.querySelectorAll('select[data-pref]').forEach(sel => {
    let saved = sel.value;
    sel.addEventListener('change', async () => {
      try {
        const r = await fetch('/settings/prefs', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
          body: new URLSearchParams({ key: sel.dataset.pref, value: sel.value }),
        });
        if (!r.ok) throw new Error(r.status);
        saved = sel.value;
        msg.textContent = LANG === 'es' ? 'Guardado ✓' : 'Saved ✓';
      } catch {
        sel.value = saved;
        msg.textContent = LANG === 'es' ? 'No se ha podido guardar' : 'Could not save';
      }
    });
  });
  document.querySelectorAll('input[data-pref-ms]').forEach(inp => {
    let saved = inp.value;
    inp.addEventListener('change', async () => {
      try {
        const r = await fetch('/settings/prefs', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
          body: new URLSearchParams({ key: inp.dataset.prefMs, value: String(Math.round(parseFloat(inp.value.replace(',', '.')) * 1000)) }),
        });
        if (!r.ok) throw new Error(r.status);
        saved = inp.value;
        msg.textContent = LANG === 'es' ? 'Guardado ✓' : 'Saved ✓';
      } catch {
        inp.value = saved;
        msg.textContent = LANG === 'es' ? 'No se ha podido guardar (0 a 10 s)' : 'Could not save (0 to 10 s)';
      }
    });
  });
})();

/* ── Seguridad: contraseña de acceso ── */
(function () {
  const sw = document.getElementById('pwSwitch');
  if (!sw) return;
  const fields = document.getElementById('pwFields');
  const actions = document.getElementById('pwActions');
  const pw = document.getElementById('pwNew'), pw2 = document.getElementById('pwConfirm');
  const msgEl = document.getElementById('pwMsg');
  const msg = { set textContent(v) { msgEl.textContent = v; msgEl.parentElement.hidden = !v; } };
  const ES = LANG === 'es';
  let enabled = sw.classList.contains('is-on');
  const paint = () => {
    sw.classList.toggle('is-on', enabled);
    sw.setAttribute('aria-checked', enabled ? 'true' : 'false');
    actions.hidden = !enabled;
    setNavDot('sec', enabled ? 'ok' : '');
  };
  async function send(body) {
    const r = await fetch('/settings/security', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
      body: new URLSearchParams(body),
    });
    const d = await r.json().catch(() => ({}));
    if (!r.ok || !d.ok) throw new Error(d.error || (ES ? 'No se ha podido guardar' : 'Could not save'));
    return d;
  }
  sw.addEventListener('click', async () => {
    if (enabled) {
      try {
        await send({ enabled: '0' });
        enabled = false; paint();
        fields.hidden = false;
        msg.textContent = ES ? 'Contraseña desactivada ✓' : 'Password disabled ✓';
      } catch (e) { msg.textContent = e.message; }
    } else {
      fields.hidden = false;
      pw.focus();
      msg.textContent = ES ? 'Escribe la contraseña y pulsa «Activar».' : 'Type the password and press "Enable".';
    }
  });
  document.getElementById('pwChange').addEventListener('click', () => { fields.hidden = false; pw.focus(); });
  document.getElementById('pwSave').addEventListener('click', async () => {
    try {
      await send({ enabled: '1', password: pw.value, confirm: pw2.value });
      const changed = enabled;
      enabled = true; paint();
      pw.value = pw2.value = '';
      fields.hidden = true;
      msg.textContent = changed ? (ES ? 'Contraseña cambiada ✓' : 'Password changed ✓')
                                : (ES ? 'Contraseña activada ✓ Este navegador sigue dentro hasta que pulses «Bloquear» en el inicio o «Cerrar sesión» aquí; a partir de ahí Sistema y Catálogo piden la contraseña.' : 'Password enabled ✓ This browser stays signed in until you press "Lock" on the home page or "Sign out" here; from then on System and Catalog ask for the password.');
    } catch (e) { msg.textContent = e.message; }
  });
})();

const formSnapshot = f => new URLSearchParams(new FormData(f)).toString();
const restartSnapshot = f => Array.from(f.querySelectorAll('[data-restart]')).map(el => el.value).join('|');
let initialForm = null, initialRestart = null;
function updateSaveBar(){
  const changed = formSnapshot(settingsForm) !== initialForm;
  const restart = changed && restartSnapshot(settingsForm) !== initialRestart;
  document.getElementById('stBar').classList.toggle('is-dirty', changed);
  document.getElementById('stBarDot').className = 'st-dot' + (changed ? ' st-dot--warn' : '');
  document.getElementById('stBarMsg').textContent = changed
    ? (LANG === 'es' ? 'Cambios sin guardar' : 'Unsaved changes')
    : (LANG === 'es' ? 'Sin cambios' : 'No changes');
  document.getElementById('stBarRestart').hidden = !restart;
  document.getElementById('stDiscard').hidden = !changed;
}
let saveBarQueued = false;
function queueSaveBar(){
  if (saveBarQueued) return;
  saveBarQueued = true;
  setTimeout(() => { saveBarQueued = false; updateSaveBar(); }, 0);
}
['input', 'change', 'click'].forEach(ev => settingsForm.addEventListener(ev, queueSaveBar));

/* ── lane badge labels ── */
function updateLaneBadges(){
  let offset = 1;
  document.querySelectorAll('.circuit-row').forEach((row, idx) => {
    const lanes = parseInt(row.querySelector('.circuit-lanes-input')?.value || '8', 10);
    const badge = row.querySelector('.circuit-row__lanes-badge');
    const title = row.querySelector('.vt-circuit-row__title');
    if (title) title.textContent = (LANG === 'es' ? 'Circuito ' : 'Circuit ') + (idx + 1);
    if (badge) badge.textContent = (LANG === 'es' ? 'Carriles ' : 'Lanes ') + offset + '–' + (offset + lanes - 1);
    offset += lanes;
  });
}

/* ── combo desplegable ↔ escritura a mano (puerto y baud) ── */
function wireCombo(container, selCls, inpCls, toggleCls){
  const sel = container.querySelector(selCls);
  const inp = container.querySelector(inpCls);
  if (!sel || !inp) return;
  sel.addEventListener('change', () => { if (sel.value) inp.value = sel.value; });
  inp.addEventListener('input', () => {
    let opt = Array.from(sel.options).find(o => o.value === inp.value);
    if (!opt && inp.value) { opt = new Option(inp.value, inp.value); sel.appendChild(opt); }
    sel.value = inp.value;
  });
  const toggle = container.querySelector(toggleCls);
  toggle?.addEventListener('click', () => {
    const open = inp.classList.toggle('is-hidden') === false;
    toggle.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (open) inp.focus();
  });
}
function wirePortFields(container){ wireCombo(container, '.port-select', '.port-manual', '.port-manual-toggle'); }
function wireBaudFields(container){ wireCombo(container, '.baud-select', '.baud-manual', '.baud-manual-toggle'); }
document.querySelectorAll('.circuit-row__field--port').forEach(wirePortFields);
document.querySelectorAll('.js-baud-field').forEach(wireBaudFields);

/* ── escenario (circuito guardado) ↔ filas de DS ───────────────────────────
   Un escenario puede tener varios circuitos (sub-lazos de 2-8 carriles). Al
   elegirlo, esta fila pasa a ser el circuito 1 y se crean automáticamente las
   filas de DS restantes (una por circuito), cada una con SUS carriles. */
function renumberCircuitRows(){
  document.querySelectorAll('.circuit-row').forEach((row, i) => {
    const num = row.querySelector('.cnum'); if (num) num.textContent = i + 1;
    const title = row.querySelector('.cname'); if (title) title.textContent = (LANG === 'es' ? 'Circuito ' : 'Circuit ') + (i + 1);
  });
}

function wireCircuitRef(row){
  const sel = row.querySelector('.circuit-ref-select');
  const inp = row.querySelector('.circuit-lanes-input');
  const sub = row.querySelector('.circuit-sub-input');
  if (!sel || !inp) return;
  sel.addEventListener('change', () => {
    // Quita las filas auto-creadas por una expansión previa de ESTA fila.
    if (row.dataset.expandGroup){
      document.querySelectorAll(`.circuit-row[data-expand-of="${row.dataset.expandGroup}"]`).forEach(r => r.remove());
      delete row.dataset.expandGroup;
    }
    let config = [];
    try { config = JSON.parse(sel.options[sel.selectedIndex]?.dataset?.config || '[]'); } catch {}
    if (!sel.value || !config.length){
      inp.readOnly = false; if (sub) sub.value = '';
      updateLaneBadges(); renumberCircuitRows(); return;
    }
    // Esta fila = circuito 1 del escenario.
    inp.value = config[0]; inp.readOnly = true; if (sub) sub.value = '0';
    // Una fila de DS por cada circuito restante (carriles propios, readonly).
    if (config.length > 1){
      const gid = 'g' + (window.__cgid = (window.__cgid || 0) + 1);
      row.dataset.expandGroup = gid;
      let after = row;
      for (let i = 1; i < config.length; i++){
        const nr = makeCircuitRow();
        nr.dataset.expandOf = gid;
        const nsel = nr.querySelector('.circuit-ref-select');
        const ninp = nr.querySelector('.circuit-lanes-input');
        const nsub = nr.querySelector('.circuit-sub-input');
        if (nsel) nsel.value = sel.value;
        if (ninp){ ninp.value = config[i]; ninp.readOnly = true; }
        if (nsub) nsub.value = String(i);
        after.after(nr); after = nr;
      }
    }
    updateLaneBadges(); renumberCircuitRows();
  });
}
document.querySelectorAll('.circuit-row').forEach(wireCircuitRef);
document.getElementById('circuitList').addEventListener('input', e => {
  if (e.target.classList.contains('circuit-lanes-input')) updateLaneBadges();
});

/* ── port options template for add-circuit ── */
const portOptions = Array.from(document.querySelectorAll('select.port-select option'))
  .filter((o,i,a) => a.findIndex(x => x.value === o.value) === i && o.value)
  .map(o => `<option value="${o.value}">${o.textContent.trim()}</option>`).join('');

const circuitRefOptions = `<option value="">— ${LANG === 'es' ? 'Manual' : 'Manual'} —</option>` +
  Array.from(document.querySelector('.circuit-ref-select')?.options || [])
    .filter(o => o.value)
    .map(o => `<option value="${o.value}" data-lanes="${o.dataset.lanes}" data-config='${o.dataset.config || ''}'>${o.textContent.trim()}</option>`)
    .join('');

/* ── fábrica de filas de DS ── */
