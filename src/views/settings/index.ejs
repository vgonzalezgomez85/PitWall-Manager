<%- include('../partials/header', { pageTitle: lang === 'es' ? 'Configuración' : 'Settings' }) %>

<%
const portsList = (connectedPorts || []).map(p => String(p).split('/').pop()).join(' · ');
const portState = isSimulating ? 'sim' : (connectedPorts && connectedPorts.length > 0 ? 'ok' : 'off');
%>

<div class="vt-page">
  <div class="vt-wrap vt-wrap--narrow">

    <a href="/" class="vt-back-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      <%= lang === 'es' ? 'Inicio' : 'Home' %>
    </a>

    <% if (flash) { %>
      <div class="flash flash--<%= flash.type %>" style="margin-bottom:1rem"><%- flash.text %></div>
    <% } %>

    <h1><%= lang === 'es' ? 'Configuración' : 'Settings' %></h1>

    <% if (portState === 'sim') { %>
      <div class="vt-port-pill is-sim">
        <span class="dot"></span> <%= lang === 'es' ? 'Modo simulación activo' : 'Simulation mode active' %>
      </div>
    <% } else if (portState === 'ok') { %>
      <% connectedPorts.forEach((p, i) => { %>
        <div class="vt-port-pill" style="margin-right:8px">
          <span class="dot"></span> C<%= i+1 %>: <span class="vt-mono"><%= p %></span>
        </div>
      <% }) %>
    <% } else { %>
      <div class="vt-port-pill is-off">
        <span class="dot"></span> <%= lang === 'es' ? 'Sin conexión' : 'Not connected' %>
      </div>
    <% } %>

    <form action="/settings" method="POST" class="vt-panel" novalidate>

      <datalist id="baud-options">
        <option value="9600"></option>
        <option value="19200"></option>
        <option value="38400"></option>
        <option value="56000"></option>
        <option value="57600"></option>
        <option value="115200"></option>
        <option value="230400"></option>
        <option value="460800"></option>
        <option value="921600"></option>
      </datalist>

      <div class="vt-sec-lbl"><%= lang === 'es' ? 'Fuente de datos' : 'Data source' %></div>

      <div class="vt-opts">
        <label class="vt-opt <%= (cfg.serial_mode || 'simulation') === 'simulation' ? 'is-sel' : '' %>" id="optSim">
          <input type="radio" name="serial_mode" value="simulation" <%= (cfg.serial_mode || 'simulation') === 'simulation' ? 'checked' : '' %>>
          <div class="vt-opt__radio"><svg viewBox="0 0 24 24"><path d="M5 12l4 4 10-10"/></svg></div>
          <div class="vt-opt__ico">
            <svg viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="11" rx="5.5"/><path d="M7.5 11v3M6 12.5h3"/><circle cx="16" cy="11.5" r="1"/><circle cx="18" cy="14" r="1"/></svg>
          </div>
          <div class="vt-opt__t"><%= lang === 'es' ? 'Simulación' : 'Simulation' %></div>
          <div class="vt-opt__d"><%= lang === 'es' ? 'Genera vueltas aleatorias. Ideal para pruebas.' : 'Generates random laps. Ideal for testing.' %></div>
        </label>

        <label class="vt-opt <%= cfg.serial_mode === 'serial' ? 'is-sel' : '' %>" id="optDs">
          <input type="radio" name="serial_mode" value="serial" <%= cfg.serial_mode === 'serial' ? 'checked' : '' %>>
          <div class="vt-opt__radio"><svg viewBox="0 0 24 24"><path d="M5 12l4 4 10-10"/></svg></div>
          <div class="vt-opt__ico">
            <svg viewBox="0 0 24 24"><path d="M9 2v5M15 2v5"/><path d="M7 7h10v3a5 5 0 0 1-10 0z"/><path d="M12 15v6"/></svg>
          </div>
          <div class="vt-opt__t">DS-300</div>
          <div class="vt-opt__d"><%= lang === 'es' ? 'Uno o varios DS-300 por USB/RS-232.' : 'One or more DS-300 via USB/RS-232.' %></div>
        </label>

        <label class="vt-opt <%= cfg.serial_mode === 'bart' ? 'is-sel' : '' %>" id="optBart">
          <input type="radio" name="serial_mode" value="bart" <%= cfg.serial_mode === 'bart' ? 'checked' : '' %>>
          <div class="vt-opt__radio"><svg viewBox="0 0 24 24"><path d="M5 12l4 4 10-10"/></svg></div>
          <div class="vt-opt__ico">
            <svg viewBox="0 0 24 24"><path d="M7 7l10 10-5 4V3l5 4L7 17"/></svg>
          </div>
          <div class="vt-opt__t">BART</div>
          <div class="vt-opt__d"><%= lang === 'es' ? 'Cronómetro BLE (Slot.it/Policar) vía puente.' : 'BLE timer (Slot.it/Policar) via bridge.' %></div>
        </label>
      </div>

      <!-- ── Simulation ──────────────────────────────────────────────────── -->
      <div id="simSettings" style="margin-top:22px">
        <div class="vt-sec-lbl"><%= lang === 'es' ? 'Parámetros de simulación' : 'Simulation parameters' %></div>
        <div class="vt-fields vt-fields--2">
          <div class="vt-field">
            <label><%= lang === 'es' ? 'Carriles a simular' : 'Lanes to simulate' %></label>
            <input class="vt-inp is-mono" type="number" name="sim_lanes" min="1" max="32" value="<%= cfg.sim_lanes || 6 %>">
          </div>
          <div class="vt-field">
            <label><%= lang === 'es' ? 'Vuelta media (ms)' : 'Avg lap time (ms)' %></label>
            <input class="vt-inp is-mono" type="number" name="sim_avg_ms" min="3000" max="60000" step="1000" value="<%= cfg.sim_avg_ms || 12000 %>">
          </div>
        </div>
      </div>

      <!-- ── BART (BLE timer via bridge) ──────────────────────────────────── -->
      <div id="bartSettings" style="display:none;margin-top:26px">
        <div class="vt-sub">
          <div>
            <h3><%= lang === 'es' ? 'Cronómetro BART (BLE)' : 'BART timer (BLE)' %></h3>
            <p class="vt-sub__p">
              <%= lang === 'es'
                ? 'SlotTime se conecta por TCP a un puente BART (emulador o puente BLE→TCP). El puente entrega los cruces; SlotTime lleva la carrera. Carriles numerados de forma global.'
                : 'SlotTime connects over TCP to a BART bridge (emulator or BLE→TCP bridge). The bridge delivers crossings; SlotTime runs the race. Lanes numbered globally.' %>
            </p>
          </div>
        </div>
        <div class="vt-fields vt-fields--3" style="margin-top:14px">
          <div class="vt-field">
            <label><%= lang === 'es' ? 'Transporte' : 'Transport' %></label>
            <div class="vt-selw">
              <select name="bart_transport" id="bartTransport">
                <option value="tcp" <%= (cfg.bart_transport || 'tcp') === 'tcp' ? 'selected' : '' %>><%= lang === 'es' ? 'TCP (emulador / puente)' : 'TCP (emulator / bridge)' %></option>
                <option value="ble" <%= cfg.bart_transport === 'ble' ? 'selected' : '' %>>BLE (<%= lang === 'es' ? 'directo' : 'direct' %>)</option>
              </select>
            </div>
          </div>
          <div class="vt-field">
            <label><%= lang === 'es' ? 'Nº de carriles' : 'Lanes' %></label>
            <input class="vt-inp is-mono" type="number" name="bart_lanes" min="2" max="32"
                   value="<%= cfg.bart_lanes || 4 %>">
          </div>
          <div class="vt-field">
            <label><%= lang === 'es' ? 'MinLap del Master (ms)' : 'Master MinLap (ms)' %></label>
            <input class="vt-inp is-mono" type="number" name="bart_minlap" min="0" max="65535" step="100"
                   value="<%= cfg.bart_minlap || 2000 %>"
                   title="<%= lang === 'es' ? 'Filtro anti-rebote del hardware: descarta cruces más rápidos que esto' : 'Hardware debounce: drops crossings faster than this' %>">
          </div>
        </div>

        <!-- Campos de TCP -->
        <div id="bartTcpFields" class="vt-fields vt-fields--2" style="margin-top:14px">
          <div class="vt-field">
            <label><%= lang === 'es' ? 'Host del puente' : 'Bridge host' %></label>
            <input class="vt-inp is-mono" type="text" name="bart_host" placeholder="127.0.0.1"
                   value="<%= cfg.bart_host || '127.0.0.1' %>">
          </div>
          <div class="vt-field">
            <label><%= lang === 'es' ? 'Puerto' : 'Port' %></label>
            <input class="vt-inp is-mono" type="number" name="bart_port" min="1" max="65535"
                   value="<%= cfg.bart_port || 9300 %>">
          </div>
        </div>

        <!-- Campos de BLE -->
        <div id="bartBleFields" class="vt-fields vt-fields--2" style="margin-top:14px;display:none">
          <div class="vt-field">
            <label><%= lang === 'es' ? 'Nombre BLE del Master' : 'Master BLE name' %></label>
            <input class="vt-inp is-mono" type="text" name="bart_name" placeholder="BART_MST"
                   value="<%= cfg.bart_name || 'BART_MST' %>">
          </div>
        </div>
      </div>

      <!-- ── Multi-circuit serial ───────────────────────────────────────── -->
      <div id="serialSettings" style="display:none;margin-top:26px">

        <div class="vt-sub">
          <div>
            <h3><%= lang === 'es' ? 'Circuitos DS-300' : 'DS-300 circuits' %></h3>
            <p class="vt-sub__p">
              <%= lang === 'es'
                ? 'Cada DS-300 controla un circuito independiente. Los carriles se numeran de forma global.'
                : 'Each DS-300 controls one independent circuit. Lanes are numbered globally.' %>
            </p>
          </div>
          <div class="vt-sub__actions">
            <button type="button" class="vt-btn vt-btn--ghost vt-btn--sm" id="refreshPorts" title="<%= lang === 'es' ? 'Buscar puertos COM' : 'Search COM ports' %>">
              <svg viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-2.6-6.4"/><path d="M21 3v5h-5"/></svg>
              <%= lang === 'es' ? 'Buscar puertos' : 'Refresh ports' %>
            </button>
            <% if (multiCircuit) { %>
              <button type="button" class="vt-btn vt-btn--ghost vt-btn--sm" id="addCircuit">
                <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                <%= lang === 'es' ? 'Añadir circuito' : 'Add circuit' %>
              </button>
            <% } else { %>
              <a href="/license" class="vt-upgrade-hint">
                🔒 <%= lang === 'es' ? 'Multi-circuito requiere Pro' : 'Multi-circuit requires Pro' %>
              </a>
            <% } %>
          </div>
        </div>

        <div id="circuitList">
          <% let globalLaneStart = 1; %>
          <% circuits.forEach((c, i) => { %>
            <div class="vt-circuit-row circuit-row" data-index="<%= i %>">
              <div class="vt-circuit-row__h">
                <div class="vt-circuit-row__num cnum"><%= i + 1 %></div>
                <div class="vt-circuit-row__title cname"><%= lang === 'es' ? 'Circuito' : 'Circuit' %> <%= i + 1 %></div>
                <span class="vt-circuit-row__lanes-badge circuit-row__lanes-badge">
                  <%= lang === 'es' ? 'Carriles' : 'Lanes' %>&nbsp;<%= globalLaneStart %>–<%= globalLaneStart + (c.lanes || 8) - 1 %>
                </span>
                <% if (multiCircuit) { %>
                  <button type="button" class="vt-circuit-row__x btn-remove-circuit" data-index="<%= i %>" title="Eliminar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
                  </button>
                <% } %>
              </div>

              <div class="vt-group-lbl"><%= lang === 'es' ? 'Conexión serie' : 'Serial connection' %></div>
              <div class="vt-fields vt-fields--3 circuit-row__body">
                <div class="vt-field circuit-row__field circuit-row__field--port">
                  <label><%= lang === 'es' ? 'Puerto' : 'Port' %></label>
                  <div class="vt-selw">
                    <select class="port-select" name="circuit_port">
                      <option value="">— <%= lang === 'es' ? 'seleccionar' : 'select' %> —</option>
                      <% ports.forEach(p => { %>
                        <option value="<%= p.path %>" <%= c.port === p.path ? 'selected' : '' %>>
                          <%= p.path %><%= p.manufacturer ? ` — ${p.manufacturer}` : '' %>
                        </option>
                      <% }) %>
                      <% if (c.port && !ports.find(p => p.path === c.port)) { %>
                        <option value="<%= c.port %>" selected><%= c.port %></option>
                      <% } %>
                    </select>
                  </div>
                  <input class="vt-inp is-mono port-manual" type="text"
                    placeholder="<%= lang === 'es' ? 'o escribe el path: /dev/ttys003' : 'or type path: COM3' %>"
                    value="<%= c.port || '' %>" style="margin-top:7px;font-size:13px">
                </div>
                <div class="vt-field circuit-row__field circuit-row__field--baud">
                  <label>Baud rate</label>
                  <input class="vt-inp is-mono" type="number" name="circuit_baud" list="baud-options"
                         min="300" max="921600" step="1"
                         value="<%= c.baud || 57600 %>" required>
                </div>
                <div class="vt-field circuit-row__field">
                  <label>Data bits</label>
                  <div class="vt-selw">
                    <select name="circuit_databits">
                      <% [7, 8].forEach(v => { %>
                        <option value="<%= v %>" <%= (c.dataBits || 8) == v ? 'selected' : '' %>><%= v %></option>
                      <% }) %>
                    </select>
                  </div>
                </div>
                <div class="vt-field circuit-row__field">
                  <label><%= lang === 'es' ? 'Paridad' : 'Parity' %></label>
                  <div class="vt-selw">
                    <select name="circuit_parity">
                      <% ['none','even','odd'].forEach(v => { %>
                        <option value="<%= v %>" <%= (c.parity || 'none') === v ? 'selected' : '' %>><%= v %></option>
                      <% }) %>
                    </select>
                  </div>
                </div>
                <div class="vt-field circuit-row__field">
                  <label>Stop bits</label>
                  <div class="vt-selw">
                    <select name="circuit_stopbits">
                      <% [1, 2].forEach(v => { %>
                        <option value="<%= v %>" <%= (c.stopBits || 1) == v ? 'selected' : '' %>><%= v %></option>
                      <% }) %>
                    </select>
                  </div>
                </div>
                <div class="vt-field circuit-row__field">
                  <label><%= lang === 'es' ? 'Control de flujo' : 'Flow control' %></label>
                  <div class="vt-selw">
                    <select name="circuit_flow">
                      <% ['none','rtscts','xonxoff'].forEach(v => { %>
                        <option value="<%= v %>" <%= (c.flowControl || 'none') === v ? 'selected' : '' %>><%= v %></option>
                      <% }) %>
                    </select>
                  </div>
                </div>
              </div>

              <div class="vt-divider"></div>

              <div class="vt-group-lbl"><%= lang === 'es' ? 'Asignación de carriles' : 'Lane assignment' %></div>
              <div class="vt-fields vt-fields--2">
                <div class="vt-field circuit-row__field circuit-row__field--circuit">
                  <label><%= lang === 'es' ? 'Circuito' : 'Circuit' %></label>
                  <div class="vt-selw">
                    <select class="circuit-ref-select" name="circuit_ref">
                      <option value="">— <%= lang === 'es' ? 'Manual' : 'Manual' %> —</option>
                      <% allCircuits.forEach(ac => { %>
                        <option value="<%= ac.id %>" data-lanes="<%= ac.lanes_count %>"
                          <%= String(c.circuit_id || '') === String(ac.id) ? 'selected' : '' %>>
                          <%= ac.name %> (<%= ac.lanes_count %>)
                        </option>
                      <% }) %>
                    </select>
                  </div>
                </div>
                <div class="vt-field circuit-row__field circuit-row__field--lanes">
                  <label><%= lang === 'es' ? 'Nº de carriles' : 'Lanes' %></label>
                  <input class="vt-inp is-mono circuit-lanes-input" type="number" name="circuit_lanes" min="2" max="8"
                    value="<%= c.lanes || 8 %>" <%= c.circuit_id ? 'readonly' : '' %>>
                </div>
              </div>
            </div>
            <% globalLaneStart += (c.lanes || 8); %>
          <% }) %>
        </div>


        <details>
          <summary>
            <span class="ar"></span>
            <svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            <%= lang === 'es' ? 'Avanzado: timing del parser DS-300' : 'Advanced: DS-300 parser timing' %>
          </summary>
          <div class="vt-disc-body">
            <div class="vt-field" style="max-width:160px;margin-top:10px">
              <label>FRAME_GAP_MS</label>
              <input class="vt-inp is-mono" type="number" name="serial_frame_gap_ms" min="10" max="500" value="<%= cfg.serial_frame_gap_ms || 75 %>">
            </div>
            <div class="vt-hint">
              <%= lang === 'es'
                ? 'Silencio (ms) entre bytes que separa dos tramas. Por defecto 75. Bájalo si tu DS encadena tramas muy rápido (Tic-Tac usa ~1).'
                : 'Silence (ms) between bytes that separates two frames. Default 75. Lower it if your DS chains frames fast.' %>
            </div>
          </div>
        </details>

        <% if (rawLog.length > 0) { %>
          <details>
            <summary>
              <span class="ar"></span>
              <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M8 9l3 3-3 3M13 15h4"/></svg>
              <%= lang === 'es' ? 'Ver bytes recibidos (debug)' : 'View received bytes (debug)' %>
            </summary>
            <div class="vt-disc-body">
              <div class="vt-bytes"><% rawLog.forEach(({ byte }) => { %><%= '0x' + byte.toString(16).padStart(2,'0').toUpperCase() + ' ' %><% }) %></div>
            </div>
          </details>
        <% } %>
      </div>

      <!-- ── Ajustes generales (siempre visibles, no dependen del modo) ── -->
        <!-- ── Debug mode ─────────────────────────────────────────────────── -->
        <div class="vt-debug">
          <button type="button" class="vt-switch <%= cfg.debug_mode === '1' ? 'is-on' : '' %>" id="dbgSwitch" aria-label="Toggle debug"></button>
          <input type="hidden" name="debug_mode" id="dbgInput" value="<%= cfg.debug_mode === '1' ? '1' : '' %>">
          <div>
            <div class="vt-debug__t">
              <svg viewBox="0 0 24 24"><rect x="8" y="8" width="8" height="10" rx="4"/><path d="M12 8V5M9 5L8 3M15 5l1-2M8 11H4M16 11h4M8 15H4M16 15h4M8 18l-2 2M16 18l2 2"/></svg>
              <%= lang === 'es' ? 'Modo debug' : 'Debug mode' %>
            </div>
            <div class="vt-debug__d">
              <%= lang === 'es'
                ? 'Registra tramas DS-300 crudas, cruces de carril, eventos de manga y errores en ficheros (.jsonl + .log) bajo logs/debug/. Un par de ficheros por manga.'
                : 'Logs raw DS-300 frames, lane crossings, manga events and errors to files (.jsonl + .log) under logs/debug/. One pair per manga.' %>
            </div>
          </div>
        </div>

        <!-- ── Compatibilidad Infolap (Tic Tac Slot) ──────────────────────── -->
        <div class="vt-debug">
          <button type="button" class="vt-switch <%= cfg.infolap_enabled === '1' ? 'is-on' : '' %>" id="infolapSwitch" aria-label="Toggle Infolap server"></button>
          <input type="hidden" name="infolap_enabled" id="infolapInput" value="<%= cfg.infolap_enabled === '1' ? '1' : '' %>">
          <div>
            <div class="vt-debug__t">
              <svg viewBox="0 0 24 24"><path d="M3 12h4l3-7 4 14 3-7h4"/></svg>
              <%= lang === 'es' ? 'Compatibilidad Infolap' : 'Infolap compatibility' %>
            </div>
            <div class="vt-debug__d">
              <%= lang === 'es'
                ? 'Permite que la app móvil legacy de Tic Tac Slot Infolap se conecte a Voltrace y reciba vueltas en vivo. Abre UDP :4441. Cambios al toggle requieren reiniciar el servidor.'
                : 'Lets the legacy Tic Tac Slot Infolap mobile app connect to Voltrace and receive live laps. Opens UDP :4441. Restart server after toggling.' %>
            </div>
          </div>
        </div>

        <!-- ── Control de acceso web ──────────────────────────────────── -->
        <div class="vt-debug">
          <button type="button" class="vt-switch <%= cfg.access_restrict_enabled !== '0' ? 'is-on' : '' %>" id="accessSwitch" aria-label="Toggle access restriction"></button>
          <input type="hidden" name="access_restrict_enabled" id="accessInput" value="<%= cfg.access_restrict_enabled !== '0' ? '1' : '' %>">
          <div style="flex:1">
            <div class="vt-debug__t">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
              <%= lang === 'es' ? 'Restringir acceso web' : 'Restrict web access' %>
            </div>
            <div class="vt-debug__d">
              <%= lang === 'es'
                ? 'Bloquea el acceso web desde cualquier IP salvo este equipo (localhost) y las IPs/rangos de la lista. No afecta a la app móvil ni a Infolap (siguen recibiendo el vuelta a vuelta).'
                : 'Blocks web access from any IP except this machine (localhost) and the listed IPs/ranges. Does not affect the mobile app or Infolap (they keep receiving live laps).' %>
            </div>
            <span class="vt-debug__d" style="display:block;margin:.6rem 0 .25rem">
              <%= lang === 'es' ? 'IPs/rangos permitidos (uno por línea; admite CIDR, p.ej. 192.168.1.50 o 192.168.1.0/24):' : 'Allowed IPs/ranges (one per line; CIDR ok, e.g. 192.168.1.50 or 192.168.1.0/24):' %>
            </span>
            <textarea name="access_allowlist" id="accessAllowlist" class="vt-inp" rows="4" style="width:100%;font-family:monospace"
              placeholder="192.168.1.50&#10;192.168.1.0/24"><%= (function(){ try { return JSON.parse(cfg.access_allowlist || '[]').join('\n'); } catch (e) { return ''; } })() %></textarea>
          </div>
        </div>

        <!-- ── Red del servidor ──────────────────────────────────────── -->
        <div class="vt-debug">
          <div style="flex:1">
            <div class="vt-debug__t">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
              <%= lang === 'es' ? 'Red del servidor' : 'Server network' %>
            </div>
            <div class="vt-debug__d">
              <%= lang === 'es'
                ? 'Elige por qué interfaz de red sirve el servidor. "Todas" lo hace accesible por LAN y WiFi a la vez; elige una para limitarlo a esa red. Requiere reiniciar el servidor.'
                : 'Choose which network interface the server uses. "All" makes it reachable on LAN and WiFi at once; pick one to limit it. Requires a server restart.' %>
            </div>
            <div class="vt-field" style="max-width:440px;margin-top:.6rem">
              <label><%= lang === 'es' ? 'Interfaz (requiere reiniciar)' : 'Interface (requires restart)' %></label>
              <select name="server_bind_iface" class="vt-inp">
                <option value="" <%= !bindIface ? 'selected' : '' %>><%= lang === 'es' ? 'Todas las interfaces (recomendado)' : 'All interfaces (recommended)' %></option>
                <% (netInterfaces || []).forEach(function (i) { %>
                  <option value="<%= i.name %>" <%= bindIface === i.name ? 'selected' : '' %>><%= i.name %> — <%= i.ip %></option>
                <% }); %>
              </select>
            </div>
            <span class="vt-debug__d" style="display:block;margin-top:.7rem">
              <%= lang === 'es' ? 'Dirección(es) del servidor ahora mismo:' : 'Server address(es) right now:' %>
            </span>
            <div style="margin-top:.25rem;font-family:monospace;font-size:.9rem">
              <% if (!serverIps || serverIps.length === 0) { %>
                <span class="vt-debug__d"><%= lang === 'es' ? 'Sin interfaces de red detectadas.' : 'No network interfaces detected.' %></span>
              <% } else { %>
                <% serverIps.forEach(function (i) { %>
                  <div>http://<%= i.ip %>:<%= serverPort %> <span class="vt-debug__d">(<%= i.name %>)</span></div>
                <% }); %>
              <% } %>
            </div>
          </div>
        </div>

      <div class="vt-form-foot">
        <a href="/" class="vt-btn vt-btn--ghost vt-btn--lg"><%= lang === 'es' ? 'Cancelar' : 'Cancel' %></a>
        <button type="submit" class="vt-btn vt-btn--primary vt-btn--lg"><%= lang === 'es' ? 'Guardar y aplicar' : 'Save & apply' %></button>
      </div>
    </form>
  </div>
</div>

<script>
const LANG = "<%= lang %>";

/* ── radio source ── */
const sim = document.getElementById('optSim');
const ds  = document.getElementById('optDs');
const bart = document.getElementById('optBart');
const simDiv = document.getElementById('simSettings');
const serialDiv = document.getElementById('serialSettings');
const bartDiv = document.getElementById('bartSettings');
function pickSource(){
  const mode = document.querySelector('input[name="serial_mode"]:checked')?.value;
  sim.classList.toggle('is-sel', mode === 'simulation');
  ds.classList.toggle('is-sel',  mode === 'serial');
  if (bart) bart.classList.toggle('is-sel', mode === 'bart');
  simDiv.style.display    = mode === 'simulation' ? '' : 'none';
  serialDiv.style.display = mode === 'serial'     ? '' : 'none';
  if (bartDiv) bartDiv.style.display = mode === 'bart' ? '' : 'none';
}
document.querySelectorAll('input[name="serial_mode"]').forEach(r => r.addEventListener('change', pickSource));
pickSource();

/* ── BART: transporte TCP vs BLE ── */
const bartTransport = document.getElementById('bartTransport');
const bartTcpFields = document.getElementById('bartTcpFields');
const bartBleFields = document.getElementById('bartBleFields');
function pickBartTransport(){
  const t = bartTransport ? bartTransport.value : 'tcp';
  if (bartTcpFields) bartTcpFields.style.display = t === 'ble' ? 'none' : '';
  if (bartBleFields) bartBleFields.style.display = t === 'ble' ? '' : 'none';
}
if (bartTransport) { bartTransport.addEventListener('change', pickBartTransport); pickBartTransport(); }

/* ── debug switch ── */
const sw = document.getElementById('dbgSwitch');
const swInput = document.getElementById('dbgInput');
sw.addEventListener('click', () => {
  sw.classList.toggle('is-on');
  swInput.value = sw.classList.contains('is-on') ? '1' : '';
});

/* ── infolap switch ── */
const ifSw = document.getElementById('infolapSwitch');
const ifInput = document.getElementById('infolapInput');
if (ifSw && ifInput) {
  ifSw.addEventListener('click', () => {
    ifSw.classList.toggle('is-on');
    ifInput.value = ifSw.classList.contains('is-on') ? '1' : '';
  });
}

/* ── access restriction switch ── */
const acSw = document.getElementById('accessSwitch');
const acInput = document.getElementById('accessInput');
if (acSw && acInput) {
  acSw.addEventListener('click', () => {
    acSw.classList.toggle('is-on');
    acInput.value = acSw.classList.contains('is-on') ? '1' : '';
  });
}

/* ── lane badge labels ── */
function updateLaneBadges(){
  let offset = 1;
  document.querySelectorAll('.circuit-row').forEach((row, idx) => {
    const lanes = parseInt(row.querySelector('.circuit-lanes-input')?.value || '8', 10);
    const badge = row.querySelector('.circuit-row__lanes-badge');
    const title = row.querySelector('.vt-circuit-row__title');
    if (title) title.textContent = (LANG === 'es' ? 'Circuito ' : 'Circuit ') + (idx + 1);
    if (badge) badge.textContent = (LANG === 'es' ? 'Carriles ' : 'Lanes ') + offset + '–' + (offset + lanes - 1);
    offset += lanes;
  });
}

/* ── port select ↔ manual ── */
function wirePortFields(container){
  const sel = container.querySelector('.port-select');
  const inp = container.querySelector('.port-manual');
  if (!sel || !inp) return;
  sel.addEventListener('change', () => { if (sel.value) inp.value = sel.value; });
  inp.addEventListener('input', () => {
    let opt = Array.from(sel.options).find(o => o.value === inp.value);
    if (!opt && inp.value) { opt = new Option(inp.value, inp.value); sel.appendChild(opt); }
    sel.value = inp.value;
  });
}
document.querySelectorAll('.circuit-row__field--port').forEach(wirePortFields);

/* ── saved-circuit ↔ lanes input ── */
function wireCircuitRef(row){
  const sel = row.querySelector('.circuit-ref-select');
  const inp = row.querySelector('.circuit-lanes-input');
  if (!sel || !inp) return;
  sel.addEventListener('change', () => {
    const opt = sel.options[sel.selectedIndex];
    const lanes = parseInt(opt?.dataset?.lanes || '0', 10);
    if (sel.value && lanes > 0) { inp.value = lanes; inp.readOnly = true; }
    else { inp.readOnly = false; }
    updateLaneBadges();
  });
}
document.querySelectorAll('.circuit-row').forEach(wireCircuitRef);
document.getElementById('circuitList').addEventListener('input', e => {
  if (e.target.classList.contains('circuit-lanes-input')) updateLaneBadges();
});

/* ── port options template for add-circuit ── */
const portOptions = Array.from(document.querySelectorAll('select.port-select option'))
  .filter((o,i,a) => a.findIndex(x => x.value === o.value) === i && o.value)
  .map(o => `<option value="${o.value}">${o.textContent.trim()}</option>`).join('');

const circuitRefOptions = `<option value="">— ${LANG === 'es' ? 'Manual' : 'Manual'} —</option>` +
  Array.from(document.querySelector('.circuit-ref-select')?.options || [])
    .filter(o => o.value)
    .map(o => `<option value="${o.value}" data-lanes="${o.dataset.lanes}">${o.textContent.trim()}</option>`)
    .join('');

/* ── add circuit ── */
document.getElementById('addCircuit')?.addEventListener('click', () => {
  const list = document.getElementById('circuitList');
  const idx = list.querySelectorAll('.circuit-row').length;
  const div = document.createElement('div');
  div.className = 'vt-circuit-row circuit-row';
  div.innerHTML = `
    <div class="vt-circuit-row__h">
      <div class="vt-circuit-row__num cnum">${idx+1}</div>
      <div class="vt-circuit-row__title cname">${LANG === 'es' ? 'Circuito' : 'Circuit'} ${idx+1}</div>
      <span class="vt-circuit-row__lanes-badge circuit-row__lanes-badge">${LANG === 'es' ? 'Carriles ?' : 'Lanes ?'}</span>
      <button type="button" class="vt-circuit-row__x btn-remove-circuit" title="Eliminar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <div class="vt-group-lbl">${LANG === 'es' ? 'Conexión serie' : 'Serial connection'}</div>
    <div class="vt-fields vt-fields--3 circuit-row__body">
      <div class="vt-field circuit-row__field circuit-row__field--port">
        <label>${LANG === 'es' ? 'Puerto' : 'Port'}</label>
        <div class="vt-selw"><select class="port-select" name="circuit_port">
          <option value="">— ${LANG === 'es' ? 'seleccionar' : 'select'} —</option>${portOptions}
        </select></div>
        <input class="vt-inp is-mono port-manual" type="text" style="margin-top:7px;font-size:13px"
          placeholder="${LANG === 'es' ? 'o escribe el path' : 'or type path'}">
      </div>
      <div class="vt-field circuit-row__field circuit-row__field--baud">
        <label>Baud rate</label>
        <input class="vt-inp is-mono" type="number" name="circuit_baud" list="baud-options"
               min="300" max="921600" step="1" value="57600" required>
      </div>
      <div class="vt-field circuit-row__field">
        <label>Data bits</label>
        <div class="vt-selw"><select name="circuit_databits"><option value="7">7</option><option value="8" selected>8</option></select></div>
      </div>
      <div class="vt-field circuit-row__field">
        <label>${LANG === 'es' ? 'Paridad' : 'Parity'}</label>
        <div class="vt-selw"><select name="circuit_parity"><option value="none" selected>none</option><option value="even">even</option><option value="odd">odd</option></select></div>
      </div>
      <div class="vt-field circuit-row__field">
        <label>Stop bits</label>
        <div class="vt-selw"><select name="circuit_stopbits"><option value="1" selected>1</option><option value="2">2</option></select></div>
      </div>
      <div class="vt-field circuit-row__field">
        <label>${LANG === 'es' ? 'Control de flujo' : 'Flow control'}</label>
        <div class="vt-selw"><select name="circuit_flow"><option value="none" selected>none</option><option value="rtscts">rtscts</option><option value="xonxoff">xonxoff</option></select></div>
      </div>
    </div>
    <div class="vt-divider"></div>
    <div class="vt-group-lbl">${LANG === 'es' ? 'Asignación de carriles' : 'Lane assignment'}</div>
    <div class="vt-fields vt-fields--2">
      <div class="vt-field circuit-row__field circuit-row__field--circuit">
        <label>${LANG === 'es' ? 'Circuito' : 'Circuit'}</label>
        <div class="vt-selw"><select class="circuit-ref-select" name="circuit_ref">${circuitRefOptions}</select></div>
      </div>
      <div class="vt-field circuit-row__field circuit-row__field--lanes">
        <label>${LANG === 'es' ? 'Nº de carriles' : 'Lanes'}</label>
        <input class="vt-inp is-mono circuit-lanes-input" type="number" name="circuit_lanes" min="2" max="8" value="8">
      </div>
    </div>`;
  list.appendChild(div);
  wirePortFields(div.querySelector('.circuit-row__field--port'));
  wireCircuitRef(div);
  updateLaneBadges();
});

/* ── remove circuit ── */
document.getElementById('circuitList').addEventListener('click', e => {
  const btn = e.target.closest('.btn-remove-circuit');
  if (!btn) return;
  const rows = document.querySelectorAll('.circuit-row');
  if (rows.length > 1) { btn.closest('.circuit-row').remove(); updateLaneBadges(); }
});

/* ── refresh COM ports ── */
document.getElementById('refreshPorts')?.addEventListener('click', async (e) => {
  const btn = e.currentTarget;
  const originalHTML = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<svg viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-2.6-6.4"/><path d="M21 3v5h-5"/></svg>' + (LANG === 'es' ? 'Buscando…' : 'Searching…');
  try {
    const res = await fetch('/api/settings/ports');
    const { ports } = await res.json();
    document.querySelectorAll('.port-select').forEach(sel => {
      const current = sel.value;
      const opts = '<option value="">— ' + (LANG === 'es' ? 'seleccionar' : 'select') + ' —</option>' +
        ports.map(p => `<option value="${p.path}"${p.path === current ? ' selected' : ''}>${p.path}${p.manufacturer ? ' — ' + p.manufacturer : ''}</option>`).join('');
      let extra = '';
      if (current && !ports.find(p => p.path === current)) extra = `<option value="${current}" selected>${current}</option>`;
      sel.innerHTML = opts + extra;
    });
    btn.innerHTML = '✓ ' + (LANG === 'es' ? `${ports.length} puertos` : `${ports.length} ports`);
    setTimeout(() => { btn.innerHTML = originalHTML; btn.disabled = false; }, 1500);
  } catch (err) {
    btn.innerHTML = '✗ ' + (LANG === 'es' ? 'Error' : 'Error');
    setTimeout(() => { btn.innerHTML = originalHTML; btn.disabled = false; }, 2000);
  }
});
</script>

<%- include('../partials/footer') %>
