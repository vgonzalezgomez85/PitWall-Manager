<%- include('../partials/header', { pageTitle: lang === 'es' ? 'Configuración' : 'Settings' }) %>
<div class="container container--narrow">

  <div class="page-header">
    <h1 class="page-title"><%= lang === 'es' ? 'Configuración' : 'Settings' %></h1>
  </div>

  <div class="settings-status">
    <% if (isSimulating) { %>
      <span class="badge badge--active">⚡ <%= lang === 'es' ? 'Modo simulación activo' : 'Simulation mode active' %></span>
    <% } else if (connectedPorts.length > 0) { %>
      <% connectedPorts.forEach((p, i) => { %>
        <span class="badge badge--active">🔌 C<%= i+1 %>: <%= p %></span>
      <% }) %>
    <% } else { %>
      <span class="badge badge--pending"><%= lang === 'es' ? 'Sin conexión' : 'Not connected' %></span>
    <% } %>
  </div>

  <form action="/settings" method="POST" class="form-card" style="margin-top:1.5rem">

    <h2 class="section-title" style="margin-top:0"><%= lang === 'es' ? 'Fuente de datos' : 'Data source' %></h2>

    <div class="form-group">
      <div class="option-cards">
        <label class="option-card">
          <input type="radio" name="serial_mode" value="simulation"
            <%= (cfg.serial_mode || 'simulation') === 'simulation' ? 'checked' : '' %>>
          <div class="option-card__body">
            <span class="option-card__icon">🎮</span>
            <span class="option-card__title"><%= lang === 'es' ? 'Simulación' : 'Simulation' %></span>
            <span class="option-card__desc"><%= lang === 'es' ? 'Genera vueltas aleatorias. Ideal para pruebas.' : 'Generates random laps. Ideal for testing.' %></span>
          </div>
        </label>
        <label class="option-card">
          <input type="radio" name="serial_mode" value="serial"
            <%= cfg.serial_mode === 'serial' ? 'checked' : '' %>>
          <div class="option-card__body">
            <span class="option-card__icon">🔌</span>
            <span class="option-card__title">DS-300</span>
            <span class="option-card__desc"><%= lang === 'es' ? 'Uno o varios DS-300 por USB/RS-232.' : 'One or more DS-300 via USB/RS-232.' %></span>
          </div>
        </label>
      </div>
    </div>

    <!-- ── Simulation ──────────────────────────────────────────────────── -->
    <div id="simSettings">
      <h3 class="form-label" style="margin-bottom:.75rem"><%= lang === 'es' ? 'Parámetros de simulación' : 'Simulation parameters' %></h3>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
        <div class="form-group" style="margin-bottom:0">
          <label class="form-label"><%= lang === 'es' ? 'Carriles a simular' : 'Lanes to simulate' %></label>
          <input class="form-input" type="number" name="sim_lanes" min="1" max="32" value="<%= cfg.sim_lanes || 6 %>">
        </div>
        <div class="form-group" style="margin-bottom:0">
          <label class="form-label"><%= lang === 'es' ? 'Vuelta media (ms)' : 'Avg lap time (ms)' %></label>
          <input class="form-input" type="number" name="sim_avg_ms" min="3000" max="60000" step="1000" value="<%= cfg.sim_avg_ms || 12000 %>">
        </div>
      </div>
    </div>

    <!-- ── Multi-circuit serial ───────────────────────────────────────── -->
    <div id="serialSettings" style="display:none">

      <div class="circuit-section-header">
        <div>
          <h3 class="form-label" style="margin:0">
            <%= lang === 'es' ? 'Circuitos DS-300' : 'DS-300 circuits' %>
          </h3>
          <p class="form-hint" style="margin:.35rem 0 0">
            <%= lang === 'es'
              ? 'Cada DS-300 controla un circuito independiente. Los carriles se numeran de forma global.'
              : 'Each DS-300 controls one independent circuit. Lanes are numbered globally.' %>
          </p>
        </div>
        <% if (multiCircuit) { %>
          <button type="button" class="btn btn--ghost btn--sm" id="addCircuit">
            + <%= lang === 'es' ? 'Añadir circuito' : 'Add circuit' %>
          </button>
        <% } else { %>
          <a href="/license" class="upgrade-hint">
            🔒 <%= lang === 'es' ? 'Multi-circuito requiere Pro' : 'Multi-circuit requires Pro' %>
          </a>
        <% } %>
      </div>

      <div id="circuitList">
        <% let globalLaneStart = 1; %>
        <% circuits.forEach((c, i) => { %>
          <div class="circuit-row" data-index="<%= i %>">
            <div class="circuit-row__header">
              <div class="circuit-row__title">
                <span class="circuit-row__num"><%= i + 1 %></span>
                <%= lang === 'es' ? 'Circuito' : 'Circuit' %> <%= i + 1 %>
                <span class="circuit-row__lanes-badge">
                  <%= lang === 'es' ? 'Carriles' : 'Lanes' %>&nbsp;<%= globalLaneStart %>–<%= globalLaneStart + (c.lanes || 8) - 1 %>
                </span>
              </div>
              <% if (multiCircuit) { %>
                <button type="button" class="btn-remove-circuit" data-index="<%= i %>" title="Eliminar">✕</button>
              <% } %>
            </div>
            <div class="circuit-row__body">
              <div class="circuit-row__field circuit-row__field--port">
                <label class="form-label"><%= lang === 'es' ? 'Puerto serie' : 'Serial port' %></label>
                <select class="form-input" name="circuit_port">
                  <option value=""><%= lang === 'es' ? '— seleccionar —' : '— select —' %></option>
                  <% ports.forEach(p => { %>
                    <option value="<%= p.path %>" <%= c.port === p.path ? 'selected' : '' %>>
                      <%= p.path %><%= p.manufacturer ? ` — ${p.manufacturer}` : '' %>
                    </option>
                  <% }) %>
                  <% if (c.port && !ports.find(p => p.path === c.port)) { %>
                    <option value="<%= c.port %>" selected><%= c.port %></option>
                  <% } %>
                </select>
              </div>
              <div class="circuit-row__field circuit-row__field--baud">
                <label class="form-label">Baud</label>
                <input class="form-input" type="number" name="circuit_baud" value="<%= c.baud || 4800 %>">
              </div>
              <div class="circuit-row__field circuit-row__field--lanes">
                <label class="form-label"><%= lang === 'es' ? 'Carriles' : 'Lanes' %></label>
                <input class="form-input circuit-lanes-input" type="number" name="circuit_lanes" min="2" max="8" value="<%= c.lanes || 8 %>">
              </div>
            </div>
          </div>
          <% globalLaneStart += (c.lanes || 8); %>
        <% }) %>
      </div>

      <% if (rawLog.length > 0) { %>
        <details style="margin-top:1rem">
          <summary class="form-hint" style="cursor:pointer"><%= lang === 'es' ? 'Ver bytes recibidos (debug)' : 'View received bytes (debug)' %></summary>
          <div class="raw-log">
            <% rawLog.forEach(({ byte }) => { %>
              <span class="raw-byte">0x<%= byte.toString(16).padStart(2,'0').toUpperCase() %></span>
            <% }) %>
          </div>
        </details>
      <% } %>
    </div>

    <div class="form-actions">
      <a href="/" class="btn btn--ghost"><%= lang === 'es' ? 'Cancelar' : 'Cancel' %></a>
      <button type="submit" class="btn btn--primary"><%= lang === 'es' ? 'Guardar y aplicar' : 'Save & apply' %></button>
    </div>
  </form>
</div>

<style>
/* Circuit section header */
.circuit-section-header { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:1rem; gap:1rem; }
.upgrade-hint { font-size:.8rem; color:#8b949e; text-decoration:none; white-space:nowrap; padding:.3rem .75rem; border:1px solid #30363d; border-radius:6px; transition:color .15s; }
.upgrade-hint:hover { color:#d2a8ff; border-color:#d2a8ff; }

/* Circuit row */
.circuit-row { background:#0d1117; border:1px solid #21262d; border-radius:10px; padding:1rem 1.25rem; margin-bottom:.75rem; transition:border-color .15s; }
.circuit-row:hover { border-color:#30363d; }
.circuit-row__header { display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; }
.circuit-row__title { font-weight:600; color:#e6edf3; display:flex; align-items:center; gap:.6rem; font-size:.95rem; }
.circuit-row__num { width:1.5rem; height:1.5rem; background:#21262d; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:.75rem; color:#8b949e; flex-shrink:0; }
.circuit-row__lanes-badge { font-size:.72rem; background:#161b22; color:#58a6ff; border:1px solid #1c3a5e; padding:.15rem .5rem; border-radius:20px; font-weight:500; }
.circuit-row__body { display:grid; grid-template-columns:1fr 110px 110px; gap:.75rem; align-items:end; }
.circuit-row__field { display:flex; flex-direction:column; gap:.35rem; }
.btn-remove-circuit { background:none; border:none; color:#484f58; cursor:pointer; font-size:.9rem; padding:.3rem .5rem; border-radius:6px; line-height:1; transition:color .15s, background .15s; }
.btn-remove-circuit:hover { color:#f85149; background:#21262d; }
</style>

<script>
const modeRadios = document.querySelectorAll('input[name="serial_mode"]');
const simDiv     = document.getElementById('simSettings');
const serialDiv  = document.getElementById('serialSettings');
const portOptions = `<option value="">— seleccionar —</option>` +
  Array.from(document.querySelectorAll('select[name="circuit_port"] option'))
    .filter((o,i,a) => a.findIndex(x=>x.value===o.value)===i && o.value)
    .map(o=>`<option value="${o.value}">${o.textContent.trim()}</option>`).join('');

function updateView() {
  const mode = document.querySelector('input[name="serial_mode"]:checked')?.value;
  simDiv.style.display    = mode === 'simulation' ? '' : 'none';
  serialDiv.style.display = mode === 'serial'     ? '' : 'none';
}
modeRadios.forEach(r => r.addEventListener('change', updateView));
updateView();

// Update lane badge labels dynamically
function updateLaneBadges() {
  let offset = 1;
  document.querySelectorAll('.circuit-row').forEach(row => {
    const lanes = parseInt(row.querySelector('.circuit-lanes-input')?.value || '8', 10);
    const idx   = Array.from(document.querySelectorAll('.circuit-row')).indexOf(row) + 1;
    row.querySelector('.circuit-row__title').childNodes[0].textContent =
      `Circuito ${idx} `;
    row.querySelector('.circuit-row__lanes-badge').textContent =
      `Carriles ${offset}–${offset + lanes - 1}`;
    offset += lanes;
  });
}

document.getElementById('circuitList').addEventListener('input', e => {
  if (e.target.classList.contains('circuit-lanes-input')) updateLaneBadges();
});

// Add circuit
document.getElementById('addCircuit')?.addEventListener('click', () => {
  const list  = document.getElementById('circuitList');
  const idx   = list.querySelectorAll('.circuit-row').length;
  const div   = document.createElement('div');
  div.className = 'circuit-row';
  div.innerHTML = `
    <div class="circuit-row__header">
      <div class="circuit-row__title">
        <span class="circuit-row__num">${idx+1}</span>
        Circuito ${idx+1}
        <span class="circuit-row__lanes-badge">Carriles ?</span>
      </div>
      <button type="button" class="btn-remove-circuit" title="Eliminar">✕</button>
    </div>
    <div class="circuit-row__body">
      <div class="circuit-row__field circuit-row__field--port">
        <label class="form-label">Puerto serie</label>
        <select class="form-input" name="circuit_port"><option value="">— seleccionar —</option>${portOptions}</select>
      </div>
      <div class="circuit-row__field circuit-row__field--baud">
        <label class="form-label">Baud</label>
        <input class="form-input" type="number" name="circuit_baud" value="4800">
      </div>
      <div class="circuit-row__field circuit-row__field--lanes">
        <label class="form-label">Carriles</label>
        <input class="form-input circuit-lanes-input" type="number" name="circuit_lanes" min="2" max="8" value="8">
      </div>
    </div>`;
  list.appendChild(div);
  updateLaneBadges();
});

// Remove circuit
document.getElementById('circuitList').addEventListener('click', e => {
  if (e.target.classList.contains('btn-remove-circuit')) {
    const rows = document.querySelectorAll('.circuit-row');
    if (rows.length > 1) { e.target.closest('.circuit-row').remove(); updateLaneBadges(); }
  }
});
</script>

<%- include('../partials/footer') %>
